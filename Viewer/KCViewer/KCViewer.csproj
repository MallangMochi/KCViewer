	<!--
		Fork: the fork's commit, its date and whether the working tree had changes, for the version window
		(Fork/ForkVersion.cs). Read with git at build time, the way fork-portable.ps1 names its zip; empty without git.
		A release also has its version (2026-10-18 "정식 태그버전(1.0.0)과 개발버전(커밋해시와 날짜) 모두 입력 가능하게"):
		-p:ForkReleaseVersion=1.0.0 (fork-portable.ps1 -Version), else a tag such as v1.0.0 or 1.0.0 on the commit.
		The program update's public key (UPDATER-DESIGN.md 8-2, Fork/Update/ForkProgramUpdate.cs): -p:ForkUpdatePublicKey=,
		else ..\Portable\update-public-key.txt when it is there. Without one the viewer does not look for program updates.
	-->
	<Target Name="ForkCommitInfo" BeforeTargets="GetAssemblyAttributes">
		<Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
			<Output TaskParameter="ConsoleOutput" PropertyName="ForkCommit" />
		</Exec>
		<Exec Command="git log -1 --format=%%cs" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
			<Output TaskParameter="ConsoleOutput" PropertyName="ForkCommitDate" />
		</Exec>
		<Exec Command="git status --porcelain" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
			<Output TaskParameter="ConsoleOutput" PropertyName="ForkChanges" />
		</Exec>
		<Exec Command="git tag --points-at HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
			<Output TaskParameter="ConsoleOutput" PropertyName="ForkTags" />
		</Exec>
		<PropertyGroup>
			<ForkDirty>False</ForkDirty>
			<ForkDirty Condition="'$(ForkChanges)' != ''">True</ForkDirty>
			<!-- the first tag of the form [v]1.2.3 (the tags come as one list, separated by semicolons) -->
			<ForkTagVersion>$([System.Text.RegularExpressions.Regex]::Match(';$(ForkTags);', '(?&lt;=;v?)\d+\.\d+\.\d+[^;]*(?=;)'))</ForkTagVersion>
			<ForkReleaseVersion Condition="'$(ForkReleaseVersion)' == ''">$(ForkTagVersion)</ForkReleaseVersion>
			<ForkUpdatePublicKeyFile>$(MSBuildProjectDirectory)\..\Portable\update-public-key.txt</ForkUpdatePublicKeyFile>
			<ForkUpdatePublicKey Condition="'$(ForkUpdatePublicKey)' == '' And Exists('$(ForkUpdatePublicKeyFile)')">$([System.IO.File]::ReadAllText('$(ForkUpdatePublicKeyFile)').Trim())</ForkUpdatePublicKey>
		</PropertyGroup>
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>ForkReleaseVersion</_Parameter1>
				<_Parameter2>$(ForkReleaseVersion)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>ForkCommit</_Parameter1>
				<_Parameter2>$(ForkCommit)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>ForkCommitDate</_Parameter1>
				<_Parameter2>$(ForkCommitDate)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>ForkDirty</_Parameter1>
				<_Parameter2>$(ForkDirty)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>ForkUpdatePublicKey</_Parameter1>
				<_Parameter2>$(ForkUpdatePublicKey)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<EmbeddedResource Update="**\*.resx">
			<CustomToolNamespace>KCViewer.Translations</CustomToolNamespace>
		</EmbeddedResource>
	</ItemGroup>

	<PropertyGroup>
		<ResXGenerator_GenerateCode>true</ResXGenerator_GenerateCode>
		<ResXGenerator_PublicClass>true</ResXGenerator_PublicClass>
		<ResXGenerator_NullForgivingOperators>true</ResXGenerator_NullForgivingOperators>
		<ResXGenerator_StaticClass>true</ResXGenerator_StaticClass>
		<ResXGenerator_StaticMembers>true</ResXGenerator_StaticMembers>
	</PropertyGroup>
</Project>
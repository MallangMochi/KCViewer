<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conditions="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager.ViewModels.Conditions"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:models="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager.Models"
	xmlns:questTasks="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager.ViewModels.Tasks"
	xmlns:system="clr-namespace:System;assembly=System.Runtime"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:views="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager.Views"
	>
	<!--
		Fork: the editing rows of the quest tracker manager in KanColleViewer's style (mockup 20261006-quest-tracker-v2,
		approved 2026-10-06 "구현"), for the viewer's view models and template selectors. Every row: ✕ (removes it), the
		labelled controls, the viewer's summary in grey on the right. 「조건」 (tasks) and 「함선 조건」 (conditions;
		a group holds rows and other groups).
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  the ✕ before a row and in a chip: removes it  -->
	<Style x:Key="KcvQt.Remove" TargetType="Button">
		<Setter Property="Content" Value="✕" />
		<Setter Property="Width" Value="20" />
		<Setter Property="Height" Value="20" />
		<Setter Property="Margin" Value="0 0 6 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Back" Background="Transparent">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.ButtonHover}" />
							<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="KcvQt.ChipRemove"
		BasedOn="{StaticResource KcvQt.Remove}"
		TargetType="Button"
		>
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Margin" Value="3 0 0 0" />
		<Setter Property="FontSize" Value="9" />
	</Style>

	<!--  a smaller button: 「＋ 추가」, the node IDs' ＋, the pickers  -->
	<Style
		x:Key="KcvQt.Button"
		BasedOn="{StaticResource KcvRec.Button}"
		TargetType="Button"
		>
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Padding" Value="9 1" />
		<Setter Property="Margin" Value="0 1 6 1" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<!--  a chosen ship type / nationality / node ID: its name (or number box) and ✕  -->
	<Style x:Key="KcvQt.Chip" TargetType="Border">
		<Setter Property="Height" Value="22" />
		<Setter Property="Margin" Value="0 1 6 1" />
		<Setter Property="Padding" Value="6 0 3 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
		<Setter Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
		<Setter Property="TextElement.FontSize" Value="12" />
	</Style>

	<!--  the viewer's summary of a row 「0/1 1-1보스전투1」  -->
	<Style x:Key="KcvQt.Summary" TargetType="TextBlock">
		<Setter Property="Margin" Value="10 4 0 0" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
	</Style>

	<!--
		A row: the line above it, then in a DockPanel ✕ (removes the task or condition), the viewer's summary on the right
		and the labelled controls. The controls are put in the row directly, as the viewer's rows have them: in a
		ContentControl with a template around them they did not reach UI automation (screen readers, the test tool).
	-->
	<Style x:Key="KcvQt.RowLine" TargetType="Border">
		<Setter Property="Padding" Value="0 3" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
		<Setter Property="BorderThickness" Value="0 1 0 0" />
	</Style>
	<Style
		x:Key="KcvQt.RemoveTask"
		BasedOn="{StaticResource KcvQt.Remove}"
		TargetType="Button"
		>
		<Setter Property="Margin" Value="0 2 6 0" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="DockPanel.Dock" Value="Left" />
		<Setter Property="Command" Value="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}" />
		<Setter Property="CommandParameter" Value="{Binding Model}" />
	</Style>
	<Style
		x:Key="KcvQt.RemoveCondition"
		BasedOn="{StaticResource KcvQt.RemoveTask}"
		TargetType="Button"
		>
		<Setter Property="Command" Value="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}" />
	</Style>
	<Style
		x:Key="KcvQt.TaskSummary"
		BasedOn="{StaticResource KcvQt.Summary}"
		TargetType="TextBlock"
		>
		<Setter Property="DockPanel.Dock" Value="Right" />
		<Setter Property="Text" Value="{Binding Display}" />
	</Style>
	<Style
		x:Key="KcvQt.ConditionSummary"
		BasedOn="{StaticResource KcvQt.TaskSummary}"
		TargetType="TextBlock"
		>
		<Setter Property="MaxWidth" Value="260" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<Style
		x:Key="KcvQt.Line"
		BasedOn="{StaticResource KcvRec.ConditionRow}"
		TargetType="WrapPanel"
		>
		<Setter Property="Margin" Value="0" />
	</Style>

	<DataTemplate x:Key="KcvQt.EnumItem">
		<TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
	</DataTemplate>
	<DataTemplate x:Key="KcvQt.MapItem" DataType="{x:Type models:MapInfoModel}">
		<TextBlock Text="{Binding Display}" />
	</DataTemplate>
	<DataTemplate x:Key="KcvQt.ExpeditionItem" DataType="{x:Type models:ExpeditionModel}">
		<TextBlock Text="{Binding Display}" />
	</DataTemplate>
	<DataTemplate x:Key="KcvQt.ShipClassItem">
		<TextBlock Text="{Binding Converter={StaticResource ShipClassDisplayConverter}}" />
	</DataTemplate>

	<!--  a chosen ship type or nationality; its ✕ calls the condition's RemoveTypeCommand  -->
	<DataTemplate x:Key="KcvQt.EnumChip">
		<Border Style="{StaticResource KcvQt.Chip}">
			<StackPanel Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
				<Button
					Command="{Binding DataContext.RemoveTypeCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"
					CommandParameter="{Binding}"
					Style="{StaticResource KcvQt.ChipRemove}"
					/>
			</StackPanel>
		</Border>
	</DataTemplate>

	<!--  진행 and 목표 of a task (every task's model has Progress and Count)  -->
	<DataTemplate x:Key="KcvQt.ProgressGoal">
		<StackPanel Orientation="Horizontal">
			<StackPanel Style="{StaticResource KcvRec.Pair}">
				<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerProgress}" />
				<kcv:KcvNumberBox
					Width="56"
					Maximum="{Binding Model.Count}"
					Minimum="0"
					Value="{Binding Model.Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					/>
			</StackPanel>
			<StackPanel Style="{StaticResource KcvRec.Pair}">
				<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerGoal}" />
				<kcv:KcvNumberBox
					Width="56"
					Minimum="1"
					Value="{Binding Model.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					/>
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  칸 번호 (＋ and a number box per node with ✕) and 이름 (the name the summary shows instead of the numbers)  -->
	<DataTemplate x:Key="KcvQt.Nodes">
		<WrapPanel Style="{StaticResource KcvQt.Line}">
			<StackPanel Style="{StaticResource KcvRec.Pair}">
				<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerNodeIds}" />
				<Button
					Command="{Binding AddNodeIdCommand}"
					Content="＋"
					Style="{StaticResource KcvQt.Button}"
					/>
				<ItemsControl ItemsPanel="{StaticResource KcvRec.Horizontal}" ItemsSource="{Binding NodeIds}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type questTasks:NodeIdViewModel}">
							<Border Padding="0 0 3 0" Style="{StaticResource KcvQt.Chip}">
								<StackPanel Orientation="Horizontal">
									<kcv:KcvNumberBox
										Width="48"
										Height="20"
										Margin="-6 0 0 0"
										Minimum="0"
										Value="{Binding Id}"
										/>
									<Button
										Command="{Binding DataContext.RemoveNodeIdCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"
										CommandParameter="{Binding}"
										Style="{StaticResource KcvQt.ChipRemove}"
										/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
			<StackPanel Style="{StaticResource KcvRec.Pair}">
				<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerNodeName}" />
				<TextBox
					Width="80"
					Style="{StaticResource KcvRec.TextBox}"
					Text="{Binding Model.Name, UpdateSourceTrigger=PropertyChanged}"
					/>
			</StackPanel>
		</WrapPanel>
	</DataTemplate>

	<!--  ===== 조건 (tasks) =====  -->

	<DataTemplate x:Key="KcvQt.BossKill" DataType="{x:Type questTasks:BossKillTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerMap}" />
						<ComboBox
							ItemTemplate="{StaticResource KcvQt.MapItem}"
							ItemsSource="{Binding AllMaps}"
							SelectedItem="{Binding Model.Map, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerRank}" />
						<ComboBox
							MinWidth="56"
							ItemTemplate="{StaticResource KcvQt.EnumItem}"
							ItemsSource="{Binding Ranks}"
							SelectedItem="{Binding Model.Rank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.Expedition" DataType="{x:Type questTasks:ExpeditionTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerExpedition}" />
						<ComboBox
							ItemTemplate="{StaticResource KcvQt.ExpeditionItem}"
							ItemsSource="{Binding Expeditions}"
							SelectedItem="{Binding Model.Expedition}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  전투 노드 ID and the presets 7-2-1 … 7-5-3 (the same task with its nodes filled in)  -->
	<DataTemplate x:Key="KcvQt.BattleNodeId" DataType="{x:Type questTasks:BattleNodeIdTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<StackPanel>
					<WrapPanel Style="{StaticResource KcvQt.Line}">
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerMap}" />
							<ComboBox
								ItemTemplate="{StaticResource KcvQt.MapItem}"
								ItemsSource="{Binding AllMaps}"
								SelectedItem="{Binding Model.Map, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								Style="{StaticResource KcvRec.Combo}"
								/>
						</StackPanel>
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerRank}" />
							<ComboBox
								MinWidth="56"
								ItemTemplate="{StaticResource KcvQt.EnumItem}"
								ItemsSource="{Binding Ranks}"
								SelectedItem="{Binding Model.Rank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								Style="{StaticResource KcvRec.Combo}"
								/>
						</StackPanel>
						<ContentControl
							Content="{Binding}"
							ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
							Focusable="False"
							/>
					</WrapPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.Nodes}"
						Focusable="False"
						/>
				</StackPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.EquipmentScrap" DataType="{x:Type questTasks:EquipmentScrapTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerEquipment}" />
						<Button
							Command="{Binding OpenEquipmentPickerCommand}"
							Style="{StaticResource KcvQt.Button}"
							ToolTip="{Binding SelectedEquipment.NameEN}"
							>
							<TextBlock
								MaxWidth="180"
								Text="{Binding SelectedEquipment.NameEN}"
								TextTrimming="CharacterEllipsis"
								/>
						</Button>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.EquipmentCategoryScrap" DataType="{x:Type questTasks:EquipmentCategoryScrapTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerCategory}" />
						<ComboBox
							MinWidth="110"
							ItemTemplate="{StaticResource KcvQt.EnumItem}"
							ItemsSource="{Binding Categories}"
							SelectedItem="{Binding Model.Category}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.EquipmentCardTypeScrap" DataType="{x:Type questTasks:EquipmentCardTypeScrapTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerCardType}" />
						<ComboBox
							MinWidth="80"
							ItemTemplate="{StaticResource KcvQt.EnumItem}"
							ItemsSource="{Binding CardTypes}"
							SelectedItem="{Binding Model.CardType}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.EquipmentIconTypeScrap" DataType="{x:Type questTasks:EquipmentIconTypeScrapTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerIconType}" />
						<ComboBox
							MinWidth="110"
							ItemTemplate="{StaticResource KcvQt.EnumItem}"
							ItemsSource="{Binding IconTypes}"
							SelectedItem="{Binding Model.IconType}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  노드 도달 and the preset 1-6N  -->
	<DataTemplate x:Key="KcvQt.NodeReach" DataType="{x:Type questTasks:NodeReachTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerMap}" />
						<ComboBox
							ItemTemplate="{StaticResource KcvQt.MapItem}"
							ItemsSource="{Binding AllMaps}"
							SelectedItem="{Binding Model.Map, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.Nodes}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.MapFirstClear" DataType="{x:Type questTasks:MapFirstClearTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerMap}" />
						<ComboBox
							ItemTemplate="{StaticResource KcvQt.MapItem}"
							ItemsSource="{Binding AllMaps}"
							SelectedItem="{Binding Model.Map, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.Exercise" DataType="{x:Type questTasks:ExerciseTaskViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveTask}" />
				<TextBlock Style="{StaticResource KcvQt.TaskSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerRank}" />
						<ComboBox
							MinWidth="56"
							ItemTemplate="{StaticResource KcvQt.EnumItem}"
							ItemsSource="{Binding Ranks}"
							SelectedItem="{Binding Model.Rank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ProgressGoal}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.UnknownTask">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<TextBlock Style="{StaticResource KcvRec.Sub}" Text="{x:Static translations:QuestTrackerManagerResources.UnknownTask}" />
		</Border>
	</DataTemplate>

	<views:TaskTemplateSelector
		x:Key="KcvQt.TaskSelector"
		BattleNodeId="{StaticResource KcvQt.BattleNodeId}"
		BossKill="{StaticResource KcvQt.BossKill}"
		EquipmentCardTypeScrap="{StaticResource KcvQt.EquipmentCardTypeScrap}"
		EquipmentCategoryScrap="{StaticResource KcvQt.EquipmentCategoryScrap}"
		EquipmentIconTypeScrap="{StaticResource KcvQt.EquipmentIconTypeScrap}"
		EquipmentScrap="{StaticResource KcvQt.EquipmentScrap}"
		Exercise="{StaticResource KcvQt.Exercise}"
		Expedition="{StaticResource KcvQt.Expedition}"
		MapFirstClear="{StaticResource KcvQt.MapFirstClear}"
		NodeReach="{StaticResource KcvQt.NodeReach}"
		Unknown="{StaticResource KcvQt.UnknownTask}"
		/>

	<!--  ===== 함선 조건 (conditions) =====  -->

	<!--  기함일 것  -->
	<DataTemplate x:Key="KcvQt.Flagship">
		<CheckBox
			Margin="0 1 14 1"
			Content="{x:Static translations:QuestTrackerManagerResources.MustBeFlagship}"
			IsChecked="{Binding MustBeFlagship}"
			Style="{StaticResource KcvRec.Check}"
			/>
	</DataTemplate>

	<!--  함선 (the ship picker, 「*」 for any ship) and 개조  -->
	<DataTemplate x:Key="KcvQt.ShipAndRemodel">
		<StackPanel Orientation="Horizontal">
			<StackPanel Style="{StaticResource KcvRec.Pair}">
				<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerShip}" />
				<Button
					Command="{Binding OpenShipPickerCommand}"
					Content="{Binding Ship.NameEN, FallbackValue=*}"
					Style="{StaticResource KcvQt.Button}"
					/>
			</StackPanel>
			<StackPanel Style="{StaticResource KcvRec.Pair}">
				<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerRemodel}" />
				<ComboBox
					MinWidth="100"
					ItemTemplate="{StaticResource KcvQt.EnumItem}"
					ItemsSource="{Binding RemodelComparisonTypes}"
					SelectedItem="{Binding RemodelComparisonType}"
					Style="{StaticResource KcvRec.Combo}"
					/>
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!--  함종 of a ship type condition: the chosen types as chips, the type combo, 「＋ 추가」  -->
	<DataTemplate x:Key="KcvQt.ShipTypes">
		<StackPanel Style="{StaticResource KcvRec.Pair}">
			<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerShipTypes}" />
			<ItemsControl
				ItemTemplate="{StaticResource KcvQt.EnumChip}"
				ItemsPanel="{StaticResource KcvRec.Horizontal}"
				ItemsSource="{Binding Model.Types}"
				/>
			<ComboBox
				MinWidth="110"
				Margin="0 1 6 1"
				ItemTemplate="{StaticResource KcvQt.EnumItem}"
				ItemsSource="{Binding AllTypes}"
				SelectedItem="{Binding SelectedType}"
				Style="{StaticResource KcvRec.Combo}"
				/>
			<Button
				Command="{Binding AddTypeCommand}"
				Content="{x:Static fork:ForkStrings.KcvTrackerAddRow}"
				Style="{StaticResource KcvQt.Button}"
				/>
		</StackPanel>
	</DataTemplate>

	<!--  a group: 그리고 / 또는 and its summary, the condition type combo with 「＋ 추가」, its rows (and groups)  -->
	<DataTemplate x:Key="KcvQt.Group" DataType="{x:Type conditions:GroupConditionViewModel}">
		<Border
			x:Name="Frame"
			Margin="0 3"
			Padding="6 3 6 4"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="1"
			>
			<StackPanel>
				<DockPanel>
					<!--  the top group is in a ContentControl, not an ItemsControl, and has no ✕ (as the viewer's)  -->
					<Button
						Margin="0 1 6 0"
						VerticalAlignment="Top"
						Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"
						CommandParameter="{Binding Model}"
						DockPanel.Dock="Left"
						Style="{StaticResource KcvQt.Remove}"
						Visibility="{Binding RemoveButtonVisibility}"
						/>
					<ComboBox
						MinWidth="76"
						Margin="0 1 6 1"
						VerticalAlignment="Top"
						DockPanel.Dock="Left"
						ItemTemplate="{StaticResource KcvQt.EnumItem}"
						ItemsSource="{Binding Operators}"
						SelectedItem="{Binding GroupOperator}"
						Style="{StaticResource KcvRec.Combo}"
						/>
					<TextBlock
						Margin="4 4 0 0"
						Style="{StaticResource KcvQt.Summary}"
						Text="{Binding Display}"
						TextWrapping="Wrap"
						/>
				</DockPanel>
				<WrapPanel Margin="0 2 0 3" Style="{StaticResource KcvQt.Line}">
					<ComboBox
						MinWidth="100"
						Margin="0 1 6 1"
						ItemTemplate="{StaticResource KcvQt.EnumItem}"
						ItemsSource="{Binding ConditionTypes}"
						SelectedItem="{Binding SelectedConditionType}"
						Style="{StaticResource KcvRec.Combo}"
						/>
					<Button
						Command="{Binding AddConditionCommand}"
						Content="{x:Static fork:ForkStrings.KcvTrackerAddRow}"
						Style="{StaticResource KcvQt.Button}"
						/>
				</WrapPanel>
				<ItemsControl ItemTemplateSelector="{DynamicResource KcvQt.ConditionSelector}" ItemsSource="{Binding Conditions}" />
			</StackPanel>
		</Border>
		<DataTemplate.Triggers>
			<!--  the top group is the box 「함선 조건」 itself  -->
			<DataTrigger Binding="{Binding CanBeRemoved}" Value="False">
				<Setter TargetName="Frame" Property="BorderThickness" Value="0" />
				<Setter TargetName="Frame" Property="Padding" Value="0" />
				<Setter TargetName="Frame" Property="Margin" Value="0" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<!--  함 (old trackers' version, without the ship class)  -->
	<DataTemplate x:Key="KcvQt.Ship" DataType="{x:Type conditions:ShipConditionViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ShipAndRemodel}"
						Focusable="False"
						/>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.Flagship}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  함: 함급 (or 「*」), 함선, 개조, 기함일 것  -->
	<DataTemplate x:Key="KcvQt.ShipV2" DataType="{x:Type conditions:ShipConditionViewModelV2}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerShipClass}" />
						<ComboBox
							ItemTemplate="{StaticResource KcvQt.ShipClassItem}"
							ItemsSource="{Binding ShipClasses}"
							SelectedItem="{Binding ShipClass}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ShipAndRemodel}"
						Focusable="False"
						/>
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.Flagship}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  함 종류: 함종 / 수, the comparison, 기함일 것, Lv  -->
	<DataTemplate x:Key="KcvQt.ShipType" DataType="{x:Type conditions:ShipTypeConditionViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<StackPanel>
					<WrapPanel Style="{StaticResource KcvQt.Line}">
						<ContentControl
							Content="{Binding}"
							ContentTemplate="{StaticResource KcvQt.ShipTypes}"
							Focusable="False"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource KcvQt.Line}">
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerShipCount}" />
							<kcv:KcvNumberBox
								Width="56"
								Maximum="12"
								Minimum="0"
								Value="{Binding Model.Count}"
								/>
							<ComboBox
								MinWidth="56"
								Margin="6 1 0 1"
								ItemTemplate="{StaticResource KcvQt.EnumItem}"
								ItemsSource="{Binding ComparisonTypes}"
								SelectedItem="{Binding ComparisonType}"
								Style="{StaticResource KcvRec.Combo}"
								/>
						</StackPanel>
						<ContentControl
							Content="{Binding}"
							ContentTemplate="{StaticResource KcvQt.Flagship}"
							Focusable="False"
							/>
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="Lv" />
							<kcv:KcvNumberBox
								Width="56"
								Minimum="0"
								Value="{Binding Model.Level}"
								/>
						</StackPanel>
					</WrapPanel>
				</StackPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  함 (일부): 수 and 「＋ 추가」, then its 「함」 rows (old trackers' version)  -->
	<DataTemplate x:Key="KcvQt.PartialShip" DataType="{x:Type conditions:PartialShipConditionViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<StackPanel>
					<WrapPanel Style="{StaticResource KcvQt.Line}">
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerShipCount}" />
							<kcv:KcvNumberBox
								Width="56"
								Minimum="0"
								Value="{Binding Model.Count}"
								/>
						</StackPanel>
						<Button
							Command="{Binding AddConditionCommand}"
							Content="{x:Static fork:ForkStrings.KcvTrackerAddRow}"
							Style="{StaticResource KcvQt.Button}"
							/>
					</WrapPanel>
					<ItemsControl
						Margin="0 3 0 0"
						ItemTemplate="{StaticResource KcvQt.Ship}"
						ItemsSource="{Binding Conditions}"
						/>
				</StackPanel>
			</DockPanel>
		</Border>
	</DataTemplate>
	<DataTemplate x:Key="KcvQt.PartialShipV2" DataType="{x:Type conditions:PartialShipConditionViewModelV2}">

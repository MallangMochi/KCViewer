	<!--  허가 함종: 함종 only  -->
	<DataTemplate x:Key="KcvQt.AllowedShipTypes" DataType="{x:Type conditions:AllowedShipTypesConditionViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ShipTypes}"
						Focusable="False"
						/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  함 위치: 함선, 개조, 위치 1–6  -->
	<DataTemplate x:Key="KcvQt.ShipPosition" DataType="{x:Type conditions:ShipPositionConditionViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<WrapPanel Style="{StaticResource KcvQt.Line}">
					<ContentControl
						Content="{Binding}"
						ContentTemplate="{StaticResource KcvQt.ShipAndRemodel}"
						Focusable="False"
						/>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static translations:QuestTrackerManagerResources.Position}" />
						<ComboBox
							MinWidth="48"
							SelectedValue="{Binding Position}"
							Style="{StaticResource KcvRec.Combo}"
							>
							<system:Int32>1</system:Int32>
							<system:Int32>2</system:Int32>
							<system:Int32>3</system:Int32>
							<system:Int32>4</system:Int32>
							<system:Int32>5</system:Int32>
							<system:Int32>6</system:Int32>
						</ComboBox>
					</StackPanel>
				</WrapPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<!--  함 국적: 국적 / 수, the comparison, 기함일 것  -->
	<DataTemplate x:Key="KcvQt.ShipNationality" DataType="{x:Type conditions:ShipNationalityConditionViewModel}">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<DockPanel>
				<Button Style="{StaticResource KcvQt.RemoveCondition}" />
				<TextBlock Style="{StaticResource KcvQt.ConditionSummary}" />
				<StackPanel>
					<WrapPanel Style="{StaticResource KcvQt.Line}">
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerNationality}" />
							<ItemsControl
								ItemTemplate="{StaticResource KcvQt.EnumChip}"
								ItemsPanel="{StaticResource KcvRec.Horizontal}"
								ItemsSource="{Binding Model.Nationalities}"
								/>
							<ComboBox
								MinWidth="80"
								Margin="0 1 6 1"
								ItemTemplate="{StaticResource KcvQt.EnumItem}"
								ItemsSource="{Binding AllNationalities}"
								SelectedItem="{Binding SelectedNationality}"
								Style="{StaticResource KcvRec.Combo}"
								/>
							<Button
								Command="{Binding AddTypeCommand}"
								Content="{x:Static fork:ForkStrings.KcvTrackerAddRow}"
								Style="{StaticResource KcvQt.Button}"
								/>
						</StackPanel>
					</WrapPanel>
					<WrapPanel Style="{StaticResource KcvQt.Line}">
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static fork:ForkStrings.KcvTrackerShipCount}" />
							<kcv:KcvNumberBox
								Width="56"
								Maximum="12"
								Minimum="1"
								Value="{Binding Model.Count}"
								/>
							<ComboBox
								MinWidth="56"
								Margin="6 1 0 1"
								ItemTemplate="{StaticResource KcvQt.EnumItem}"
								ItemsSource="{Binding ComparisonTypes}"
								SelectedItem="{Binding ComparisonType}"
								Style="{StaticResource KcvRec.Combo}"
								/>
						</StackPanel>
						<ContentControl
							Content="{Binding}"
							ContentTemplate="{StaticResource KcvQt.Flagship}"
							Focusable="False"
							/>
					</WrapPanel>
				</StackPanel>
			</DockPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="KcvQt.UnknownCondition">
		<Border Style="{StaticResource KcvQt.RowLine}">
			<TextBlock Style="{StaticResource KcvRec.Sub}" Text="{x:Static translations:QuestTrackerManagerResources.UnknownCondition}" />
		</Border>
	</DataTemplate>

	<views:ConditionTemplateSelector
		x:Key="KcvQt.ConditionSelector"
		AllowedShipTypes="{StaticResource KcvQt.AllowedShipTypes}"
		Group="{StaticResource KcvQt.Group}"
		PartialShip="{StaticResource KcvQt.PartialShip}"
		PartialShipV2="{StaticResource KcvQt.PartialShipV2}"
		Ship="{StaticResource KcvQt.Ship}"
		ShipNationality="{StaticResource KcvQt.ShipNationality}"
		ShipPosition="{StaticResource KcvQt.ShipPosition}"
		ShipType="{StaticResource KcvQt.ShipType}"
		ShipV2="{StaticResource KcvQt.ShipV2}"
		Unknown="{StaticResource KcvQt.UnknownCondition}"
		/>

</ResourceDictionary>

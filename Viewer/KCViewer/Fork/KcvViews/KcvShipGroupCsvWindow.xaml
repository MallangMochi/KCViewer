<Window
	x:Class="KCViewer.Fork.KcvViews.KcvShipGroupCsvWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static translations:ShipGroupCSVOutputResources.Title}"
	Width="380"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	>
	<!--
		Fork: the ship group's CSV output in KanColleViewer's style (mockup viewer-design/mockups/20261019-group-csv-v2.html,
		approved 2026-10-19 "구현"): the viewer's 옵션 (열람 용, 데이터 용) and 출력처 with 「...」, OK while a path is
		there (Enter), 취소 (Esc).
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<kcv:KcvHasTextConverter x:Key="HasText" />
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button
					MinWidth="72"
					Click="OkButton_Click"
					Content="OK"
					IsDefault="True"
					IsEnabled="{Binding Text, ElementName=PathBox, Converter={StaticResource HasText}}"
					Style="{StaticResource KcvRec.PrimaryButton}"
					/>
				<Button
					MinWidth="72"
					Content="{x:Static translations:GeneralRes.Cancel}"
					IsCancel="True"
					Style="{StaticResource KcvRec.Button}"
					/>
			</StackPanel>
		</Border>

		<StackPanel Margin="12 6 12 4">
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static translations:GeneralRes.Option}">
				<WrapPanel Style="{StaticResource Cfg.Row}">
					<RadioButton
						x:Name="UserFormat"
						Content="{x:Static translations:ShipGroupCSVOutputResources.RadioFormat_User}"
						IsChecked="True"
						/>
					<RadioButton Content="{x:Static translations:ShipGroupCSVOutputResources.RadioFormat_Data}" />
				</WrapPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static translations:ShipGroupCSVOutputResources.OutputDestination}">
				<DockPanel Margin="0 2">
					<Button
						Click="BrowseButton_Click"
						DockPanel.Dock="Right"
						Style="{StaticResource Cfg.Browse}"
						/>
					<TextBox x:Name="PathBox" Style="{StaticResource Cfg.Field}" />
				</DockPanel>
			</ContentControl>
		</StackPanel>
	</DockPanel>
</Window>

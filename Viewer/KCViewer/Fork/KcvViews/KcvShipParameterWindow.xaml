<Window
	x:Class="KCViewer.Fork.KcvViews.KcvShipParameterWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static translations:EncycloRes.EditShipParameter}"
	Width="860"
	d:DataContext="{d:DesignInstance kcv:KcvShipParameterViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	ShowInTaskbar="False"
	SizeToContent="Height"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d"
	>
	<!--
		Fork: the ship album's 수치 편집 in KanColleViewer's style (KcvShipAlbumTools, mockup
		viewer-design/mockups/20261017-album-ship-tools-v2.html, approved 2026-10-18 "구현"): the banner, type, name and ID
		at the top (not edited, as the viewer's), then the record in fields: 능력치 (initial, the initial's upper bound for
		ASW, evasion and LoS, max) with 사거리, 장비 (the ID with the equipment's name, 탑재), 대사 · 설명 and 자원. A field
		that is not a number turns red and OK waits for it; 취소 and closing change nothing.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style
				x:Key="Num"
				BasedOn="{StaticResource Cfg.Num}"
				TargetType="kcv:KcvNumberBox"
				>
				<Setter Property="Width" Value="62" />
				<Setter Property="KeepsInvalidText" Value="True" />
			</Style>
			<Style
				x:Key="Name"
				BasedOn="{StaticResource Cfg.Lbl}"
				TargetType="TextBlock"
				>
				<Setter Property="Width" Value="60" />
			</Style>
			<Style
				x:Key="Name96"
				BasedOn="{StaticResource Cfg.Lbl}"
				TargetType="TextBlock"
				>
				<Setter Property="Width" Value="96" />
			</Style>
			<Style x:Key="Head" TargetType="TextBlock">
				<Setter Property="Width" Value="66" />
				<Setter Property="FontSize" Value="11" />
				<Setter Property="Margin" Value="0 2" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
			</Style>

			<!--  a message: lines from the top, a scroll bar when they do not fit  -->
			<Style
				x:Key="Message"
				BasedOn="{StaticResource KcvRec.TextBox}"
				TargetType="TextBox"
				>
				<Setter Property="AcceptsReturn" Value="True" />
				<Setter Property="TextWrapping" Value="Wrap" />
				<Setter Property="FontSize" Value="12.5" />
				<Setter Property="VerticalAlignment" Value="Top" />
				<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="TextBox">
							<Border
								x:Name="Box"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1"
								>
								<ScrollViewer x:Name="PART_ContentHost" Margin="5 3" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<DockPanel>
				<StackPanel
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					Orientation="Horizontal"
					>
					<Button
						x:Name="OkButton"
						MinWidth="72"
						Click="Save"
						Content="OK"
						IsDefault="True"
						Style="{StaticResource KcvRec.PrimaryButton}"
						/>
					<Button
						MinWidth="72"
						Content="{x:Static translations:GeneralRes.Cancel}"
						IsCancel="True"
						Style="{StaticResource KcvRec.Button}"
						/>
				</StackPanel>
				<TextBlock
					Margin="0"
					FontSize="11"
					Style="{StaticResource Cfg.Note}"
					Text="{x:Static translations:EncycloRes.EditShipParameterHint}"
					/>
			</DockPanel>
		</Border>

		<StackPanel Margin="12 6 12 4">
			<StackPanel Margin="0 2 0 10" Orientation="Horizontal">
				<Image
					Width="240"
					Height="60"
					Source="{Binding Ship, Converter={StaticResource ShipToBannerImageConverter}, IsAsync=True}"
					/>
				<StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
					<TextBlock
						FontSize="12"
						Foreground="{DynamicResource Kcv.SubForeground}"
						Text="{Binding ShipTypeName}"
						/>
					<TextBlock>
						<Run FontSize="17" Text="{Binding ShipName, Mode=OneWay}" />
						<Run
							FontSize="12"
							Foreground="{DynamicResource Kcv.SubForeground}"
							Text="{Binding IdText, Mode=OneWay}"
							/>
					</TextBlock>
				</StackPanel>
			</StackPanel>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="12" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvAlbumStats}">
						<StackPanel>
							<!--  over the boxes: the name's width and its margin  -->
							<StackPanel Orientation="Horizontal">
								<TextBlock Width="68" />
								<TextBlock Style="{StaticResource Head}" Text="{x:Static fork:ForkStrings.KcvAlbumInitial}" />
								<TextBlock Style="{StaticResource Head}" Text="{x:Static fork:ForkStrings.ShipParamInitialMax}" />
								<TextBlock Style="{StaticResource Head}" Text="{x:Static fork:ForkStrings.KcvAlbumMaximum}" />
							</StackPanel>
							<ItemsControl Focusable="False" ItemsSource="{Binding Stats}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type kcv:KcvShipParameterStat}">
										<StackPanel Orientation="Horizontal">
											<TextBlock Style="{StaticResource Name}" Text="{Binding Name}" />
											<kcv:KcvNumberBox
												Minimum="0"
												Style="{StaticResource Num}"
												Value="{Binding Initial}"
												/>
											<Grid Width="66">
												<kcv:KcvNumberBox
													HorizontalAlignment="Left"
													Minimum="0"
													Style="{StaticResource Num}"
													Value="{Binding InitialMax}"
													Visibility="{Binding HasRange, Converter={StaticResource BooleanToVisibilityConverter}}"
													/>
												<TextBlock
													Width="62"
													HorizontalAlignment="Left"
													VerticalAlignment="Center"
													Foreground="{DynamicResource Kcv.FaintForeground}"
													Text="–"
													TextAlignment="Center"
													Visibility="{Binding HasRange, Converter={StaticResource Cfg.Collapsed}}"
													/>
											</Grid>
											<kcv:KcvNumberBox
												Minimum="0"
												Style="{StaticResource Num}"
												Value="{Binding Maximum}"
												/>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<WrapPanel Margin="0 6 0 2" Style="{StaticResource Cfg.Row}">
								<TextBlock Style="{StaticResource Name}" Text="{x:Static fork:ForkStrings.KcvAlbumRange}" />
								<ComboBox
									MinWidth="90"
									DisplayMemberPath="Name"
									ItemsSource="{Binding Ranges}"
									SelectedItem="{Binding Range}"
									Style="{StaticResource Cfg.Combo}"
									/>
							</WrapPanel>
							<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.ShipParamStatsNote}" />
						</StackPanel>
					</ContentControl>

					<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvAlbumSlots}">
						<StackPanel>
							<ItemsControl Focusable="False" ItemsSource="{Binding Slots}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type kcv:KcvShipParameterSlot}">
										<StackPanel Orientation="Horizontal">
											<TextBlock
												Width="14"
												Style="{StaticResource Cfg.Lbl}"
												Text="{Binding Number}"
												/>
											<kcv:KcvNumberBox
												Width="70"
												Minimum="-1"
												Style="{StaticResource Num}"
												Value="{Binding Equipment}"
												/>
											<TextBlock
												x:Name="EquipmentName"
												Width="170"
												Margin="2 0 6 0"
												VerticalAlignment="Center"
												FontSize="13"
												Text="{Binding EquipmentName}"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding EquipmentName}"
												/>
											<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{x:Static fork:ForkStrings.KcvAlbumAircraft}" />
											<kcv:KcvNumberBox
												Width="56"
												Minimum="0"
												Style="{StaticResource Num}"
												Value="{Binding Aircraft}"
												/>
										</StackPanel>
										<DataTemplate.Triggers>
											<DataTrigger Binding="{Binding IsEmpty}" Value="True">
												<Setter TargetName="EquipmentName" Property="Foreground" Value="{DynamicResource Kcv.FaintForeground}" />
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.ShipParamSlotsNote}" />
						</StackPanel>
					</ContentControl>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.ShipParamMessages}">
						<StackPanel>
							<TextBlock
								Margin="0 2 0 3"
								Style="{StaticResource Cfg.Lbl}"
								Text="{x:Static fork:ForkStrings.ShipParamMessageGet}"
								/>
							<TextBox
								Height="48"
								Style="{StaticResource Message}"
								Text="{Binding MessageGet, UpdateSourceTrigger=PropertyChanged}"
								/>
							<TextBlock
								Margin="0 8 0 3"
								Style="{StaticResource Cfg.Lbl}"
								Text="{x:Static fork:ForkStrings.KcvAlbumDescription}"
								/>
							<TextBox
								Height="86"
								Style="{StaticResource Message}"
								Text="{Binding MessageAlbum, UpdateSourceTrigger=PropertyChanged}"
								/>
							<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.ShipParamMessagesNote}" />
						</StackPanel>
					</ContentControl>

					<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.ShipParamResources}">
						<StackPanel>
							<WrapPanel Style="{StaticResource Cfg.Row}">
								<TextBlock Style="{StaticResource Name96}" Text="{x:Static fork:ForkStrings.ShipParamResourceName}" />
								<TextBox
									Width="180"
									Style="{StaticResource Cfg.Field}"
									Text="{Binding ResourceName, UpdateSourceTrigger=PropertyChanged}"
									/>
							</WrapPanel>
							<WrapPanel Style="{StaticResource Cfg.Row}">
								<TextBlock Style="{StaticResource Name96}" Text="{x:Static fork:ForkStrings.ShipParamGraphicVersion}" />
								<kcv:KcvNumberBox
									Minimum="0"
									Style="{StaticResource Num}"
									Value="{Binding GraphicVersion}"
									/>
								<TextBlock Style="{StaticResource Cfg.Lbl2}" Text="{x:Static fork:ForkStrings.ShipParamVoiceVersion}" />
								<kcv:KcvNumberBox
									Minimum="0"
									Style="{StaticResource Num}"
									Value="{Binding VoiceVersion}"
									/>
							</WrapPanel>
							<WrapPanel Style="{StaticResource Cfg.Row}">
								<TextBlock Style="{StaticResource Name96}" Text="{x:Static fork:ForkStrings.ShipParamPortVoiceVersion}" />
								<kcv:KcvNumberBox
									Minimum="0"
									Style="{StaticResource Num}"
									Value="{Binding PortVoiceVersion}"
									/>
							</WrapPanel>
							<WrapPanel Style="{StaticResource Cfg.Row}">
								<TextBlock Style="{StaticResource Name96}" Text="{x:Static fork:ForkStrings.ShipParamCostume}" />
								<kcv:KcvNumberBox
									Minimum="-1"
									Style="{StaticResource Num}"
									Value="{Binding OriginalCostumeShipId}"
									/>
								<TextBlock
									Margin="2 0 0 0"
									FontSize="11"
									Style="{StaticResource Cfg.Note}"
									Text="{Binding CostumeNote}"
									/>
							</WrapPanel>
						</StackPanel>
					</ContentControl>
				</StackPanel>
			</Grid>
		</StackPanel>
	</DockPanel>
</Window>

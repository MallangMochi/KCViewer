<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:system="clr-namespace:System;assembly=System.Runtime"
	>
	<!--
		Fork: what the record windows in KanColleViewer's style share (Fork/KcvViews/KcvRecord*Window, mockups
		viewer-design/mockups/20261004-*-record-*.html, VIEWER-PLAN.md "기록 묶음"): the table of the ship list with the
		viewer's column menus, the folding 검색 조건 box, check boxes with the box after the label, the buttons, the
		status bar, ship chips and the coloured nodes, ranks and recipes. Each window merges this dictionary.
	-->

	<BooleanToVisibilityConverter x:Key="KcvRec.Visible" />
	<kcv:KcvRecordTimeConverter x:Key="KcvRec.Time" />
	<kcv:KcvRecordFleetConverter x:Key="KcvRec.FleetShips" />
	<kcv:KcvCountPartConverter x:Key="KcvRec.CountPart" />
	<kcv:KcvZeroCountConverter x:Key="KcvRec.ZeroCount" />
	<kcv:KcvIsZeroConverter x:Key="KcvRec.IsZero" />
	<kcv:KcvSignedConverter x:Key="KcvRec.Signed" />
	<kcv:KcvNumberConverter x:Key="KcvRec.Number" />
	<kcv:KcvRecipeConverter x:Key="KcvRec.RecipeParts" />
	<kcv:KcvLargeRecipeConverter x:Key="KcvRec.LargeRecipe" />
	<kcv:KcvShipTypeNameConverter x:Key="KcvRec.ShipType" />
	<kcv:KcvRankKindConverter x:Key="KcvRec.RankKind" />
	<kcv:KcvGameIconConverter x:Key="KcvRec.GameIcon" />

	<!--  resource colours, the same in both themes (the mockups and the resource chart's legend)  -->
	<SolidColorBrush x:Key="KcvRec.Fuel" Color="#4CAF50" />
	<SolidColorBrush x:Key="KcvRec.Ammo" Color="#C9A43A" />
	<SolidColorBrush x:Key="KcvRec.Steel" Color="#A0A0A8" />
	<SolidColorBrush x:Key="KcvRec.Bauxite" Color="#D9822B" />

	<Style x:Key="KcvRec.Text" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="6 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!--  grey text after a value: the ship type after a name, a rate after a count  -->
	<Style x:Key="KcvRec.Sub" TargetType="TextBlock">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
	</Style>

	<!--  a condition's label 「기간:」  -->
	<Style x:Key="KcvRec.Label" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="0 0 5 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
	</Style>
	<Style
		x:Key="KcvRec.FirstLabel"
		BasedOn="{StaticResource KcvRec.Label}"
		TargetType="TextBlock"
		>
		<Setter Property="Margin" Value="0 0 5 0" />
	</Style>

	<!--  a label and its control(s), kept together when a row wraps  -->
	<Style x:Key="KcvRec.Pair" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="Margin" Value="0 1 14 1" />
	</Style>

	<!--  a row of conditions  -->
	<Style x:Key="KcvRec.ConditionRow" TargetType="WrapPanel">
		<Setter Property="Margin" Value="0 2" />
		<Setter Property="Orientation" Value="Horizontal" />
	</Style>

	<!--
		The scroll bars of the record windows always show (the viewer hides them until the mouse comes near), so a
		narrow window shows that its table goes on to the right ("창 크기가 작으면 스크롤 보이도록 할 것", 2026-10-05)
	-->
	<system:Boolean x:Key="AutoHideScrollBars">False</system:Boolean>

	<!--  An item of the drop-down: the grey of a row under the mouse, the accent when chosen  -->
	<Style x:Key="KcvRec.ComboItem" TargetType="ComboBoxItem">
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="Padding" Value="8 3" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBoxItem">
					<Border
						x:Name="Back"
						Padding="{TemplateBinding Padding}"
						Background="Transparent"
						>
						<ContentPresenter />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.Accent}" />
							<Setter Property="Foreground" Value="White" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		A combo box as KanColleViewer's inputs: a dark box with a grey border (the accent under the mouse) and a dark
		drop-down. The viewer's own combo box dropped down white in the dark theme, so its items could not be read
		("다크모드인데 흰색배경이라 글자가 안보임", 2026-10-05).
	-->
	<Style x:Key="KcvRec.Combo" TargetType="ComboBox">
		<Setter Property="MinWidth" Value="64" />
		<Setter Property="Margin" Value="0 1" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="Background" Value="{DynamicResource Kcv.ButtonBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="MaxDropDownHeight" Value="360" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource KcvRec.ComboItem}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<!--  stretched: the viewer's (ModernWpf's) button style puts buttons on the left at their own size  -->
						<ToggleButton
							x:Name="Toggle"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							ClickMode="Press"
							Focusable="False"
							IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							>
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border
										x:Name="Box"
										Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
										BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
										BorderThickness="1"
										>
										<Path
											Width="8"
											Height="5"
											Margin="0 0 7 0"
											HorizontalAlignment="Right"
											VerticalAlignment="Center"
											Data="M 0,0 L 4,4 L 8,0"
											Stroke="{DynamicResource Kcv.SubForeground}"
											StrokeThickness="1.4"
											/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
										</Trigger>
										<Trigger Property="IsChecked" Value="True">
											<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>
						<ContentPresenter
							Margin="7 2 22 2"
							VerticalAlignment="Center"
							Content="{TemplateBinding SelectionBoxItem}"
							ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
							ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
							IsHitTestVisible="False"
							/>
						<Popup
							x:Name="PART_Popup"
							AllowsTransparency="True"
							Focusable="False"
							IsOpen="{TemplateBinding IsDropDownOpen}"
							Placement="Bottom"
							PopupAnimation="None"
							>
							<Border
								MinWidth="{Binding ActualWidth, ElementName=Toggle}"
								MaxHeight="{TemplateBinding MaxDropDownHeight}"
								Background="{DynamicResource Kcv.Background}"
								BorderBrush="{DynamicResource Kcv.Separator}"
								BorderThickness="1"
								>
								<ScrollViewer SnapsToDevicePixels="True">
									<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  A text box with the combo boxes' dark box; the Tag is the grey hint shown while it is empty  -->
	<Style x:Key="KcvRec.TextBox" TargetType="TextBox">
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="Background" Value="{DynamicResource Kcv.ButtonBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
		<Setter Property="CaretBrush" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource Kcv.Accent}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border
						x:Name="Box"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="1"
						>
						<Grid Margin="5 2">
							<TextBlock
								x:Name="Hint"
								Foreground="{DynamicResource Kcv.InactiveForeground}"
								IsHitTestVisible="False"
								Text="{TemplateBinding Tag}"
								Visibility="Collapsed"
								/>
							<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="">
							<Setter TargetName="Hint" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		The box of the search conditions: 「검색 조건」 on the left, 「접기 ▴」 on the right folds it (mockup v5, so it is
		clear the box is open and nothing is hidden).
	-->
	<Style x:Key="KcvRec.Conditions" TargetType="ContentControl">
		<Setter Property="Margin" Value="8 6 8 6" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ContentControl">
					<Border
						Padding="8 3 8 5"
						BorderBrush="{DynamicResource Kcv.HeaderBackground}"
						BorderThickness="1"
						>
						<DockPanel>
							<Grid DockPanel.Dock="Top">
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource Kcv.SubForeground}"
									Text="{x:Static fork:ForkStrings.KcvRecordConditions}"
									/>
								<ToggleButton
									x:Name="Fold"
									HorizontalAlignment="Right"
									Cursor="Hand"
									Focusable="False"
									IsChecked="True"
									>
									<ToggleButton.Template>
										<ControlTemplate TargetType="ToggleButton">
											<TextBlock
												x:Name="Label"
												Background="Transparent"
												FontSize="11"
												Foreground="{DynamicResource Kcv.InactiveForeground}"
												Text="{x:Static fork:ForkStrings.KcvRecordFold}"
												/>
											<ControlTemplate.Triggers>
												<Trigger Property="IsChecked" Value="False">
													<Setter TargetName="Label" Property="Text" Value="{x:Static fork:ForkStrings.KcvRecordUnfold}" />
												</Trigger>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</ToggleButton.Template>
								</ToggleButton>
							</Grid>
							<ContentPresenter x:Name="Body" Margin="0 3 0 0" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger SourceName="Fold" Property="IsChecked" Value="False">
							<Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		A box like the search conditions without the fold, its title from Tag: the calculators' 「계산 조건」 and
		「표시 조건」 (mockup 20261006-calc-windows-v2)
	-->
	<Style x:Key="KcvRec.Box" TargetType="ContentControl">
		<Setter Property="Margin" Value="8 6 8 6" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ContentControl">
					<Border
						Padding="8 3 8 5"
						BorderBrush="{DynamicResource Kcv.HeaderBackground}"
						BorderThickness="1"
						>
						<DockPanel>
							<TextBlock
								DockPanel.Dock="Top"
								FontSize="12"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
								/>
							<ContentPresenter Margin="0 3 0 0" />
						</DockPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		A check box with its box after the label ("체크박스는 항목명 뒤에 체크박스를 배치하도록 함", 2026-10-04): checked
		in the accent colour with a white mark, unchecked an empty box, the third state (보스, 대형함 건조: either) a dash.
	-->
	<Style x:Key="KcvRec.Check" TargetType="CheckBox">
		<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="0 0 14 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<StackPanel Background="Transparent" Orientation="Horizontal">
						<ContentPresenter
							x:Name="Text"
							Margin="0 0 5 0"
							VerticalAlignment="Center"
							RecognizesAccessKey="True"
							/>
						<Border
							x:Name="Box"
							Width="13"
							Height="13"
							VerticalAlignment="Center"
							Background="{DynamicResource Kcv.ButtonBackground}"
							BorderBrush="{DynamicResource Kcv.Separator}"
							BorderThickness="1"
							CornerRadius="2"
							>
							<Grid>
								<Path
									x:Name="Mark"
									Margin="1"
									Data="M 1.5,5.5 L 4.2,8.2 L 9,2.5"
									Stroke="White"
									StrokeThickness="1.6"
									Visibility="Collapsed"
									/>
								<Rectangle
									x:Name="Partial"
									Width="7"
									Height="1.6"
									Fill="{DynamicResource Kcv.AccentHighlight}"
									Visibility="Collapsed"
									/>
							</Grid>
						</Border>
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Mark" Property="Visibility" Value="Visible" />
							<Setter TargetName="Box" Property="Background" Value="{DynamicResource Kcv.Accent}" />
							<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="{x:Null}">
							<Setter TargetName="Partial" Property="Visibility" Value="Visible" />
							<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.AccentHighlight}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
							<Setter TargetName="Box" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  [검색] in the accent colour, [취소] (enabled while searching) and [초기화] as KanColleViewer's buttons  -->
	<Style x:Key="KcvRec.Button" TargetType="Button">
		<Setter Property="Foreground" Value="{DynamicResource Kcv.ButtonForeground}" />
		<Setter Property="Background" Value="{DynamicResource Kcv.ButtonBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.ButtonBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="14 2" />
		<Setter Property="Margin" Value="6 0 0 0" />
		<Setter Property="MinWidth" Value="56" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Back"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						>
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							RecognizesAccessKey="True"
							/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.ButtonHover}" />
							<Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.Accent}" />
							<Setter Property="Foreground" Value="White" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="KcvRec.PrimaryButton"
		BasedOn="{StaticResource KcvRec.Button}"
		TargetType="Button"
		>
		<Setter Property="Margin" Value="16 0 0 0" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Background" Value="{DynamicResource Kcv.Accent}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.AccentHighlight}" />
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Background" Value="{DynamicResource Kcv.ButtonBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Kcv.ButtonBorder}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  Grips to resize a column, as the viewer's header has them  -->
	<Style x:Key="KcvRec.Grip" TargetType="Thumb">
		<Setter Property="Width" Value="6" />
		<Setter Property="Cursor" Value="SizeWE" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Border Background="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		The ship list's header with the viewer's header menu (비표시, 열 표시 설정, 정렬 초기화). The table's Tag holds its
		DataGridViewModel; the menu reaches it through the header (the menu is outside the visual tree).
	-->
	<Style x:Key="KcvRec.Header" TargetType="DataGridColumnHeader">
		<Setter Property="Background" Value="{DynamicResource Kcv.TableHeaderBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Padding" Value="6 5" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="Tag" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
		<Setter Property="ContextMenu">
			<Setter.Value>
				<ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
					<MenuItem
						Command="{Binding HideColumnCommand}"
						CommandParameter="{Binding PlacementTarget.Content, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
						Header="{Binding DataGrid.HideColumn}"
						/>
					<Separator />
					<MenuItem Command="{Binding OpenColumnSelectorCommand}" Header="{Binding DataGrid.OpenColumnSelector}" />
					<MenuItem Command="{Binding ClearSortingCommand}" Header="{Binding DataGrid.ClearSorting}" />
				</ContextMenu>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridColumnHeader">
					<Grid>
						<Border
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{DynamicResource Kcv.HeaderBackground}"
							BorderThickness="0 0 1 1"
							>
							<DockPanel>
								<Path
									x:Name="Arrow"
									Width="8"
									Height="5"
									Margin="4 0 0 0"
									VerticalAlignment="Center"
									Data="M 0,0 L 4,5 L 8,0 Z"
									DockPanel.Dock="Right"
									Fill="{DynamicResource Kcv.SubForeground}"
									Visibility="Collapsed"
									/>
								<ContentPresenter VerticalAlignment="Center">
									<ContentPresenter.Resources>
										<Style TargetType="TextBlock">
											<Setter Property="TextTrimming" Value="CharacterEllipsis" />
										</Style>
									</ContentPresenter.Resources>
								</ContentPresenter>
							</DockPanel>
						</Border>
						<Thumb
							x:Name="PART_LeftHeaderGripper"
							HorizontalAlignment="Left"
							Style="{StaticResource KcvRec.Grip}"
							/>
						<Thumb
							x:Name="PART_RightHeaderGripper"
							HorizontalAlignment="Right"
							Style="{StaticResource KcvRec.Grip}"
							/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="SortDirection" Value="Descending">
							<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="SortDirection" Value="Ascending">
							<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
							<Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 4,0 L 8,5 Z" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="KcvRec.Cell" TargetType="DataGridCell">
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<!--  the background takes clicks on the empty part of a cell too  -->
					<Border Background="{TemplateBinding Background}">
						<ContentPresenter VerticalAlignment="Stretch" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  The colours (under the mouse, selected) are on the row template's border, as in the ship list  -->
	<Style x:Key="KcvRec.Row" TargetType="DataGridRow">
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridRow">
					<Border
						x:Name="Back"
						Background="Transparent"
						SnapsToDevicePixels="True"
						>
						<DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		The table: the viewer's (ModernWpf's) data grid with the ship list's look. In a table with a star column the
		columns with a pixel width also have it as their MinWidth: the data grid otherwise narrows them to fit a narrow
		window instead of scrolling ("창 크기가 작으면 스크롤 보이도록 할 것", 2026-10-05). A click puts a row into the
		selection or takes it out, without Ctrl (KcvRecordSelection.cs).
	-->
	<Style
		x:Key="KcvRec.Grid"
		BasedOn="{StaticResource {x:Type DataGrid}}"
		TargetType="DataGrid"
		>
		<Setter Property="AutoGenerateColumns" Value="False" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CanUserAddRows" Value="False" />
		<Setter Property="CanUserDeleteRows" Value="False" />
		<Setter Property="CanUserResizeRows" Value="False" />
		<Setter Property="CellStyle" Value="{StaticResource KcvRec.Cell}" />
		<Setter Property="ColumnHeaderStyle" Value="{StaticResource KcvRec.Header}" />
		<Setter Property="RowStyle" Value="{StaticResource KcvRec.Row}" />
		<Setter Property="RowBackground" Value="Transparent" />
		<Setter Property="AlternatingRowBackground" Value="Transparent" />
		<Setter Property="GridLinesVisibility" Value="Horizontal" />
		<Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Kcv.Separator}" />
		<Setter Property="HeadersVisibility" Value="Column" />
		<Setter Property="IsReadOnly" Value="True" />
		<Setter Property="SelectionMode" Value="Extended" />
		<Setter Property="SelectionUnit" Value="FullRow" />
		<Setter Property="EnableRowVirtualization" Value="True" />
		<Setter Property="MinRowHeight" Value="26" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Setter Property="kcv:KcvRecordSelection.Toggle" Value="True" />
	</Style>

	<!--  The status bar: the search state on the left, the selection on the right  -->
	<Style x:Key="KcvRec.StatusBar" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource Kcv.StatusBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
		<Setter Property="BorderThickness" Value="0 1 0 0" />
		<Setter Property="Padding" Value="8 3" />
		<Setter Property="TextElement.Foreground" Value="{DynamicResource Kcv.SubForeground}" />
		<Setter Property="TextElement.FontSize" Value="12" />
	</Style>

	<ItemsPanelTemplate x:Key="KcvRec.Horizontal">
		<StackPanel Orientation="Horizontal" />
	</ItemsPanelTemplate>

	<!--  A ship of a recorded fleet: the name and a grey level  -->
	<DataTemplate x:Key="KcvRec.ShipChip" DataType="{x:Type kcv:KcvRecordShip}">
		<Border
			Margin="0 0 3 0"
			Padding="5 0"
			VerticalAlignment="Center"
			Background="{DynamicResource Kcv.ChipBackground}"
			CornerRadius="2"
			>
			<TextBlock FontSize="12" Foreground="{DynamicResource Kcv.Foreground}">
				<Run Text="{Binding Name, Mode=OneWay}" />
				<Run
					FontSize="11"
					Foreground="{DynamicResource Kcv.InactiveForeground}"
					Text="{Binding Level, Mode=OneWay}"
					/>
			</TextBlock>
		</Border>
	</DataTemplate>

	<!--  The fleet column: a line of ship chips, the ship list's scale  -->
	<Style x:Key="KcvRec.Fleet" TargetType="ItemsControl">
		<Setter Property="Margin" Value="6 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="ItemsPanel" Value="{StaticResource KcvRec.Horizontal}" />
		<Setter Property="ItemTemplate" Value="{StaticResource KcvRec.ShipChip}" />
	</Style>

	<!--  A node of the sortie route or the drop table, coloured by its kind (Kcv.Node in KcvViews.xaml, by the Kind of the row)  -->
	<Style
		x:Key="KcvRec.Node"
		BasedOn="{StaticResource Kcv.Node}"
		TargetType="Border"
		>
		<Setter Property="Tag" Value="{Binding Kind}" />
	</Style>

	<!--
		A battle rank in the user's colours (2026-10-13, mockup 20261013-battle-hp-damage-v5): SS and S gold, A red,
		B orange, C yellow, D green, E sky blue
	-->
	<Style x:Key="KcvRec.Rank" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="6 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="S">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankS}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="SS">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankS}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="A">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankA}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="B">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankB}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="C">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankC}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="D">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankD}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="E">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.RankE}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!--  A resource's coloured square before its number  -->
	<Style x:Key="KcvRec.Dot" TargetType="Rectangle">
		<Setter Property="Width" Value="8" />
		<Setter Property="Height" Value="8" />
		<Setter Property="RadiusX" Value="2" />
		<Setter Property="RadiusY" Value="2" />
		<Setter Property="Margin" Value="0 0 3 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!--  A recipe: coloured squares and numbers (fuel, ammo, steel, bauxite, development material)  -->
	<DataTemplate x:Key="KcvRec.RecipePart" DataType="{x:Type kcv:KcvRecipePart}">
		<StackPanel Margin="0 0 7 0" Orientation="Horizontal">
			<Rectangle Fill="{Binding Color}" Style="{StaticResource KcvRec.Dot}" />
			<TextBlock
				VerticalAlignment="Center"
				FontSize="13"
				Text="{Binding Value}"
				/>
		</StackPanel>
	</DataTemplate>
	<Style x:Key="KcvRec.Recipe" TargetType="ItemsControl">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="ItemsPanel" Value="{StaticResource KcvRec.Horizontal}" />
		<Setter Property="ItemTemplate" Value="{StaticResource KcvRec.RecipePart}" />
	</Style>

	<!--
		A count with its rate 「47 (35.3%)」: the number, then the rate in grey; all grey when the count is 0. The cell's
		text comes as the content (the viewer's display text).
	-->
	<DataTemplate x:Key="KcvRec.Count">
		<TextBlock x:Name="Text" Style="{StaticResource KcvRec.Text}">
			<Run Text="{Binding Mode=OneWay, Converter={StaticResource KcvRec.CountPart}, ConverterParameter=main}" />
			<Run
				x:Name="Rate"
				FontSize="11"
				Foreground="{DynamicResource Kcv.InactiveForeground}"
				Text="{Binding Mode=OneWay, Converter={StaticResource KcvRec.CountPart}, ConverterParameter=rate}"
				/>
		</TextBlock>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Converter={StaticResource KcvRec.ZeroCount}}" Value="True">
				<Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>
</ResourceDictionary>

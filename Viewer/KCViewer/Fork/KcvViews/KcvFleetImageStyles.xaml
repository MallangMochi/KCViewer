<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	>
	<!--
		Fork: what the parts of 편성 이미지 출력 in KanColleViewer's style share (Fork/KcvViews/KcvFleetImage*, mockup
		20261007-fleet-image-v2): its tabs, as 칸무스 수집 진행도's, and two converters.
	-->

	<kcv:KcvRadioConverter x:Key="KcvFi.Radio" />
	<kcv:KcvLabelTextConverter x:Key="KcvFi.LabelText" />

	<!--  A tab: grey, the foreground with the accent line under it when chosen (KcvKancolleProgressWindow's)  -->
	<Style x:Key="KcvFi.Tab" TargetType="RadioButton">
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RadioButton">
					<Border
						x:Name="Line"
						Padding="14 6 14 5"
						Background="Transparent"
						BorderBrush="Transparent"
						BorderThickness="0 0 0 2"
						>
						<TextBlock
							FontSize="13"
							Foreground="{TemplateBinding Foreground}"
							Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
							/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
							<Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>

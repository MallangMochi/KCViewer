<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:airBase="clr-namespace:KCViewer.Window.Settings.SubWindow.AirBase"
	xmlns:arsenal="clr-namespace:KCViewer.Window.Settings.SubWindow.Arsenal"
	xmlns:behavior="clr-namespace:KCViewer.Window.Settings.Behavior"
	xmlns:bgm="clr-namespace:KCViewer.Window.Settings.BGM"
	xmlns:browser="clr-namespace:KCViewer.Window.Settings.SubWindow.Browser"
	xmlns:colorPicker="clr-namespace:ColorPickerLib.Controls;assembly=ColorPickerLib"
	xmlns:combat="clr-namespace:KCViewer.Window.Settings.SubWindow.Combat"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:compass="clr-namespace:KCViewer.Window.Settings.SubWindow.Compass"
	xmlns:connection="clr-namespace:KCViewer.Window.Settings.Connection"
	xmlns:converters="clr-namespace:KCViewer.Converters"
	xmlns:data="clr-namespace:KCViewer.Data"
	xmlns:dataSubmission="clr-namespace:KCViewer.Window.Settings.DataSubmission"
	xmlns:debugging="clr-namespace:KCViewer.Window.Settings.Debugging"
	xmlns:discordRpc="clr-namespace:KCViewer.Data.DiscordRPC"
	xmlns:dock="clr-namespace:KCViewer.Window.Settings.SubWindow.Dock"
	xmlns:fleet="clr-namespace:KCViewer.Window.Settings.SubWindow.Fleet"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:group="clr-namespace:KCViewer.Window.Settings.SubWindow.Group"
	xmlns:headquarters="clr-namespace:KCViewer.Window.Settings.SubWindow.Headquarters"
	xmlns:json="clr-namespace:KCViewer.Window.Settings.SubWindow.Json"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:log="clr-namespace:KCViewer.Window.Settings.Log"
	xmlns:quest="clr-namespace:KCViewer.Window.Settings.SubWindow.Quest"
	xmlns:shipTraining="clr-namespace:KCViewer.Window.Settings.SubWindow.ShipTraining"
	xmlns:types="clr-namespace:KCViewer.Core.Types;assembly=KCViewer.Core"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="clr-namespace:KCViewer.Window.Settings.UI"
	xmlns:window="clr-namespace:KCViewer.Window.Settings.Window"
	>
	<!--
		Fork: the pages of the settings window in KanColleViewer's style (KcvConfigurationWindow, mockup
		20261007-settings-v2, approved 2026-10-07 "구현"), one template per page by the viewer's view model of that tab,
		so the values are the viewer's and its [OK] saves them. Each page is boxes with titles; labels without the
		viewer's colons; check boxes before their names (the app's style); a list of checks wraps to fewer columns in
		a narrow window. Left out as the mockup: 통신's port, system proxy and proxy script (the fork reads the game
		through DevTools and starts no proxy), the languages the portable does not carry (only 日本語, English, 한국어),
		UI's browser font (the viewer shows it in debug builds only). The notification pages are in
		KcvConfigurationNotifyPages.xaml, 데이터 is KcvConfigDataPage.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  통신: the browser's proxy and the saving of the game's traffic  -->
	<DataTemplate DataType="{x:Type connection:ConfigurationConnectionViewModel}">
		<StackPanel>
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigBrowserProxy}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<CheckBox
							Content="{Binding Translation.Connection_UseUpstreamProxy, Converter={StaticResource Cfg.Label}}"
							IsChecked="{Binding UseUpstreamProxy}"
							ToolTip="{Binding Translation.Connection_UseUpstreamProxyToolTip}"
							/>
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{x:Static fork:ForkStrings.KcvConfigAddress}" />
						<TextBox
							Width="150"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding UpstreamProxyAddress}"
							ToolTip="{Binding Translation.UpstreamProxyToolTip}"
							/>
						<TextBlock Style="{StaticResource Cfg.Lbl2}" Text="{x:Static fork:ForkStrings.KcvConfigPort}" />
						<kcv:KcvNumberBox
							Width="80"
							Maximum="65535"
							Minimum="0"
							Style="{StaticResource Cfg.Num}"
							ToolTip="{Binding Translation.Connection_UpstreamProxyPortToolTip}"
							Value="{Binding UpstreamProxyPort}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Connection_DownstreamProxyLabel, Converter={StaticResource Cfg.Label}}" />
						<TextBox
							Width="360"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding DownstreamProxy}"
							ToolTip="{Binding Translation.Connection_DownstreamProxyToolTip}"
							/>
					</WrapPanel>
					<TextBlock Style="{StaticResource Cfg.Warn}" Text="{Binding Translation.NetworkSettingsNote}" />
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigSaveData}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<CheckBox Content="{Binding Translation.Connection_SaveReceivedData}" IsChecked="{Binding SaveReceivedData}" />
						<TextBlock Style="{StaticResource Cfg.Note}" Text="{Binding Translation.MayIncreaseSize}" />
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.SaveLocation, Converter={StaticResource Cfg.Label}}" />
						<TextBox
							Width="420"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding SaveDataPath, UpdateSourceTrigger=PropertyChanged}"
							/>
						<Button Command="{Binding SelectSaveDataPathCommand}" Style="{StaticResource Cfg.Browse}" />
					</WrapPanel>
					<WrapPanel IsEnabled="{Binding SaveReceivedData}" Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{x:Static fork:ForkStrings.KcvConfigSaveWhat}" />
						<CheckBox
							Content="Request"
							IsChecked="{Binding SaveRequest}"
							ToolTip="{Binding Translation.SaveAPIRequests}"
							/>
						<CheckBox
							Content="Response"
							IsChecked="{Binding SaveResponse}"
							ToolTip="{Binding Translation.SaveAPIResponses}"
							/>
						<CheckBox
							Content="Other"
							IsChecked="{Binding SaveOtherFile}"
							ToolTip="{Binding Translation.SaveAllConnectionFiles}"
							/>
						<CheckBox
							Content="Version"
							IsChecked="{Binding ApplyVersion}"
							ToolTip="{Binding Translation.AddVersionToFile}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>
		</StackPanel>
	</DataTemplate>

	<!--  UI: fonts, display, translation, theme and language  -->
	<DataTemplate DataType="{x:Type ui:ConfigurationUIViewModel}">
		<StackPanel>
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigFonts}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							MinWidth="64"
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding Translation.MainFont, Converter={StaticResource Cfg.Label}}"
							/>
						<ComboBox
							Width="220"
							Margin="0 1 6 1"
							IsEditable="{Binding FontFamilyTextSearch}"
							ItemsSource="{Binding AllFontFamilies}"
							SelectedItem="{Binding MainFontFamily}"
							Style="{StaticResource Cfg.Combo}"
							>
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource Cfg.FontDisplay}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<kcv:KcvNumberBox
							Minimum="6"
							Style="{StaticResource Cfg.Num}"
							Value="{Binding MainFontSize}"
							/>
						<CheckBox
							Margin="10 1 0 1"
							Content="{Binding Translation.TextSearch}"
							IsChecked="{Binding FontFamilyTextSearch}"
							ToolTip="{Binding Translation.TextSearchToolTip}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							MinWidth="64"
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding Translation.SubFont, Converter={StaticResource Cfg.Label}}"
							/>
						<ComboBox
							Width="220"
							Margin="0 1 6 1"
							IsEditable="{Binding FontFamilyTextSearch}"
							ItemsSource="{Binding AllFontFamilies}"
							SelectedItem="{Binding SubFontFamily}"
							Style="{StaticResource Cfg.Combo}"
							>
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource Cfg.FontDisplay}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<kcv:KcvNumberBox
							Minimum="6"
							Style="{StaticResource Cfg.Num}"
							Value="{Binding SubFontSize}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigDisplay}">
				<WrapPanel>
					<CheckBox
						Content="{Binding Translation.UI_BarColorMorphing}"
						IsChecked="{Binding BarColorMorphing}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.UI_BarColorMorphingToolTip}"
						/>
					<CheckBox
						Content="{Binding Translation.UI_IsLayoutFixed}"
						IsChecked="{Binding IsLayoutFixed}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.UI_IsLayoutFixedToolTip}"
						/>
					<CheckBox
						Content="{Binding Translation.UI_NodeNumbering}"
						IsChecked="{Binding UseOriginalNodeId}"
						Style="{StaticResource Cfg.Cell}"
						/>
				</WrapPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigTranslation}">
				<WrapPanel>
					<CheckBox
						Content="{Binding Translation.UI_JapaneseShipTypes}"
						IsChecked="{Binding JapaneseShipType}"
						Style="{StaticResource Cfg.Cell}"
						/>
					<CheckBox
						Content="{Binding Translation.UI_JapaneseEquipmentTypes}"
						IsChecked="{Binding JapaneseEquipmentType}"
						Style="{StaticResource Cfg.Cell}"
						/>
					<CheckBox
						Content="{Binding Translation.UI_JapaneseShipNames}"
						IsChecked="{Binding JapaneseShipName}"
						Style="{StaticResource Cfg.Cell}"
						/>
					<CheckBox
						Content="{Binding Translation.UI_JapaneseEquipmentNames}"
						IsChecked="{Binding JapaneseEquipmentName}"
						Style="{StaticResource Cfg.Cell}"
						/>
					<CheckBox
						Content="{Binding Translation.UI_DisableOtherTranslations}"
						IsChecked="{Binding DisableOtherTranslations}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.UI_DisableOtherTranslationsToolTip}"
						/>
				</WrapPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigThemeLanguage}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding Translation.Theme, Converter={StaticResource Cfg.Label}}"
							ToolTip="{Binding Translation.ThemeToolTip}"
							/>
						<RadioButton
							Command="{Binding SetThemeCommand}"
							CommandParameter="{x:Static ui:ThemeMode.Light}"
							Content="{Binding Translation.Theme_Light}"
							IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Light}"
							/>
						<RadioButton
							Command="{Binding SetThemeCommand}"
							CommandParameter="{x:Static ui:ThemeMode.Dark}"
							Content="{Binding Translation.Theme_Dark}"
							IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Dark}"
							/>
						<RadioButton
							Command="{Binding SetThemeCommand}"
							CommandParameter="{x:Static ui:ThemeMode.Custom}"
							Content="{Binding Translation.Theme_Custom}"
							IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Custom}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.UI_LanguageLabel, Converter={StaticResource Cfg.Label}}" />
						<RadioButton
							Command="{Binding SetLanguageCommand}"
							CommandParameter="ja-JP"
							Content="{Binding Translation.Language_Japanese}"
							IsChecked="{Binding Culture, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=ja-JP}"
							/>
						<RadioButton
							Command="{Binding SetLanguageCommand}"
							CommandParameter="en-US"
							Content="{Binding Translation.Language_English}"
							IsChecked="{Binding Culture, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=en-US}"
							/>
						<RadioButton
							Command="{Binding SetLanguageCommand}"
							CommandParameter="ko-KR"
							Content="{Binding Translation.Language_Korean}"
							IsChecked="{Binding Culture, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=ko-KR}"
							/>
					</WrapPanel>
					<TextBlock Style="{StaticResource Cfg.Warn}" Text="{Binding Translation.UI_RestartHint}" />
				</StackPanel>
			</ContentControl>
		</StackPanel>
	</DataTemplate>

	<!--  로그: the log file, the fork's daily cleanup, spoilers  -->
	<DataTemplate DataType="{x:Type log:ConfigurationLogViewModel}">
		<StackPanel>
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigLogFile}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<CheckBox Content="{Binding Translation.Log_SaveLogFlag}" IsChecked="{Binding SaveLogFlag}" />
						<CheckBox
							Content="{Binding Translation.Log_SaveLogImmediately}"
							IsChecked="{Binding SaveLogImmediately}"
							ToolTip="{Binding Translation.Log_SaveLogImmediatelyToolTip}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.LoggingLevel, Converter={StaticResource Cfg.Label}}" />
						<kcv:KcvNumberBox
							Maximum="3"
							Minimum="0"
							Style="{StaticResource Cfg.Num}"
							Value="{Binding LogLevel}"
							/>
						<TextBlock
							Style="{StaticResource Cfg.Lbl2}"
							Text="{Binding ForkCleanupHourLabel, Converter={StaticResource Cfg.Label}}"
							ToolTip="{Binding ForkCleanupHourToolTip}"
							/>
						<ComboBox
							MinWidth="80"
							DisplayMemberPath="Display"
							ItemsSource="{Binding ForkCleanupHours}"
							SelectedValue="{Binding ForkCleanupHour}"
							SelectedValuePath="Hour"
							Style="{StaticResource Cfg.Combo}"
							ToolTip="{Binding ForkCleanupHourToolTip}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<CheckBox
							Content="{Binding Translation.Log_SaveErrorReport}"
							IsChecked="{Binding SaveErrorReport}"
							ToolTip="{Binding Translation.SaveErrorToolTip}"
							/>
						<CheckBox
							Content="{Binding Translation.Log_SaveBattleLog}"
							IsChecked="{Binding SaveBattleLog}"
							ToolTip="{Binding Translation.Log_SaveBattleLogToolTip}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding Translation.Encoding, Converter={StaticResource Cfg.Label}}"
							ToolTip="{Binding Translation.EncodingToolTip}"
							/>
						<ComboBox
							Margin="0 1 10 1"
							ItemsSource="{Binding Encodings}"
							SelectedItem="{Binding SelectedEncoding}"
							Style="{StaticResource Cfg.Combo}"
							>
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Display}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<TextBlock Style="{StaticResource Cfg.Note}" Text="{Binding Translation.CorruptLogs}" />
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigSpoiler}">
				<StackPanel>
					<CheckBox
						Content="{Binding Translation.Log_ShowSpoiler}"
						IsChecked="{Binding ShowSpoiler}"
						ToolTip="{Binding Translation.Log_ShowSpoilerToolTip}"
						/>
					<WrapPanel Margin="22 2 0 0" IsEnabled="{Binding ShowSpoiler}">
						<CheckBox
							Content="{Binding Translation.Log_ShowDropSpoiler}"
							IsChecked="{Binding ShowDropSpoiler}"
							Style="{StaticResource Cfg.Cell}"
							ToolTip="{Binding Translation.Log_ShowDropSpoilerToolTip}"
							/>
						<CheckBox
							Content="{Binding Translation.Log_ShowExpeditionSpoiler}"
							IsChecked="{Binding ShowExpeditionSpoiler}"
							Style="{StaticResource Cfg.Cell}"
							ToolTip="{Binding Translation.Log_ShowExpeditionSpoilerToolTip}"
							/>
						<CheckBox
							Content="{Binding Translation.Log_ShowDevelopmentSpoiler}"
							IsChecked="{Binding ShowDevelopmentSpoiler}"
							Style="{StaticResource Cfg.Cell}"
							ToolTip="{Binding Translation.Log_ShowDevelopmentSpoilerToolTip}"
							/>
						<CheckBox
							Content="{Binding Translation.Log_ShowEquipmentImprovementSpoiler}"
							IsChecked="{Binding ShowEquipmentImprovementSpoiler}"
							Style="{StaticResource Cfg.Cell}"
							ToolTip="{Binding Translation.Log_ShowEquipmentImprovementSpoilerToolTip}"
							/>
						<CheckBox
							Content="{Binding Translation.Log_ShowModernizationSpoiler}"
							IsChecked="{Binding ShowModernizationSpoiler}"
							Style="{StaticResource Cfg.Cell}"
							ToolTip="{Binding Translation.Log_ShowModernizationSpoilerToolTip}"
							/>
						<CheckBox
							Content="{Binding Translation.Log_ShowConstructionSpoiler}"
							IsChecked="{Binding ShowConstructionSpoiler}"
							Style="{StaticResource Cfg.Cell}"
							ToolTip="{Binding Translation.Log_ShowConstructionSpoilerToolTip}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>
		</StackPanel>
	</DataTemplate>

	<!--  동작: records and display, warnings and sound, translation data, Discord  -->
	<DataTemplate DataType="{x:Type behavior:ConfigurationBehaviorViewModel}">
		<StackPanel>
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigRecordDisplay}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.LogFrequency, Converter={StaticResource Cfg.Label}}" />
						<RadioButton
							Command="{Binding SetRecordAutoSavingCommand}"
							CommandParameter="{x:Static behavior:RecordAutoSaving.None}"
							Content="{Binding Translation.ProgressAutoSaving_Disable}"
							IsChecked="{Binding RecordAutoSaving, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=None}"
							/>
						<RadioButton
							Command="{Binding SetRecordAutoSavingCommand}"
							CommandParameter="{x:Static behavior:RecordAutoSaving.Hourly}"
							Content="{Binding Translation.ProgressAutoSaving_Hourly}"
							IsChecked="{Binding RecordAutoSaving, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Hourly}"
							/>
						<RadioButton
							Command="{Binding SetRecordAutoSavingCommand}"
							CommandParameter="{x:Static behavior:RecordAutoSaving.Daily}"
							Content="{Binding Translation.ProgressAutoSaving_Daily}"
							IsChecked="{Binding RecordAutoSaving, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Daily}"
							/>
						<RadioButton
							Command="{Binding SetRecordAutoSavingCommand}"
							CommandParameter="{x:Static behavior:RecordAutoSaving.Instant}"
							Content="{Binding Translation.ProgressAutoSaving_Immediately}"
							IsChecked="{Binding RecordAutoSaving, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Instant}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.MoraleBorder, Converter={StaticResource Cfg.Label}}" />
						<kcv:KcvNumberBox
							Maximum="100"
							Minimum="1"
							Style="{StaticResource Cfg.Num}"
							Value="{Binding ConditionBorder}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding Translation.FormationModifier, Converter={StaticResource Cfg.Label}}"
							ToolTip="{Binding Translation.Control_PowerEngagementFormToolTip}"
							/>
						<RadioButton
							Command="{Binding SetPowerEngagementFormCommand}"
							CommandParameter="{x:Static types:EngagementType.Parallel}"
							Content="{Binding Translation.Control_PowerEngagementForm_Parallel}"
							IsChecked="{Binding PowerEngagementForm, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=Parallel}"
							/>
						<RadioButton
							Command="{Binding SetPowerEngagementFormCommand}"
							CommandParameter="{x:Static types:EngagementType.HeadOn}"
							Content="{Binding Translation.Control_PowerEngagementForm_HeadOn}"
							IsChecked="{Binding PowerEngagementForm, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=HeadOn}"
							/>
						<RadioButton
							Command="{Binding SetPowerEngagementFormCommand}"
							CommandParameter="{x:Static types:EngagementType.TAdvantage}"
							Content="{Binding Translation.Control_PowerEngagementForm_GreenT}"
							IsChecked="{Binding PowerEngagementForm, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=TAdvantage}"
							/>
						<RadioButton
							Command="{Binding SetPowerEngagementFormCommand}"
							CommandParameter="{x:Static types:EngagementType.TDisadvantage}"
							Content="{Binding Translation.Control_PowerEngagementForm_RedT}"
							IsChecked="{Binding PowerEngagementForm, Mode=OneWay, Converter={StaticResource Cfg.Radio}, ConverterParameter=TDisadvantage}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigWarnings}">
				<StackPanel>
					<CheckBox
						Content="{Binding Translation.Control_ShowSallyAreaAlertDialog}"
						IsChecked="{Binding ShowSallyAreaAlertDialog}"
						ToolTip="{Binding Translation.Control_ShowSallyAreaAlertDialogTooltip}"
						/>
					<CheckBox
						Content="{Binding Translation.Control_ShowExpeditionAlertDialog}"
						IsChecked="{Binding ShowExpeditionAlertDialog}"
						ToolTip="{Binding Translation.Control_ShowExpeditionAlertDialogTooltip}"
						/>
					<CheckBox
						Content="{Binding Translation.Control_UseSystemVolume}"
						IsChecked="{Binding UseSystemVolume}"
						ToolTip="{Binding Translation.Control_UseSystemVolumeToolTip}"
						/>
				</StackPanel>
			</ContentControl>

			<!--  Fork: the translations from their own address, EO's data from the old one (mockup 20261007-translation-url-v2)  -->
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigTranslationData}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							MinWidth="76"
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding ForkTranslationUrlLabel, Converter={StaticResource Cfg.Label}}"
							ToolTip="{Binding ForkTranslationUrlToolTip}"
							/>
						<TextBox
							Width="440"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding ForkTranslationUrl}"
							ToolTip="{Binding ForkTranslationUrlToolTip}"
							/>
						<Button
							Command="{Binding ForceUpdateCommand}"
							Content="{Binding Translation.Control_ForceUpdate}"
							Style="{StaticResource Cfg.Button}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock
							MinWidth="76"
							Style="{StaticResource Cfg.Lbl}"
							Text="{Binding ForkDataUrlLabel, Converter={StaticResource Cfg.Label}}"
							ToolTip="{Binding ForkDataUrlToolTip}"
							/>
						<TextBox
							Width="440"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding UpdateRepoURL}"
							ToolTip="{Binding ForkDataUrlToolTip}"
							/>
					</WrapPanel>
					<!--  Fork: the start-up update checks, off by default (mockup 20261007-update-watch-v1)  -->
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<CheckBox
							Content="{Binding ForkWatchGameLabel}"
							IsChecked="{Binding ForkWatchGame}"
							ToolTip="{Binding ForkWatchGameToolTip}"
							/>
						<CheckBox
							Content="{Binding ForkWatchKc3Label}"
							IsChecked="{Binding ForkWatchKc3}"
							ToolTip="{Binding ForkWatchKc3ToolTip}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="Discord">
				<StackPanel>
					<CheckBox
						Content="{Binding Translation.Control_EnableDiscordRPC}"
						IsChecked="{Binding EnableDiscordRPC}"
						ToolTip="{Binding Translation.Control_EnableDiscordRPCToolTip}"
						/>
					<StackPanel Margin="22 2 0 0" Visibility="{Binding EnableDiscordRPC, Converter={StaticResource KcvRec.Visible}}">
						<WrapPanel Style="{StaticResource Cfg.Row}">
							<TextBlock
								MinWidth="120"
								Style="{StaticResource Cfg.Lbl}"
								Text="{Binding Translation.ApplicationId, Converter={StaticResource Cfg.Label}}"
								ToolTip="{Binding Translation.Control_ApplicationIDToolTip}"
								/>
							<TextBox
								Width="260"
								Style="{StaticResource Cfg.Field}"
								Text="{Binding DiscordRPCApplicationId}"
								/>

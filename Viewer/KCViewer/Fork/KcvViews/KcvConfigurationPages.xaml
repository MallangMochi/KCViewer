	<!--  BGM: the player, then the table of the scenes (the mockup's); [편집] opens the KanColleViewer style editor  -->
	<DataTemplate DataType="{x:Type bgm:ConfigurationBGMViewModel}">
		<StackPanel>
			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigBgmPlayer}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<CheckBox Content="{Binding Translation.BGMPlayer_Enabled}" IsChecked="{Binding Enabled}" />
						<CheckBox
							Content="{Binding Translation.BGMPlayer_SyncBrowserMute}"
							IsChecked="{Binding SyncBrowserMute}"
							ToolTip="{Binding Translation.BGMPlayer_SyncBrowserMuteToolTip}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Source={x:Static translations:ConfigRes.Volume}, Converter={StaticResource Cfg.Label}}" />
						<kcv:KcvNumberBox
							Maximum="100"
							Minimum="0"
							Style="{StaticResource Cfg.Num}"
							Value="{Binding SetAllVolumeValue}"
							/>
						<Button
							Command="{Binding SetAllVolumeCommand}"
							Content="{Binding Translation.BGMPlayer_SetVolumeAll}"
							Style="{StaticResource Cfg.Button}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<Grid Style="{StaticResource Cfg.TableHead}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="48" />
					<ColumnDefinition Width="130" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="80" />
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" Style="{StaticResource Cfg.HeadCell}">
					<TextBlock Text="{x:Static fork:ForkStrings.KcvConfigBgmUse}" />
				</Border>
				<Border Grid.Column="1" Style="{StaticResource Cfg.HeadCell}">
					<TextBlock Text="{x:Static translations:ConfigRes.Scene}" />
				</Border>
				<Border Grid.Column="2" Style="{StaticResource Cfg.HeadCell}">
					<TextBlock Text="{x:Static fork:ForkStrings.KcvConfigBgmFile}" />
				</Border>
				<Border Grid.Column="3" Style="{StaticResource Cfg.HeadCell}" />
			</Grid>
			<ItemsControl ItemsSource="{Binding Handles}">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type bgm:SoundHandleViewModel}">
						<Border Style="{StaticResource Cfg.TableRow}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48" />
									<ColumnDefinition Width="130" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="80" />
								</Grid.ColumnDefinitions>
								<CheckBox
									Grid.Column="0"
									Margin="10 0 0 0"
									VerticalAlignment="Center"
									AutomationProperties.Name="{Binding Name}"
									IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
									/>
								<TextBlock Grid.Column="1" Style="{StaticResource Cfg.CellText}" Text="{Binding Name}" />
								<!--  the file, or a dimmed 「(없음)」  -->
								<TextBlock Grid.Column="2" ToolTip="{Binding Path}">
									<TextBlock.Style>
										<Style BasedOn="{StaticResource Cfg.CellText}" TargetType="TextBlock">
											<Setter Property="Text" Value="{Binding Path}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Path}" Value="">
													<Setter Property="Text" Value="{x:Static fork:ForkStrings.KcvConfigBgmNoFile}" />
													<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
													<Setter Property="ToolTipService.IsEnabled" Value="False" />
												</DataTrigger>
												<DataTrigger Binding="{Binding Path}" Value="{x:Null}">
													<Setter Property="Text" Value="{x:Static fork:ForkStrings.KcvConfigBgmNoFile}" />
													<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
													<Setter Property="ToolTipService.IsEnabled" Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<Button
									Grid.Column="3"
									Margin="6 2"
									Command="{Binding DataContext.EditSoundHandleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
									CommandParameter="{Binding}"
									Content="{Binding DataContext.Translation.Edit, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
									Style="{StaticResource KcvRec.Button}"
									/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>


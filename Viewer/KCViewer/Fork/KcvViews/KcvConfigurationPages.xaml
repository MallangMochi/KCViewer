						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.ToolMenuDockStyle, Converter={StaticResource Cfg.Label}}" />
						<ComboBox
							MinWidth="70"
							ItemTemplate="{StaticResource Cfg.EnumItem}"
							ItemsSource="{Binding DockStyles}"
							SelectedItem="{Binding ToolMenuDockStyle}"
							Style="{StaticResource Cfg.Combo}"
							/>
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Translation.Screenshot}">
				<StackPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{x:Static fork:ForkStrings.KcvConfigFormat}" />
						<ItemsControl
							Margin="0 0 4 0"
							ItemsPanel="{StaticResource KcvRec.Horizontal}"
							ItemsSource="{Binding ScreenshotFormats}"
							>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton Content="{Binding Value}" IsChecked="{Binding IsChecked}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<CheckBox
							Content="{Binding Translation.FormBrowser_ScreenShotFormat_AvoidTwitterDeterioration}"
							IsChecked="{Binding AvoidTwitterDeterioration}"
							ToolTip="{Binding Translation.FormBrowser_ScreenShotFormat_AvoidTwitterDeteriorationToolTip}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Output, Converter={StaticResource Cfg.Label}}" />
						<ComboBox
							Margin="0 1 10 1"
							ItemTemplate="{StaticResource Cfg.EnumItem}"
							ItemsSource="{Binding ScreenshotSaveModes}"
							SelectedItem="{Binding ScreenShotSaveMode}"
							Style="{StaticResource Cfg.Combo}"
							/>
						<!--  the screenshot key where 모드 was (ConfigurationBrowserViewModel.Fork.cs, mockup 20261009-screenshot-capture-v2);
						     as tall as the combo box it replaces, so the box keeps its size  -->
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{x:Static fork:ForkStrings.ScreenshotHotkey}" />
						<fork:ForkHotkeyBox
							Width="120"
							Height="21"
							Hotkey="{Binding ForkScreenshotHotkey}"
							Style="{StaticResource Cfg.Field}"
							ToolTip="{x:Static fork:ForkStrings.ScreenshotHotkeyToolTip}"
							/>
						<Button
							Command="{Binding ForkClearScreenshotHotkeyCommand}"
							Content="{x:Static fork:ForkStrings.ScreenshotHotkeyClear}"
							Style="{StaticResource Cfg.Button}"
							/>
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.SaveLocation, Converter={StaticResource Cfg.Label}}" />
						<TextBox
							Width="420"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding ScreenShotPath}"
							/>
						<Button Command="{Binding SelectScreenshotFolderCommand}" Style="{StaticResource Cfg.Browse}" />
					</WrapPanel>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigBrowserRestart}">
				<WrapPanel>
					<CheckBox
						Content="{Binding Translation.FormBrowser_HardwareAccelerationEnabled, Converter={StaticResource Cfg.Label}}"
						IsChecked="{Binding HardwareAccelerationEnabled}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.FormBrowser_HardwareAccelerationEnabledToolTip}"
						/>
					<CheckBox
						Content="{Binding Translation.FormBrowser_SavesBrowserLog, Converter={StaticResource Cfg.Label}}"
						IsChecked="{Binding SavesBrowserLog}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.FormBrowser_SavesBrowserLogTooltip}"
						/>
					<CheckBox
						Content="{Binding Translation.FormBrowser_PreserveDrawingBuffer, Converter={StaticResource Cfg.Label}}"
						IsChecked="{Binding PreserveDrawingBuffer}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.FormBrowser_PreserveDrawingBufferToolTip}"
						/>
					<CheckBox
						Content="{Binding Translation.FormBrowser_UseVulkanWorkaround, Converter={StaticResource Cfg.Label}}"
						IsChecked="{Binding UseVulkanWorkaround}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.FormBrowser_UseVulkanWorkaroundToolTip}"
						/>
					<CheckBox
						Content="{Binding Translation.FormBrowser_ForceColorProfile, Converter={StaticResource Cfg.Label}}"
						IsChecked="{Binding ForceColorProfile}"
						Style="{StaticResource Cfg.Cell}"
						ToolTip="{Binding Translation.FormBrowser_ForceColorProfileToolTip}"
						/>
				</WrapPanel>
			</ContentControl>
		</StackPanel>
	</DataTemplate>


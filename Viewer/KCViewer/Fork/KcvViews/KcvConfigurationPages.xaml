							Text="{Binding APIListPath}"
							/>
						<Button Command="{Binding SelectApiListPathCommand}" Style="{StaticResource Cfg.Browse}" />
					</WrapPanel>
					<WrapPanel Style="{StaticResource Cfg.Row}">
						<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Debug_ElectronicObserverApiUrl, Converter={StaticResource Cfg.Label}}" />
						<TextBox
							Width="360"
							Style="{StaticResource Cfg.Field}"
							Text="{Binding ElectronicObserverApiUrl}"

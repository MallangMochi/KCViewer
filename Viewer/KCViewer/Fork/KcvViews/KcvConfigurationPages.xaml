						Content="{Binding Translation.Debug_LoadAPIListOnLoad}"
						IsChecked="{Binding LoadAPIListOnLoad}"
						ToolTip="{Binding Translation.Debug_LoadAPIListOnLoadToolTip}"
						/>
					<WrapPanel Style="{StaticResource Cfg.Row}">

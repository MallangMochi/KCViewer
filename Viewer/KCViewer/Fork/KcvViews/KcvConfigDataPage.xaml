<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvConfigDataPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dataSubmission="clr-namespace:KCViewer.Window.Settings.DataSubmission"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance dataSubmission:ConfigurationDataSubmissionViewModel}"
	mc:Ignorable="d"
	>
	<!--
		Fork: 데이터 of the settings window in KanColleViewer's style (mockup 20261007-settings-v2): the viewer's data
		submission, off by default (VIEWER-PLAN 8번 원칙), with its links in KanColleViewer's link colour and Bonodere's
		login while that integration is on. A user control for the password box, which gives the login its password.
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style TargetType="Hyperlink">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.Link}" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.KcvConfigDataSubmission}">
		<StackPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="{Binding Translation.EnableTsunDbSubmission}" IsChecked="{Binding SubmitDataToTsunDb}" />
				<TextBlock VerticalAlignment="Center" FontSize="12">
					<Hyperlink Command="{Binding OpenHyperlinkCommand}" CommandParameter="https://github.com/Jebzou/ElectronicObserver/wiki/Privacy-policy">
						<Run Text="{Binding Translation.PrivacyPolicy, Mode=OneWay}" />
					</Hyperlink>
				</TextBlock>
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="PoiDB" IsChecked="{Binding SendDataToPoi}" />
				<TextBlock VerticalAlignment="Center" FontSize="12">
					<Hyperlink Command="{Binding OpenHyperlinkCommand}" CommandParameter="https://github.com/ElectronicObserverEN/ElectronicObserver/wiki/PoiDB">
						<Run Text="{Binding Translation.Details, Mode=OneWay}" />
					</Hyperlink>
				</TextBlock>
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="KCRDB" IsChecked="{Binding SendDataToKancolleReplayDb}" />
				<TextBlock VerticalAlignment="Center" FontSize="12">
					<Hyperlink Command="{Binding OpenHyperlinkCommand}" CommandParameter="https://github.com/ElectronicObserverEN/ElectronicObserver/wiki/KCRDB">
						<Run Text="{Binding Translation.Details, Mode=OneWay}" />
					</Hyperlink>
				</TextBlock>
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="{Binding Translation.BonodereIntegration, Mode=OneWay}" IsChecked="{Binding BonodereIntegrationEnabled}" />
				<TextBlock VerticalAlignment="Center" FontSize="12">
					<Hyperlink Command="{Binding OpenHyperlinkCommand}" CommandParameter="https://bonodere.famluro.es/participate">
						<Run Text="{Binding Translation.DataSubmissionFAQ, Mode=OneWay}" />
					</Hyperlink>
				</TextBlock>
			</WrapPanel>

			<!--  Bonodere: logged in, or the login while the integration is on  -->
			<WrapPanel
				Margin="22 2 0 0"
				Style="{StaticResource Cfg.Row}"
				Visibility="{Binding IsBonodereReady, Converter={StaticResource KcvRec.Visible}}"
				>
				<TextBlock Style="{StaticResource Cfg.Lbl}"><Run Text="{Binding Translation.LoggedInAs, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding BonodereUsername, Mode=OneWay}" /></TextBlock>
				<Button
					Command="{Binding BonodereLogoutCommand}"
					Content="{Binding Translation.Logout, Mode=OneWay}"
					Style="{StaticResource Cfg.Button}"
					/>
			</WrapPanel>
			<Grid Margin="22 2 0 0" Visibility="{Binding BonodereIntegrationEnabled, Converter={StaticResource KcvRec.Visible}}">
				<Grid Visibility="{Binding IsBonodereReady, Converter={StaticResource Cfg.Collapsed}}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Username, Mode=OneWay, Converter={StaticResource Cfg.Label}}" />
					<TextBox
						Grid.Column="1"
						Width="200"
						Style="{StaticResource Cfg.Field}"
						Text="{Binding BonodereUsername}"
						/>
					<TextBlock
						Grid.Row="1"
						Style="{StaticResource Cfg.Lbl}"
						Text="{Binding Translation.Password, Mode=OneWay, Converter={StaticResource Cfg.Label}}"
						/>
					<PasswordBox
						Grid.Row="1"
						Grid.Column="1"
						Width="200"
						Height="24"
						Margin="0 1"
						Background="{DynamicResource Kcv.ButtonBackground}"
						BorderBrush="{DynamicResource Kcv.Separator}"
						CaretBrush="{DynamicResource Kcv.Foreground}"
						Foreground="{DynamicResource Kcv.Foreground}"
						PasswordChanged="PasswordChanged"
						/>
					<Button
						x:Name="LoginButton"
						Grid.Row="1"
						Grid.Column="2"
						Command="{Binding BonodereLoginCommand}"
						Content="{Binding Translation.Login, Mode=OneWay}"
						Style="{StaticResource Cfg.Button}"
						/>
				</Grid>
			</Grid>
			<TextBlock Style="{StaticResource Cfg.Warn}" Text="{Binding LoginError}" />
		</StackPanel>
	</ContentControl>
</UserControl>

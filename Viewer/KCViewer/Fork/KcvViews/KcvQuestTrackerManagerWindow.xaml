<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvQuestTrackerManagerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager.Models"
	xmlns:questTrackerManager="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:viewModels="clr-namespace:KCViewer.Window.Dialog.QuestTrackerManager.ViewModels"
	Title="{x:Static translations:QuestTrackerManagerResources.Title}"
	Width="800"
	Height="560"
	d:DataContext="{d:DesignInstance questTrackerManager:QuestTrackerManagerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="questTrackerManager:QuestTrackerManagerViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: 퀘스트 추적 매니저 in KanColleViewer's style (mockup 20261006-quest-tracker-v2, approved 2026-10-06 "구현")
		with the viewer's view model (the same trackers as its window). At the top the quest combo, [추적 추가] and the
		quest's description; then a card per tracker: the category colour, the quest, its grey ID, the progress in
		orange, 「자세히 보기」, [복사], [삭제]. Opened: the description, the box 「조건」 (the task type combo with
		「＋ 추가」 and a labelled row per task) and the box 「함선 조건」 (KcvQuestTrackerTemplates.xaml).
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvQuestTrackerTemplates.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<kcv:KcvQuestCategoryBrushConverter x:Key="CategoryBrush" />

			<DataTemplate x:Key="QuestItem" DataType="{x:Type models:QuestModel}">
				<TextBlock Text="{Binding Display}" />
			</DataTemplate>

			<!--  a tracker: the card's header, then (자세히 보기) the description, 「조건」 and 「함선 조건」  -->
			<DataTemplate x:Key="Tracker" DataType="{x:Type viewModels:TrackerViewModel}">
				<Border
					Margin="0 0 0 6"
					BorderBrush="{DynamicResource Kcv.HeaderBackground}"
					BorderThickness="1"
					>
					<StackPanel>
						<!--  the buttons on the right come before the progress, which takes the width left and wraps  -->
						<DockPanel Margin="8 4">
							<Rectangle
								Width="12"
								Height="12"
								Margin="0 0 8 0"
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								Fill="{Binding QuestCategory, Converter={StaticResource CategoryBrush}}"
								/>
							<TextBlock
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								FontSize="14"
								>
								<Run Text="{Binding Model.Quest.Code, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Title, Mode=OneWay}" />
							</TextBlock>
							<TextBlock
								Margin="6 0 0 0"
								DockPanel.Dock="Left"
								FontSize="12"
								Style="{StaticResource KcvRec.Sub}"
								Text="{Binding QuestId, StringFormat='(ID: {0})'}"
								/>
							<Button
								Command="{Binding DataContext.RemoveTrackerCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"
								CommandParameter="{Binding}"
								Content="{x:Static fork:ForkStrings.KcvTrackerRemove}"
								DockPanel.Dock="Right"
								Style="{StaticResource KcvQt.Button}"
								/>
							<Button
								Command="{Binding CopyTrackerCommand}"
								Content="{x:Static translations:QuestTrackerManagerResources.Copy}"
								DockPanel.Dock="Right"
								Style="{StaticResource KcvQt.Button}"
								/>
							<CheckBox
								Content="{x:Static translations:QuestTrackerManagerResources.ShowDetails}"
								DockPanel.Dock="Right"
								IsChecked="{Binding ShowDetails}"
								Style="{StaticResource KcvRec.Check}"
								/>
							<ItemsControl
								Margin="12 0 8 0"
								VerticalAlignment="Center"
								Focusable="False"
								ItemsSource="{Binding Tasks}"
								>
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock
											Margin="0 0 10 0"
											FontSize="12"
											Foreground="{DynamicResource Kcv.InProgressBadgeForeground}"
											Text="{Binding Display}"
											/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</DockPanel>

						<StackPanel Visibility="{Binding ShowDetails, Converter={StaticResource KcvRec.Visible}}">
							<TextBlock
								Margin="28 0 8 4"
								FontSize="12"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Text="{Binding Description}"
								TextWrapping="Wrap"
								/>

							<ContentControl
								Margin="28 2 8 6"
								Style="{StaticResource KcvRec.Box}"
								Tag="{x:Static fork:ForkStrings.KcvTrackerTasks}"
								>
								<StackPanel>
									<WrapPanel Margin="0 0 0 3" Style="{StaticResource KcvQt.Line}">
										<ComboBox
											MinWidth="120"
											Margin="0 1 6 1"
											ItemTemplate="{StaticResource KcvQt.EnumItem}"
											ItemsSource="{Binding TaskTypes}"
											SelectedItem="{Binding TaskTypeType}"
											Style="{StaticResource KcvRec.Combo}"
											/>
										<Button
											Command="{Binding AddTaskCommand}"
											Content="{x:Static fork:ForkStrings.KcvTrackerAddRow}"
											Style="{StaticResource KcvQt.Button}"
											/>
									</WrapPanel>
									<ItemsControl
										Focusable="False"
										ItemTemplateSelector="{StaticResource KcvQt.TaskSelector}"
										ItemsSource="{Binding Tasks}"
										/>
								</StackPanel>
							</ContentControl>

							<ContentControl
								Margin="28 0 8 8"
								Style="{StaticResource KcvRec.Box}"
								Tag="{x:Static fork:ForkStrings.KcvTrackerShipConditions}"
								>
								<ContentControl
									Content="{Binding GroupConditions}"
									ContentTemplate="{StaticResource KcvQt.Group}"
									Focusable="False"
									/>
							</ContentControl>
						</StackPanel>
					</StackPanel>
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Menu Grid.Row="0">
			<MenuItem Header="{Binding Translation.File}">
				<MenuItem Command="{Binding CopyTrackersToClipboardCommand}" Header="{Binding Translation.CopyTrackersToClipboard}" />
				<MenuItem Command="{Binding LoadTrackerFromClipboardCommand}" Header="{Binding Translation.Load}" />
			</MenuItem>
			<MenuItem Header="Debug" Visibility="{Binding DebugEnabled, Converter={StaticResource KcvRec.Visible}}">
				<MenuItem Command="{Binding CopyAllTrackersToClipboardCommand}" Header="Copy all trackers" />
			</MenuItem>
		</Menu>

		<!--  the quest to track and [추적 추가]  -->
		<WrapPanel Grid.Row="1" Margin="10 4 10 0">
			<ComboBox
				MinWidth="240"
				ItemTemplate="{StaticResource QuestItem}"
				ItemsSource="{Binding Quests}"
				SelectedItem="{Binding Quest}"
				Style="{StaticResource KcvRec.Combo}"
				/>
			<Button
				Margin="8 0 0 0"
				Command="{Binding AddTrackerCommand}"
				Content="{x:Static fork:ForkStrings.KcvTrackerAdd}"
				Style="{StaticResource KcvRec.PrimaryButton}"
				/>
		</WrapPanel>
		<TextBlock
			Grid.Row="2"
			Margin="10 4 10 6"
			FontSize="12"
			Foreground="{DynamicResource Kcv.SubForeground}"
			Text="{Binding Quest.Description}"
			TextWrapping="Wrap"
			/>

		<ScrollViewer
			Grid.Row="3"
			Padding="10 0 10 6"
			VerticalScrollBarVisibility="Auto"
			>
			<ItemsControl
				Focusable="False"
				ItemTemplate="{StaticResource Tracker}"
				ItemsSource="{Binding Trackers}"
				/>
		</ScrollViewer>
	</Grid>
</common:WindowBase>

<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvJsonView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="Panel"
	d:DesignHeight="300"
	d:DesignWidth="600"
	AllowDrop="True"
	Background="{DynamicResource Kcv.Background}"
	DragEnter="OnDragEnter"
	DragOver="OnDragEnter"
	Drop="OnDrop"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the JSON panel in KanColleViewer's style (remaining panels mockup 1, user's approval 2026-10-02), the
		viewer's WinForms FormJson rewritten in WPF with the same behaviour (KcvJson.cs): the Tree, Raw and Config tabs
		(the viewer's own English tab names), the tree's menu and saved API files dropped on the panel. The tree and the
		raw text in Consolas; the selected node is a grey band.
	-->
	<UserControl.Resources>
		<FontFamily x:Key="Mono">Consolas, Malgun Gothic, Meiryo UI</FontFamily>

		<!--  The tree's expander: a small triangle, pointing down while expanded  -->
		<Style x:Key="Expander" TargetType="ToggleButton">
			<Setter Property="Width" Value="14" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border Background="Transparent">
							<Path
								x:Name="Arrow"
								Width="5"
								Height="8"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="M 0,0 L 5,4 L 0,8 Z"
								Fill="{DynamicResource Kcv.SubForeground}"
								/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Arrow" Property="Width" Value="8" />
								<Setter TargetName="Arrow" Property="Height" Value="5" />
								<Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,5 Z" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Node" TargetType="TreeViewItem">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
			<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
			<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNodeRightButtonDown" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TreeViewItem">
						<StackPanel>
							<Border x:Name="Band" Padding="0 1" Background="Transparent">
								<DockPanel>
									<ToggleButton
										x:Name="Toggle"
										ClickMode="Press"
										IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
										Style="{StaticResource Expander}"
										/>
									<ContentPresenter ContentSource="Header" />
								</DockPanel>
							</Border>
							<ItemsPresenter x:Name="Items" Margin="14 0 0 0" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsExpanded" Value="False">
								<Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
							</Trigger>
							<Trigger Property="HasItems" Value="False">
								<Setter TargetName="Toggle" Property="Visibility" Value="Hidden" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Band" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid DataContext="{Binding ElementName=Panel}">
		<TabControl Margin="4 2 4 4" Background="Transparent" BorderThickness="0">
			<TabItem Header="Tree">
				<TreeView
					x:Name="Tree"
					Padding="2 4"
					Background="Transparent"
					BorderThickness="0"
					FontFamily="{StaticResource Mono}"
					FontSize="12"
					ItemContainerStyle="{StaticResource Node}"
					ItemsSource="{Binding Model.Nodes}"
					Tag="{Binding Translation}"
					>
					<TreeView.ItemTemplate>
						<HierarchicalDataTemplate DataType="{x:Type kcv:KcvJsonNode}" ItemsSource="{Binding Children}">
							<TextBlock Margin="0 0 8 0" Text="{Binding Text}" TextOptions.TextFormattingMode="Ideal" />
						</HierarchicalDataTemplate>
					</TreeView.ItemTemplate>
					<TreeView.ContextMenu>
						<ContextMenu Opened="OnTreeMenuOpened">
							<MenuItem Click="OnExpandAll" Header="{Binding PlacementTarget.Tag.TreeContextMenu_Expand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
							<MenuItem Click="OnCollapse" Header="{Binding PlacementTarget.Tag.TreeContextMenu_Shrink, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
							<MenuItem Click="OnCollapseParent" Header="{Binding PlacementTarget.Tag.TreeContextMenu_ShrinkParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
							<Separator />
							<MenuItem x:Name="CsvItem" Click="OnWriteCsv" Header="{Binding PlacementTarget.Tag.TreeContextMenu_OutputCSV, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
							<MenuItem Click="OnCopy" Header="{Binding PlacementTarget.Tag.TreeContextMenu_CopyToClipboard, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
							<MenuItem Click="OnCopyDocument" Header="{Binding PlacementTarget.Tag.TreeContextMenu_CopyAsDocument, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
						</ContextMenu>
					</TreeView.ContextMenu>
				</TreeView>
			</TabItem>

			<TabItem Header="Raw">
				<TextBox
					Margin="2 4"
					Background="Transparent"
					BorderThickness="0"
					FontFamily="{StaticResource Mono}"
					FontSize="12"
					Foreground="{DynamicResource Kcv.Foreground}"
					HorizontalScrollBarVisibility="Auto"
					IsReadOnly="True"
					Text="{Binding Model.RawText, Mode=OneWay}"
					TextWrapping="NoWrap"
					VerticalScrollBarVisibility="Auto"
					>
					<!--  the raw text stands on the panel as in the mockup: no box, no accent border when focused  -->
					<TextBox.Resources>
						<SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
						<SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
						<SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
						<SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
					</TextBox.Resources>
				</TextBox>
			</TabItem>

			<TabItem Header="Config">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<CheckBox
						Grid.Row="0"
						Grid.Column="0"
						Content="{Binding Translation.AutoUpdate}"
						IsChecked="{Binding Model.AutoUpdate}"
						/>
					<TextBlock
						Grid.Row="0"
						Grid.RowSpan="2"
						Grid.Column="1"
						FontSize="11"
						Foreground="{DynamicResource Kcv.SubForeground}"
						Text="{Binding Translation.label2}"
						TextAlignment="Right"
						/>
					<CheckBox
						Grid.Row="1"
						Grid.Column="0"
						Content="{Binding Translation.UpdatesTree}"
						IsChecked="{Binding Model.UpdatesTree}"
						/>
					<DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0 8 0 0">
						<TextBlock
							Margin="0 0 6 0"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Text="{Binding Translation.label1}"
							/>
						<TextBox
							x:Name="FilterBox"
							FontFamily="{StaticResource Mono}"
							LostKeyboardFocus="OnFilterLostFocus"
							Text="{Binding Model.Filter, UpdateSourceTrigger=PropertyChanged}"
							>
							<TextBox.Style>
								<Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
									<Style.Triggers>
										<!--  an invalid pattern, as the viewer's MistyRose box  -->
										<DataTrigger Binding="{Binding Model.FilterInvalid}" Value="True">
											<Setter Property="Background" Value="{DynamicResource Kcv.BlockedRow}" />
											<Setter Property="BorderBrush" Value="{DynamicResource Kcv.BlockedBar}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBox.Style>
						</TextBox>
					</DockPanel>
					<TextBlock
						Grid.Row="4"
						Grid.ColumnSpan="2"
						FontSize="11"
						Foreground="{DynamicResource Kcv.SubForeground}"
						Text="{Binding Translation.label3}"
						/>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>

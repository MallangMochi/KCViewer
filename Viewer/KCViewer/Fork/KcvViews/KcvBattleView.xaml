<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvBattleView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:battle="clr-namespace:KCViewer.Window.Wpf.Battle"
	xmlns:battleViewModels="clr-namespace:KCViewer.Window.Wpf.Battle.ViewModels"
	xmlns:core="clr-namespace:KCViewer.Core.Types;assembly=KCViewer.Core"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance Type=battle:BattleViewModel}"
	d:DesignHeight="360"
	d:DesignWidth="560"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the battle panel drawn as KanColleViewer's BattleInfo (the user's reference, 2026-10-01): 戦闘情報 with
		the time, the battle and the engagement; the viewer's own information table (search, air battle, anti-air,
		damage rates and predicted rank); then the friendly fleet in the left half and the enemy in the right half,
		each ship with its name and type, HP: now/max and a gauge. A combined fleet takes two columns in its half:
		friendly 1st, friendly 2nd | enemy 2nd, enemy 1st. The viewer's own view model (BattleViewModel) fills it; its
		tooltips, context menu and MVP, escaped and sunk colours stay.
	-->
	<UserControl.Resources>
		<!--
			One ship: name (with MVP or 退避 on the right) and type, HP: now/max and the gauge. The viewer's row colours
			become a mark (MVP, escaped) or dimmed text (sunk, escaped); only the boss-damaged colour stays.
		-->
		<DataTemplate x:Key="ShipRow" DataType="{x:Type battleViewModels:HealthBarViewModel}">
			<Border
				x:Name="Row"
				Padding="0 4 0 5"
				Background="Transparent"
				BorderBrush="{DynamicResource Kcv.Separator}"
				BorderThickness="0 0 0 1"
				ToolTip="{Binding ToolTip}"
				Visibility="{Binding Visibility}"
				>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<DockPanel>
							<!--  A badge like KanColleViewer's 成功 in the arsenal tab  -->
							<Border
								x:Name="MarkBox"
								Margin="6 0 0 0"
								Padding="4 0"
								VerticalAlignment="Center"
								Background="{DynamicResource Kcv.Accent}"
								DockPanel.Dock="Right"
								Visibility="Collapsed"
								>
								<TextBlock
									x:Name="Mark"
									FontSize="10"
									Foreground="White"
									/>
							</Border>
							<TextBlock
								x:Name="Name"
								FontSize="15"
								Foreground="{DynamicResource Kcv.Foreground}"
								Text="{Binding ShipName}"
								TextTrimming="CharacterEllipsis"
								/>
						</DockPanel>
						<TextBlock
							FontSize="10"
							Foreground="{DynamicResource Kcv.SubForeground}"
							Text="{Binding ShipTypeName}"
							TextTrimming="CharacterEllipsis"
							/>
					</StackPanel>

					<StackPanel
						Grid.Column="1"
						Margin="8 0 0 0"
						VerticalAlignment="Center"
						>
						<TextBlock HorizontalAlignment="Right">
							<Run
								x:Name="HpLabel"
								FontSize="11"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Text="HP:"
								/>
							<Run
								x:Name="Hp"
								FontSize="15"
								Foreground="{DynamicResource Kcv.Foreground}"
								Text="{Binding Value, Mode=OneWay}"
								/>
							<Run
								FontSize="11"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Text="/"
								/>
							<Run
								FontSize="11"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Text="{Binding MaximumValue, Mode=OneWay}"
								/>
						</TextBlock>
						<!--
							The gauge with the HP lost in this battle (mockup 20261013-battle-hp-damage-v5): the part
							lost in light grey behind the gauge, and the number of it in the middle, over the gauge,
							which keeps its size
						-->
						<Grid
							x:Name="Gauge"
							Width="80"
							Margin="0 2 0 0"
							HorizontalAlignment="Right"
							>
							<ProgressBar
								Foreground="{DynamicResource Kcv.GaugeLost}"
								Maximum="{Binding MaximumValue}"
								Style="{StaticResource Kcv.Gauge}"
								Value="{Binding PrevValue, Mode=OneWay}"
								/>
							<ProgressBar
								Background="Transparent"
								Maximum="{Binding MaximumValue}"
								Style="{StaticResource Kcv.Gauge}"
								Value="{Binding Value, Mode=OneWay}"
								>
								<ProgressBar.Foreground>
									<MultiBinding Converter="{StaticResource Kcv.GaugeBrush}">
										<Binding Path="Value" />
										<Binding Path="MaximumValue" />
									</MultiBinding>
								</ProgressBar.Foreground>
							</ProgressBar>
							<kcv:KcvOutlinedText
								Fill="{DynamicResource Kcv.GaugeDamageText}"
								FontFamily="{DynamicResource Kcv.FontFamily}"
								FontSize="10"
								Outline="{DynamicResource Kcv.GaugeDamageOutline}"
								Text="{Binding ForkDamageText}"
								/>
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
			<DataTemplate.Triggers>
				<DataTrigger Value="MVP">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Kcv.BattleState}">
							<Binding Path="BackColor" />
							<Binding Path="Value" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter TargetName="MarkBox" Property="Visibility" Value="Visible" />
					<Setter TargetName="Mark" Property="Text" Value="MVP" />
				</DataTrigger>
				<DataTrigger Value="Escaped">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Kcv.BattleState}">
							<Binding Path="BackColor" />
							<Binding Path="Value" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter TargetName="MarkBox" Property="Visibility" Value="Visible" />
					<Setter TargetName="MarkBox" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
					<Setter TargetName="Mark" Property="Text" Value="{x:Static fork:ForkStrings.KcvEscaped}" />
					<Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
					<Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
					<Setter TargetName="Hp" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
				</DataTrigger>
				<DataTrigger Value="Sunk">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Kcv.BattleState}">
							<Binding Path="BackColor" />
							<Binding Path="Value" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
					<Setter TargetName="Hp" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
				</DataTrigger>
				<!--  The boss's armour broken by a gimmick: the viewer's colour, as nothing else shows it  -->
				<DataTrigger Value="Boss">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Kcv.BattleState}">
							<Binding Path="BackColor" />
							<Binding Path="Value" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter TargetName="Row" Property="Background" Value="{Binding BackgroundColor}" />
					<Setter TargetName="Name" Property="Foreground" Value="{Binding MainFontBrush}" />
					<Setter TargetName="Hp" Property="Foreground" Value="{Binding MainFontBrush}" />
				</DataTrigger>
				<!--
					Two columns in a half (the list's Tag says so): smaller text and gauge, no "HP:", so the names keep
					some room
				-->
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
					<Setter TargetName="Name" Property="FontSize" Value="13" />
					<Setter TargetName="HpLabel" Property="Text" Value="" />
					<Setter TargetName="Hp" Property="FontSize" Value="13" />
					<Setter TargetName="Gauge" Property="Width" Value="56" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!--  Fleet name and formation above a column: 第一艦隊 単縦陣  -->
		<Style x:Key="FleetName" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0 0 10 0" />
		</Style>
		<Style x:Key="Formation" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
		</Style>
		<!--  The information table: the friendly value right-aligned, the centre item, the enemy value left-aligned  -->
		<Style x:Key="InfoText" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style x:Key="InfoIcon" BasedOn="{StaticResource Kcv.EquipmentIcon}" TargetType="Image">
			<Setter Property="Height" Value="16" />
			<Setter Property="Margin" Value="0 0 3 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style x:Key="InfoLine" TargetType="Border">
			<Setter Property="Grid.ColumnSpan" Value="3" />
			<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
		</Style>
		<Style x:Key="FriendCell" TargetType="StackPanel">
			<Setter Property="Grid.Column" Value="0" />
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="Margin" Value="0 3 14 3" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style x:Key="CentreCell" TargetType="StackPanel">
			<Setter Property="Grid.Column" Value="1" />
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0 3" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style x:Key="EnemyCell" TargetType="StackPanel">
			<Setter Property="Grid.Column" Value="2" />
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="Margin" Value="14 3 0 3" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Resources>

	<Border Background="Transparent">
		<Border.ContextMenu>
			<ContextMenu>
				<MenuItem Command="{Binding ShowBattleDetailCommand}" Header="{Binding FormBattle.RightClickMenu_ShowBattleDetail}" />
				<Separator />
				<MenuItem Command="{Binding ShowBattleResultCommand}" Header="{Binding FormBattle.RightClickMenu_ShowBattleResult}" />
				<Separator />
				<!--  the dropped ship's box; the same value as the log setting 드랍 보고 표시 (mockup 20261006-battle-drop-v2)  -->
				<MenuItem
					Header="{x:Static fork:ForkStrings.KcvShowDrop}"
					IsCheckable="True"
					IsChecked="{Binding ForkShowDrop}"
					/>
			</ContextMenu>
		</Border.ContextMenu>

		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="12 8 12 8">
				<!--  戦闘情報  2015/08/22 13:16:02 / 演習昼戦  反航戦, and on the right the dropped ship  -->
				<DockPanel>
					<!--
						드랍 and the dropped ship's name (mockup 20261006-battle-drop-v2): one not owned in the orange badge
						of the quest panel's 수행 중, 「없음」 faint, 「스포일러」 with the name in the tooltip. Shown from
						the battle result until the next battle, not for exercises (BattleViewModel.Fork.cs).
					-->
					<StackPanel
						Margin="12 0 0 0"
						VerticalAlignment="Top"
						DockPanel.Dock="Right"
						Orientation="Horizontal"
						Visibility="{Binding ForkDropVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
						>
						<TextBlock
							Margin="0 0 12 0"
							VerticalAlignment="Center"
							FontSize="13"
							Style="{StaticResource Kcv.SubText}"
							Text="{x:Static fork:ForkStrings.KcvDrop}"
							/>
						<Border VerticalAlignment="Center">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="Transparent" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding ForkDropState}" Value="NewShip">
											<Setter Property="Background" Value="{DynamicResource Kcv.InProgressBadgeBackground}" />
											<Setter Property="Padding" Value="6 0" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<TextBlock
								FontSize="13"
								Text="{Binding ForkDropText}"
								ToolTip="{Binding ForkDropToolTip}"
								>
								<TextBlock.Style>
									<Style BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
										<Style.Triggers>
											<DataTrigger Binding="{Binding ForkDropState}" Value="NewShip">
												<Setter Property="Foreground" Value="{DynamicResource Kcv.InProgressBadgeForeground}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding ForkDropState}" Value="None">
												<Setter Property="Foreground" Value="{DynamicResource Kcv.FaintForeground}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Border>
					</StackPanel>

					<StackPanel Orientation="Horizontal">
						<TextBlock
							Margin="0 0 18 0"
							FontSize="13"
							Style="{StaticResource Kcv.SubText}"
							Text="{x:Static fork:ForkStrings.KcvBattleInfo}"
							/>
						<StackPanel Visibility="{Binding ViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock
								FontSize="13"
								Style="{StaticResource Kcv.Text}"
								Text="{Binding ForkBattleTime}"
								/>
							<TextBlock
								FontSize="13"
								Style="{StaticResource Kcv.Text}"
								TextWrapping="Wrap"
								>
								<Run Text="{Binding ForkBattleName, Mode=OneWay}" />
								<Run Text="  " />
								<Run Text="{Binding FormationText, Mode=OneWay}">
									<Run.Foreground>
										<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
											<Binding Mode="OneWay" Path="FormationForeColor" />
											<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
										</MultiBinding>
									</Run.Foreground>
								</Run>
							</TextBlock>
						</StackPanel>
					</StackPanel>
				</DockPanel>

				<!--
					The viewer's battle information, as its own panel has it: friendly on the left, the item in the
					centre of the panel, enemy on the right. Search (or land-based air attack), air battle stage 1 with
					the air state, stage 2 with the anti-air fire or cut-in, damage rates with the predicted rank.
				-->
				<Grid Margin="0 8 0 0" Visibility="{Binding ViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" MinWidth="110" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0" Style="{StaticResource InfoLine}" />
					<Border Grid.Row="1" Style="{StaticResource InfoLine}" />
					<Border Grid.Row="2" Style="{StaticResource InfoLine}" />
					<Border Grid.Row="3" Style="{StaticResource InfoLine}" />

					<!--  Search  -->
					<StackPanel
						Grid.Row="0"
						Style="{StaticResource FriendCell}"
						ToolTip="{Binding SearchingFriendToolTip}"
						>
						<Image Source="{Binding SearchingFriendIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding SearchingFriendText}" />
						<Image
							Margin="3 0 0 0"
							Source="{Binding Source={x:Static core:EquipmentIconType.SmokeGenerator}, Converter={StaticResource Kcv.GameIcon}}"
							Style="{StaticResource InfoIcon}"
							Visibility="{Binding Smoker1Active, Converter={StaticResource BooleanToVisibilityConverter}}"
							/>
						<Image
							Source="{Binding Source={x:Static core:EquipmentIconType.SmokeGenerator}, Converter={StaticResource Kcv.GameIcon}}"
							Style="{StaticResource InfoIcon}"
							Visibility="{Binding Smoker2Active, Converter={StaticResource BooleanToVisibilityConverter}}"
							/>
						<Image
							Source="{Binding Source={x:Static core:EquipmentIconType.SmokeGenerator}, Converter={StaticResource Kcv.GameIcon}}"
							Style="{StaticResource InfoIcon}"
							Visibility="{Binding Smoker3Active, Converter={StaticResource BooleanToVisibilityConverter}}"
							/>
					</StackPanel>
					<StackPanel
						Grid.Row="0"
						Style="{StaticResource CentreCell}"
						ToolTip="{Binding SearchingToolTip}"
						>
						<Image Source="{Binding SearchingIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock
							Foreground="{DynamicResource Kcv.SubForeground}"
							Style="{StaticResource InfoText}"
							Text="{Binding SearchingText}"
							/>
					</StackPanel>
					<StackPanel
						Grid.Row="0"
						Style="{StaticResource EnemyCell}"
						ToolTip="{Binding SearchingEnemyToolTip}"
						>
						<Image Source="{Binding SearchingEnemyIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding SearchingEnemyText}" />
					</StackPanel>

					<!--  Air battle stage 1: planes lost, the air state  -->
					<StackPanel
						Grid.Row="1"
						Style="{StaticResource FriendCell}"
						ToolTip="{Binding AirStage1FriendToolTip}"
						>
						<Image Source="{Binding AirStage1FriendIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding AirStage1FriendText}">
							<TextBlock.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
									<Binding Path="AirStage1FriendForeColor" />
									<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
								</MultiBinding>
							</TextBlock.Foreground>
						</TextBlock>
					</StackPanel>
					<StackPanel
						Grid.Row="1"
						Style="{StaticResource CentreCell}"
						ToolTip="{Binding AirSuperiorityToolTip}"
						>
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding AirSuperiorityText}">
							<TextBlock.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
									<Binding Path="AirSuperiorityForeColor" />
									<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
								</MultiBinding>
							</TextBlock.Foreground>
						</TextBlock>
					</StackPanel>
					<StackPanel
						Grid.Row="1"
						Style="{StaticResource EnemyCell}"
						ToolTip="{Binding AirStage1EnemyToolTip}"
						>
						<Image Source="{Binding AirStage1EnemyIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding AirStage1EnemyText}">
							<TextBlock.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
									<Binding Path="AirStage1EnemyForeColor" />
									<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
								</MultiBinding>
							</TextBlock.Foreground>
						</TextBlock>
					</StackPanel>

					<!--  Air battle stage 2: planes shot down by anti-air fire, the anti-air cut-in  -->
					<StackPanel
						Grid.Row="2"
						Style="{StaticResource FriendCell}"
						ToolTip="{Binding AirStage2FriendToolTip}"
						>
						<Image Source="{Binding AirStage2FriendIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding AirStage2FriendText}">
							<TextBlock.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
									<Binding Path="AirStage2FriendForeColor" />
									<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
								</MultiBinding>
							</TextBlock.Foreground>
						</TextBlock>
					</StackPanel>
					<StackPanel
						Grid.Row="2"
						Style="{StaticResource CentreCell}"
						ToolTip="{Binding AACutinToolTip}"
						>
						<Image Source="{Binding AACutinIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding AACutinText}" />
					</StackPanel>
					<StackPanel
						Grid.Row="2"
						Style="{StaticResource EnemyCell}"
						ToolTip="{Binding AirStage2EnemyToolTip}"
						>
						<Image Source="{Binding AirStage2EnemyIcon, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource InfoIcon}" />
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding AirStage2EnemyText}">
							<TextBlock.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
									<Binding Path="AirStage2EnemyForeColor" />
									<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
								</MultiBinding>
							</TextBlock.Foreground>
						</TextBlock>
					</StackPanel>

					<!--  Damage rates and the predicted rank  -->
					<StackPanel Grid.Row="3" Style="{StaticResource FriendCell}">
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding DamageFriendText}" />
					</StackPanel>
					<StackPanel Grid.Row="3" Style="{StaticResource CentreCell}">
						<!--
							The predicted rank in the user's colours (2026-10-13 "SS,S 금색 A 적색 B 주황 C 노랑 D 초록 E
							하늘색"); an air raid's result keeps the viewer's colour
						-->
						<TextBlock
							FontSize="16"
							FontWeight="SemiBold"
							Text="{Binding WinRankText}"
							>
							<TextBlock.Style>
								<Style BasedOn="{StaticResource InfoText}" TargetType="TextBlock">
									<Setter Property="Foreground">
										<Setter.Value>
											<MultiBinding Converter="{StaticResource Kcv.ViewerBrush}">
												<Binding Path="WinRankForeColor" />
												<Binding Path="Dark" Source="{x:Static kcv:KcvViewState.Current}" />
											</MultiBinding>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding WinRankText}" Value="SS">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankS}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding WinRankText}" Value="S">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankS}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding WinRankText}" Value="A">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankA}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding WinRankText}" Value="B">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankB}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding WinRankText}" Value="C">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankC}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding WinRankText}" Value="D">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankD}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding WinRankText}" Value="E">
											<Setter Property="Foreground" Value="{DynamicResource Kcv.RankE}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
					<StackPanel Grid.Row="3" Style="{StaticResource EnemyCell}">
						<TextBlock Style="{StaticResource InfoText}" Text="{Binding DamageEnemyText}" />
					</StackPanel>
				</Grid>

				<!--
					The fleets: the friendly half left of the centre line, the enemy half right of it (user decision), so
					the two stay apart whatever the fleets. A combined fleet takes two columns in its half: friendly 1st,
					friendly 2nd | enemy 2nd, enemy 1st. Collapsed columns take no share of a UniformGrid.
				-->
				<Grid Margin="0 12 0 0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<UniformGrid Grid.Column="0" Rows="1">
						<StackPanel Margin="0 0 6 0" Visibility="{Binding PlayerFleetVisible, Converter={StaticResource BooleanToHiddenConverter}}">
							<StackPanel
								Margin="0 0 0 4"
								Background="Transparent"
								Orientation="Horizontal"
								ToolTip="{Binding FleetFriendToolTip}"
								>
								<TextBlock>
									<TextBlock.Style>
										<Style BasedOn="{StaticResource FleetName}" TargetType="TextBlock">
											<Setter Property="Text" Value="{Binding FleetFriendText}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding ForkFriendCombined}" Value="True">
													<Setter Property="Text" Value="{x:Static fork:ForkStrings.KcvFriendFleet1}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<TextBlock Style="{StaticResource Formation}" Text="{Binding FormationFriendText}" />
							</StackPanel>
							<ItemsControl
								ItemTemplate="{StaticResource ShipRow}"
								ItemsSource="{Binding ForkFriendMainBars}"
								Tag="{Binding ForkFriendCombined}"
								/>
						</StackPanel>

						<StackPanel Margin="6 0 6 0" Visibility="{Binding ForkFriendCombined, Converter={StaticResource BooleanToVisibilityConverter}}">
							<StackPanel Visibility="{Binding PlayerFleetVisible, Converter={StaticResource BooleanToHiddenConverter}}">
								<TextBlock
									Margin="0 0 0 4"
									Style="{StaticResource FleetName}"
									Text="{x:Static fork:ForkStrings.KcvFriendFleet2}"
									/>
								<ItemsControl
									ItemTemplate="{StaticResource ShipRow}"
									ItemsSource="{Binding ForkFriendEscortBars}"
									Tag="{Binding ForkFriendCombined}"
									/>
							</StackPanel>
						</StackPanel>
					</UniformGrid>

					<!--  The centre line between the friendly and the enemy half  -->
					<Rectangle
						Grid.Column="1"
						Width="1"
						Margin="7 0"
						Fill="{DynamicResource Kcv.Separator}"
						/>

					<UniformGrid Grid.Column="2" Rows="1">
						<StackPanel Margin="6 0 6 0" Visibility="{Binding ForkEnemyCombined, Converter={StaticResource BooleanToVisibilityConverter}}">
							<StackPanel Visibility="{Binding ViewVisible, Converter={StaticResource BooleanToHiddenConverter}}">
								<TextBlock
									Margin="0 0 0 4"
									Style="{StaticResource FleetName}"
									Text="{x:Static fork:ForkStrings.KcvEnemyFleet2}"
									/>
								<ItemsControl
									ItemTemplate="{StaticResource ShipRow}"
									ItemsSource="{Binding ForkEnemyEscortBars}"
									Tag="{Binding ForkEnemyCombined}"
									/>
							</StackPanel>
						</StackPanel>

						<StackPanel Margin="6 0 0 0" Visibility="{Binding ViewVisible, Converter={StaticResource BooleanToHiddenConverter}}">
							<StackPanel Margin="0 0 0 4" Orientation="Horizontal">
								<TextBlock>
									<TextBlock.Style>
										<Style BasedOn="{StaticResource FleetName}" TargetType="TextBlock">
											<Setter Property="Text" Value="{Binding FormBattle.FleetEnemy}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding ForkEnemyCombined}" Value="True">
													<Setter Property="Text" Value="{x:Static fork:ForkStrings.KcvEnemyFleet1}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<TextBlock Style="{StaticResource Formation}" Text="{Binding FormationEnemyText}" />
							</StackPanel>
							<ItemsControl
								ItemTemplate="{StaticResource ShipRow}"
								ItemsSource="{Binding ForkEnemyMainBars}"
								Tag="{Binding ForkEnemyCombined}"
								/>
						</StackPanel>
					</UniformGrid>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Border>
</UserControl>

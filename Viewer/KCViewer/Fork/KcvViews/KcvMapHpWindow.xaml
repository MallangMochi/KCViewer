<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvMapHpWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding Title}"
	Width="540"
	Height="620"
	d:DataContext="{d:DesignInstance kcv:KcvMapHpViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="kcv:KcvMapHpViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: KanColleViewer's MapHP (the user's reference of 攻略中マップ, mockup 3). A header, one row per map (number
		with the difficulty and the gauge number, area and map name, what is left over a gauge), then the fleet's
		transport points and when the list is updated. No remaining count (user's choice).
	-->
	<Window.Resources>
		<Style x:Key="Line" TargetType="Border">
			<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
		</Style>
		<Style x:Key="Name" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 8 12 6"
			DockPanel.Dock="Top"
			Style="{StaticResource Line}"
			>
			<TextBlock FontSize="13" Text="{Binding Header}" />
		</Border>

		<StackPanel DockPanel.Dock="Bottom">
			<!--  a line above too, as the list may end well above it  -->
			<Border
				Padding="12 6"
				BorderThickness="0 1 0 1"
				Style="{StaticResource Line}"
				>
				<TextBlock VerticalAlignment="Center" FontSize="12"><Run Text="{Binding TransportLabel, Mode=OneWay}" /><Run Text="   S: " /><Run FontSize="15" Text="{Binding TransportS, Mode=OneWay}" /><Run Text="   A: " /><Run FontSize="15" Text="{Binding TransportA, Mode=OneWay}" /></TextBlock>
			</Border>
			<TextBlock
				Margin="12 7 12 9"
				FontSize="11"
				Foreground="{DynamicResource Kcv.SubForeground}"
				Text="{Binding Note}"
				TextWrapping="Wrap"
				/>
		</StackPanel>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Rows}">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type kcv:KcvMapHpRow}">
						<Border Padding="12 6" Style="{StaticResource Line}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="88" />
									<ColumnDefinition Width="168" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<!--  1-6 #1, 60-1 갑 #1  -->
								<TextBlock VerticalAlignment="Center"><Run FontSize="18" Text="{Binding Number, Mode=OneWay}" /><Run FontSize="12" Text="{Binding DifficultyText, Mode=OneWay}" /><Run
										FontSize="11"
										Foreground="{DynamicResource Kcv.InactiveForeground}"
										Text="{Binding GaugeText, Mode=OneWay}"
										/></TextBlock>

								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Style="{StaticResource Name}" Text="{Binding AreaName}" />
									<TextBlock Style="{StaticResource Name}" Text="{Binding MapName}" />
								</StackPanel>

								<!--  6 / 7 over the gauge  -->
								<StackPanel
									Grid.Column="2"
									Margin="8 0 0 0"
									VerticalAlignment="Center"
									>
									<TextBlock HorizontalAlignment="Center"><Run FontSize="15" Text="{Binding Current, Mode=OneWay}" /><Run
											FontSize="11"
											Foreground="{DynamicResource Kcv.SubForeground}"
											Text="{Binding MaxText, Mode=OneWay}"
											/></TextBlock>
									<ProgressBar
										Height="9"
										Margin="0 2 0 0"
										Background="{DynamicResource Kcv.MapGaugeBackground}"
										Foreground="{Binding Bar}"
										Maximum="{Binding Max}"
										Style="{StaticResource Kcv.Gauge}"
										Value="{Binding Current, Mode=OneWay}"
										/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>
</common:WindowBase>

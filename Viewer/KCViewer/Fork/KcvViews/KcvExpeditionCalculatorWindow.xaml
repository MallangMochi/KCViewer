<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvExpeditionCalculatorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:calculator="clr-namespace:KCViewer.Avalonia.ExpeditionCalculator;assembly=KCViewer.Avalonia"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:core="clr-namespace:KCViewer.Core.Types;assembly=KCViewer.Core"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static calculator:ExpeditionCalculatorResources.Title}"
	Width="1000"
	Height="680"
	d:DataContext="{d:DesignInstance calculator:ExpeditionCalculatorViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="calculator:ExpeditionCalculatorViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: 원정 계산기 in KanColleViewer's style (mockup 20261006-expedition-calculator-v2, approved 2026-10-06 "1번
		수정 반영해서 구현") with the viewer's view model, instead of its Avalonia window, which the style does not reach.
		The box 「계산 조건」: 월간 (three states as the viewer's: unchecked without the monthly expeditions, checked only
		them, the third both) / the fleet: 전원 반짝임 · 반짝임 함선 수 · 드럼통 개수 · 기함 레벨 / 점수 가중치 with the
		resource icons. The table: 점수 · ID · 원정 이름 (from the viewer's expedition data) · 원정 시간 · resources (icons
		in the headers, 0 grey) · 아이템1·2 (icon, name, ×n) · 대성공; a header sorts.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<kcv:KcvMissionNameConverter x:Key="MissionName" />
			<kcv:KcvUseItemIconConverter x:Key="UseItemIcon" />
			<kcv:KcvUseItemNameConverter x:Key="UseItemName" />

			<!--  the record windows' header without their column menu (this table has no column settings)  -->
			<Style
				x:Key="Header"
				BasedOn="{StaticResource KcvRec.Header}"
				TargetType="DataGridColumnHeader"
				>
				<Setter Property="ContextMenu" Value="{x:Null}" />
			</Style>

			<Style x:Key="Icon" TargetType="Image">
				<Setter Property="Width" Value="16" />
				<Setter Property="Height" Value="16" />
				<Setter Property="Margin" Value="0 0 4 0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
			</Style>

			<!--  a weight: the resource's icon and name, then its number box  -->
			<DataTemplate x:Key="WeightLabel">
				<StackPanel Margin="12 0 5 0" Orientation="Horizontal">
					<Image Source="{Binding Converter={StaticResource UseItemIcon}}" Style="{StaticResource Icon}" />
					<TextBlock
						VerticalAlignment="Center"
						FontSize="13"
						Foreground="{DynamicResource Kcv.SubForeground}"
						Text="{Binding Converter={StaticResource UseItemName}}"
						/>
				</StackPanel>
			</DataTemplate>

			<!--  a resource header: its icon and name  -->
			<DataTemplate x:Key="ResourceHeader">
				<StackPanel Orientation="Horizontal">
					<Image Source="{Binding Converter={StaticResource UseItemIcon}}" Style="{StaticResource Icon}" />
					<TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource UseItemName}}" />
				</StackPanel>
			</DataTemplate>

			<!--  a resource amount, 0 grey  -->
			<Style
				x:Key="Amount"
				BasedOn="{StaticResource KcvRec.Text}"
				TargetType="TextBlock"
				>
				<Style.Triggers>
					<Trigger Property="Text" Value="0">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
					</Trigger>
				</Style.Triggers>
			</Style>

			<!--  a reward: its icon, its name and a grey 「×1」  -->
			<DataTemplate x:Key="Reward" DataType="{x:Type calculator:ExpeditionReward}">
				<StackPanel Margin="6 0" Orientation="Horizontal">
					<Image
						Width="18"
						Height="18"
						Margin="0 0 4 0"
						VerticalAlignment="Center"
						RenderOptions.BitmapScalingMode="HighQuality"
						Source="{Binding Type, Converter={StaticResource UseItemIcon}}"
						/>
					<TextBlock
						VerticalAlignment="Center"
						FontSize="13"
						Text="{Binding Type, Converter={StaticResource UseItemName}}"
						/>
					<TextBlock
						Margin="3 0 0 0"
						Style="{StaticResource KcvRec.Sub}"
						Text="{Binding Amount, StringFormat={}×{0}}"
						/>
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!--  계산 조건: 월간 / the fleet / 점수 가중치  -->
		<ContentControl
			Grid.Row="0"
			Style="{StaticResource KcvRec.Box}"
			Tag="{x:Static fork:ForkStrings.KcvCalcConditions}"
			>
			<StackPanel>
				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<CheckBox
						Content="{x:Static calculator:ExpeditionCalculatorResources.Monthly}"
						IsChecked="{Binding ShowMonthlyExpeditions}"
						IsThreeState="True"
						Style="{StaticResource KcvRec.Check}"
						/>
				</WrapPanel>

				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<CheckBox
						Content="{x:Static calculator:ExpeditionCalculatorResources.AllSparkled}"
						IsChecked="{Binding FleetInfo.AllSparkled}"
						Style="{StaticResource KcvRec.Check}"
						/>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static calculator:ExpeditionCalculatorResources.SparkleCount}" />
						<kcv:KcvNumberBox
							Width="52"
							Maximum="6"
							Minimum="0"
							Value="{Binding FleetInfo.SparkleCount}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static calculator:ExpeditionCalculatorResources.DrumCount}" />
						<kcv:KcvNumberBox
							Width="52"
							Minimum="0"
							Value="{Binding FleetInfo.DrumCount}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{x:Static calculator:ExpeditionCalculatorResources.FlagshipLevel}" />
						<kcv:KcvNumberBox
							Width="56"
							Minimum="1"
							Value="{Binding FleetInfo.FlagshipLevel}"
							/>
					</StackPanel>
				</WrapPanel>

				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<TextBlock Style="{StaticResource KcvRec.FirstLabel}" Text="{x:Static fork:ForkStrings.KcvScoreWeights}" />
					<StackPanel Orientation="Horizontal">
						<ContentPresenter Content="{x:Static core:UseItemId.Fuel}" ContentTemplate="{StaticResource WeightLabel}" />
						<kcv:KcvNumberBox
							Width="52"
							Minimum="0"
							Value="{Binding ExpeditionScoreWeights.Fuel}"
							/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<ContentPresenter Content="{x:Static core:UseItemId.Ammo}" ContentTemplate="{StaticResource WeightLabel}" />
						<kcv:KcvNumberBox
							Width="52"
							Minimum="0"
							Value="{Binding ExpeditionScoreWeights.Ammo}"
							/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<ContentPresenter Content="{x:Static core:UseItemId.Steel}" ContentTemplate="{StaticResource WeightLabel}" />
						<kcv:KcvNumberBox
							Width="52"
							Minimum="0"
							Value="{Binding ExpeditionScoreWeights.Steel}"
							/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<ContentPresenter Content="{x:Static core:UseItemId.Bauxite}" ContentTemplate="{StaticResource WeightLabel}" />
						<kcv:KcvNumberBox
							Width="52"
							Minimum="0"
							Value="{Binding ExpeditionScoreWeights.Bauxite}"
							/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<ContentPresenter Content="{x:Static core:UseItemId.InstantRepair}" ContentTemplate="{StaticResource WeightLabel}" />
						<kcv:KcvNumberBox
							Width="60"
							Minimum="0"
							Value="{Binding ExpeditionScoreWeights.InstantRepair}"
							/>
					</StackPanel>
				</WrapPanel>
			</StackPanel>
		</ContentControl>

		<DataGrid
			Grid.Row="1"
			ColumnHeaderStyle="{StaticResource Header}"
			ItemsSource="{Binding Expeditions}"
			Style="{StaticResource KcvRec.Grid}"
			>
			<DataGrid.Columns>
				<DataGridTemplateColumn
					Width="54"
					MinWidth="54"
					Header="{x:Static calculator:ExpeditionCalculatorResources.Score}"
					SortMemberPath="Score"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding Score}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="40"
					MinWidth="40"
					Header="ID"
					SortMemberPath="DisplayId"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding DisplayId}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="170"
					MinWidth="170"
					Header="{x:Static fork:ForkStrings.KcvExpeditionName}"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding DisplayId, Converter={StaticResource MissionName}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="70"
					MinWidth="70"
					Header="{x:Static calculator:ExpeditionCalculatorResources.Duration}"
					SortMemberPath="Duration"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding Duration, StringFormat={}{0:hh\\:mm}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="64"
					MinWidth="64"
					Header="{x:Static core:UseItemId.Fuel}"
					HeaderTemplate="{StaticResource ResourceHeader}"
					SortMemberPath="Fuel"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource Amount}" Text="{Binding Fuel}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="64"
					MinWidth="64"
					Header="{x:Static core:UseItemId.Ammo}"
					HeaderTemplate="{StaticResource ResourceHeader}"
					SortMemberPath="Ammo"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource Amount}" Text="{Binding Ammo}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="64"
					MinWidth="64"
					Header="{x:Static core:UseItemId.Steel}"
					HeaderTemplate="{StaticResource ResourceHeader}"
					SortMemberPath="Steel"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource Amount}" Text="{Binding Steel}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="90"
					MinWidth="90"
					Header="{x:Static core:UseItemId.Bauxite}"
					HeaderTemplate="{StaticResource ResourceHeader}"
					SortMemberPath="Bauxite"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock Style="{StaticResource Amount}" Text="{Binding Bauxite}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="140"
					MinWidth="140"
					Header="{x:Static calculator:ExpeditionCalculatorResources.Item1}"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<ContentPresenter VerticalAlignment="Center" Content="{Binding Item1}" ContentTemplate="{StaticResource Reward}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="140"
					MinWidth="140"
					Header="{x:Static calculator:ExpeditionCalculatorResources.Item2}"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<ContentPresenter VerticalAlignment="Center" Content="{Binding Item2}" ContentTemplate="{StaticResource Reward}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="*"
					MinWidth="76"
					Header="{x:Static calculator:ExpeditionCalculatorResources.GreatSuccess}"
					SortMemberPath="GreatSuccessRate"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type calculator:ExpeditionViewModel}">
							<TextBlock x:Name="Rate" Style="{StaticResource KcvRec.Text}" Text="{Binding GreatSuccessRate, StringFormat={}{0:p2}}" />
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding GreatSuccessRate}" Value="0">
									<Setter TargetName="Rate" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</common:WindowBase>

<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	>
	<!--
		Fork: what the ship and equipment albums in KanColleViewer's style share (KcvAlbumShipWindow,
		KcvAlbumEquipmentWindow, mockup viewer-design/mockups/20261005-album-v5.html, VIEWER-PLAN.md "도감 묶음"): the
		record windows' table, inputs and status bar, and the album's cards, the search box and the folding conditions.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<kcv:KcvRarityConverter x:Key="KcvAlbum.Rarity" />
	<kcv:KcvUpgradeRangeConverter x:Key="KcvAlbum.UpgradeRange" />
	<kcv:KcvNotNullVisibilityConverter x:Key="KcvAlbum.NotNull" />

	<!--
		The album's table rows: the record windows' rows, but the chosen row in the accent colour (mockup v1: the row
		whose details show). One row at a time, chosen by a plain click.
	-->
	<Style x:Key="KcvAlbum.Row" TargetType="DataGridRow">
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridRow">
					<Border
						x:Name="Back"
						Background="Transparent"
						SnapsToDevicePixels="True"
						>
						<DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.Accent}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="KcvAlbum.Grid"
		BasedOn="{StaticResource KcvRec.Grid}"
		TargetType="DataGrid"
		>
		<Setter Property="SelectionMode" Value="Single" />
		<Setter Property="kcv:KcvRecordSelection.Toggle" Value="False" />
		<Setter Property="RowStyle" Value="{StaticResource KcvAlbum.Row}" />
	</Style>

	<!--  A cell's text, white on the chosen row; the grey kind (ID, the ship type) a light accent there  -->
	<Style
		x:Key="KcvAlbum.CellText"
		BasedOn="{StaticResource KcvRec.Text}"
		TargetType="TextBlock"
		>
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
				<Setter Property="Foreground" Value="White" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style
		x:Key="KcvAlbum.CellGrey"
		BasedOn="{StaticResource KcvRec.Text}"
		TargetType="TextBlock"
		>
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
				<Setter Property="Foreground" Value="#E2C8EC" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!--  A card of the details: the status bar's grey with the input border  -->
	<Style x:Key="KcvAlbum.Card" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource Kcv.StatusBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Kcv.ButtonBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="8 5 8 6" />
		<Setter Property="Margin" Value="0 0 0 8" />
	</Style>

	<!--  A card's small grey title, and the hint on its right  -->
	<Style x:Key="KcvAlbum.CardTitle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0 0 0 4" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
	</Style>
	<Style
		x:Key="KcvAlbum.CardHint"
		BasedOn="{StaticResource KcvAlbum.CardTitle}"
		TargetType="TextBlock"
		>
		<Setter Property="HorizontalAlignment" Value="Right" />
	</Style>

	<!--  A label of the details (건조 시간, 해체…) and its value  -->
	<Style x:Key="KcvAlbum.Key" TargetType="TextBlock">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="0 1 10 1" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
	</Style>
	<Style x:Key="KcvAlbum.Value" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="0 1" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
	</Style>
	<Style x:Key="KcvAlbum.Number" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="0 1" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
	</Style>
	<Style x:Key="KcvAlbum.Grey" TargetType="TextBlock">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
	</Style>

	<!--  A ship to go to (개장 전·후, the conversion's equipment): the link colour, underlined under the mouse  -->
	<Style
		x:Key="KcvAlbum.Link"
		BasedOn="{StaticResource KcvAlbum.Value}"
		TargetType="TextBlock"
		>
		<Setter Property="Foreground" Value="{DynamicResource Kcv.Link}" />
		<Setter Property="Cursor" Value="Hand" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="TextDecorations" Value="Underline" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  The round colour of a rarity before its name  -->
	<Style x:Key="KcvAlbum.RarityDot" TargetType="Ellipse">
		<Setter Property="Width" Value="12" />
		<Setter Property="Height" Value="12" />
		<Setter Property="Margin" Value="0 0 5 0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!--  A ship among the upgrade's helpers: a chip, red when none is owned (as the viewer)  -->
	<Style x:Key="KcvAlbum.Chip" TargetType="Border">
		<Setter Property="Margin" Value="0 0 4 3" />
		<Setter Property="Padding" Value="6 0" />
		<Setter Property="CornerRadius" Value="2" />
		<Setter Property="Background" Value="{DynamicResource Kcv.ChipBackground}" />
	</Style>

	<!--  The search box of the ship album: 「검색 조건」 over the conditions, without folding (mockup v1)  -->
	<Style x:Key="KcvAlbum.SearchBox" TargetType="ContentControl">
		<Setter Property="Margin" Value="8 6 8 6" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ContentControl">
					<Border
						Padding="8 3 8 5"
						BorderBrush="{DynamicResource Kcv.HeaderBackground}"
						BorderThickness="1"
						>
						<DockPanel>
							<TextBlock
								DockPanel.Dock="Top"
								FontSize="12"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Text="{x:Static fork:ForkStrings.KcvRecordConditions}"
								/>
							<ContentPresenter Margin="0 3 0 0" />
						</DockPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		The search conditions of the equipment album: the header (the name box) always shows; 「펼치기 ▾」 opens the rest
		(the categories). Folded when the window opens ("기본은 접은 상태로해줘, 장비명 검색창만 보이게", 2026-10-05).
	-->
	<Style x:Key="KcvAlbum.Conditions" TargetType="HeaderedContentControl">
		<Setter Property="Margin" Value="8 6 8 6" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="HeaderedContentControl">
					<Border
						Padding="8 3 8 5"
						BorderBrush="{DynamicResource Kcv.HeaderBackground}"
						BorderThickness="1"
						>
						<DockPanel>
							<Grid DockPanel.Dock="Top">
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource Kcv.SubForeground}"
									Text="{x:Static fork:ForkStrings.KcvRecordConditions}"
									/>
								<ToggleButton
									x:Name="Fold"
									HorizontalAlignment="Right"
									Cursor="Hand"
									Focusable="False"
									IsChecked="False"
									>
									<ToggleButton.Template>
										<ControlTemplate TargetType="ToggleButton">
											<TextBlock
												x:Name="Label"
												Background="Transparent"
												FontSize="11"
												Foreground="{DynamicResource Kcv.InactiveForeground}"
												Text="{x:Static fork:ForkStrings.KcvRecordFold}"
												/>
											<ControlTemplate.Triggers>
												<Trigger Property="IsChecked" Value="False">
													<Setter TargetName="Label" Property="Text" Value="{x:Static fork:ForkStrings.KcvRecordUnfold}" />
												</Trigger>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</ToggleButton.Template>
								</ToggleButton>
							</Grid>
							<ContentPresenter
								Margin="0 3 0 0"
								ContentSource="Header"
								DockPanel.Dock="Top"
								/>
							<ContentPresenter
								x:Name="Body"
								Margin="0 6 0 0"
								Visibility="Collapsed"
								/>
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger SourceName="Fold" Property="IsChecked" Value="True">
							<Setter TargetName="Body" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>

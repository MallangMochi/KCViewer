<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvKancolleProgressWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:progress="clr-namespace:KancolleProgress.Translations;assembly=KancolleProgress"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static progress:KancolleProgressResources.Title}"
	Width="1280"
	Height="860"
	d:DataContext="{d:DesignInstance kcv:KcvKancolleProgressViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="kcv:KcvKancolleProgressViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: 칸무스 수집 진행도 in KanColleViewer's style (mockup 20261006-kancolle-progress-v3, approved 2026-10-06
		"구현"), instead of the viewer's maximized window. The menu 파일 (CSV 내보내기), the tabs 칸무스 / 이벤트 (the
		viewer's 표시 menu, removed: "표시는 없앰"), the box 「컬러 필터」 with a chip per level colour and the owned total
		(칸무스 only), then the groups of ship types left to right: the name and 「owned/all」, the class boxes. The window's
		height sets how many class boxes go under one another; what is wider than the window scrolls sideways. Missing
		ships show no level. The first size is 1280×860, then the last one is kept (WindowBase).
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!--  A tab: grey, the foreground with the accent line under it when chosen  -->
			<Style x:Key="Tab" TargetType="RadioButton">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="RadioButton">
							<Border
								x:Name="Line"
								Padding="14 6 14 5"
								Background="Transparent"
								BorderBrush="Transparent"
								BorderThickness="0 0 0 2"
								>
								<TextBlock
									FontSize="13"
									Foreground="{TemplateBinding Foreground}"
									Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
									/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
								</Trigger>
								<Trigger Property="IsChecked" Value="True">
									<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
									<Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--  Text in a level's colour (DataContext: a ship or a filter, with Tier)  -->
			<Style x:Key="Tiered" TargetType="TextBlock">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Tier}" Value="Max">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.LevelMax}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Lv99">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.Level99}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Lv90">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.Level90}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Lv80">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.Level80}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Missing">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.LackForeground}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!--  The colour square of a chip  -->
			<Style x:Key="Swatch" TargetType="Rectangle">
				<Setter Property="Width" Value="10" />
				<Setter Property="Height" Value="10" />
				<Setter Property="Margin" Value="0 0 6 0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Fill" Value="{DynamicResource Kcv.Foreground}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Tier}" Value="Max">
						<Setter Property="Fill" Value="{DynamicResource Kcv.LevelMax}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Lv99">
						<Setter Property="Fill" Value="{DynamicResource Kcv.Level99}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Lv90">
						<Setter Property="Fill" Value="{DynamicResource Kcv.Level90}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Lv80">
						<Setter Property="Fill" Value="{DynamicResource Kcv.Level80}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Tier}" Value="Missing">
						<Setter Property="Fill" Value="{DynamicResource Kcv.LackForeground}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!--  One ship: the name, the level on the right (none when missing)  -->
			<DataTemplate x:Key="ShipRow" DataType="{x:Type kcv:KcvProgressShip}">
				<DockPanel Height="18" Margin="6 0">
					<TextBlock
						MinWidth="18"
						Margin="10 0 0 0"
						DockPanel.Dock="Right"
						Style="{StaticResource Tiered}"
						Text="{Binding LevelText}"
						TextAlignment="Right"
						/>
					<TextBlock Style="{StaticResource Tiered}" Text="{Binding Name}" />
				</DockPanel>
			</DataTemplate>

			<!--  The ships of one class  -->
			<DataTemplate x:Key="ClassBox" DataType="{x:Type kcv:KcvProgressClass}">
				<Border
					Margin="0 0 4 4"
					Padding="0 2"
					Background="{DynamicResource Kcv.AlternateRow}"
					BorderBrush="{DynamicResource Kcv.HeaderBackground}"
					BorderThickness="1"
					>
					<ItemsControl
						Focusable="False"
						ItemTemplate="{StaticResource ShipRow}"
						ItemsSource="{Binding Ships}"
						/>
				</Border>
			</DataTemplate>

			<!--  A group of ship types: the name and 「owned/all」, the class boxes top to bottom, then the next column  -->
			<DataTemplate x:Key="Group" DataType="{x:Type kcv:KcvProgressGroup}">
				<Border
					Margin="0 0 6 0"
					VerticalAlignment="Top"
					BorderBrush="{DynamicResource Kcv.HeaderBackground}"
					BorderThickness="1"
					>
					<DockPanel>
						<Border
							Height="22"
							Padding="8 0"
							Background="{DynamicResource Kcv.HeaderBackground}"
							DockPanel.Dock="Top"
							>
							<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource Kcv.SubForeground}"
									Text="{Binding Label}"
									/>
								<TextBlock
									Margin="8 0 0 0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{DynamicResource Kcv.InactiveForeground}"
									Text="{Binding Count}"
									/>
							</StackPanel>
						</Border>
						<ItemsControl
							Margin="4 4 0 0"
							Focusable="False"
							ItemTemplate="{StaticResource ClassBox}"
							ItemsSource="{Binding Classes}"
							>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Vertical" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</DockPanel>
				</Border>
			</DataTemplate>

			<!--  A chip of 「컬러 필터」: the colour, its name in it, the count  -->
			<DataTemplate x:Key="FilterChip" DataType="{x:Type kcv:KcvProgressFilter}">
				<Border
					Height="22"
					Margin="0 0 6 0"
					Padding="8 0"
					Background="{DynamicResource Kcv.AlternateRow}"
					BorderBrush="{DynamicResource Kcv.Separator}"
					BorderThickness="1"
					>
					<StackPanel Orientation="Horizontal">
						<Rectangle Style="{StaticResource Swatch}" />
						<TextBlock Style="{StaticResource Tiered}" Text="{Binding Label}" />
						<TextBlock
							Margin="6 0 0 0"
							VerticalAlignment="Center"
							FontSize="12"
							Foreground="{DynamicResource Kcv.Foreground}"
							Text="{Binding Count}"
							/>
					</StackPanel>
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Menu Grid.Row="0">
			<MenuItem Header="{x:Static progress:KancolleProgressResources.File}">
				<MenuItem Command="{Binding ExportAsCsvCommand}" Header="{x:Static progress:KancolleProgressResources.ExportAsCsv}" />
			</MenuItem>
		</Menu>

		<StackPanel
			Grid.Row="1"
			Margin="10 0"
			Orientation="Horizontal"
			>
			<RadioButton
				Content="{x:Static progress:KancolleProgressResources.Ships}"
				GroupName="View"
				IsChecked="{Binding IsShipsView}"
				Style="{StaticResource Tab}"
				/>
			<RadioButton
				Content="{x:Static progress:KancolleProgressResources.Event}"
				GroupName="View"
				IsChecked="{Binding IsEventView}"
				Style="{StaticResource Tab}"
				/>
		</StackPanel>

		<!--  컬러 필터 (칸무스 only, as the viewer)  -->
		<ContentControl
			Grid.Row="2"
			Margin="10 6"
			Style="{StaticResource KcvRec.Box}"
			Tag="{x:Static progress:KancolleProgressResources.ColorFilters}"
			Visibility="{Binding IsShipsView, Converter={StaticResource KcvRec.Visible}}"
			>
			<WrapPanel>
				<ItemsControl
					Focusable="False"
					ItemTemplate="{StaticResource FilterChip}"
					ItemsPanel="{StaticResource KcvRec.Horizontal}"
					ItemsSource="{Binding Filters}"
					/>
				<TextBlock
					Margin="4 0 0 0"
					VerticalAlignment="Center"
					FontSize="12"
					Foreground="{DynamicResource Kcv.SubForeground}"
					Text="{Binding OwnedSummary}"
					/>
			</WrapPanel>
		</ContentControl>

		<!--  The scroll bar is drawn over the content (ModernWpf), so the class boxes keep its height free under them  -->
		<ScrollViewer
			Grid.Row="3"
			Padding="10 8 10 18"
			HorizontalScrollBarVisibility="Visible"
			VerticalScrollBarVisibility="Disabled"
			>
			<ItemsControl
				Focusable="False"
				ItemTemplate="{StaticResource Group}"
				ItemsPanel="{StaticResource KcvRec.Horizontal}"
				ItemsSource="{Binding Groups}"
				/>
		</ScrollViewer>
	</Grid>
</common:WindowBase>

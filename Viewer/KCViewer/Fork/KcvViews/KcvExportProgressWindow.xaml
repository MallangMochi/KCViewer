<Window
	x:Class="KCViewer.Fork.KcvViews.KcvExportProgressWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static translations:ExportProgressResources.Title}"
	Width="360"
	d:DataContext="{d:DesignInstance kcv:KcvExportProgressViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d"
	>
	<!--
		Fork: the sortie record's 데이터 처리... in KanColleViewer's style (KcvContentDialogService, mockup
		20261020-csv-export-dialogs-v2): 「41 / 82」, the bar, 취소 (Esc); it closes itself when the work is done.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<Button
				MinWidth="72"
				HorizontalAlignment="Right"
				Content="{x:Static translations:ExportProgressResources.Cancel}"
				IsCancel="True"
				Style="{StaticResource KcvRec.Button}"
				/>
		</Border>

		<StackPanel Margin="16 12 16 14">
			<TextBlock
				Margin="0 0 0 8"
				HorizontalAlignment="Center"
				FontSize="13"
				Text="{Binding Text}"
				/>
			<ProgressBar
				Height="8"
				Background="{DynamicResource Kcv.CheckFill}"
				Foreground="{DynamicResource Kcv.Accent}"
				Maximum="{Binding Total, Mode=OneWay}"
				Style="{StaticResource Kcv.Gauge}"
				Value="{Binding Progress, Mode=OneWay}"
				/>
		</StackPanel>
	</DockPanel>
</Window>

<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvUpgradeCostView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:costs="clr-namespace:KCViewer.Window.Tools.EquipmentUpgradePlanner.CostCalculation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance costs:EquipmentUpgradePlanCostViewModel}"
	mc:Ignorable="d"
	>
	<!--
		Fork: an upgrade cost (EquipmentUpgradePlanCostViewModel) in KanColleViewer's style, for the planned upgrades
		panel's tooltip and the upgrade planner window: fuel, ammo, steel, bauxite, development and improvement materials
		on one wrapping line, then the equipment and consumables used up (owned / required). What is short is in
		Kcv.LackForeground, as the viewer's red; the tooltips of the lines are the viewer's (owned, required).
	-->
	<UserControl.Resources>
		<costs:EquipmentUpgradePlanCostBindingProxy x:Key="Proxy" DataContext="{Binding}" />

		<Style x:Key="Amount" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="3 0 12 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding EnoughOwned}" Value="False">
					<Setter Property="Foreground" Value="{DynamicResource Kcv.LackForeground}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="Line" BasedOn="{StaticResource Amount}" TargetType="TextBlock">
			<Setter Property="Margin" Value="0 3 0 0" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<Style x:Key="Resource" TargetType="StackPanel">
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="Margin" Value="0 1" />
		</Style>

		<ToolTip x:Key="OwnedRequired" x:Shared="False">
			<StackPanel>
				<TextBlock>
					<Run Text="{Binding DataContext.EquipmentUpgradePlanner.Owned, Source={StaticResource Proxy}, Mode=OneWay}" />
					<Run Text="{Binding Owned, Mode=OneWay}" />
				</TextBlock>
				<TextBlock>
					<Run Text="{Binding DataContext.EquipmentUpgradePlanner.Required, Source={StaticResource Proxy}, Mode=OneWay}" />
					<Run Text="{Binding Required, Mode=OneWay}" />
				</TextBlock>
			</StackPanel>
		</ToolTip>
	</UserControl.Resources>

	<StackPanel>
		<WrapPanel>
			<StackPanel DataContext="{Binding Fuel}" Style="{StaticResource Resource}">
				<common:UseItemIcon Type="Fuel" />
				<TextBlock Style="{StaticResource Amount}" Text="{Binding Required}" />
			</StackPanel>
			<StackPanel DataContext="{Binding Ammo}" Style="{StaticResource Resource}">
				<common:UseItemIcon Type="Ammo" />
				<TextBlock Style="{StaticResource Amount}" Text="{Binding Required}" />
			</StackPanel>
			<StackPanel DataContext="{Binding Steel}" Style="{StaticResource Resource}">
				<common:UseItemIcon Type="Steel" />
				<TextBlock Style="{StaticResource Amount}" Text="{Binding Required}" />
			</StackPanel>
			<StackPanel DataContext="{Binding Bauxite}" Style="{StaticResource Resource}">
				<common:UseItemIcon Type="Bauxite" />
				<TextBlock Style="{StaticResource Amount}" Text="{Binding Required}" />
			</StackPanel>
			<StackPanel DataContext="{Binding DevelopmentMaterial}" Style="{StaticResource Resource}">
				<common:UseItemIcon Type="DevelopmentMaterial" />
				<TextBlock Style="{StaticResource Amount}" Text="{Binding Required}" />
			</StackPanel>
			<StackPanel DataContext="{Binding ImprovementMaterial}" Style="{StaticResource Resource}">
				<common:UseItemIcon Type="ImproveMaterial" />
				<TextBlock Style="{StaticResource Amount}" Text="{Binding Required}" />
			</StackPanel>
		</WrapPanel>

		<ItemsControl ItemsSource="{Binding RequiredEquipments}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type costs:EquipmentUpgradePlanCostEquipmentViewModel}">
					<TextBlock
						Background="Transparent"
						Style="{StaticResource Line}"
						ToolTip="{StaticResource OwnedRequired}"
						>
						<Run Text="{Binding Equipment.NameEN, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Owned, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Required, Mode=OneWay}" /><Run Text=")" />
					</TextBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<ItemsControl ItemsSource="{Binding RequiredConsumables}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type costs:EquipmentUpgradePlanCostConsumableViewModel}">
					<TextBlock
						Background="Transparent"
						Style="{StaticResource Line}"
						ToolTip="{StaticResource OwnedRequired}"
						>
						<Run Text="{Binding Consumable.NameTranslated, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Owned, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Required, Mode=OneWay}" /><Run Text=")" />
					</TextBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</StackPanel>
</UserControl>

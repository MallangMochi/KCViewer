<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvFleetImageHeader"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fleetImage="clr-namespace:KCViewer.Window.Tools.FleetImageGenerator"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance fleetImage:FleetImageGeneratorViewModel}"
	d:DesignWidth="1000"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: what is above the preview of 편성 이미지 출력 in KanColleViewer's style (mockup 20261007-fleet-image-v2,
		layout 나). The image type as tabs (they change the whole preview) with 복사 · 불러오기 · 저장 · 설정 on the right
		(under the tabs when the window is too narrow for both), the box 「출력 조건」 with the fleets (box after the name),
		전차 수송량 and 기지 항공대, then the settings when 「설정을 창에 펼치기」 is on, as the viewer's quick access.
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvFleetImageStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<StackPanel>
		<Grid
			x:Name="TopRow"
			Margin="10 2 10 0"
			SizeChanged="PlaceButtons"
			>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel
				x:Name="Tabs"
				HorizontalAlignment="Left"
				Orientation="Horizontal"
				>
				<RadioButton
					Command="{Binding ChangeImageTypeCommand}"
					CommandParameter="{x:Static fleetImage:ImageType.Card}"
					Content="{Binding DialogFleetImageGenerator.ImageTypeCard}"
					IsChecked="{Binding ImageType, Mode=OneWay, Converter={StaticResource KcvFi.Radio}, ConverterParameter=Card}"
					Style="{StaticResource KcvFi.Tab}"
					/>
				<RadioButton
					Command="{Binding ChangeImageTypeCommand}"
					CommandParameter="{x:Static fleetImage:ImageType.CutIn}"
					Content="{Binding DialogFleetImageGenerator.ImageTypeCutin}"
					IsChecked="{Binding ImageType, Mode=OneWay, Converter={StaticResource KcvFi.Radio}, ConverterParameter=CutIn}"
					Style="{StaticResource KcvFi.Tab}"
					/>
				<RadioButton
					Command="{Binding ChangeImageTypeCommand}"
					CommandParameter="{x:Static fleetImage:ImageType.Banner}"
					Content="{Binding DialogFleetImageGenerator.ImageTypeBanner}"
					IsChecked="{Binding ImageType, Mode=OneWay, Converter={StaticResource KcvFi.Radio}, ConverterParameter=Banner}"
					Style="{StaticResource KcvFi.Tab}"
					/>
			</StackPanel>

			<StackPanel
				x:Name="Buttons"
				Grid.Column="1"
				Margin="0 2 0 2"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				>
				<Button
					Click="CopyToClipboard"
					Content="{Binding DialogFleetImageGenerator.CopyToClipboard}"
					Style="{StaticResource KcvRec.Button}"
					/>
				<Button
					Click="LoadFromClipboard"
					Content="{Binding DialogFleetImageGenerator.LoadFromClipboard}"
					Style="{StaticResource KcvRec.Button}"
					/>
				<Button
					Click="SaveToFile"
					Content="{Binding DialogFleetImageGenerator.SaveImageToFile}"
					Style="{StaticResource KcvRec.PrimaryButton}"
					/>
				<Button
					Click="OpenSettings"
					Content="{Binding DialogFleetImageGenerator.Settings}"
					Style="{StaticResource KcvRec.Button}"
					/>
			</StackPanel>
		</Grid>

		<ContentControl Style="{StaticResource KcvRec.Box}" Tag="{x:Static fork:ForkStrings.KcvFleetImageConditions}">
			<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
				<StackPanel Style="{StaticResource KcvRec.Pair}">
					<TextBlock Style="{StaticResource KcvRec.FirstLabel}" Text="{x:Static fork:ForkStrings.KcvFleetImageFleets}" />
					<CheckBox
						Content="#1"
						IsChecked="{Binding Fleet1Visible}"
						Style="{StaticResource KcvRec.Check}"
						/>
					<CheckBox
						Content="#2"
						IsChecked="{Binding Fleet2Visible}"
						Style="{StaticResource KcvRec.Check}"
						/>
					<CheckBox
						Content="#3"
						IsChecked="{Binding Fleet3Visible}"
						Style="{StaticResource KcvRec.Check}"
						/>
					<CheckBox
						Margin="0"
						Content="#4"
						IsChecked="{Binding Fleet4Visible}"
						Style="{StaticResource KcvRec.Check}"
						/>
				</StackPanel>
				<StackPanel Style="{StaticResource KcvRec.Pair}">
					<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding DialogFleetImageGenerator.ShowTankTp}" />
					<ComboBox
						ItemsSource="{Binding TankTpGauges}"
						SelectedValue="{Binding TankTpGauge}"
						Style="{StaticResource KcvRec.Combo}"
						>
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
				<Button
					Margin="0 1"
					Command="{Binding LoadAirBasesCommand}"
					Content="{Binding DialogFleetImageGenerator.AirBase}"
					Style="{StaticResource KcvRec.Button}"
					/>
			</WrapPanel>
		</ContentControl>

		<ContentControl
			Margin="8 0 8 6"
			Style="{StaticResource KcvRec.Box}"
			Tag="{Binding DialogFleetImageGenerator.Settings}"
			Visibility="{Binding QuickConfigAccess, Converter={StaticResource KcvRec.Visible}}"
			>
			<kcv:KcvFleetImageSettingsView />
		</ContentControl>
	</StackPanel>
</UserControl>

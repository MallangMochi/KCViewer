<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvResourceChartWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:chart="clr-namespace:KCViewer.Window.Dialog.ResourceChartWPF"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding DialogResourceChart.Title}"
	Width="950"
	Height="600"
	d:DataContext="{d:DesignInstance chart:ResourceChartViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="chart:ResourceChartViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the resource chart in KanColleViewer's style (mockup v7, viewer-design/mockups/20261004-resource-chart-v7.html,
		approved 2026-10-04), drawn anew with ScottPlot (code behind). The eight items in one chart, solid lines in the
		legend's colours; click the legend to hide an item. Resources on the left axis in 만, materials on the right
		(on the left when the resources are all hidden, none when the materials are). 자원(차분) and the experience graphs
		as the viewer has them. The tooltip lists the shown items.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="{Binding DialogResourceChart.Menu_File}">
				<MenuItem Click="SaveImage" Header="{Binding DialogResourceChart.Menu_File_SaveImage}" />
			</MenuItem>
			<MenuItem Header="{Binding DialogResourceChart.Menu_Graph}">
				<MenuItem
					x:Name="KindResource"
					Click="SelectKind"
					Header="{Binding DialogResourceChart.Menu_Graph_Resource}"
					IsCheckable="True"
					Tag="Resource"
					/>
				<MenuItem
					x:Name="KindResourceDiff"
					Click="SelectKind"
					Header="{Binding DialogResourceChart.Menu_Graph_ResourceDiff}"
					IsCheckable="True"
					Tag="ResourceDiff"
					/>
				<Separator />
				<MenuItem
					x:Name="KindExperience"
					Click="SelectKind"
					Header="{Binding DialogResourceChart.Menu_Graph_Experience}"
					IsCheckable="True"
					Tag="Experience"
					/>
				<MenuItem
					x:Name="KindExperienceDiff"
					Click="SelectKind"
					Header="{Binding DialogResourceChart.Menu_Graph_ExperienceDiff}"
					IsCheckable="True"
					Tag="ExperienceDiff"
					/>
			</MenuItem>
			<MenuItem x:Name="SpanMenu" Header="{Binding DialogResourceChart.Menu_Span}">
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_Day}"
					IsCheckable="True"
					Tag="Day"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_Week}"
					IsCheckable="True"
					Tag="Week"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_Month}"
					IsCheckable="True"
					Tag="Month"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_Season}"
					IsCheckable="True"
					Tag="Season"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_Year}"
					IsCheckable="True"
					Tag="Year"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_All}"
					IsCheckable="True"
					Tag="All"
					/>
				<Separator />
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_WeekFirst}"
					IsCheckable="True"
					Tag="WeekFirst"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_MonthFirst}"
					IsCheckable="True"
					Tag="MonthFirst"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_SeasonFirst}"
					IsCheckable="True"
					Tag="SeasonFirst"
					/>
				<MenuItem
					Click="SelectSpan"
					Header="{Binding DialogResourceChart.Menu_Span_YearFirst}"
					IsCheckable="True"
					Tag="YearFirst"
					/>
			</MenuItem>
			<MenuItem Header="{Binding DialogResourceChart.OptionsMenu}">
				<MenuItem
					x:Name="ShowAllData"
					Click="Redraw"
					Header="{Binding DialogResourceChart.Menu_Option_ShowAllData}"
					IsCheckable="True"
					/>
				<MenuItem
					x:Name="DivideByDay"
					Click="Redraw"
					Header="{Binding DialogResourceChart.Menu_Option_DivideByDay}"
					IsCheckable="True"
					/>
			</MenuItem>
		</Menu>

		<!--  검색 조건: 기간 (dates only, as the viewer)  -->
		<ContentControl DockPanel.Dock="Top" Style="{StaticResource KcvRec.Conditions}">
			<!--  the buttons go to the next line when they do not fit beside the period (mockup v6)  -->
			<kcv:KcvTrailingPanel>
				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<TextBlock Style="{StaticResource KcvRec.FirstLabel}" Text="{Binding Source={x:Static fork:ForkStrings.KcvRecordPeriod}, StringFormat={}{0}:}" />
					<DatePicker
						VerticalAlignment="Center"
						DisplayDateEnd="{Binding MaxDate}"
						DisplayDateStart="{Binding MinDate}"
						FirstDayOfWeek="Monday"
						SelectedDate="{Binding DateBegin}"
						/>
					<TextBlock
						Margin="6 0"
						VerticalAlignment="Center"
						Text="~"
						/>
					<DatePicker
						VerticalAlignment="Center"
						DisplayDateEnd="{Binding MaxDate}"
						DisplayDateStart="{Binding MinDate}"
						FirstDayOfWeek="Monday"
						SelectedDate="{Binding DateEnd}"
						/>
				</WrapPanel>
				<StackPanel Orientation="Horizontal">
					<Button
						Click="Search"
						Content="{x:Static fork:ForkStrings.KcvRecordSearch}"
						Style="{StaticResource KcvRec.PrimaryButton}"
						/>
					<Button
						Click="ResetConditions"
						Content="{x:Static fork:ForkStrings.KcvRecordReset}"
						Style="{StaticResource KcvRec.Button}"
						/>
				</StackPanel>
			</kcv:KcvTrailingPanel>
		</ContentControl>

		<Grid Margin="8 0 8 8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Border
				Grid.Column="0"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="1"
				>
				<Grid>
					<WpfPlot
						x:Name="Chart"
						MouseLeave="HidePoint"
						MouseMove="ShowPoint"
						/>
					<Canvas IsHitTestVisible="False">
						<Border
							x:Name="Tip"
							Padding="8 4"
							Background="{DynamicResource Kcv.TableHeaderBackground}"
							BorderBrush="{DynamicResource Kcv.ChartFrame}"
							BorderThickness="1"
							Visibility="Collapsed"
							>
							<StackPanel x:Name="TipLines" TextElement.FontSize="12" />
						</Border>
					</Canvas>
				</Grid>
			</Border>

			<!--  the legend: 자원 and 자재, a click hides or shows an item  -->
			<StackPanel
				x:Name="Legend"
				Grid.Column="1"
				MinWidth="120"
				Margin="8 0 0 0"
				/>
		</Grid>
	</DockPanel>
</common:WindowBase>

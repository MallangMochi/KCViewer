<Window
	x:Class="KCViewer.Fork.KcvViews.KcvVersionWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static translations:VersionResources.Title}"
	Width="380"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	>
	<!--
		Fork: 버전 정보 in KanColleViewer's style (KcvMenuWindows, mockup viewer-design/mockups/20261018-menu-windows-v2.html,
		approved 2026-10-18 "구현"): the name, 「접속기」 with 버전 (a release's version with its commit, else the commit
		and its date: Fork/ForkVersion.cs), 빌드, 기반, 실행 환경 and 저장소 (the user's answer "저장소 추가"), 「74식」 with
		its developers, and 닫기 (Enter, Esc).
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style
				x:Key="Name"
				BasedOn="{StaticResource Cfg.Lbl}"
				TargetType="TextBlock"
				>
				<Setter Property="Margin" Value="0 1 14 1" />
			</Style>
			<Style x:Key="Value" TargetType="TextBlock">
				<Setter Property="Margin" Value="0 1" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style TargetType="Hyperlink">
				<Setter Property="Foreground" Value="{DynamicResource Kcv.Link}" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<Button
				MinWidth="72"
				HorizontalAlignment="Right"
				Click="CloseWindow"
				Content="{x:Static translations:VersionResources.ButtonClose}"
				IsCancel="True"
				IsDefault="True"
				Style="{StaticResource KcvRec.PrimaryButton}"
				/>
		</Border>

		<StackPanel Margin="12 6 12 4">
			<StackPanel Margin="0 4 0 10" Orientation="Horizontal">
				<Image
					x:Name="Logo"
					Width="32"
					Height="32"
					Margin="0 0 10 0"
					/>
				<TextBlock
					VerticalAlignment="Center"
					FontSize="18"
					Text="{x:Static fork:ForkStrings.ProductDisplayName}"
					/>
			</StackPanel>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.VersionViewer}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock
						Grid.Row="0"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowVersion}"
						/>
					<TextBlock
						x:Name="VersionText"
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource Value}"
						/>
					<TextBlock
						Grid.Row="1"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowBuilt}"
						/>
					<TextBlock
						x:Name="BuiltText"
						Grid.Row="1"
						Grid.Column="1"
						Style="{StaticResource Value}"
						/>
					<TextBlock
						Grid.Row="2"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowBase}"
						/>
					<TextBlock
						x:Name="BaseText"
						Grid.Row="2"
						Grid.Column="1"
						Style="{StaticResource Value}"
						/>
					<TextBlock
						Grid.Row="3"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowRuntime}"
						/>
					<TextBlock
						x:Name="RuntimeText"
						Grid.Row="3"
						Grid.Column="1"
						Style="{StaticResource Value}"
						/>
					<TextBlock
						Grid.Row="4"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowRepository}"
						/>
					<TextBlock
						Grid.Row="4"
						Grid.Column="1"
						Style="{StaticResource Value}"
						>
						<Hyperlink NavigateUri="https://github.com/MallangMochi/KCViewer" RequestNavigate="OpenLink">github.com/MallangMochi/KCViewer</Hyperlink>
					</TextBlock>
				</Grid>
			</ContentControl>

			<ContentControl Style="{StaticResource Cfg.Box}" Tag="{x:Static fork:ForkStrings.VersionOriginal}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock
						Grid.Row="0"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowDeveloper}"
						/>
					<TextBlock
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource Value}"
						>
						<Hyperlink NavigateUri="https://twitter.com/andanteyk" RequestNavigate="OpenLink">
							<Run Text="{x:Static translations:VersionResources.TextAuthor}" />
						</Hyperlink>
					</TextBlock>
					<TextBlock
						Grid.Row="1"
						Style="{StaticResource Name}"
						Text="{x:Static fork:ForkStrings.VersionRowMaintainers}"
						/>
					<TextBlock
						Grid.Row="1"
						Grid.Column="1"
						Style="{StaticResource Value}"
						Text="{x:Static translations:VersionResources.Maintainers}"
						/>
				</Grid>
			</ContentControl>
		</StackPanel>
	</DockPanel>
</Window>

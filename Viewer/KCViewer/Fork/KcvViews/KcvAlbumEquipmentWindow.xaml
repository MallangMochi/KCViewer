<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvAlbumEquipmentWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:core="clr-namespace:KCViewer.Core.Types;assembly=KCViewer.Core"
	xmlns:cost="clr-namespace:KCViewer.Window.Tools.EquipmentUpgradePlanner.CostCalculation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:equipment="clr-namespace:KCViewer.Window.Tools.DialogAlbumMasterEquipment"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:helpers="clr-namespace:KCViewer.Window.Tools.EquipmentUpgradePlanner.Helpers"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:persistentColumns="clr-namespace:KCViewer.Behaviors.PersistentColumns"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:upgrade="clr-namespace:KCViewer.Window.Tools.DialogAlbumMasterEquipment.EquipmentUpgrade"
	Title="{Binding Title}"
	Width="900"
	Height="630"
	MinWidth="840"
	MinHeight="480"
	d:DataContext="{d:DesignInstance equipment:DialogAlbumMasterEquipmentViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="equipment:DialogAlbumMasterEquipmentViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the equipment album in KanColleViewer's style (mockup v5, viewer-design/mockups/20261005-album-v5.html,
		approved 2026-10-05 "구현 진행해") with the viewer's view model. 「검색 조건」 is folded when the window opens: only
		「장비명:」 shows; 「펼치기 ▾」 opens the game's categories with their icons, as the equipment list (all the master
		data's categories here). Left the table ID·icon·분류·장비명; right the details in cards and the improvement card
		under them (the cost per ★, the helpers' days, the conversion). The viewer's menus, tooltips and right clicks stay.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvAlbumStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!--  a right click on a row opens that equipment in a new album window, as the viewer  -->
			<Style
				x:Key="Row"
				BasedOn="{StaticResource KcvAlbum.Row}"
				TargetType="DataGridRow"
				>
				<EventSetter Event="MouseRightButtonUp" Handler="OpenRowInNewWindow" />
			</Style>

			<!--  a stat of the equipment: the viewer's icon, the name and the value (0 faded)  -->
			<Style x:Key="StatIcon" TargetType="Image">
				<Setter Property="Width" Value="16" />
				<Setter Property="Height" Value="16" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style
				x:Key="StatName"
				BasedOn="{StaticResource KcvAlbum.Value}"
				TargetType="TextBlock"
				>
				<Setter Property="Margin" Value="4 1 6 1" />
			</Style>
			<Style
				x:Key="StatValue"
				BasedOn="{StaticResource KcvAlbum.Number}"
				TargetType="TextBlock"
				>
				<Style.Triggers>
					<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="0">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!--  what an improvement step consumes: equipment and items, red when not enough are owned (as the viewer)  -->
			<Style x:Key="CostText" TargetType="TextBlock">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="Margin" Value="0 1" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding EnoughOwned}" Value="False">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.LackForeground}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<DataTemplate x:Key="ItemCost" DataType="{x:Type upgrade:EquipmentUpgradeItemCostViewModel}">
				<StackPanel>
					<ItemsControl Focusable="False" ItemsSource="{Binding RequiredEquipments}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type cost:EquipmentUpgradePlanCostEquipmentViewModel}">
								<TextBlock Style="{StaticResource CostText}">
									<Run Text="{Binding Equipment.NameEN, Mode=OneWay}" />
									<Run Text="×" /><Run Text="{Binding Required, Mode=OneWay}" />
									<Run FontSize="11" Text="(" /><Run FontSize="11" Text="{x:Static fork:ForkStrings.KcvAlbumOwned}" />
									<Run FontSize="11" Text="{Binding Owned, Mode=OneWay}" /><Run FontSize="11" Text=")" />
								</TextBlock>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<ItemsControl Focusable="False" ItemsSource="{Binding RequiredConsumables}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type cost:EquipmentUpgradePlanCostConsumableViewModel}">
								<TextBlock Style="{StaticResource CostText}">
									<Run Text="{Binding Consumable.NameTranslated, Mode=OneWay}" />
									<Run Text="×" /><Run Text="{Binding Required, Mode=OneWay}" />
									<Run FontSize="11" Text="(" /><Run FontSize="11" Text="{x:Static fork:ForkStrings.KcvAlbumOwned}" />
									<Run FontSize="11" Text="{Binding Owned, Mode=OneWay}" /><Run FontSize="11" Text=")" />
								</TextBlock>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</DataTemplate>

			<!--  a helper ship: a chip, its name red when none is owned  -->
			<DataTemplate x:Key="Helper" DataType="{x:Type helpers:EquipmentUpgradeHelperViewModel}">
				<Border Style="{StaticResource KcvAlbum.Chip}">
					<TextBlock FontSize="11" Text="{Binding Helper.NameEN}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding PlayerHasAtleastOne}" Value="False">
										<Setter Property="Foreground" Value="{DynamicResource Kcv.LackForeground}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Border>
			</DataTemplate>
			<ItemsPanelTemplate x:Key="Wrap">
				<WrapPanel />
			</ItemsPanelTemplate>

			<!--  a day box of the helpers: the viewer's colours (the helper's days blue, today bright blue)  -->
			<DataTemplate x:Key="Day" DataType="{x:Type helpers:EquipmentUpgradeHelpersDayViewModel}">
				<Border
					x:Name="Box"
					Width="26"
					Margin="0 0 2 0"
					Padding="0 1"
					Background="{Binding Background}"
					BorderBrush="{DynamicResource Kcv.ButtonBorder}"
					BorderThickness="1"
					>
					<TextBlock
						x:Name="Text"
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource Kcv.FaintForeground}"
						Text="{Binding DayValue, Converter={StaticResource Kcv.UpgradeDayText}}"
						/>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding IsHelperDay}" Value="True">
						<Setter TargetName="Text" Property="Foreground" Value="White" />
						<Setter TargetName="Box" Property="BorderBrush" Value="#5A5AF0" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Converter={StaticResource Kcv.UpgradeDayState}}" Value="Today">
						<Setter TargetName="Box" Property="BorderBrush" Value="#1E8EFF" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>

			<!--  the cost table's cells  -->
			<Style x:Key="TableHead" TargetType="Border">
				<Setter Property="Padding" Value="6 3" />
				<Setter Property="Background" Value="{DynamicResource Kcv.TableHeaderBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
				<Setter Property="BorderThickness" Value="0 0 1 1" />
				<Setter Property="TextElement.FontSize" Value="11" />
				<Setter Property="TextElement.Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			</Style>
			<Style x:Key="TableCell" TargetType="Border">
				<Setter Property="Padding" Value="6 3" />
				<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
				<Setter Property="BorderThickness" Value="0 0 0 1" />
				<Setter Property="TextElement.FontSize" Value="12" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid x:Name="Root">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Menu Grid.Row="0">
			<MenuItem Header="{Binding DialogAlbumMasterEquipment.StripMenu_File}">
				<MenuItem Command="{Binding StripMenu_File_OutputCSVUser_ClickCommand}" Header="{Binding DialogAlbumMasterEquipment.StripMenu_File_OutputCSVUser}" />
				<MenuItem Command="{Binding StripMenu_File_OutputCSVData_ClickCommand}" Header="{Binding DialogAlbumMasterEquipment.StripMenu_File_OutputCSVData}" />
			</MenuItem>
			<MenuItem Header="{Binding DialogAlbumMasterEquipment.StripMenu_Edit}">
				<MenuItem Command="{Binding StripMenu_Edit_CopyEquipmentName_ClickCommand}" Header="{Binding DialogAlbumMasterEquipment.StripMenu_Edit_CopyEquipmentName}" />
				<MenuItem Command="{Binding StripMenu_Edit_CopyEquipmentData_ClickCommand}" Header="{Binding DialogAlbumMasterEquipment.StripMenu_Edit_CopyEquipmentData}" />
				<Separator />
				<MenuItem Command="{Binding StripMenu_Edit_GoogleEquipmentName_ClickCommand}" Header="{Binding DialogAlbumMasterEquipment.StripMenu_Edit_GoogleEquipmentName}" />
			</MenuItem>
			<MenuItem Header="{Binding DialogAlbumMasterEquipment.StripMenu_View}">
				<MenuItem Command="{Binding StripMenu_View_ShowAppearingArea_ClickCommand}" Header="{Binding DialogAlbumMasterEquipment.StripMenu_View_ShowAppearingArea}" />
			</MenuItem>
		</Menu>

		<!--  the search conditions: the name always, the categories when unfolded  -->
		<HeaderedContentControl
			Grid.Row="1"
			DataContext="{Binding Filters, RelativeSource={RelativeSource AncestorType=kcv:KcvAlbumEquipmentWindow}}"
			Style="{StaticResource KcvAlbum.Conditions}"
			>
			<HeaderedContentControl.Header>
				<StackPanel Orientation="Horizontal">
					<TextBlock Style="{StaticResource KcvRec.FirstLabel}">
						<Run Text="{x:Static fork:ForkStrings.KcvAlbumEquipmentName}" /><Run Text=":" />
					</TextBlock>
					<TextBox
						Width="220"
						Style="{StaticResource KcvRec.TextBox}"
						Tag="{x:Static fork:ForkStrings.KcvPickerNameHint}"
						Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
						/>
				</StackPanel>
			</HeaderedContentControl.Header>

			<DockPanel>
				<TextBlock
					Margin="0 3 5 0"
					VerticalAlignment="Top"
					DockPanel.Dock="Left"
					Style="{StaticResource KcvRec.FirstLabel}"
					>
					<Run Text="{x:Static fork:ForkStrings.KcvAlbumCategory}" /><Run Text=":" />
				</TextBlock>
				<StackPanel>
					<Button
						Margin="0 0 0 4"
						HorizontalAlignment="Left"
						Command="{Binding ToggleAllCommand}"
						Content="{x:Static fork:ForkStrings.KcvToggleAll}"
						Style="{StaticResource KcvRec.Button}"
						/>
					<!--  the equipment list's check boxes: the game's icon and the category name  -->
					<ItemsControl Focusable="False" ItemsSource="{Binding Categories}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type kcv:KcvEquipmentCategoryFilter}">
								<CheckBox
									Width="152"
									Margin="0 0 4 0"
									IsChecked="{Binding IsChecked}"
									ToolTip="{Binding Name}"
									>
									<StackPanel Orientation="Horizontal">
										<Image
											Width="24"
											Height="24"
											Margin="0 0 4 0"
											Source="{Binding Icon, Converter={StaticResource Kcv.GameIcon}}"
											Style="{StaticResource Kcv.EquipmentIcon}"
											/>
										<TextBlock
											MaxWidth="100"
											VerticalAlignment="Center"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis"
											/>
									</StackPanel>
								</CheckBox>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</DockPanel>
		</HeaderedContentControl>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="330" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border
				Grid.Column="0"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="0 1 1 0"
				>
				<DataGrid
					x:Name="Table"
					ItemsSource="{Binding DataGridViewModel.Items, IsAsync=True, NotifyOnTargetUpdated=True}"
					RowStyle="{StaticResource Row}"
					SelectedItem="{Binding SelectedEquipmentModel}"
					Style="{StaticResource KcvAlbum.Grid}"
					Tag="{Binding DataGridViewModel}"
					TargetUpdated="TableUpdated"
					VirtualizingStackPanel.IsVirtualizing="True"
					VirtualizingStackPanel.VirtualizationMode="Recycling"
					>
					<b:Interaction.Behaviors>
						<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridViewModel.SortDescriptions}" />
					</b:Interaction.Behaviors>

					<DataGrid.ContextMenu>
						<ContextMenu>
							<MenuItem Command="{Binding DataGridViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridViewModel.DataGrid.OpenColumnSelector}" />
							<MenuItem Command="{Binding DataGridViewModel.ClearSortingCommand}" Header="{Binding DataGridViewModel.DataGrid.ClearSorting}" />
						</ContextMenu>
					</DataGrid.ContextMenu>

					<DataGrid.Columns>
						<DataGridTemplateColumn
							Width="48"
							MinWidth="48"
							Header="ID"
							SortMemberPath="ID"
							>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate DataType="{x:Type core:IEquipmentDataMaster}">
									<TextBlock Style="{StaticResource KcvAlbum.CellGrey}" Text="{Binding ID}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn
							Width="30"
							MinWidth="30"
							Header=""
							SortMemberPath="IconTypeTyped"
							>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate DataType="{x:Type core:IEquipmentDataMaster}">
									<Image
										Width="20"
										Height="20"
										HorizontalAlignment="Center"
										Source="{Binding IconTypeTyped, Converter={StaticResource Kcv.GameIcon}}"
										Style="{StaticResource Kcv.EquipmentIcon}"
										/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn
							Width="100"
							MinWidth="100"
							Header="{x:Static fork:ForkStrings.KcvAlbumCategory}"
							SortMemberPath="CategoryType"
							>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate DataType="{x:Type core:IEquipmentDataMaster}">
									<TextBlock Style="{StaticResource KcvAlbum.CellText}" Text="{Binding CategoryTypeInstance.NameEN}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn
							Width="*"
							Header="{x:Static fork:ForkStrings.KcvAlbumEquipmentName}"
							SortMemberPath="NameEN"
							>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate DataType="{x:Type core:IEquipmentDataMaster}">
									<TextBlock Style="{StaticResource KcvAlbum.CellText}" Text="{Binding NameEN}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!--  the details of the chosen equipment  -->
			<ScrollViewer
				Grid.Column="1"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="0 1 0 0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto"
				>
				<StackPanel
					Margin="10 8 22 0"
					DataContext="{Binding SelectedEquipmentViewModel}"
					Visibility="{Binding DataContext.DetailsVisible, ElementName=Root, Converter={StaticResource KcvRec.Visible}}"
					>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="200" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<!--  the icon and the name; the category, the ID and the album number  -->
							<Border Style="{StaticResource KcvAlbum.Card}">
								<StackPanel>
									<StackPanel Orientation="Horizontal">
										<Image
											Width="22"
											Height="22"
											Margin="0 0 6 0"
											Source="{Binding Equipment.IconTypeTyped, Converter={StaticResource Kcv.GameIcon}}"
											Style="{StaticResource Kcv.EquipmentIcon}"
											/>
										<TextBlock
											VerticalAlignment="Center"
											Background="Transparent"
											FontSize="16"
											Text="{Binding Equipment.NameEN}"
											ToolTip="{Binding EquipmentNameToolTip}"
											>
											<TextBlock.InputBindings>
												<MouseBinding Command="{Binding DataContext.StripMenu_Edit_CopyEquipmentName_ClickCommand, ElementName=Root}" MouseAction="RightClick" />
											</TextBlock.InputBindings>
										</TextBlock>
									</StackPanel>
									<TextBlock Margin="0 2 0 0" Style="{StaticResource KcvAlbum.Grey}">
										<Run Text="{Binding Equipment.CategoryTypeInstance.NameEN, Mode=OneWay}" ToolTip="{Binding EquipmentTypeToolTip}" />
										<Run Text="·" />
										<Run Text="ID" ToolTip="{Binding EquipmentIdToolTip}" />
										<Run Text="{Binding Equipment.ID, Mode=OneWay}" ToolTip="{Binding EquipmentIdToolTip}" />
										<Run Text="·" />
										<Run Text="{x:Static fork:ForkStrings.KcvAlbumNumber}" />
										<Run Text="{Binding Equipment.AlbumNo, Mode=OneWay}" />
									</TextBlock>
								</StackPanel>
							</Border>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="132" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<!--  the stats (interceptors: interception and anti-bomber in place of evasion and accuracy)  -->
								<Border
									Grid.Column="0"
									VerticalAlignment="Top"
									Style="{StaticResource KcvAlbum.Card}"
									>
									<StackPanel>
										<TextBlock Style="{StaticResource KcvAlbum.CardTitle}" Text="{Binding DataContext.DialogAlbumMasterEquipment.Performance, ElementName=Root}" />
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="18" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="32" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<Image Source="{StaticResource Parameter.Firepower}" Style="{StaticResource StatIcon}" />
											<TextBlock
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleFirepower, ElementName=Root}"
												/>
											<TextBlock
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.Firepower, Converter={StaticResource KcvRec.Signed}}"
												/>

											<Image
												Grid.Row="1"
												Source="{StaticResource Parameter.Torpedo}"
												Style="{StaticResource StatIcon}"
												/>
											<TextBlock
												Grid.Row="1"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleTorpedo, ElementName=Root}"
												/>
											<TextBlock
												Grid.Row="1"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.Torpedo, Converter={StaticResource KcvRec.Signed}}"
												/>

											<Image
												Grid.Row="2"
												Source="{StaticResource Parameter.AntiAir}"
												Style="{StaticResource StatIcon}"
												/>
											<TextBlock
												Grid.Row="2"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleAA, ElementName=Root}"
												/>
											<TextBlock
												Grid.Row="2"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.AA, Converter={StaticResource KcvRec.Signed}}"
												/>

											<Image
												Grid.Row="3"
												Source="{StaticResource Parameter.Armor}"
												Style="{StaticResource StatIcon}"
												/>
											<TextBlock
												Grid.Row="3"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleArmor, ElementName=Root}"
												/>
											<TextBlock
												Grid.Row="3"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.Armor, Converter={StaticResource KcvRec.Signed}}"
												/>

											<Image
												Grid.Row="4"
												Source="{StaticResource Parameter.AntiSubmarine}"
												Style="{StaticResource StatIcon}"
												/>
											<TextBlock
												Grid.Row="4"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleASW, ElementName=Root}"
												/>
											<TextBlock
												Grid.Row="4"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.ASW, Converter={StaticResource KcvRec.Signed}}"
												/>

											<!--  evasion, or interception for an interceptor  -->
											<Image
												Grid.Row="5"
												Source="{StaticResource Parameter.Evasion}"
												Style="{StaticResource StatIcon}"
												Visibility="{Binding IsNotInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<Image
												Grid.Row="5"
												Source="{StaticResource Parameter.Interception}"
												Style="{StaticResource StatIcon}"
												Visibility="{Binding IsInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<TextBlock
												Grid.Row="5"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleEvasion, ElementName=Root}"
												Visibility="{Binding IsNotInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<TextBlock
												Grid.Row="5"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.Interception, ElementName=Root}"
												Visibility="{Binding IsInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<TextBlock
												Grid.Row="5"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.Evasion, Converter={StaticResource KcvRec.Signed}}"
												/>

											<Image
												Grid.Row="6"
												Source="{StaticResource Parameter.Los}"
												Style="{StaticResource StatIcon}"
												/>
											<TextBlock
												Grid.Row="6"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleLOS, ElementName=Root}"
												/>
											<TextBlock
												Grid.Row="6"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.LOS, Converter={StaticResource KcvRec.Signed}}"
												/>

											<!--  accuracy, or anti-bomber for an interceptor  -->
											<Image
												Grid.Row="7"
												Source="{StaticResource Parameter.Accuracy}"
												Style="{StaticResource StatIcon}"
												Visibility="{Binding IsNotInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<Image
												Grid.Row="7"
												Source="{StaticResource Parameter.AntiBomber}"
												Style="{StaticResource StatIcon}"
												Visibility="{Binding IsInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<TextBlock
												Grid.Row="7"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleAccuracy, ElementName=Root}"
												Visibility="{Binding IsNotInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<TextBlock
												Grid.Row="7"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.AntiBomber, ElementName=Root}"
												Visibility="{Binding IsInterceptor, Converter={StaticResource KcvRec.Visible}}"
												/>
											<TextBlock
												Grid.Row="7"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.Accuracy, Converter={StaticResource KcvRec.Signed}}"
												/>

											<Image
												Grid.Row="8"
												Source="{StaticResource Parameter.Bomber}"
												Style="{StaticResource StatIcon}"
												/>
											<TextBlock
												Grid.Row="8"
												Grid.Column="1"
												Style="{StaticResource StatName}"
												Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleBomber, ElementName=Root}"
												/>
											<TextBlock
												Grid.Row="8"
												Grid.Column="2"
												Style="{StaticResource StatValue}"
												Text="{Binding Equipment.Bomber, Converter={StaticResource KcvRec.Signed}}"
												/>
										</Grid>
									</StackPanel>
								</Border>

								<!--  the ships that come with it (right click: the ship album)  -->
								<Border
									Grid.Column="2"
									VerticalAlignment="Top"
									Style="{StaticResource KcvAlbum.Card}"
									>
									<StackPanel>
										<Grid>
											<TextBlock Style="{StaticResource KcvAlbum.CardTitle}" Text="{x:Static fork:ForkStrings.KcvAlbumInitialShips}" />
											<TextBlock Style="{StaticResource KcvAlbum.CardHint}" Text="{x:Static fork:ForkStrings.KcvAlbumRightClickShip}" />
										</Grid>
										<ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto">
											<ItemsControl Focusable="False" ItemsSource="{Binding DefaultSlotShips}">
												<ItemsControl.ItemTemplate>
													<DataTemplate DataType="{x:Type core:IShipDataMaster}">
														<TextBlock
															Background="Transparent"
															MouseRightButtonUp="OpenInitialShip"
															Style="{StaticResource KcvAlbum.Value}"
															>
															<Run Text="{Binding NameWithClass, Mode=OneWay}" />
															<Run
																FontSize="11"
																Foreground="{DynamicResource Kcv.InactiveForeground}"
																Text="{Binding ShipID, Mode=OneWay}"
																/>
														</TextBlock>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
									</StackPanel>
								</Border>
							</Grid>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<Image
								Width="198"
								Height="198"
								Margin="0 0 0 8"
								Source="{Binding Equipment, Converter={StaticResource EquipmentToImageConverter}}"
								/>

							<!--  speed (always none for equipment, as the viewer), rarity, range, aircraft cost and radius, scrap  -->
							<Border Style="{StaticResource KcvAlbum.Card}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<TextBlock Style="{StaticResource KcvAlbum.Key}" Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleSpeed, ElementName=Root}" />
									<TextBlock
										Grid.Column="1"
										Style="{StaticResource KcvAlbum.Grey}"
										Text="{Binding Speed}"
										/>

									<TextBlock
										Grid.Row="1"
										Style="{StaticResource KcvAlbum.Key}"
										Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleRarity, ElementName=Root}"
										/>
									<StackPanel
										Grid.Row="1"
										Grid.Column="1"
										Orientation="Horizontal"
										>
										<Ellipse Fill="{Binding Equipment.Rarity, Converter={StaticResource KcvAlbum.Rarity}, ConverterParameter='Equipment Brush'}" Style="{StaticResource KcvAlbum.RarityDot}" />
										<TextBlock Style="{StaticResource KcvAlbum.Value}" Text="{Binding Equipment.Rarity, Converter={StaticResource KcvAlbum.Rarity}, ConverterParameter=Equipment}" />
									</StackPanel>

									<TextBlock
										Grid.Row="2"
										Style="{StaticResource KcvAlbum.Key}"
										Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleRange, ElementName=Root}"
										/>
									<TextBlock
										Grid.Row="2"
										Grid.Column="1"
										Style="{StaticResource KcvAlbum.Value}"
										Text="{Binding Equipment.Range, Converter={StaticResource RangeConverter}}"
										/>

									<TextBlock
										Grid.Row="3"
										Background="Transparent"
										Style="{StaticResource KcvAlbum.Key}"
										Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleAircraftCost, ElementName=Root}"
										ToolTip="{Binding AircraftCostToolTip}"
										Visibility="{Binding IsAircraft, Converter={StaticResource KcvRec.Visible}}"
										/>
									<TextBlock
										Grid.Row="3"
										Grid.Column="1"
										Background="Transparent"
										Style="{StaticResource KcvAlbum.Value}"
										Text="{Binding Equipment.AircraftCost}"
										ToolTip="{Binding AircraftCostToolTip}"
										Visibility="{Binding IsAircraft, Converter={StaticResource KcvRec.Visible}}"
										/>

									<TextBlock
										Grid.Row="4"
										Style="{StaticResource KcvAlbum.Key}"
										Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleAircraftDistance, ElementName=Root}"
										Visibility="{Binding IsAircraft, Converter={StaticResource KcvRec.Visible}}"
										/>
									<TextBlock
										Grid.Row="4"
										Grid.Column="1"
										Style="{StaticResource KcvAlbum.Value}"
										Text="{Binding Equipment.AircraftDistance}"
										Visibility="{Binding IsAircraft, Converter={StaticResource KcvRec.Visible}}"
										/>

									<TextBlock
										Grid.Row="5"
										Style="{StaticResource KcvAlbum.Key}"
										Text="{Binding DataContext.DialogAlbumMasterEquipment.TitleDismantling, ElementName=Root}"
										/>
									<WrapPanel Grid.Row="5" Grid.Column="1">
										<Rectangle Fill="{StaticResource KcvRec.Fuel}" Style="{StaticResource KcvRec.Dot}" />
										<TextBlock
											Margin="0 1 7 1"
											Style="{StaticResource KcvAlbum.Value}"
											Text="{Binding Equipment.Material[0]}"
											/>
										<Rectangle Fill="{StaticResource KcvRec.Ammo}" Style="{StaticResource KcvRec.Dot}" />
										<TextBlock
											Margin="0 1 7 1"
											Style="{StaticResource KcvAlbum.Value}"
											Text="{Binding Equipment.Material[1]}"
											/>
										<Rectangle Fill="{StaticResource KcvRec.Steel}" Style="{StaticResource KcvRec.Dot}" />
										<TextBlock
											Margin="0 1 7 1"
											Style="{StaticResource KcvAlbum.Value}"
											Text="{Binding Equipment.Material[2]}"
											/>
										<Rectangle Fill="{StaticResource KcvRec.Bauxite}" Style="{StaticResource KcvRec.Dot}" />
										<TextBlock Style="{StaticResource KcvAlbum.Value}" Text="{Binding Equipment.Material[3]}" />
									</WrapPanel>
								</Grid>
							</Border>
						</StackPanel>
					</Grid>

					<!--  improvement: the resources, the cost per ★ range, the helpers by day and the conversion  -->
					<Border DataContext="{Binding UpgradeViewModel}">
						<Border.Style>
							<Style BasedOn="{StaticResource KcvAlbum.Card}" TargetType="Border">
								<Style.Triggers>
									<DataTrigger Binding="{Binding UpgradeViewModels.Count}" Value="0">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<StackPanel>
							<Grid>
								<TextBlock Style="{StaticResource KcvAlbum.CardTitle}" Text="{x:Static fork:ForkStrings.KcvAlbumUpgrade}" />
								<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
									<TextBlock
										Margin="0 0 6 4"
										Style="{StaticResource KcvAlbum.CardTitle}"
										Text="{x:Static fork:ForkStrings.KcvAlbumUpgradeResources}"
										/>
									<Rectangle
										Margin="0 0 3 4"
										Fill="{StaticResource KcvRec.Fuel}"
										Style="{StaticResource KcvRec.Dot}"
										/>
									<TextBlock
										Margin="0 0 8 4"
										FontSize="12"
										Text="{Binding Fuel}"
										/>
									<Rectangle
										Margin="0 0 3 4"
										Fill="{StaticResource KcvRec.Ammo}"
										Style="{StaticResource KcvRec.Dot}"
										/>
									<TextBlock
										Margin="0 0 8 4"
										FontSize="12"
										Text="{Binding Ammo}"
										/>
									<Rectangle
										Margin="0 0 3 4"
										Fill="{StaticResource KcvRec.Steel}"
										Style="{StaticResource KcvRec.Dot}"
										/>
									<TextBlock
										Margin="0 0 8 4"
										FontSize="12"
										Text="{Binding Steel}"
										/>
									<Rectangle
										Margin="0 0 3 4"
										Fill="{StaticResource KcvRec.Bauxite}"
										Style="{StaticResource KcvRec.Dot}"
										/>
									<TextBlock
										Margin="0 0 0 4"
										FontSize="12"
										Text="{Binding Bauxite}"
										/>
								</StackPanel>
							</Grid>

							<ItemsControl Focusable="False" ItemsSource="{Binding UpgradeViewModels}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type upgrade:AlbumMasterEquipmentUpgradeGroupViewModel}">
										<Border
											x:Name="Group"
											Margin="0 6 0 0"
											Padding="0 6 0 0"
											BorderBrush="{DynamicResource Kcv.ButtonBorder}"
											BorderThickness="0 1 0 0"
											>
											<StackPanel>
												<!--  the cost table: ★, development and improvement materials (normal / sure), what it consumes  -->
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="56" />
														<ColumnDefinition Width="84" />
														<ColumnDefinition Width="84" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<Border Grid.Column="0" Style="{StaticResource TableHead}">
														<TextBlock Text="{Binding EquipmentUpgradeTranslation.UpgradeLevel}" />
													</Border>
													<Border Grid.Column="1" Style="{StaticResource TableHead}">
														<TextBlock Text="{x:Static fork:ForkStrings.KcvAlbumDevelopmentMaterial}" />
													</Border>
													<Border Grid.Column="2" Style="{StaticResource TableHead}">
														<TextBlock Text="{x:Static fork:ForkStrings.KcvAlbumImprovementMaterial}" />
													</Border>
													<Border
														Grid.Column="3"
														BorderThickness="0 0 0 1"
														Style="{StaticResource TableHead}"
														>
														<TextBlock Text="{Binding EquipmentUpgradeTranslation.RequiredItems}" />
													</Border>
												</Grid>
												<ItemsControl Focusable="False" ItemsSource="{Binding RequiredItemsPerLevel}">
													<ItemsControl.ItemTemplate>
														<DataTemplate DataType="{x:Type upgrade:AlbumMasterEquipmentUpgradeLevelViewModel}">
															<Grid>
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="56" />
																	<ColumnDefinition Width="84" />
																	<ColumnDefinition Width="84" />
																	<ColumnDefinition Width="*" />
																</Grid.ColumnDefinitions>
																<Border Grid.Column="0" Style="{StaticResource TableCell}">
																	<TextBlock Text="{Binding UpgradeLevelsDisplay, Converter={StaticResource KcvAlbum.UpgradeRange}}" />
																</Border>
																<Border Grid.Column="1" Style="{StaticResource TableCell}">
																	<TextBlock>
																		<Run Text="{Binding EquipmentUpgradeCost.DevmatCost, Mode=OneWay}" />
																		<Run Text="/" />
																		<Run Text="{Binding EquipmentUpgradeCost.SliderDevmatCost, Mode=OneWay}" />
																	</TextBlock>
																</Border>
																<Border Grid.Column="2" Style="{StaticResource TableCell}">
																	<TextBlock>
																		<Run Text="{Binding EquipmentUpgradeCost.ImproveMatCost, Mode=OneWay}" />
																		<Run Text="/" />
																		<Run Text="{Binding EquipmentUpgradeCost.SliderImproveMatCost, Mode=OneWay}" />
																	</TextBlock>
																</Border>
																<Border Grid.Column="3" Style="{StaticResource TableCell}">
																	<ContentControl
																		Content="{Binding RequiredItems}"
																		ContentTemplate="{StaticResource ItemCost}"
																		Focusable="False"
																		/>
																</Border>
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<!--  the helpers: the days (Monday first) and the ships, one line per group  -->
												<ItemsControl
													Margin="0 6 0 0"
													Focusable="False"
													ItemsSource="{Binding Helpers}"
													>
													<ItemsControl.ItemTemplate>
														<DataTemplate DataType="{x:Type helpers:EquipmentUpgradeHelpersViewModel}">
															<Grid Margin="0 0 0 2">
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="Auto" />
																	<ColumnDefinition Width="*" />
																</Grid.ColumnDefinitions>
																<ItemsControl
																	Margin="0 0 10 3"
																	VerticalAlignment="Top"
																	Focusable="False"
																	ItemTemplate="{StaticResource Day}"
																	ItemsPanel="{StaticResource KcvRec.Horizontal}"
																	ItemsSource="{Binding Days}"
																	/>
																<ItemsControl
																	Grid.Column="1"
																	Focusable="False"
																	ItemTemplate="{StaticResource Helper}"
																	ItemsPanel="{StaticResource Wrap}"
																	ItemsSource="{Binding Helpers}"
																	/>
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<!--  the conversion: into what, its cost at ★max and its helpers  -->
												<ItemsControl Focusable="False" ItemsSource="{Binding ConversionViewModel}">
													<ItemsControl.ItemTemplate>
														<DataTemplate DataType="{x:Type upgrade:EquipmentUpgradeConversionViewModel}">
															<Border
																Margin="0 6 0 0"
																Padding="0 5 0 0"
																BorderBrush="{DynamicResource Kcv.ButtonBorder}"
																BorderThickness="0 1 0 0"
																>
																<StackPanel>
																	<WrapPanel Margin="0 0 0 4">
																		<TextBlock Margin="0 1 4 1" Style="{StaticResource KcvAlbum.Value}">
																			<Run Text="{x:Static fork:ForkStrings.KcvAlbumConversion}" />
																			<Run Text="{Binding DataContext.Equipment.NameEN, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
																			<Run Text="→" />
																		</TextBlock>
																		<TextBlock
																			MouseRightButtonUp="OpenConvertedEquipment"
																			Style="{StaticResource KcvAlbum.Link}"
																			Tag="{Binding EquipmentAfterConversion}"
																			Text="{Binding EquipmentAfterConversion.NameEN}"
																			ToolTip="{x:Static fork:ForkStrings.KcvAlbumRightClickEquipment}"
																			/>
																	</WrapPanel>
																	<Grid>
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="84" />
																			<ColumnDefinition Width="84" />
																			<ColumnDefinition Width="*" />
																		</Grid.ColumnDefinitions>
																		<Border Grid.Column="0" Style="{StaticResource TableHead}">
																			<TextBlock Text="{x:Static fork:ForkStrings.KcvAlbumDevelopmentMaterial}" />
																		</Border>
																		<Border Grid.Column="1" Style="{StaticResource TableHead}">
																			<TextBlock Text="{x:Static fork:ForkStrings.KcvAlbumImprovementMaterial}" />
																		</Border>
																		<Border
																			Grid.Column="2"
																			BorderThickness="0 0 0 1"
																			Style="{StaticResource TableHead}"
																			>
																			<TextBlock Text="{Binding DataContext.EquipmentUpgradeTranslation.RequiredItems, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
																		</Border>
																	</Grid>
																	<Grid>
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition Width="84" />
																			<ColumnDefinition Width="84" />
																			<ColumnDefinition Width="*" />
																		</Grid.ColumnDefinitions>
																		<Border Grid.Column="0" Style="{StaticResource TableCell}">
																			<TextBlock>
																				<Run Text="{Binding ImprovementModel.Costs.CostMax.DevmatCost, Mode=OneWay}" />
																				<Run Text="/" />
																				<Run Text="{Binding ImprovementModel.Costs.CostMax.SliderDevmatCost, Mode=OneWay}" />
																			</TextBlock>
																		</Border>
																		<Border Grid.Column="1" Style="{StaticResource TableCell}">
																			<TextBlock>
																				<Run Text="{Binding ImprovementModel.Costs.CostMax.ImproveMatCost, Mode=OneWay}" />
																				<Run Text="/" />
																				<Run Text="{Binding ImprovementModel.Costs.CostMax.SliderImproveMatCost, Mode=OneWay}" />
																			</TextBlock>
																		</Border>
																		<Border Grid.Column="2" Style="{StaticResource TableCell}">
																			<ContentControl
																				Content="{Binding ConversionCost}"
																				ContentTemplate="{StaticResource ItemCost}"
																				Focusable="False"
																				/>
																		</Border>
																	</Grid>
																	<DockPanel Margin="0 4 0 0">
																		<TextBlock
																			Margin="0 0 6 0"
																			VerticalAlignment="Top"
																			DockPanel.Dock="Left"
																			Style="{StaticResource KcvAlbum.Grey}"
																			Text="{Binding DataContext.EquipmentUpgradeTranslation.Helpers, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																			/>
																		<ItemsControl
																			Focusable="False"
																			ItemTemplate="{StaticResource Helper}"
																			ItemsPanel="{StaticResource Wrap}"
																			ItemsSource="{Binding Helpers}"
																			/>
																	</DockPanel>
																</StackPanel>
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Border>
										<DataTemplate.Triggers>
											<!--  no line over the first group  -->
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
												<Setter TargetName="Group" Property="BorderThickness" Value="0" />
												<Setter TargetName="Group" Property="Margin" Value="0" />
												<Setter TargetName="Group" Property="Padding" Value="0" />
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<!--  the status bar: the equipment the search shows  -->
		<Border Grid.Row="3" Style="{StaticResource KcvRec.StatusBar}">
			<TextBlock x:Name="Count" />
		</Border>
	</Grid>
</common:WindowBase>

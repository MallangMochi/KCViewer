<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvSortieRecordWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:behaviors="clr-namespace:KCViewer.Behaviors"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:persistentColumns="clr-namespace:KCViewer.Behaviors.PersistentColumns"
	xmlns:sortie="clr-namespace:KCViewer.Window.Tools.SortieRecordViewer"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding SortieRecordViewer.Title}"
	Width="800"
	Height="450"
	d:DataContext="{d:DesignInstance sortie:SortieRecordViewerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="sortie:SortieRecordViewerViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the sortie record in KanColleViewer's style (mockup v5, viewer-design/mockups/20261004-sortie-record-v5.html,
		approved 2026-10-04) with the viewer's view model. Columns 시간·해역·맵·경로·함대: the route is the nodes passed,
		coloured by kind, with the kind and the battle's rank in each node's tooltip (read in the background from the
		record database, KcvSortieRoutes); the fleet is ship chips. The menus, the quick export row, the row menu and the
		dialogs are the viewer's.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<kcv:KcvSortieRoutes x:Key="Routes" />
			<kcv:KcvRouteConverter x:Key="RouteOf" Routes="{StaticResource Routes}" />

			<Style
				x:Key="QuickExport"
				BasedOn="{StaticResource KcvRec.Button}"
				TargetType="Button"
				>
				<Setter Property="Margin" Value="0 0 4 4" />
				<Setter Property="Padding" Value="8 1" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="FontSize" Value="12" />
			</Style>

			<DataTemplate x:Key="RouteNode" DataType="{x:Type kcv:KcvRouteNode}">
				<StackPanel Orientation="Horizontal">
					<TextBlock
						x:Name="Arrow"
						Margin="2 0"
						VerticalAlignment="Center"
						FontSize="9"
						Foreground="{DynamicResource Kcv.FaintForeground}"
						Text="▸"
						/>
					<Border Style="{StaticResource KcvRec.Node}" ToolTip="{Binding ToolTip}">
						<TextBlock HorizontalAlignment="Center" Text="{Binding Letter}" />
					</Border>
				</StackPanel>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding IsFirst}" Value="True">
						<Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Menu Grid.Row="0">
				<MenuItem Header="{Binding SortieRecordViewer.File}">
					<MenuItem Command="{Binding LoadSortieDataCommand}" Header="{Binding SortieRecordViewer.LoadSortieData}" />
				</MenuItem>
				<MenuItem Header="{Binding SortieRecordViewer.View}">
					<MenuItem
						Header="{Binding SortieRecordViewer.ShowQuickExport}"
						IsCheckable="True"
						IsChecked="{Binding ShowQuickExport}"
						/>
				</MenuItem>
			</Menu>

			<!--  퀵 내보내기: every searched sortie through the export filter dialog, as the viewer  -->
			<Border
				Grid.Row="1"
				Padding="8 4 8 0"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="0 0 0 1"
				Visibility="{Binding ShowQuickExport, Converter={StaticResource KcvRec.Visible}}"
				>
				<WrapPanel>
					<Button
						Command="{Binding ExportShellingBattleCommand}"
						Content="{x:Static translations:CsvExportResources.ShellingBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportNightBattleCommand}"
						Content="{x:Static translations:CsvExportResources.NightBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportTorpedoBattleCommand}"
						Content="{x:Static translations:CsvExportResources.TorpedoBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportAirBattleCommand}"
						Content="{x:Static translations:CsvExportResources.AirBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportAirBaseBattleCommand}"
						Content="{x:Static translations:CsvExportResources.AirBaseBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportRedShellingBattleCommand}"
						Content="{x:Static translations:CsvExportResources.RedShellingBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportRedNightBattleCommand}"
						Content="{x:Static translations:CsvExportResources.RedNightBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportRedTorpedoBattleCommand}"
						Content="{x:Static translations:CsvExportResources.RedTorpedoBattle}"
						Style="{StaticResource QuickExport}"
						/>
					<Button
						Command="{Binding ExportAirBaseAirDefenseCommand}"
						Content="{x:Static translations:CsvExportResources.AirBaseAirDefense}"
						Style="{StaticResource QuickExport}"
						/>
				</WrapPanel>
			</Border>

			<!--  검색 조건: 기간 (date and time), 해역, 맵, 보스 도달  -->
			<ContentControl Grid.Row="2" Style="{StaticResource KcvRec.Conditions}">
				<DockPanel>
					<StackPanel
						VerticalAlignment="Bottom"
						DockPanel.Dock="Right"
						Orientation="Horizontal"
						>
						<Button
							Command="{Binding SearchCommand}"
							Content="{x:Static fork:ForkStrings.KcvRecordSearch}"
							Style="{StaticResource KcvRec.PrimaryButton}"
							/>
						<Button
							Command="{Binding SearchCancelCommand}"
							Content="{x:Static fork:ForkStrings.KcvRecordCancel}"
							Style="{StaticResource KcvRec.Button}"
							/>
						<Button
							Click="ResetConditions"
							Content="{x:Static fork:ForkStrings.KcvRecordReset}"
							Style="{StaticResource KcvRec.Button}"
							/>
					</StackPanel>
					<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
						<kcv:KcvRecordPeriod Margin="0 0 14 0" />
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding SortieRecordViewer.World, StringFormat={}{0}:}" />
							<ComboBox
								ItemsSource="{Binding Worlds}"
								SelectedItem="{Binding World}"
								Style="{StaticResource KcvRec.Combo}"
								/>
						</StackPanel>
						<StackPanel Style="{StaticResource KcvRec.Pair}">
							<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding SortieRecordViewer.Map, StringFormat={}{0}:}" />
							<ComboBox
								ItemsSource="{Binding Maps}"
								SelectedItem="{Binding Map}"
								Style="{StaticResource KcvRec.Combo}"
								/>
						</StackPanel>
						<CheckBox
							Content="{Binding SortieRecordViewer.BossNodeOnly}"
							IsChecked="{Binding BossNodeOnly}"
							Style="{StaticResource KcvRec.Check}"
							/>
					</WrapPanel>
				</DockPanel>
			</ContentControl>

			<DataGrid
				x:Name="Table"
				Grid.Row="3"
				ItemsSource="{Binding Sorties}"
				SelectedItem="{Binding SelectedSortie}"
				Style="{StaticResource KcvRec.Grid}"
				Tag="{Binding DataGridViewModel}"
				>
				<b:Interaction.Behaviors>
					<behaviors:MultiSelectionBehavior SelectedItems="{Binding SelectedSorties}" />
					<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridViewModel.SortDescriptions}" />
				</b:Interaction.Behaviors>

				<DataGrid.ContextMenu>
					<ContextMenu>
						<MenuItem Command="{Binding DataGridViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridViewModel.DataGrid.OpenColumnSelector}" />
						<MenuItem Command="{Binding DataGridViewModel.ClearSortingCommand}" Header="{Binding DataGridViewModel.DataGrid.ClearSorting}" />
						<Separator />
						<MenuItem Command="{Binding OpenFleetImageGeneratorCommand}" Header="{Binding SortieRecordViewer.FleetImage}" />
						<MenuItem Header="{Binding SortieRecordViewer.Replay}">
							<MenuItem Command="{Binding CopyReplayLinkToClipboardCommand}" Header="{Binding SortieRecordViewer.CopyLink}" />
							<MenuItem Command="{Binding CopyReplayDataToClipboardCommand}" Header="{Binding SortieRecordViewer.CopyData}" />
						</MenuItem>
						<MenuItem Command="{Binding ShowSortieDetailsCommand}" Header="{Binding SortieRecordViewer.SortieDetail}" />
						<MenuItem Command="{Binding OpenSortieCostCommand}" Header="{Binding SortieRecordViewer.SortieCost}" />
						<MenuItem Command="{Binding CopySortieDataCommand}" Header="{Binding SortieRecordViewer.CopySortieData}" />
						<MenuItem Header="{Binding SortieRecordViewer.AirControlSimulator}">
							<MenuItem Command="{Binding CopyAirControlSimulatorLinkCommand}" Header="{Binding SortieRecordViewer.CopyLink}" />
							<MenuItem Command="{Binding OpenAirControlSimulatorCommand}" Header="{Binding SortieRecordViewer.Open}" />
						</MenuItem>
						<MenuItem Header="{Binding SortieRecordViewer.OperationRoom}">
							<MenuItem Command="{Binding CopyOperationRoomLinkCommand}" Header="{Binding SortieRecordViewer.CopyLink}" />
							<MenuItem Command="{Binding OpenOperationRoomCommand}" Header="{Binding SortieRecordViewer.Open}" />
						</MenuItem>
						<MenuItem Header="{x:Static translations:CsvExportResources.LogbookRedCsvExport}">
							<MenuItem Command="{Binding ExportShellingBattleCommand}" Header="{x:Static translations:CsvExportResources.ShellingBattle}" />
							<MenuItem Command="{Binding ExportNightBattleCommand}" Header="{x:Static translations:CsvExportResources.NightBattle}" />
							<MenuItem Command="{Binding ExportTorpedoBattleCommand}" Header="{x:Static translations:CsvExportResources.TorpedoBattle}" />
							<MenuItem Command="{Binding ExportAirBattleCommand}" Header="{x:Static translations:CsvExportResources.AirBattle}" />
							<MenuItem Command="{Binding ExportAirBaseBattleCommand}" Header="{x:Static translations:CsvExportResources.AirBaseBattle}" />
							<MenuItem Command="{Binding ExportRedShellingBattleCommand}" Header="{x:Static translations:CsvExportResources.RedShellingBattle}" />
							<MenuItem Command="{Binding ExportRedNightBattleCommand}" Header="{x:Static translations:CsvExportResources.RedNightBattle}" />
							<MenuItem Command="{Binding ExportRedTorpedoBattleCommand}" Header="{x:Static translations:CsvExportResources.RedTorpedoBattle}" />
							<MenuItem Command="{Binding ExportAirBaseAirDefenseCommand}" Header="{x:Static translations:CsvExportResources.AirBaseAirDefense}" />
						</MenuItem>
						<MenuItem Header="CSV">
							<MenuItem Command="{Binding CopySmokerDataCsvCommand}" Header="{Binding SortieRecordViewer.SmokeScreenCsv}" />
							<MenuItem Command="{Binding ExportBattleRanksCommand}" Header="{x:Static translations:CsvExportResources.CombatRankPrediction}" />
						</MenuItem>
						<MenuItem
							Command="{Binding OpenLocalApiLoaderCommand}"
							Header="Local api loader"
							Visibility="{Binding IsDebug, Converter={StaticResource KcvRec.Visible}}"
							/>
					</ContextMenu>
				</DataGrid.ContextMenu>

				<DataGrid.Columns>
					<DataGridTemplateColumn
						Width="140"
						Header="{x:Static fork:ForkStrings.KcvRecordTime}"
						SortMemberPath="SortieStart"
						>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate DataType="{x:Type sortie:SortieRecordViewModel}">
								<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding SortieStart, Converter={StaticResource KcvRec.Time}}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn
						Width="44"
						Header="{x:Static translations:SortieRecordViewerResources.World}"
						SortMemberPath="World"
						>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate DataType="{x:Type sortie:SortieRecordViewModel}">
								<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding World}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn
						Width="40"
						Header="{x:Static translations:SortieRecordViewerResources.Map}"
						SortMemberPath="Map"
						>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate DataType="{x:Type sortie:SortieRecordViewModel}">
								<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding Map}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn
						Width="210"
						CanUserSort="False"
						Header="{x:Static fork:ForkStrings.KcvRecordRoute}"
						>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate DataType="{x:Type sortie:SortieRecordViewModel}">
								<ItemsControl
									Margin="6 0"
									VerticalAlignment="Center"
									
									Focusable="False"
									ItemTemplate="{StaticResource RouteNode}"
									ItemsPanel="{StaticResource KcvRec.Horizontal}"
									>
									<ItemsControl.ItemsSource>
										<MultiBinding Converter="{StaticResource RouteOf}">
											<Binding Path="Id" />
											<Binding Path="Version" Source="{StaticResource Routes}" />
										</MultiBinding>
									</ItemsControl.ItemsSource>
								</ItemsControl>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn
						x:Name="FleetColumn"
						Width="Auto"
						MinWidth="120"
						CanUserSort="False"
						Header="{x:Static translations:SortieRecordViewerResources.Fleet}"
						>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate DataType="{x:Type sortie:SortieRecordViewModel}">
								<ItemsControl ItemsSource="{Binding Converter={StaticResource KcvRec.FleetShips}}" Style="{StaticResource KcvRec.Fleet}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

			<Border Grid.Row="4" Style="{StaticResource KcvRec.StatusBar}">
				<DockPanel>
					<TextBlock x:Name="SelectionText" DockPanel.Dock="Right" />
					<TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
				</DockPanel>
			</Border>
		</Grid>
	</Grid>
</common:WindowBase>

<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvEquipmentListWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding Title}"
	Width="860"
	Height="600"
	d:DataContext="{d:DesignInstance kcv:KcvEquipmentListViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="kcv:KcvEquipmentListViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the equipment list as KanColleViewer's 所有装備一覧 (viewer-design/kcv-reference/03-equipment-list.png).
		表示の更新 on top, the name box and the viewer's type filter under it (folded as the ship list's, the fold kept;
		mockup 20261005-list-search-v2), then one table: equipment name with its icon, total, and per
		improvement level ★+n, owned (spare) and the ships holding it. Right click a row: the equipment encyclopedia.
		The name, total and owned headers sort the list (rules in the view model), with the ship list's arrows.
	-->
	<Window.Resources>
		<!--  A sortable header, drawn as the ship list's: dim text, brighter under the mouse, ▼ / ▲ by Tag  -->
		<Style x:Key="SortHeader" TargetType="Button">
			<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Padding="8 6" Background="{TemplateBinding Background}">
							<DockPanel>
								<Path
									x:Name="Arrow"
									Width="8"
									Height="5"
									Margin="4 0 0 0"
									VerticalAlignment="Center"
									Data="M 0,0 L 4,5 L 8,0 Z"
									DockPanel.Dock="Right"
									Fill="{DynamicResource Kcv.SubForeground}"
									Visibility="Collapsed"
									/>
								<ContentPresenter VerticalAlignment="Center" />
							</DockPanel>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="Tag" Value="Descending">
								<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="Tag" Value="Ascending">
								<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
								<Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 4,0 L 8,5 Z" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SortHeaderText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
		</Style>

		<Style x:Key="Header" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Padding" Value="8 6" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style x:Key="HeaderCell" TargetType="Border">
			<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
			<Setter Property="BorderThickness" Value="0 0 1 0" />
		</Style>
		<Style x:Key="Cell" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="8 4" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>

		<Style x:Key="Row" TargetType="ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Back" Background="Transparent">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="12 8 12 10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!--  表示の更新, locked only  -->
		<StackPanel Grid.Row="0" Orientation="Horizontal">
			<Button
				MinWidth="140"
				MinHeight="28"
				Command="{Binding UpdateCommand}"
				Content="{x:Static fork:ForkStrings.KcvRefresh}"
				/>
			<CheckBox
				Margin="16 0 0 0"
				Content="{Binding DialogEquipmentList.ShowLockedEquipmentOnly}"
				IsChecked="{Binding ShowLockedEquipmentOnly}"
				/>
		</StackPanel>

		<!--
			フィルター設定 (folds the categories), the name box, shown folded too, and while folded how many categories
			show (mockup 20261005-list-search-v2)
		-->
		<StackPanel
			Grid.Row="1"
			Margin="0 6"
			Orientation="Horizontal"
			>
			<StackPanel.Resources>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</StackPanel.Resources>
			<ToggleButton IsChecked="{Binding FiltersExpanded}" Style="{StaticResource Kcv.FilterFold}" />
			<TextBlock Margin="28 0 0 0" Style="{StaticResource KcvRec.FirstLabel}">
				<Run Text="{x:Static fork:ForkStrings.KcvEquipmentName}" /><Run Text=":" />
			</TextBlock>
			<TextBox
				Width="300"
				Style="{StaticResource KcvRec.TextBox}"
				Tag="{x:Static fork:ForkStrings.KcvPickerNameHint}"
				Text="{Binding Filters.NameFilter, UpdateSourceTrigger=PropertyChanged}"
				/>
			<TextBlock
				Margin="16 0 0 0"
				VerticalAlignment="Center"
				FontSize="12"
				Foreground="{DynamicResource Kcv.InProgressBadgeForeground}"
				Text="{Binding AppliedText}"
				/>
		</StackPanel>

		<!--  Categories with their icons (only those of owned equipment) and all on / off, in a box as the ship list's filters  -->
		<Border
			Grid.Row="2"
			Margin="0 0 0 6"
			Padding="10 6"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="1"
			Visibility="{Binding FiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
			>
			<StackPanel DataContext="{Binding Filters}">
				<ItemsControl ItemsSource="{Binding Categories}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type kcv:KcvEquipmentCategoryFilter}">
							<CheckBox
								Width="152"
								Margin="0 0 4 0"
								IsChecked="{Binding IsChecked}"
								ToolTip="{Binding Name}"
								>
								<StackPanel Orientation="Horizontal">
									<Image
										Width="24"
										Height="24"
										Margin="0 0 4 0"
										Source="{Binding Icon, Converter={StaticResource Kcv.GameIcon}}"
										Style="{StaticResource Kcv.EquipmentIcon}"
										/>
									<TextBlock
										MaxWidth="100"
										VerticalAlignment="Center"
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis"
										/>
								</StackPanel>
							</CheckBox>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Button
					Margin="0 6 0 0"
					HorizontalAlignment="Left"
					Command="{Binding ToggleAllCommand}"
					Content="{x:Static fork:ForkStrings.KcvToggleAll}"
					/>
			</StackPanel>
		</Border>

		<Border
			Grid.Row="3"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="1"
			>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Background="{DynamicResource Kcv.TableHeaderBackground}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="230" />
						<ColumnDefinition Width="56" />
						<ColumnDefinition Width="70" />
						<ColumnDefinition Width="110" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Style="{StaticResource HeaderCell}">
						<Button
							Command="{Binding SortCommand}"
							CommandParameter="{x:Static kcv:KcvEquipmentSort.Name}"
							Style="{StaticResource SortHeader}"
							Tag="{Binding NameSort}"
							>
							<TextBlock Style="{StaticResource SortHeaderText}" Text="{x:Static fork:ForkStrings.KcvEquipmentName}" />
						</Button>
					</Border>
					<Border Grid.Column="1" Style="{StaticResource HeaderCell}">
						<Button
							Command="{Binding SortCommand}"
							CommandParameter="{x:Static kcv:KcvEquipmentSort.Total}"
							Style="{StaticResource SortHeader}"
							Tag="{Binding TotalSort}"
							>
							<TextBlock Style="{StaticResource SortHeaderText}" Text="{x:Static fork:ForkStrings.KcvTotal}" />
						</Button>
					</Border>
					<!--  improvement levels and holders are several lines per equipment: not sortable  -->
					<Border Grid.Column="2" Style="{StaticResource HeaderCell}">
						<TextBlock Style="{StaticResource Header}" Text="{x:Static fork:ForkStrings.KcvImprovement}" />
					</Border>
					<Border Grid.Column="3" Style="{StaticResource HeaderCell}">
						<Button
							Command="{Binding SortCommand}"
							CommandParameter="{x:Static kcv:KcvEquipmentSort.Owned}"
							Style="{StaticResource SortHeader}"
							Tag="{Binding OwnedSort}"
							>
							<TextBlock Style="{StaticResource SortHeaderText}" Text="{x:Static fork:ForkStrings.KcvOwnedSpare}" />
						</Button>
					</Border>
					<TextBlock
						Grid.Column="4"
						Style="{StaticResource Header}"
						Text="{x:Static fork:ForkStrings.KcvEquippedBy}"
						/>
				</Grid>

				<ListBox
					Grid.Row="1"
					Background="Transparent"
					BorderThickness="0"
					ItemContainerStyle="{StaticResource Row}"
					ItemsSource="{Binding Groups}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					VirtualizingPanel.IsVirtualizing="True"
					VirtualizingPanel.ScrollUnit="Pixel"
					>
					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type kcv:KcvEquipmentGroup}">
							<Border
								Background="Transparent"
								BorderBrush="{DynamicResource Kcv.Separator}"
								BorderThickness="0 0 0 1"
								>
								<Border.InputBindings>
									<MouseBinding
										Command="{Binding DataContext.OpenEquipmentEncyclopediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
										CommandParameter="{Binding Id}"
										MouseAction="RightClick"
										/>
								</Border.InputBindings>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="230" />
										<ColumnDefinition Width="56" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<StackPanel
										Grid.Column="0"
										Margin="8 4"
										VerticalAlignment="Top"
										Background="Transparent"
										Orientation="Horizontal"
										ToolTip="{Binding ToolTip}"
										>
										<Image
											Width="26"
											Height="26"
											Source="{Binding IconType, Converter={StaticResource Kcv.GameIcon}}"
											Style="{StaticResource Kcv.EquipmentIcon}"
											/>
										<TextBlock
											MaxWidth="190"
											Margin="6 0 0 0"
											VerticalAlignment="Center"
											FontSize="13"
											Style="{StaticResource Kcv.Text}"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis"
											/>
									</StackPanel>

									<TextBlock
										Grid.Column="1"
										Style="{StaticResource Cell}"
										Text="{Binding Total}"
										/>

									<!--  One line per improvement level  -->
									<ItemsControl Grid.Column="2" ItemsSource="{Binding Levels}">
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="{x:Type kcv:KcvEquipmentLevel}">
												<Border x:Name="Line" BorderBrush="{DynamicResource Kcv.Separator}">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="70" />
															<ColumnDefinition Width="110" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>

														<StackPanel
															Grid.Column="0"
															Margin="8 4"
															VerticalAlignment="Top"
															Orientation="Horizontal"
															>
															<TextBlock
																FontSize="13"
																Foreground="{Binding Level, Converter={StaticResource Kcv.StarBrush}}"
																Text="{Binding LevelText}"
																/>
															<common:AircraftProficiency
																x:Name="Proficiency"
																Margin="4 0 0 0"
																VerticalAlignment="Center"
																AircraftLevel="{Binding AircraftLevel}"
																/>
														</StackPanel>

														<TextBlock Grid.Column="1" Style="{StaticResource Cell}">
															<Run Text="{Binding Count, Mode=OneWay}" />
															<Run
																FontSize="11"
																Foreground="{DynamicResource Kcv.SubForeground}"
																Text="{Binding Spare, Mode=OneWay, StringFormat=({0})}"
																/>
														</TextBlock>

														<ItemsControl
															Grid.Column="2"
															Margin="8 4 4 4"
															ItemsSource="{Binding Holders}"
															>
															<ItemsControl.ItemsPanel>
																<ItemsPanelTemplate>
																	<WrapPanel Orientation="Horizontal" />
																</ItemsPanelTemplate>
															</ItemsControl.ItemsPanel>
															<ItemsControl.ItemTemplate>
																<DataTemplate DataType="{x:Type kcv:KcvEquipmentHolder}">
																	<TextBlock
																		Margin="0 0 16 2"
																		FontSize="13"
																		Style="{StaticResource Kcv.Text}"
																		>
																		<Run Text="{Binding Name, Mode=OneWay}" />
																		<Run
																			FontSize="11"
																			Foreground="{DynamicResource Kcv.SubForeground}"
																			Text="{Binding Level, Mode=OneWay}"
																			/><Run
																			FontSize="11"
																			Foreground="{DynamicResource Kcv.SubForeground}"
																			Text="{Binding CountText, Mode=OneWay}"
																			/>
																	</TextBlock>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</Grid>
												</Border>
												<DataTemplate.Triggers>
													<!--  A line above every improvement level but the first  -->
													<DataTrigger Binding="{Binding IsFirst}" Value="False">
														<Setter TargetName="Line" Property="BorderThickness" Value="0 1 0 0" />
													</DataTrigger>
													<DataTrigger Binding="{Binding AircraftLevel}" Value="0">
														<Setter TargetName="Proficiency" Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</DataTemplate.Triggers>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>
	</Grid>
</common:WindowBase>

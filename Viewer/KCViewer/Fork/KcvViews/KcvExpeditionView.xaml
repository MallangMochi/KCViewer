<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvExpeditionView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance Type=kcv:KcvExpeditionViewModel}"
	d:DesignHeight="120"
	d:DesignWidth="260"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the expeditions of fleets 2 to 4 drawn as the dock and arsenal tables (KcvDockView, mockup v2 approved
		2026-10-02): a vertical label, then fleet number, the expedition in progress and the time left. A fleet not on an
		expedition reads 待機中 (as an empty dock), a fleet not opened yet 艦隊未開放 dimmed (as a locked dock). The time
		left has the return time as its tooltip (KcvExpeditionViewModel).
		The context menu lays the fleets out side by side as cells that wrap, without the header, or one under another
		as the table (default), and shows or hides the expedition names (off: 「[02]」, the name in the tooltip, and
		narrower cells); the time left reads 「완료!」 once it is over (mockup 20261006-timer-panels-v2).
	-->
	<UserControl.Resources>
		<kcv:KcvTimeLeftConverter x:Key="TimeLeft" />

		<ItemsPanelTemplate x:Key="OneUnderAnother">
			<StackPanel />
		</ItemsPanelTemplate>
		<!--  side by side: the cells share the width, at least their minimum (the offset: margins 20, label 24, gap 4, slack 2)  -->
		<ItemsPanelTemplate x:Key="SideBySide">
			<kcv:KcvCellGrid AvailableWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Offset="50">
				<kcv:KcvCellGrid.Style>
					<Style TargetType="kcv:KcvCellGrid">
						<Style.Triggers>
							<!--  원정명을 표시 off: the number only, so narrower cells (150: 「[02]」 and 「대기 중」 still read beside the time; 96 of the mockup cut them)  -->
							<DataTrigger Binding="{Binding ShowName}" Value="False">
								<Setter Property="MinCellWidth" Value="150" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</kcv:KcvCellGrid.Style>
			</kcv:KcvCellGrid>
		</ItemsPanelTemplate>

		<!--  A row of the table  -->
		<DataTemplate x:Key="Row" DataType="{x:Type kcv:KcvExpeditionLine}">
			<Grid x:Name="Row" Height="28">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="30" />
					<ColumnDefinition Width="*" MinWidth="64" />
					<ColumnDefinition Width="Auto" SharedSizeGroup="KcvRemaining" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					HorizontalAlignment="Center"
					Style="{StaticResource Kcv.SubText}"
					FontSize="12"
					VerticalAlignment="Center"
					Text="{Binding FleetId}"
					/>

				<TextBlock
					x:Name="Ship"
					Grid.Column="1"
					Style="{StaticResource Kcv.TableCell}"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding NameToolTip}"
					/>
				<TextBlock
					Grid.Column="2"
					Style="{StaticResource Kcv.TableCell}"
					Text="{Binding TimeText, Converter={StaticResource TimeLeft}}"
					ToolTip="{Binding TimeToolTip}"
					/>
			</Grid>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Kcv.RowIndex}, ConverterParameter=Odd}" Value="True">
					<Setter TargetName="Row" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding State}" Value="{x:Static kcv:KcvExpeditionLineState.Idle}">
					<Setter TargetName="Ship" Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding State}" Value="{x:Static kcv:KcvExpeditionLineState.Locked}">
					<Setter TargetName="Ship" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!--  A cell of the side by side layout: number, ship and time left on one line  -->
		<DataTemplate x:Key="Cell" DataType="{x:Type kcv:KcvExpeditionLine}">
			<Border
				Height="28"
				Padding="2 0 8 0"
				Background="{DynamicResource Kcv.AlternateRow}"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="1"
				>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="22" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Column="0"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="12"
						Style="{StaticResource Kcv.SubText}"
						Text="{Binding FleetId}"
						/>
					<TextBlock
						x:Name="Ship"
						Grid.Column="1"
						Style="{StaticResource Kcv.TableCell}"
						Text="{Binding Name}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding NameToolTip}"
						/>
					<TextBlock
						Grid.Column="2"
						Margin="6 0 0 0"
						Style="{StaticResource Kcv.TableCell}"
						Text="{Binding TimeText, Converter={StaticResource TimeLeft}}"
						ToolTip="{Binding TimeToolTip}"
						/>
				</Grid>
			</Border>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding State}" Value="{x:Static kcv:KcvExpeditionLineState.Idle}">
					<Setter TargetName="Ship" Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding State}" Value="{x:Static kcv:KcvExpeditionLineState.Locked}">
					<Setter TargetName="Ship" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</UserControl.Resources>

	<!--
		No horizontal scrolling: in a narrow pane a long name is trimmed (…) and the time left stays in sight. The table
		sits at the top, so in a taller pane the vertical label does not stretch down past the rows (as the expedition panel).
	-->
	<ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
		<!--  sideways only for the cells, which keep their minimum width in a narrow pane; the table trims instead  -->
		<ScrollViewer.Style>
			<Style BasedOn="{StaticResource {x:Type ScrollViewer}}" TargetType="ScrollViewer">
				<Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Horizontal, Source={x:Static kcv:KcvPanelLayout.Expedition}}" Value="True">
						<Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ScrollViewer.Style>
		<ScrollViewer.ContextMenu>
			<ContextMenu>
				<MenuItem
					Header="{x:Static fork:ForkStrings.KcvHorizontalLayout}"
					IsCheckable="True"
					IsChecked="{Binding LayoutHorizontal, Source={x:Static kcv:KcvPanelLayout.Expedition}, Mode=TwoWay}"
					/>
				<MenuItem
					Header="{x:Static fork:ForkStrings.KcvVerticalLayout}"
					IsCheckable="True"
					IsChecked="{Binding LayoutVertical, Source={x:Static kcv:KcvPanelLayout.Expedition}, Mode=TwoWay}"
					/>
				<Separator />
				<MenuItem
					Header="{x:Static fork:ForkStrings.KcvShowExpeditionName}"
					IsCheckable="True"
					IsChecked="{Binding ShowName, Mode=TwoWay}"
					/>
			</ContextMenu>
		</ScrollViewer.ContextMenu>

		<Grid Margin="10 8" VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="24" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="{DynamicResource Kcv.HeaderBackground}">
				<TextBlock Style="{StaticResource Kcv.SideLabel}" Text="{x:Static fork:ForkStrings.KcvExpeditionPanel}" />
			</Border>

			<Grid Grid.Column="1" Grid.IsSharedSizeScope="True">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Background="{DynamicResource Kcv.HeaderBackground}">
					<Grid.Style>
						<Style TargetType="Grid">
							<Style.Triggers>
								<DataTrigger Binding="{Binding Horizontal, Source={x:Static kcv:KcvPanelLayout.Expedition}}" Value="True">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="30" />
						<ColumnDefinition Width="*" MinWidth="64" />
						<ColumnDefinition Width="Auto" SharedSizeGroup="KcvRemaining" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="1" Style="{StaticResource Kcv.TableHeader}" Text="{x:Static fork:ForkStrings.KcvExpeditionInProgress}" />
					<TextBlock Grid.Column="2" Style="{StaticResource Kcv.TableHeader}" Text="{x:Static fork:ForkStrings.KcvRemainingTime}" />
				</Grid>

				<ItemsControl
					Grid.Row="1"
					AlternationCount="8"
					ItemsSource="{Binding Lines}"
					>
					<ItemsControl.Style>
						<Style TargetType="ItemsControl">
							<Setter Property="ItemTemplate" Value="{StaticResource Row}" />
							<Setter Property="ItemsPanel" Value="{StaticResource OneUnderAnother}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Horizontal, Source={x:Static kcv:KcvPanelLayout.Expedition}}" Value="True">
									<Setter Property="ItemTemplate" Value="{StaticResource Cell}" />
									<Setter Property="ItemsPanel" Value="{StaticResource SideBySide}" />
									<Setter Property="Margin" Value="4 0 0 0" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ItemsControl.Style>
				</ItemsControl>
			</Grid>
		</Grid>
	</ScrollViewer>
</UserControl>

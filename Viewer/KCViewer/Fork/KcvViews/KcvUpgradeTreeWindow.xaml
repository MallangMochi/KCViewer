<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvUpgradeTreeWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tree="clr-namespace:KCViewer.Window.Tools.EquipmentUpgradePlanner.UpgradeTree"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Width="860"
	Height="560"
	MinWidth="600"
	MinHeight="300"
	d:DataContext="{d:DesignInstance tree:UpgradeTreeViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="tree:UpgradeTreeViewModel"
	Background="{DynamicResource Kcv.Background}"
	ShowInTaskbar="False"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d"
	>
	<!--
		Fork: the upgrade tree in KanColleViewer's style (mockup 20261009-upgrade-plan-windows-v2, approved 2026-10-09
		"구현") with the viewer's view model: 「개수 트리 - 장비」, [모두 펼치기] [모두 접기], a row per item over the whole
		width (icon, ×count, name and its mark: 목표 ★max / 개수 갱신 / 개발·입수 / 할당됨, none for those got by remodelling)
		with the six costs of a plan in columns, the viewer's right-click menu, and a status bar. At first only the root
		is open.
	-->
	<Window.Resources>
		<kcv:KcvTreeIndentConverter x:Key="Indent" />

		<!--  a header cell with the record tables' line on its right  -->
		<Style x:Key="HeadCell" TargetType="Border">
			<Setter Property="Padding" Value="6 4" />
			<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
			<Setter Property="BorderThickness" Value="0 0 1 0" />
		</Style>

		<Style x:Key="Cost" TargetType="TextBlock">
			<Setter Property="Margin" Value="0 0 6 0" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<!--  The expander arrow: ▸ closed, ▾ open, nothing without children  -->
		<Style x:Key="Arrow" TargetType="ToggleButton">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Width" Value="16" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border Background="Transparent">
							<TextBlock
								x:Name="Glyph"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="10"
								Foreground="{DynamicResource Kcv.InactiveForeground}"
								Text="▸"
								/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Glyph" Property="Text" Value="▾" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  An item's row over the whole width, indented inside, its children under it; hover and selection as the tables  -->
		<Style x:Key="Node" TargetType="TreeViewItem">
			<!--  without this the system's tree item style leaves every text not coloured here black  -->
			<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TreeViewItem">
						<StackPanel>
							<Border
								x:Name="Row"
								MinHeight="28"
								Background="Transparent"
								BorderBrush="{DynamicResource Kcv.HeaderBackground}"
								BorderThickness="0 0 0 1"
								>
								<DockPanel>
									<ToggleButton
										x:Name="Expander"
										Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Indent}}"
										DockPanel.Dock="Left"
										IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
										Style="{StaticResource Arrow}"
										/>
									<ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
								</DockPanel>
							</Border>
							<ItemsPresenter x:Name="ItemsHost" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsExpanded" Value="False">
								<Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
							</Trigger>
							<Trigger Property="HasItems" Value="False">
								<Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
							</Trigger>
							<Trigger SourceName="Row" Property="IsMouseOver" Value="True">
								<Setter TargetName="Row" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Row" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  The mark beside the name: a plan's goal framed in the accent colour, 개발·입수 orange, 할당됨 green  -->
		<Style x:Key="Mark" TargetType="Border">
			<Setter Property="Margin" Value="8 0 0 0" />
			<Setter Property="Padding" Value="6 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextElement.FontSize" Value="11" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding ForkMarkKind}" Value="">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
				<DataTrigger Binding="{Binding ForkMarkKind}" Value="Plan">
					<Setter Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
					<Setter Property="BorderThickness" Value="1" />
				</DataTrigger>
				<DataTrigger Binding="{Binding ForkMarkKind}" Value="Craft">
					<Setter Property="Background" Value="{DynamicResource Kcv.InProgressBadgeBackground}" />
					<Setter Property="TextElement.Foreground" Value="{DynamicResource Kcv.InProgressBadgeForeground}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding ForkMarkKind}" Value="Owned">
					<Setter Property="Background" Value="{DynamicResource Kcv.BadgeBackground}" />
					<Setter Property="TextElement.Foreground" Value="{DynamicResource Kcv.BadgeForeground}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<DockPanel>
		<!--  모두 펼치기 · 모두 접기 · the menu's hint  -->
		<StackPanel
			Margin="12 6 12 8"
			DockPanel.Dock="Top"
			Orientation="Horizontal"
			>
			<Button
				Margin="0 0 6 0"
				Padding="12 2"
				Click="ExpandAll"
				Content="{x:Static fork:ForkStrings.KcvExpandAll}"
				/>
			<Button
				Margin="0 0 6 0"
				Padding="12 2"
				Click="CollapseAll"
				Content="{x:Static fork:ForkStrings.KcvCollapseAll}"
				/>
			<TextBlock
				Margin="8 0 0 0"
				VerticalAlignment="Center"
				FontSize="11"
				Foreground="{DynamicResource Kcv.InactiveForeground}"
				Text="{x:Static fork:ForkStrings.KcvUpgradeTreeHint}"
				/>
		</StackPanel>

		<Border
			Background="{DynamicResource Kcv.StatusBackground}"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<TextBlock
				x:Name="Status"
				Margin="10 4"
				FontSize="12"
				Foreground="{DynamicResource Kcv.SubForeground}"
				/>
		</Border>

		<!--  항목 and the six cost icons over their columns  -->
		<Border
			Background="{DynamicResource Kcv.TableHeaderBackground}"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 1"
			DockPanel.Dock="Top"
			>
			<Grid Margin="0 0 18 0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="58" />
					<ColumnDefinition Width="58" />
					<ColumnDefinition Width="58" />
					<ColumnDefinition Width="58" />
					<ColumnDefinition Width="50" />
					<ColumnDefinition Width="50" />
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" Style="{StaticResource HeadCell}">
					<TextBlock
						FontSize="12"
						Foreground="{DynamicResource Kcv.SubForeground}"
						Text="{x:Static fork:ForkStrings.KcvUpgradeTreeItem}"
						/>
				</Border>
				<Border Grid.Column="1" Style="{StaticResource HeadCell}">
					<Image
						Height="16"
						HorizontalAlignment="Center"
						Source="{x:Static kcv:KcvHqIcons.Fuel}"
						/>
				</Border>
				<Border Grid.Column="2" Style="{StaticResource HeadCell}">
					<Image
						Height="16"
						HorizontalAlignment="Center"
						Source="{x:Static kcv:KcvHqIcons.Ammo}"
						/>
				</Border>
				<Border Grid.Column="3" Style="{StaticResource HeadCell}">
					<Image
						Height="16"
						HorizontalAlignment="Center"
						Source="{x:Static kcv:KcvHqIcons.Steel}"
						/>
				</Border>
				<Border Grid.Column="4" Style="{StaticResource HeadCell}">
					<Image
						Height="16"
						HorizontalAlignment="Center"
						Source="{x:Static kcv:KcvHqIcons.Bauxite}"
						/>
				</Border>
				<Border Grid.Column="5" Style="{StaticResource HeadCell}">
					<Image
						Height="16"
						HorizontalAlignment="Center"
						Source="{x:Static kcv:KcvHqIcons.DevelopmentMaterial}"
						/>
				</Border>
				<Border Grid.Column="6" Style="{StaticResource HeadCell}">
					<Image
						Height="16"
						HorizontalAlignment="Center"
						Source="{x:Static kcv:KcvHqIcons.ImprovementMaterial}"
						/>
				</Border>
			</Grid>
		</Border>

		<TreeView
			x:Name="Tree"
			Background="Transparent"
			BorderThickness="0"
			ItemContainerStyle="{StaticResource Node}"
			ItemsSource="{Binding Items}"
			>
			<!--  the record tables' scroll bar (always drawn, over the rows' right end, which the cost columns leave free)  -->
			<TreeView.Template>
				<ControlTemplate TargetType="TreeView">
					<ScrollViewer
						ui:ScrollViewerHelper.AutoHideScrollBars="False"
						CanContentScroll="False"
						Focusable="False"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto"
						>
						<ItemsPresenter />
					</ScrollViewer>
				</ControlTemplate>
			</TreeView.Template>
			<TreeView.ItemTemplate>
				<HierarchicalDataTemplate DataType="{x:Type tree:UpgradeTreeUpgradePlanViewModel}" ItemContainerStyle="{StaticResource Node}" ItemsSource="{Binding Children}">
					<!--  the right margin as the header's: the scroll bar comes over it  -->
					<Grid Margin="0 0 18 0" Background="Transparent">
						<!--  the viewer's menu, its items shown as the viewer shows them  -->
						<Grid.ContextMenu>
							<ContextMenu>
								<MenuItem
									Command="{Binding AddEquipmentPlanCommand}"
									Header="{Binding Translations.CreateUpgradePlan}"
									Visibility="{Binding CanBePlanned, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding EditEquipmentPlanCommand}"
									Header="{Binding Translations.EditUpgradePlan}"
									Visibility="{Binding AlreadyPlanned, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding RemoveEquipmentPlanCommand}"
									Header="{Binding Translations.RemoveUpgradePlan}"
									Visibility="{Binding AlreadyPlanned, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding CreatePlanAndAssignEquipmentToUpgradeCommand}"
									Header="{Binding Translations.AddPlanAndAssignEquipmentToUpgrade}"
									Visibility="{Binding CanAddPlanAndAssignEquipmentToUpgrade, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding CreatePlanAndAssignEquipmentCommand}"
									Header="{Binding Translations.AddPlanAndAssignEquipmentToUse}"
									Visibility="{Binding CanAddPlanAndAssignEquipmentToConsume, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding AssignEquipmentToUpgradeToPlanCommand}"
									Header="{Binding Translations.AssignEquipmentToUpgrade}"
									Visibility="{Binding CanAssignEquipmentToUpgrade, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding AssignEquipmentToPlanCommand}"
									Header="{Binding Translations.AssignEquipmentToUse}"
									Visibility="{Binding CanAssignEquipmentToConsume, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding UnAssignEquipmentToPlanCommand}"
									Header="{Binding Translations.UnassignEquipment}"
									Visibility="{Binding AlreadyAssignedAnEquipment, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
							</ContextMenu>
						</Grid.ContextMenu>

						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="58" />
							<ColumnDefinition Width="58" />
							<ColumnDefinition Width="58" />
							<ColumnDefinition Width="58" />
							<ColumnDefinition Width="50" />
							<ColumnDefinition Width="50" />
						</Grid.ColumnDefinitions>

						<StackPanel
							Grid.Column="0"
							Margin="2 0 0 0"
							VerticalAlignment="Center"
							Orientation="Horizontal"
							>
							<Image
								Width="20"
								Height="20"
								Margin="0 0 6 0"
								Source="{Binding ForkIcon, Converter={StaticResource Kcv.GameIcon}}"
								Style="{StaticResource Kcv.EquipmentIcon}"
								/>
							<TextBlock
								Margin="0 0 6 0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource Kcv.InactiveForeground}"
								Text="{Binding ForkCount}"
								/>
							<TextBlock VerticalAlignment="Center" Text="{Binding ForkName}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding ForkIsPlan}" Value="True">
												<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
												<Setter Property="FontWeight" Value="SemiBold" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<Border Style="{StaticResource Mark}">
								<!--  the goal's level in its improvement colour, as the planner's cards; the runs touch, so no space between  -->
								<TextBlock><Run Text="{Binding ForkMark, Mode=OneWay}" /><Run Foreground="{Binding ForkGoalLevel, Converter={StaticResource Kcv.UpgradeLevel}, ConverterParameter=Brush}" Text="{Binding ForkGoal, Mode=OneWay}" /></TextBlock>
							</Border>
						</StackPanel>

						<!--  a plan's costs up to its goal; nothing when its resources are all 0, as the viewer's  -->
						<TextBlock
							Grid.Column="1"
							Style="{StaticResource Cost}"
							Text="{Binding Cost.Fuel.Required}"
							/>
						<TextBlock
							Grid.Column="2"
							Style="{StaticResource Cost}"
							Text="{Binding Cost.Ammo.Required}"
							/>
						<TextBlock
							Grid.Column="3"
							Style="{StaticResource Cost}"
							Text="{Binding Cost.Steel.Required}"
							/>
						<TextBlock
							Grid.Column="4"
							Style="{StaticResource Cost}"
							Text="{Binding Cost.Bauxite.Required}"
							/>
						<TextBlock
							Grid.Column="5"
							Style="{StaticResource Cost}"
							Text="{Binding Cost.DevelopmentMaterial.Required}"
							/>
						<TextBlock
							Grid.Column="6"
							Style="{StaticResource Cost}"
							Text="{Binding Cost.ImprovementMaterial.Required}"
							/>
					</Grid>
				</HierarchicalDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
	</DockPanel>
</common:WindowBase>

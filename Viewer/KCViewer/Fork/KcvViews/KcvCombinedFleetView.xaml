<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvCombinedFleetView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:core="clr-namespace:KCViewer.Core.Types;assembly=KCViewer.Core"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fleetViewModels="clr-namespace:KCViewer.Window.Wpf.Fleet.ViewModels"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="KcvCombinedControl"
	d:DataContext="{d:DesignInstance kcv:KcvCombinedFleetViewModel}"
	d:DesignHeight="334"
	d:DesignWidth="794"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the combined fleet panel (mockup 20261009-combined-fleet-panel-v3, approved 2026-10-09 "구현"). One header as
		the fleet panel's (KcvFleetView): the worse fleet's mark, 연합함대 and the kind, then 제공 · 색적 (a click cycles the
		branch weight) · TP · 속력 and [함대 상세] (the fleet detail's combined fleet); the worse fleet's status bar; fleet 1
		on the left and fleet 2 on the right with a line between, each ship on a 41 px row made small to fit two in a fleet
		panel: type 10 and name 15, Lv 13 and Next 9.5, HP 13 with a 54 px gauge, the condition, fuel and ammo, 18 px
		equipment icons. The rows are the fleet panels' own view models, with their tooltips and menus, the heavy damage
		red, the docking colour (입거 시 강조) and the docking badge. Without a combined fleet: 연합함대가 편성되어 있지 않습니다.
	-->
	<UserControl.Resources>
		<fleetViewModels:FleetViewModelBindingProxy x:Key="Proxy" DataContext="{Binding Fleet1}" />

		<Style x:Key="Stat" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="3 0 12 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="Small" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="9.5" />
		</Style>

		<Style x:Key="Gauge" BasedOn="{StaticResource Kcv.Gauge}" TargetType="ProgressBar">
			<Setter Property="Height" Value="5" />
		</Style>

		<!--  A ship of the half width row: as the fleet panel's, smaller  -->
		<DataTemplate x:Key="Row" DataType="{x:Type fleetViewModels:FleetItemViewModel}">
			<Border
				Height="41"
				BorderBrush="{DynamicResource Kcv.Separator}"
				BorderThickness="0 0 0 1"
				Visibility="{Binding Visibility}"
				>
				<Border.Style>
					<Style TargetType="Border">
						<Setter Property="Background" Value="Transparent" />
						<Style.Triggers>
							<!--  as the fleet panel: heavily damaged red, in the dock with 입거 시 강조 the docking colour; nothing blinks  -->
							<DataTrigger Binding="{Binding ShowSinkWarning}" Value="True">
								<Setter Property="Background" Value="#80E02020" />
							</DataTrigger>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding HP.RepairTimeShowMode}" Value="Visible" />
									<Condition Binding="{Binding DockHighlight, RelativeSource={RelativeSource AncestorType=kcv:KcvCombinedFleetView}}" Value="True" />
								</MultiDataTrigger.Conditions>
								<Setter Property="Background" Value="#80FF9A20" />
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>

				<Grid Margin="4 0 0 0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="104" />
						<ColumnDefinition Width="58" />
						<ColumnDefinition Width="60" />
						<ColumnDefinition Width="36" />
						<ColumnDefinition Width="34" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!--  type over the name  -->
					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<TextBlock FontSize="10" Style="{StaticResource Kcv.SubText}">
							<TextBlock.Text>
								<MultiBinding Converter="{StaticResource Kcv.ShipType}">
									<Binding Path="Ship" />
									<Binding Path="Name.Text" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
						<Border
							Margin="0 -2 4 0"
							HorizontalAlignment="Left"
							Background="{Binding Name.Background}"
							ToolTip="{Binding Name.ToolTip}"
							>
							<Border.InputBindings>
								<MouseBinding Command="{Binding Name.OpenShipEncyclopediaCommand}" MouseAction="RightClick" />
							</Border.InputBindings>
							<TextBlock
								FontSize="15"
								Style="{StaticResource Kcv.Text}"
								Text="{Binding Name.Text}"
								TextTrimming="CharacterEllipsis"
								/>
						</Border>
					</StackPanel>

					<!--  Lv.74 / Next: 8923  -->
					<StackPanel
						Grid.Column="1"
						VerticalAlignment="Center"
						Background="{Binding Level.Background}"
						Cursor="Help"
						DataContext="{Binding Level}"
						ForceCursor="True"
						ToolTip="{Binding ToolTip}"
						>
						<StackPanel.ContextMenu>
							<ContextMenu>
								<MenuItem Command="{Binding OpenExpCheckerCommand}" Header="{Binding DataContext.FormFleet.ContextMenuFleetShipLevel_OpenExpChecker, Source={StaticResource Proxy}}" />
								<Separator />
								<MenuItem
									Command="{Binding CreateTrainingPlanCommand}"
									Header="{Binding DataContext.FormFleet.ContextMenuFleetShipLevel_CreateTrainingPlan, Source={StaticResource Proxy}}"
									Visibility="{Binding CanAddPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding ShipTrainingPlanViewerViewModel.OpenEditPopupCommand}"
									CommandParameter="{Binding FirstTrainingPlan}"
									Header="{Binding DataContext.FormFleet.ContextMenuFleetShipLevel_EditTrainingPlan, Source={StaticResource Proxy}}"
									Visibility="{Binding CanEditOrRemovePlan, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
								<MenuItem
									Command="{Binding ShipTrainingPlanViewerViewModel.RemovePlanCommand}"
									CommandParameter="{Binding FirstTrainingPlan}"
									Header="{Binding DataContext.FormFleet.ContextMenuFleetShipLevel_RemoveTrainingPlan, Source={StaticResource Proxy}}"
									Visibility="{Binding CanEditOrRemovePlan, Converter={StaticResource BooleanToVisibilityConverter}}"
									/>
							</ContextMenu>
						</StackPanel.ContextMenu>
						<TextBlock Style="{StaticResource Kcv.Text}">
							<Run FontSize="9.5" Foreground="{DynamicResource Kcv.SubForeground}" Text="Lv." /><Run FontSize="13" Text="{Binding Value, Mode=OneWay}" />
						</TextBlock>
						<TextBlock Margin="0 -1 0 0" Style="{StaticResource Small}">
							<Run Text="Next:" />
							<Run Text="{Binding ValueNext, Mode=OneWay}" />
						</TextBlock>
					</StackPanel>

					<!--  HP 45 / 45 with the gauge; in the dock the badge over it  -->
					<StackPanel
						Grid.Column="2"
						VerticalAlignment="Center"
						Background="{Binding HP.Background}"
						DataContext="{Binding HP}"
						ToolTip="{Binding ToolTip}"
						>
						<i:Interaction.Triggers>
							<i:EventTrigger EventName="MouseEnter">
								<i:InvokeCommandAction Command="{Binding MouseEnterCommand}" />
							</i:EventTrigger>
							<i:EventTrigger EventName="MouseLeave">
								<i:InvokeCommandAction Command="{Binding MouseLeaveCommand}" />
							</i:EventTrigger>
						</i:Interaction.Triggers>
						<TextBlock Style="{StaticResource Kcv.Text}">
							<Run FontSize="13" Text="{Binding HPBar.Value, Mode=OneWay}" /><Run FontSize="9.5" Foreground="{DynamicResource Kcv.SubForeground}" Text=" / " /><Run FontSize="9.5" Foreground="{DynamicResource Kcv.SubForeground}" Text="{Binding HPBar.MaximumValue, Mode=OneWay}" />
						</TextBlock>
						<Grid Margin="0 3 0 0" HorizontalAlignment="Left">
							<ProgressBar
								Width="54"
								Maximum="{Binding HPBar.MaximumValue}"
								Style="{StaticResource Gauge}"
								Value="{Binding HPBar.Value, Mode=OneWay}"
								>
								<ProgressBar.Foreground>
									<MultiBinding Converter="{StaticResource Kcv.GaugeBrush}">
										<Binding Path="HPBar.Value" />
										<Binding Path="HPBar.MaximumValue" />
									</MultiBinding>
								</ProgressBar.Foreground>
							</ProgressBar>
							<Canvas>
								<Border
									Canvas.Top="-4"
									Width="54"
									Height="12"
									Background="{DynamicResource Kcv.InProgressBadgeBackground}"
									CornerRadius="2"
									>
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding RepairTimeShowMode}" Value="Visible">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<TextBlock
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="9"
										Foreground="{DynamicResource Kcv.InProgressBadgeForeground}"
										>
										<Run Text="{x:Static fork:ForkStrings.KcvFleetDockBadge}" />
										<Run Text="{Binding DisplayText, Mode=OneWay}" />
									</TextBlock>
								</Border>
							</Canvas>
						</Grid>
					</StackPanel>

					<!--  ■ 49  -->
					<StackPanel
						Grid.Column="3"
						VerticalAlignment="Center"
						Background="Transparent"
						DataContext="{Binding Condition}"
						Orientation="Horizontal"
						ToolTip="{Binding ToolTip}"
						>
						<Rectangle
							Width="9"
							Height="9"
							Margin="0 1 3 0"
							VerticalAlignment="Center"
							Fill="{Binding Tag, Converter={StaticResource Kcv.ConditionBrush}}"
							Stroke="{DynamicResource Kcv.MarkBorder}"
							StrokeThickness="1"
							/>
						<TextBlock
							FontSize="13"
							Style="{StaticResource Kcv.Text}"
							Text="{Binding Text}"
							/>
					</StackPanel>

					<!--  Fuel and ammo  -->
					<StackPanel
						Grid.Column="4"
						VerticalAlignment="Center"
						Background="Transparent"
						DataContext="{Binding ShipResource}"
						ToolTip="{Binding ToolTip}"
						>
						<ProgressBar
							Width="26"
							Height="4"
							HorizontalAlignment="Left"
							Maximum="{Binding BarFuel.MaximumValue}"
							Style="{StaticResource Kcv.Gauge}"
							Value="{Binding BarFuel.Value, Mode=OneWay}"
							>
							<ProgressBar.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.GaugeBrush}">
									<Binding Path="BarFuel.Value" />
									<Binding Path="BarFuel.MaximumValue" />
								</MultiBinding>
							</ProgressBar.Foreground>
						</ProgressBar>
						<ProgressBar
							Width="26"
							Height="4"
							Margin="0 5 0 0"
							HorizontalAlignment="Left"
							Maximum="{Binding BarAmmo.MaximumValue}"
							Style="{StaticResource Kcv.Gauge}"
							Value="{Binding BarAmmo.Value, Mode=OneWay}"
							>
							<ProgressBar.Foreground>
								<MultiBinding Converter="{StaticResource Kcv.GaugeBrush}">
									<Binding Path="BarAmmo.Value" />
									<Binding Path="BarAmmo.MaximumValue" />
								</MultiBinding>
							</ProgressBar.Foreground>
						</ProgressBar>
					</StackPanel>

					<!--
						Equipment icons, 18 px; equipment in the reinforcement slot (Slots[^1]) after a line,
						as the fleet panel (mockup 20261010-ex-slot-separator-v1)
					-->
					<ItemsControl
						Grid.Column="5"
						VerticalAlignment="Center"
						Background="Transparent"
						DataContext="{Binding Equipments}"
						ItemsSource="{Binding Slots}"
						ToolTip="{Binding ToolTip}"
						>
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type fleetViewModels:ShipSlotViewModel}">
								<StackPanel Orientation="Horizontal">
									<Rectangle
										x:Name="ExLine"
										Width="1"
										Height="14"
										Margin="1 0 3 0"
										VerticalAlignment="Center"
										Fill="{DynamicResource Kcv.Separator}"
										Visibility="Collapsed"
										/>
									<Image
										Width="18"
										Height="18"
										Margin="0 0 1 0"
										Source="{Binding EquipmentIconType, Converter={StaticResource Kcv.GameIcon}}"
										ToolTip="{Binding NameWithLevel}"
										>
										<Image.Style>
											<Style BasedOn="{StaticResource Kcv.EquipmentIcon}" TargetType="Image">
												<Setter Property="Visibility" Value="{Binding SlotVisibility}" />
												<Style.Triggers>
													<!--  an empty slot has no icon (as the fleet panel: EquipmentIconType notifies)  -->
													<DataTrigger Binding="{Binding EquipmentIconType}" Value="{x:Static core:EquipmentIconType.Nothing}">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Image.Style>
									</Image>
								</StackPanel>
								<DataTemplate.Triggers>
									<DataTrigger Value="True">
										<DataTrigger.Binding>
											<MultiBinding Converter="{StaticResource Kcv.IsLastItem}">
												<Binding />
												<Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
											</MultiBinding>
										</DataTrigger.Binding>
										<Setter TargetName="ExLine" Property="Visibility" Value="Visible" />
									</DataTrigger>
									<DataTrigger Binding="{Binding EquipmentIconType}" Value="{x:Static core:EquipmentIconType.Nothing}">
										<Setter TargetName="ExLine" Property="Visibility" Value="Collapsed" />
									</DataTrigger>
									<DataTrigger Binding="{Binding SlotVisibility}" Value="Collapsed">
										<Setter TargetName="ExLine" Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</DataTemplate.Triggers>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!--  The worse fleet's mark, 연합함대 and the kind; the combined values on the right  -->
		<DockPanel Grid.Row="0" Margin="10 7 10 5">
			<Button
				Margin="14 0 0 0"
				Padding="12 3"
				Command="{Binding OpenDetailCommand}"
				Content="{x:Static fork:ForkStrings.KcvFleetDetail}"
				DockPanel.Dock="Right"
				FontSize="12"
				Visibility="{Binding IsCombined, Converter={StaticResource BooleanToVisibilityConverter}}"
				/>
			<StackPanel
				Background="Transparent"
				DockPanel.Dock="Right"
				Orientation="Horizontal"
				ToolTip="{Binding Card.ToolTip}"
				Visibility="{Binding IsCombined, Converter={StaticResource BooleanToVisibilityConverter}}"
				>
				<Image Width="20" Height="20" Source="{Binding Source={x:Static core:EquipmentIconType.CarrierBasedFighter}, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource Kcv.EquipmentIcon}" />
				<TextBlock Style="{StaticResource Stat}" Text="{Binding Card.Air}" />
				<StackPanel Background="Transparent" Orientation="Horizontal">
					<StackPanel.InputBindings>
						<MouseBinding Command="{Binding Card.CycleCnCommand}" MouseAction="LeftClick" />
					</StackPanel.InputBindings>
					<Image Width="20" Height="20" Source="{Binding Source={x:Static core:EquipmentIconType.CarrierBasedRecon}, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource Kcv.EquipmentIcon}" />
					<TextBlock Style="{StaticResource Stat}" Text="{Binding Card.LosValue}" />
				</StackPanel>
				<Image Width="20" Height="20" Source="{Binding Source={x:Static core:EquipmentIconType.Supplies}, Converter={StaticResource Kcv.GameIcon}}" Style="{StaticResource Kcv.EquipmentIcon}" />
				<TextBlock Style="{StaticResource Stat}" Text="{Binding Card.Tp}" />
				<StackPanel
					Background="Transparent"
					Orientation="Horizontal"
					ToolTip="{Binding SpeedToolTip}"
					>
					<common:ParameterIcon Type="Speed" />
					<TextBlock
						Margin="3 0 0 0"
						Style="{StaticResource Stat}"
						Text="{Binding SpeedText}"
						/>
				</StackPanel>
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<Rectangle
					Width="11"
					Height="11"
					VerticalAlignment="Center"
					Fill="{Binding WorseFleet.ControlFleet.State.StateLabels[0].State, Converter={StaticResource Kcv.FleetStateBrush}, ConverterParameter=Mark}"
					Visibility="{Binding IsCombined, Converter={StaticResource BooleanToVisibilityConverter}}"
					/>
				<TextBlock
					Margin="6 0 0 0"
					VerticalAlignment="Center"
					FontSize="14"
					Style="{StaticResource Kcv.Text}"
					Text="{x:Static fork:ForkStrings.KcvCombinedFleet}"
					/>
				<TextBlock
					Margin="8 0 0 0"
					VerticalAlignment="Center"
					FontSize="12"
					Style="{StaticResource Kcv.SubText}"
					Text="{Binding KindText}"
					/>
			</StackPanel>
		</DockPanel>

		<!--  Without a combined fleet  -->
		<TextBlock
			Grid.Row="1"
			Margin="12 4 10 0"
			FontSize="12"
			Text="{Binding NotFormedText}"
			>
			<TextBlock.Style>
				<Style BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsCombined}" Value="True">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>

		<!--  The worse fleet's status bar, as the fleet panel's  -->
		<Border
			Grid.Row="1"
			MinHeight="22"
			Margin="10 0 10 3"
			Background="{Binding WorseFleet.ControlFleet.State.StateLabels[0].State, Converter={StaticResource Kcv.FleetStateBrush}}"
			Visibility="{Binding IsCombined, Converter={StaticResource BooleanToVisibilityConverter}}"
			>
			<ItemsControl
				Margin="6 0"
				VerticalAlignment="Center"
				ItemsSource="{Binding WorseFleet.ControlFleet.State.StateLabels}"
				>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type fleetViewModels:StateLabel}">
						<TextBlock
							Margin="0 2 16 2"
							FontSize="12"
							Foreground="White"
							Text="{Binding DisplayText}"
							ToolTip="{Binding Label.ToolTip}"
							Visibility="{Binding Visibility}"
							/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>

		<!--  Fleet 1 | Fleet 2  -->
		<ScrollViewer
			Grid.Row="2"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			Visibility="{Binding IsCombined, Converter={StaticResource BooleanToVisibilityConverter}}"
			>
			<Grid Margin="10 0" MinWidth="773">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="1" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<ItemsControl
					Grid.Column="0"
					ItemTemplate="{StaticResource Row}"
					ItemsSource="{Binding Fleet1.ControlMember}"
					/>
				<Rectangle Grid.Column="1" Fill="{DynamicResource Kcv.Separator}" />
				<ItemsControl
					Grid.Column="2"
					ItemTemplate="{StaticResource Row}"
					ItemsSource="{Binding Fleet2.ControlMember}"
					/>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>

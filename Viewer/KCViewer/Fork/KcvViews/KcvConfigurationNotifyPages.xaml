<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:anchorageRepair="clr-namespace:KCViewer.Window.Settings.Notification.AnchorageRepair"
	xmlns:baseAirCorps="clr-namespace:KCViewer.Window.Settings.Notification.BaseAirCorps"
	xmlns:battleEnd="clr-namespace:KCViewer.Window.Settings.Notification.BattleEnd"
	xmlns:colorPicker="clr-namespace:ColorPickerLib.Controls;assembly=ColorPickerLib"
	xmlns:damage="clr-namespace:KCViewer.Window.Settings.Notification.Damage"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:homePortSupply="clr-namespace:KCViewer.Window.Settings.Notification.HomePortSupply"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:notifyBase="clr-namespace:KCViewer.Window.Settings.Notification.Base"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	>
	<!--
		Fork: the pages of 알람 in the settings window in KanColleViewer's style (mockup 20261007-settings-v2, approved
		2026-10-07 "구현"): a notification's settings in the window instead of the viewer's 800×450 dialog, whose type's
		box was cut off below. 알람 활성화 and the three boxes (알람음, 알람 이미지, 알람 대화상자) each have
		「이 알람만 개별 설정」: off, the part follows 기본 설정 and shows its values dimmed; on, the notification's own
		values win. 기본 설정 is the same page without those checks, with the table of which parts are whose.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  a box with its title on the left and 「이 알람만 개별 설정」 (the header) on the right  -->
	<Style x:Key="Cfg.PartBox" TargetType="HeaderedContentControl">
		<Setter Property="Margin" Value="0 0 0 8" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="HeaderedContentControl">
					<Border
						Padding="8 3 8 5"
						BorderBrush="{DynamicResource Kcv.HeaderBackground}"
						BorderThickness="1"
						>
						<DockPanel>
							<DockPanel DockPanel.Dock="Top" LastChildFill="False">
								<ContentPresenter ContentSource="Header" DockPanel.Dock="Right" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource Kcv.SubForeground}"
									Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
									/>
							</DockPanel>
							<ContentPresenter Margin="0 3 0 0" />
						</DockPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="Cfg.Own"
		BasedOn="{StaticResource {x:Type CheckBox}}"
		TargetType="CheckBox"
		>
		<Setter Property="Margin" Value="0" />
		<Setter Property="Content" Value="{x:Static fork:ForkStrings.KcvNotifyOwn}" />
		<Setter Property="Visibility" Value="{Binding IsDefault, Converter={StaticResource Cfg.Collapsed}}" />
	</Style>

	<!--  the dimmed common settings in a part that follows them  -->
	<Style x:Key="Cfg.Dimmed" TargetType="ContentControl">
		<Setter Property="IsEnabled" Value="False" />
		<Setter Property="Opacity" Value="0.45" />
		<Setter Property="Focusable" Value="False" />
	</Style>

	<DataTemplate x:Key="Cfg.SoundBody" DataType="{x:Type notifyBase:ConfigurationNotificationBaseViewModel}">
		<StackPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="{Binding Translation.PlaysSound}" IsChecked="{Binding PlaysSound}" />
				<CheckBox Content="{Binding Translation.LoopsSound}" IsChecked="{Binding LoopsSound}" />
				<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Volume, Converter={StaticResource Cfg.Label}}" />
				<kcv:KcvNumberBox
					Maximum="100"
					Minimum="0"
					Style="{StaticResource Cfg.Num}"
					ToolTip="{Binding Translation.SoundVolumeToolTip}"
					Value="{Binding SoundVolume}"
					/>
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<TextBox
					Width="440"
					Style="{StaticResource Cfg.Field}"
					Tag="{x:Static fork:ForkStrings.KcvConfigSoundHint}"
					Text="{Binding SoundPath}"
					/>
				<Button Command="{Binding OpenSoundPathCommand}" Style="{StaticResource Cfg.Browse}" />
				<Button
					Command="{Binding SoundPathDirectorizeCommand}"
					Content="{Binding Translation.Dir}"
					Style="{StaticResource Cfg.Browse}"
					ToolTip="{Binding Translation.SoundPathDirectorizeToolTip}"
					/>
			</WrapPanel>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="Cfg.ImageBody" DataType="{x:Type notifyBase:ConfigurationNotificationBaseViewModel}">
		<StackPanel>
			<CheckBox Content="{Binding Translation.DrawsImage}" IsChecked="{Binding DrawsImage}" />
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<TextBox
					Width="440"
					Style="{StaticResource Cfg.Field}"
					Tag="{x:Static fork:ForkStrings.KcvConfigImageHint}"
					Text="{Binding ImagePath}"
					/>
				<Button Command="{Binding OpenImagePathCommand}" Style="{StaticResource Cfg.Browse}" />
			</WrapPanel>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="Cfg.DialogBody" DataType="{x:Type notifyBase:ConfigurationNotificationBaseViewModel}">
		<StackPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="{Binding Translation.ShowsDialog}" IsChecked="{Binding ShowsDialog}" />
				<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Alignment, Converter={StaticResource Cfg.Label}}" />
				<ComboBox
					Margin="0 1 18 1"
					ItemTemplate="{StaticResource Cfg.EnumItem}"
					ItemsSource="{Binding DialogAlignments}"
					SelectedItem="{Binding Alignment}"
					Style="{StaticResource Cfg.Combo}"
					ToolTip="{Binding Translation.AlignHint}"
					/>
				<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Location, Converter={StaticResource Cfg.Label}}" />
				<kcv:KcvNumberBox
					Style="{StaticResource Cfg.Num}"
					ToolTip="{Binding Translation.LocXHint}"
					Value="{Binding LocationX}"
					/>
				<kcv:KcvNumberBox
					Style="{StaticResource Cfg.Num}"
					ToolTip="{Binding Translation.LocYHint}"
					Value="{Binding LocationY}"
					/>
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox
					Content="{Binding Translation.DrawsMessage}"
					IsChecked="{Binding DrawsMessage}"
					ToolTip="{Binding Translation.DisplayMessageHint}"
					/>
				<CheckBox
					Content="{Binding Translation.HasFormBorder}"
					IsChecked="{Binding HasFormBorder}"
					ToolTip="{Binding Translation.WindowBorderHint}"
					/>
				<CheckBox
					Content="{Binding Translation.ShowWithActivation}"
					IsChecked="{Binding ShowWithActivation}"
					ToolTip="{Binding Translation.ShowWithActivationToolTip}"
					/>
				<CheckBox Content="{Binding Translation.TopMostFlag}" IsChecked="{Binding TopMost}" />
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<TextBlock
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.HurryBy, Converter={StaticResource Cfg.Label}}"
					ToolTip="{Binding Translation.HurryHint}"
					/>
				<kcv:KcvNumberBox
					Minimum="0"
					Style="{StaticResource Cfg.Num}"
					Value="{Binding AccelInterval}"
					/>
				<TextBlock
					Margin="0 0 18 0"
					Style="{StaticResource Cfg.Unit}"
					Text="{Binding Translation.Sec}"
					/>
				<TextBlock
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.AutoClose, Converter={StaticResource Cfg.Label}}"
					ToolTip="{Binding Translation.IntervalHint}"
					/>
				<kcv:KcvNumberBox
					Minimum="0"
					Style="{StaticResource Cfg.Num}"
					Value="{Binding ClosingInterval}"
					/>
				<TextBlock Style="{StaticResource Cfg.Unit}" Text="{Binding Translation.Sec}" />
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<TextBlock
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.ForeColorPreview, Converter={StaticResource Cfg.Label}}"
					ToolTip="{Binding Translation.ForeColorDispHint}"
					/>
				<colorPicker:ColorPicker
					Margin="0 1 18 1"
					ColorMode="ColorCanvas"
					DisplayColorAndName="True"
					SelectedColor="{Binding ForeColor}"
					>
					<colorPicker:ColorPicker.Resources>
						<SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource SystemAltHighColor}" />
					</colorPicker:ColorPicker.Resources>
				</colorPicker:ColorPicker>
				<TextBlock
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.BackColorPreview, Converter={StaticResource Cfg.Label}}"
					ToolTip="{Binding Translation.BackColorDispHint}"
					/>
				<colorPicker:ColorPicker
					Margin="0 1"
					ColorMode="ColorCanvas"
					DisplayColorAndName="True"
					SelectedColor="{Binding BackColor}"
					>
					<colorPicker:ColorPicker.Resources>
						<SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource SystemAltHighColor}" />
					</colorPicker:ColorPicker.Resources>
				</colorPicker:ColorPicker>
			</WrapPanel>
			<DockPanel Margin="0 2">
				<TextBlock
					VerticalAlignment="Top"
					Margin="0 3 8 0"
					DockPanel.Dock="Left"
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.CloseOn, Converter={StaticResource Cfg.Label}}"
					/>
				<ItemsControl ItemsPanel="{StaticResource Cfg.Wrap}" ItemsSource="{Binding ClickFlags}" />
			</DockPanel>
		</StackPanel>
	</DataTemplate>

	<DataTemplate DataType="{x:Type kcv:KcvNotifierPage}">
		<StackPanel>
			<TextBlock
				Margin="0 0 0 6"
				Style="{StaticResource Cfg.Note}"
				Text="{x:Static fork:ForkStrings.KcvNotifyDefaultNote}"
				Visibility="{Binding IsDefault, Converter={StaticResource KcvRec.Visible}}"
				/>

			<!--  알람 활성화  -->
			<DockPanel Margin="0 0 0 6">
				<CheckBox
					DockPanel.Dock="Right"
					IsChecked="{Binding OwnEnabled}"
					Style="{StaticResource Cfg.Own}"
					/>
				<Grid>
					<CheckBox
						HorizontalAlignment="Left"
						Content="{Binding Notifier.Translation.IsEnabled}"
						IsChecked="{Binding Notifier.IsEnabled}"
						Visibility="{Binding OwnEnabled, Converter={StaticResource KcvRec.Visible}}"
						/>
					<StackPanel Orientation="Horizontal" Visibility="{Binding OwnEnabled, Converter={StaticResource Cfg.Collapsed}}">
						<CheckBox
							Content="{Binding Default.Translation.IsEnabled}"
							IsChecked="{Binding Default.IsEnabled, Mode=OneWay}"
							IsEnabled="False"
							Opacity="0.45"
							/>
						<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.KcvNotifyFollows}" />
					</StackPanel>
				</Grid>
			</DockPanel>

			<HeaderedContentControl Style="{StaticResource Cfg.PartBox}" Tag="{Binding Notifier.Translation.GroupSound}">
				<HeaderedContentControl.Header>
					<CheckBox IsChecked="{Binding OwnSound}" Style="{StaticResource Cfg.Own}" />
				</HeaderedContentControl.Header>
				<Grid>
					<ContentControl
						Content="{Binding Notifier}"
						ContentTemplate="{StaticResource Cfg.SoundBody}"
						Focusable="False"
						Visibility="{Binding OwnSound, Converter={StaticResource KcvRec.Visible}}"
						/>
					<StackPanel Visibility="{Binding OwnSound, Converter={StaticResource Cfg.Collapsed}}">
						<ContentControl
							Content="{Binding Default}"
							ContentTemplate="{StaticResource Cfg.SoundBody}"
							Style="{StaticResource Cfg.Dimmed}"
							/>
						<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.KcvNotifyFollows}" />
					</StackPanel>
				</Grid>
			</HeaderedContentControl>

			<HeaderedContentControl Style="{StaticResource Cfg.PartBox}" Tag="{Binding Notifier.Translation.GroupImage}">
				<HeaderedContentControl.Header>
					<CheckBox IsChecked="{Binding OwnImage}" Style="{StaticResource Cfg.Own}" />
				</HeaderedContentControl.Header>
				<Grid>
					<ContentControl
						Content="{Binding Notifier}"
						ContentTemplate="{StaticResource Cfg.ImageBody}"
						Focusable="False"
						Visibility="{Binding OwnImage, Converter={StaticResource KcvRec.Visible}}"
						/>
					<StackPanel Visibility="{Binding OwnImage, Converter={StaticResource Cfg.Collapsed}}">
						<ContentControl
							Content="{Binding Default}"
							ContentTemplate="{StaticResource Cfg.ImageBody}"
							Style="{StaticResource Cfg.Dimmed}"
							/>
						<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.KcvNotifyFollows}" />
					</StackPanel>
				</Grid>
			</HeaderedContentControl>

			<HeaderedContentControl Style="{StaticResource Cfg.PartBox}" Tag="{Binding Notifier.Translation.GroupDialog}">
				<HeaderedContentControl.Header>
					<CheckBox IsChecked="{Binding OwnDialog}" Style="{StaticResource Cfg.Own}" />
				</HeaderedContentControl.Header>
				<Grid>
					<ContentControl
						Content="{Binding Notifier}"
						ContentTemplate="{StaticResource Cfg.DialogBody}"
						Focusable="False"
						Visibility="{Binding OwnDialog, Converter={StaticResource KcvRec.Visible}}"
						/>
					<StackPanel Visibility="{Binding OwnDialog, Converter={StaticResource Cfg.Collapsed}}">
						<ContentControl
							Content="{Binding Default}"
							ContentTemplate="{StaticResource Cfg.DialogBody}"
							Style="{StaticResource Cfg.Dimmed}"
							/>
						<TextBlock Style="{StaticResource Cfg.Note}" Text="{x:Static fork:ForkStrings.KcvNotifyFollows}" />
					</StackPanel>
				</Grid>
			</HeaderedContentControl>

			<!--  the box of the notification's type (대파 경고 and so on); none for the others and 기본 설정  -->
			<ContentControl Content="{Binding Notifier}" Focusable="False">
				<ContentControl.Resources>
					<DataTemplate DataType="{x:Type notifyBase:ConfigurationNotificationBaseViewModel}" />

					<DataTemplate DataType="{x:Type damage:ConfigurationNotificationDamageViewModel}">
						<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Translation.GroupDamage}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<CheckBox
									Grid.Row="0"
									Grid.Column="0"
									Content="{Binding Translation.NotifiesBefore}"
									IsChecked="{Binding NotifiesBefore}"
									ToolTip="{Binding Translation.NotifyBeforeHint}"
									/>
								<CheckBox
									Grid.Row="0"
									Grid.Column="1"
									Content="{Binding Translation.ContainsNotLockedShip}"
									IsChecked="{Binding ContainsNotLockedShip}"
									/>
								<CheckBox
									Grid.Row="0"
									Grid.Column="2"
									Content="{Binding Translation.NotifiesAtEndpoint}"
									IsChecked="{Binding NotifiesAtEndpoint}"
									/>
								<CheckBox
									Grid.Row="1"
									Grid.Column="0"
									Content="{Binding Translation.NotifiesNow}"
									IsChecked="{Binding NotifiesNow}"
									ToolTip="{Binding Translation.NotifyNowHint}"
									/>
								<CheckBox
									Grid.Row="1"
									Grid.Column="1"
									Content="{Binding Translation.ContainsSafeShip}"
									IsChecked="{Binding ContainsSafeShip}"
									/>
								<StackPanel
									Grid.Row="1"
									Grid.Column="2"
									Orientation="Horizontal"
									>
									<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.MinLv, Converter={StaticResource Cfg.Label}}" />
									<kcv:KcvNumberBox
										Minimum="1"
										Style="{StaticResource Cfg.Num}"
										ToolTip="{Binding Translation.LvHint}"
										Value="{Binding LevelBorder}"
										/>
								</StackPanel>
								<CheckBox
									Grid.Row="2"
									Grid.Column="0"
									Content="{Binding Translation.NotifiesAfter}"
									IsChecked="{Binding NotifiesAfter}"
									ToolTip="{Binding Translation.NotifyAfterHint}"
									/>
								<CheckBox
									Grid.Row="2"
									Grid.Column="1"
									Content="{Binding Translation.ContainsFlagship}"
									IsChecked="{Binding ContainsFlagship}"
									/>
							</Grid>
						</ContentControl>
					</DataTemplate>

					<DataTemplate DataType="{x:Type anchorageRepair:ConfigurationNotificationAnchorageRepairViewModel}">
						<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Translation.GroupAnchorageRepair}">
							<WrapPanel Style="{StaticResource Cfg.Row}">
								<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.TriggerWhen, Converter={StaticResource Cfg.Label}}" />
								<ComboBox
									MinWidth="150"
									ItemTemplate="{StaticResource Cfg.EnumItem}"
									ItemsSource="{Binding NotificationLevels}"
									SelectedItem="{Binding NotificationLevel}"
									Style="{StaticResource Cfg.Combo}"
									ToolTip="{Binding Translation.AnchorageRepairNotificationLevelToolTip}"
									/>
							</WrapPanel>
						</ContentControl>
					</DataTemplate>

					<DataTemplate DataType="{x:Type homePortSupply:ConfigurationNotificationHomePortSupplyViewModel}">
						<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Translation.GroupHomePortSupply}">
							<StackPanel>
								<WrapPanel Style="{StaticResource Cfg.Row}">
									<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.TriggerWhen, Converter={StaticResource Cfg.Label}}" />
									<ComboBox
										Margin="0 1 18 1"
										MinWidth="150"
										ItemTemplate="{StaticResource Cfg.EnumItem}"
										ItemsSource="{Binding NotificationLevels}"
										SelectedItem="{Binding NotificationLevel}"
										Style="{StaticResource Cfg.Combo}"
										ToolTip="{Binding Translation.HomePortSupplyNotificationLevelToolTip}"
										/>
									<CheckBox
										Content="{Binding Translation.HomePortSupply_NotifyForExpeditions}"
										IsChecked="{Binding NotifyForExpeditions}"
										ToolTip="{Binding Translation.HomePortSupply_NotifyForExpeditionsToolTip}"
										/>
								</WrapPanel>
								<WrapPanel Style="{StaticResource Cfg.Row}">
									<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.HomePortSupply_ExpeditionHurryBy, Converter={StaticResource Cfg.Label}}" />
									<kcv:KcvNumberBox Style="{StaticResource Cfg.Num}" Value="{Binding ExpeditionAccelInterval}" />
									<TextBlock Style="{StaticResource Cfg.Unit}" Text="{Binding Translation.Sec}" />
								</WrapPanel>
							</StackPanel>
						</ContentControl>
					</DataTemplate>

					<DataTemplate DataType="{x:Type baseAirCorps:ConfigurationNotificationBaseAirCorpsViewModel}">
						<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Translation.GroupBaseAirCorps}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<CheckBox
									Grid.Row="0"
									Grid.Column="0"
									Content="{Binding Translation.BaseAirCorps_NotSupplied}"
									IsChecked="{Binding NotifiesNotSupplied}"
									ToolTip="{Binding Translation.BaseAirCorps_NotSuppliedToolTip}"
									/>
								<CheckBox
									Grid.Row="0"
									Grid.Column="1"
									Content="{Binding Translation.BaseAirCorps_Standby}"
									IsChecked="{Binding NotifiesStandby}"
									ToolTip="{Binding Translation.BaseAirCorps_StandbyToolTip}"
									/>
								<CheckBox
									Grid.Row="0"
									Grid.Column="2"
									Content="{Binding Translation.BaseAirCorps_NormalMap}"
									IsChecked="{Binding NotifiesNormalMap}"
									ToolTip="{Binding Translation.BaseAirCorps_NormalMapToolTip}"
									/>
								<CheckBox
									Grid.Row="0"
									Grid.Column="3"
									Content="{Binding Translation.BaseAirCorps_SquadronRelocation}"
									IsChecked="{Binding NotifiesSquadronRelocation}"
									ToolTip="{Binding Translation.BaseAirCorps_SquadronRelocationToolTip}"
									/>
								<CheckBox
									Grid.Row="1"
									Grid.Column="0"
									Content="{Binding Translation.BaseAirCorps_Tired}"
									IsChecked="{Binding NotifiesTired}"
									ToolTip="{Binding Translation.BaseAirCorps_TiredToolTip}"
									/>
								<CheckBox
									Grid.Row="1"
									Grid.Column="1"
									Content="{Binding Translation.BaseAirCorps_Retreat}"
									IsChecked="{Binding NotifiesRetreat}"
									ToolTip="{Binding Translation.BaseAirCorps_RetreatToolTip}"
									/>
								<CheckBox
									Grid.Row="1"
									Grid.Column="2"
									Content="{Binding Translation.BaseAirCorps_EventMap}"
									IsChecked="{Binding NotifiesEventMap}"
									ToolTip="{Binding Translation.BaseAirCorps_EventMapToolTip}"
									/>
								<CheckBox
									Grid.Row="1"
									Grid.Column="3"
									Content="{Binding Translation.BaseAirCorps_EquipmentRelocation}"
									IsChecked="{Binding NotifiesEquipmentRelocation}"
									ToolTip="{Binding Translation.BaseAirCorps_EquipmentRelocationToolTip}"
									/>
								<CheckBox
									Grid.Row="2"
									Grid.Column="0"
									Content="{Binding Translation.BaseAirCorps_NotOrganized}"
									IsChecked="{Binding NotifiesNotOrganized}"
									ToolTip="{Binding Translation.BaseAirCorps_NotOrganizedToolTip}"
									/>
								<CheckBox
									Grid.Row="2"
									Grid.Column="1"
									Content="{Binding Translation.BaseAirCorps_Rest}"
									IsChecked="{Binding NotifiesRest}"
									ToolTip="{Binding Translation.BaseAirCorps_RestToolTip}"
									/>
							</Grid>
						</ContentControl>
					</DataTemplate>

					<DataTemplate DataType="{x:Type battleEnd:ConfigurationNotificationBattleEndViewModel}">
						<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Translation.GroupBattleEnd}">
							<WrapPanel Style="{StaticResource Cfg.Row}">
								<CheckBox
									Margin="0 1 8 1"
									Content="{Binding Translation.BattleEnd_IdleTimerEnabled}"
									IsChecked="{Binding IdleTimerEnabled}"
									ToolTip="{Binding Translation.BattleEnd_IdleTimerEnabledToolTip}"
									/>
								<kcv:KcvNumberBox
									Minimum="1"
									Style="{StaticResource Cfg.Num}"
									ToolTip="{Binding Translation.BattleEnd_IdleTimeToolTip}"
									Value="{Binding IdleSeconds}"
									/>
								<TextBlock Style="{StaticResource Cfg.Unit}" Text="{Binding Translation.Sec}" />
							</WrapPanel>
						</ContentControl>
					</DataTemplate>
				</ContentControl.Resources>
			</ContentControl>

			<WrapPanel Style="{StaticResource Cfg.Row}">
				<Button
					Margin="0 0 8 0"
					Command="{Binding TestCommand}"
					Content="{Binding Notifier.Translation.ButtonTest}"
					Style="{StaticResource KcvRec.Button}"
					/>
				<TextBlock
					Style="{StaticResource Cfg.Note}"
					Text="{Binding Notifier.Translation.SettingsWillBeAppliedForTest}"
					Visibility="{Binding IsDefault, Converter={StaticResource Cfg.Collapsed}}"
					/>
				<TextBlock
					Style="{StaticResource Cfg.Note}"
					Text="{x:Static fork:ForkStrings.KcvNotifyDefaultTest}"
					Visibility="{Binding IsDefault, Converter={StaticResource KcvRec.Visible}}"
					/>
			</WrapPanel>

			<!--  기본 설정: which parts of each notification are its own  -->
			<ContentControl
				Margin="0 8 0 0"
				Style="{StaticResource Cfg.Box}"
				Tag="{x:Static fork:ForkStrings.KcvNotifyByNotification}"
				Visibility="{Binding IsDefault, Converter={StaticResource KcvRec.Visible}}"
				>
				<StackPanel>
					<!--  the mockup's widths: the names 150, the parts share the rest  -->
					<Grid Style="{StaticResource Cfg.TableHead}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="150" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Border Grid.Column="0" Style="{StaticResource Cfg.HeadCell}">
							<TextBlock Text="{x:Static translations:ConfigRes.Notification}" TextTrimming="CharacterEllipsis" />
						</Border>
						<Border Grid.Column="1" Style="{StaticResource Cfg.HeadCell}">
							<TextBlock Text="{Binding Notifier.Translation.IsEnabled}" TextTrimming="CharacterEllipsis" />
						</Border>
						<Border Grid.Column="2" Style="{StaticResource Cfg.HeadCell}">
							<TextBlock Text="{Binding Notifier.Translation.GroupSound}" TextTrimming="CharacterEllipsis" />
						</Border>
						<Border Grid.Column="3" Style="{StaticResource Cfg.HeadCell}">
							<TextBlock Text="{Binding Notifier.Translation.GroupImage}" TextTrimming="CharacterEllipsis" />
						</Border>
						<Border Grid.Column="4" Style="{StaticResource Cfg.HeadCell}">
							<TextBlock Text="{Binding Notifier.Translation.GroupDialog}" TextTrimming="CharacterEllipsis" />
						</Border>
					</Grid>
					<ItemsControl ItemsSource="{Binding Pages}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type kcv:KcvNotifierPage}">
								<Border Style="{StaticResource Cfg.TableRow}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="150" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Style="{StaticResource Cfg.CellText}" Text="{Binding Name}" />
										<TextBlock
											Grid.Column="1"
											Style="{StaticResource Cfg.PartText}"
											Tag="{Binding OwnEnabled}"
											Text="{Binding OwnEnabled, Converter={StaticResource Cfg.Part}}"
											/>
										<TextBlock
											Grid.Column="2"
											Style="{StaticResource Cfg.PartText}"
											Tag="{Binding OwnSound}"
											Text="{Binding OwnSound, Converter={StaticResource Cfg.Part}}"
											/>
										<TextBlock
											Grid.Column="3"
											Style="{StaticResource Cfg.PartText}"
											Tag="{Binding OwnImage}"
											Text="{Binding OwnImage, Converter={StaticResource Cfg.Part}}"
											/>
										<TextBlock
											Grid.Column="4"
											Style="{StaticResource Cfg.PartText}"
											Tag="{Binding OwnDialog}"
											Text="{Binding OwnDialog, Converter={StaticResource Cfg.Part}}"
											/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ContentControl>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>

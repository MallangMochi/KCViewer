<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvHeadquartersView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="Root"
	d:DesignHeight="60"
	d:DesignWidth="900"
	Background="{DynamicResource Kcv.Background}"
	ContextMenuOpening="BuildMenu"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the headquarters panel drawn as KanColleViewer's header (viewer-design/kcv-reference/01-overview.png,
		mockup 20261005-headquarters-icons-v4, user decisions 2026-10-05). One flow from the left of groups that keep
		together and wrap as one: the admiral (name with the rank in small letters and the comment, 司令部 Lv. with
		Next), ships and equipment, the four resources, the four materials, furniture coins with three 임의 아이템, and the
		senka. Each item is the game's icon and its value; its name and the viewer's tooltip are in the tooltip. The
		context menu turns each item on or off (the viewer's settings; KcvHeadquartersView.xaml.cs builds it).
	-->
	<UserControl.Resources>
		<!--  An item: the icon in a 22 px square, the value; red at the ship or equipment limit (the viewer's Tag)  -->
		<DataTemplate x:Key="Item" DataType="{x:Type kcv:KcvHqItem}">
			<StackPanel
				Width="{Binding Width}"
				Height="22"
				Background="Transparent"
				Orientation="Horizontal"
				ToolTip="{Binding ToolTip}"
				Visibility="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
				>
				<Grid
					Width="22"
					Height="22"
					Margin="0 0 6 0"
					>
					<Image
						Width="{Binding IconSize}"
						Height="{Binding IconSize}"
						RenderOptions.BitmapScalingMode="HighQuality"
						Source="{Binding Icon}"
						Stretch="Uniform"
						/>
				</Grid>
				<TextBlock
					x:Name="Value"
					VerticalAlignment="Center"
					FontSize="15"
					Style="{StaticResource Kcv.Text}"
					Text="{Binding Text}"
					/>
			</StackPanel>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsLimit}" Value="True">
					<Setter TargetName="Value" Property="Foreground" Value="#FF6464" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!--  A group: its items on one line (wrapping inside only when narrower than the group), 12 before the next  -->
		<Style x:Key="Group" TargetType="ItemsControl">
			<Setter Property="Margin" Value="0 0 12 0" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="ItemsSource" Value="{Binding Items}" />
			<Setter Property="ItemTemplate" Value="{StaticResource Item}" />
			<Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<Setter Property="ItemsPanel">
				<Setter.Value>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Senka" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0 0 16 0" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Padding" Value="0 3 0 0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Resources>

	<WrapPanel
		Margin="14 6 14 4"
		Orientation="Horizontal"
		Visibility="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
		>
		<!--  モシン 少将 / comment · 司令部 Lv.101 / Next: 113787 exp.  -->
		<StackPanel
			Margin="0 0 12 0"
			VerticalAlignment="Top"
			Orientation="Horizontal"
			Visibility="{Binding ForkShowAdmiral, Converter={StaticResource BooleanToVisibilityConverter}}"
			>
			<StackPanel
				Margin="0 0 30 0"
				VerticalAlignment="Top"
				Visibility="{Binding ForkShowNameColumn, Converter={StaticResource BooleanToVisibilityConverter}}"
				>
				<TextBlock
					Background="Transparent"
					Style="{StaticResource Kcv.Text}"
					ToolTip="{Binding AdmiralName.ToolTip}"
					Visibility="{Binding AdmiralName.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
					>
					<Run FontSize="19" Text="{Binding AdmiralName.Text, Mode=OneWay, Converter={StaticResource Kcv.AdmiralPart}}" />
					<Run FontSize="13" Text="{Binding AdmiralName.Text, Mode=OneWay, Converter={StaticResource Kcv.AdmiralPart}, ConverterParameter=Rank}" />
				</TextBlock>
				<TextBlock
					MaxWidth="260"
					Margin="0 1 0 0"
					FontSize="11"
					Style="{StaticResource Kcv.SubText}"
					Text="{Binding AdmiralComment.Text}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding AdmiralComment.ToolTip}"
					Visibility="{Binding AdmiralComment.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
					/>
			</StackPanel>

			<StackPanel
				VerticalAlignment="Top"
				Background="Transparent"
				DataContext="{Binding HQLevel}"
				ToolTip="{Binding ToolTip}"
				Visibility="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
				>
				<TextBlock Style="{StaticResource Kcv.Text}">
					<Run FontSize="12" Foreground="{DynamicResource Kcv.SubForeground}" Text="{x:Static fork:ForkStrings.KcvHqLevel}" />
					<Run FontSize="19" Text="{Binding Value, Mode=OneWay}" />
				</TextBlock>
				<TextBlock
					Margin="0 -1 0 0"
					FontSize="11"
					Style="{StaticResource Kcv.SubText}"
					>
					<Run Text="{Binding TextNext, Mode=OneWay, Converter={StaticResource Kcv.Capitalize}}" />
					<Run Text="{Binding ValueNext, Mode=OneWay, StringFormat={}{0} exp.}" />
				</TextBlock>
			</StackPanel>
		</StackPanel>

		<!--  Ships and equipment (beside the admiral's name line), resources, materials, coins with the 임의 아이템  -->
		<ItemsControl
			Margin="0 2 12 0"
			DataContext="{Binding ForkCounts}"
			Style="{StaticResource Group}"
			/>
		<ItemsControl DataContext="{Binding ForkResources}" Style="{StaticResource Group}" />
		<ItemsControl DataContext="{Binding ForkMaterials}" Style="{StaticResource Group}" />
		<ItemsControl DataContext="{Binding ForkOwned}" Style="{StaticResource Group}" />

		<!--  The senka as text (user decision)  -->
		<StackPanel
			VerticalAlignment="Top"
			Orientation="Horizontal"
			Visibility="{Binding ForkShowSenka, Converter={StaticResource BooleanToVisibilityConverter}}"
			>
			<TextBlock
				Style="{StaticResource Senka}"
				Text="{Binding SenkaSession.Text}"
				ToolTip="{Binding SenkaSession.ToolTip}"
				Visibility="{Binding SenkaSession.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
				/>
			<TextBlock
				Style="{StaticResource Senka}"
				Text="{Binding SenkaDay.Text}"
				ToolTip="{Binding SenkaDay.ToolTip}"
				Visibility="{Binding SenkaDay.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
				/>
			<TextBlock
				Style="{StaticResource Senka}"
				Text="{Binding SenkaMonth.Text}"
				ToolTip="{Binding SenkaMonth.ToolTip}"
				Visibility="{Binding SenkaMonth.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
				/>
		</StackPanel>
	</WrapPanel>
</UserControl>

<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvItemDetailWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding Title}"
	Width="430"
	Height="720"
	d:DataContext="{d:DesignInstance kcv:KcvItemDetailViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="kcv:KcvItemDetailViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the items the admiral has (mockup 20261024-item-detail-v2). One table as the ship list's: the game's icon
		and the name, how many there are. No search, no filter, no sorting: item ID order.
	-->
	<Window.Resources>
		<Style x:Key="Header" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="{DynamicResource Kcv.TableHeaderBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="8 8" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridColumnHeader">
						<Border
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{DynamicResource Kcv.HeaderBackground}"
							BorderThickness="0 0 1 0"
							>
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style
			x:Key="CountHeader"
			BasedOn="{StaticResource Header}"
			TargetType="DataGridColumnHeader"
			>
			<Setter Property="HorizontalContentAlignment" Value="Right" />
		</Style>

		<Style x:Key="Cell" TargetType="DataGridCell">
			<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridCell">
						<ContentPresenter VerticalAlignment="Stretch" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  the colours on the template's border, as the ship list's rows (DataGridRow coerces its Background)  -->
		<Style x:Key="Row" TargetType="DataGridRow">
			<Setter Property="MinHeight" Value="31" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridRow">
						<Border
							x:Name="Back"
							Background="Transparent"
							SnapsToDevicePixels="True"
							>
							<DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Text" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="8 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</Window.Resources>

	<DataGrid
		Margin="12 4 12 10"
		AutoGenerateColumns="False"
		Background="Transparent"
		BorderBrush="{DynamicResource Kcv.HeaderBackground}"
		BorderThickness="1"
		CanUserAddRows="False"
		CanUserDeleteRows="False"
		CanUserReorderColumns="False"
		CanUserResizeColumns="False"
		CanUserResizeRows="False"
		CanUserSortColumns="False"
		CellStyle="{StaticResource Cell}"
		ColumnHeaderStyle="{StaticResource Header}"
		EnableRowVirtualization="True"
		GridLinesVisibility="Horizontal"
		HeadersVisibility="Column"
		HorizontalGridLinesBrush="{DynamicResource Kcv.Separator}"
		IsReadOnly="True"
		ItemsSource="{Binding Rows}"
		RowBackground="Transparent"
		RowStyle="{StaticResource Row}"
		SelectionMode="Single"
		>
		<DataGrid.Columns>
			<DataGridTemplateColumn Width="*" Header="{x:Static fork:ForkStrings.KcvItemDetailItem}">
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate DataType="{x:Type kcv:KcvItemDetailRow}">
						<StackPanel
							Margin="8 0 0 0"
							VerticalAlignment="Center"
							Orientation="Horizontal"
							>
							<Image
								Width="24"
								Height="24"
								Source="{Binding Icon}"
								/>
							<TextBlock Style="{StaticResource Text}" Text="{Binding Name}" />
						</StackPanel>
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTemplateColumn
				Width="90"
				Header="{x:Static fork:ForkStrings.KcvItemDetailCount}"
				HeaderStyle="{StaticResource CountHeader}"
				>
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate DataType="{x:Type kcv:KcvItemDetailRow}">
						<TextBlock
							HorizontalAlignment="Right"
							Style="{StaticResource Text}"
							Text="{Binding Count}"
							/>
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>
		</DataGrid.Columns>
	</DataGrid>
</common:WindowBase>

<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvEquipmentUpgradePlannerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pager="clr-namespace:KCViewer.Window.Control.Paging"
	xmlns:planner="clr-namespace:KCViewer.Window.Tools.EquipmentUpgradePlanner"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding EquipmentUpgradePlanner.Title}"
	Width="1240"
	Height="680"
	d:DataContext="{d:DesignInstance planner:EquipmentUpgradePlannerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="planner:EquipmentUpgradePlannerViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the upgrade planner in KanColleViewer's style (mockups v1-v2, user's approval 2026-10-02), opened instead
		of the viewer's window while the style is on. The viewer's view model and its commands stay (add from owned or
		all equipment, compact mode, finished plans, day filters, pages, edit, remove, upgrade tree, total cost). Each
		plan is a card with a header line as the fleet overview's: icon, name and the buttons. Under it the level,
		goal (★+n / ★max), priority and finished, the cost, and the helpers: one line per helper group with its days,
		or in compact mode one line of days whose tooltips list that day's helpers.
	-->
	<Window.Resources>
		<planner:EquipmentUpgradePlannerBindingProxy x:Key="Proxy" DataContext="{Binding}" />

		<Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
			<Setter Property="Margin" Value="0 0 12 0" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  The upright lines between the groups of the tool bar  -->
		<Style x:Key="BarSeparator" TargetType="Border">
			<Setter Property="Width" Value="1" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="0 0 12 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
		</Style>

		<!--  A card as the fleet overview's: a frame and a header line; narrower in compact mode  -->
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Width" Value="400" />
			<Setter Property="Margin" Value="0 0 8 8" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="Transparent" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.EquipmentUpgradePlanManager.CompactMode, Source={StaticResource Proxy}}" Value="True">
					<Setter Property="Width" Value="300" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CardHeader" TargetType="DockPanel">
			<Setter Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="LastChildFill" Value="True" />
		</Style>

		<Style x:Key="CardHeaderText" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>

		<!--  The small buttons on a card's header line (based on the button style in effect, KanColleViewer's)  -->
		<Style x:Key="CardButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
			<Setter Property="Width" Value="26" />
			<Setter Property="Height" Value="22" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="3 0 0 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  Segoe MDL2 Assets glyphs of ModernWpf's Edit, Delete and AllApps symbols, in the button's text colour  -->
		<Style x:Key="CardButtonIcon" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="Label" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0 2 8 2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="Value" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0 2 12 2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  A section title with a line above it (필요 자재, 보조함)  -->
		<Style x:Key="Section" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0 0 0 3" />
		</Style>
		<Style x:Key="SectionLine" TargetType="Border">
			<Setter Property="Margin" Value="0 7 0 6" />
			<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
			<Setter Property="BorderThickness" Value="0 1 0 0" />
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="{Binding PlanListWidth, Mode=TwoWay}" />
		</Grid.ColumnDefinitions>

		<!--  The viewer's tool bar: add, compact mode, finished plans | day filters | pages  -->
		<WrapPanel
			Grid.Row="0"
			Grid.Column="0"
			Grid.ColumnSpan="3"
			Margin="12 8 12 8"
			Orientation="Horizontal"
			>
			<Button
				Margin="0 0 6 4"
				Command="{Binding AddEquipmentPlanCommand}"
				Content="{Binding EquipmentUpgradePlanner.AddOwnedEquipment}"
				/>
			<Button
				Margin="0 0 12 4"
				Command="{Binding AddEquipmentPlanFromMasterDataCommand}"
				Content="{Binding EquipmentUpgradePlanner.AddEquipmentFromLibrary}"
				/>
			<CheckBox Content="{Binding EquipmentUpgradePlanner.CompactMode}" IsChecked="{Binding EquipmentUpgradePlanManager.CompactMode}" />
			<CheckBox Content="{Binding EquipmentUpgradePlanner.DisplayFinished}" IsChecked="{Binding Filters.DisplayFinished}" />

			<Border Style="{StaticResource BarSeparator}" />

			<CheckBox Content="{Binding Filters.TodayDisplay}" IsChecked="{Binding Filters.SelectToday}" />
			<CheckBox Content="{Binding EquipmentUpgradePlanner.All}" IsChecked="{Binding Filters.SelectAllDay}" />
			<ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Filters.Days}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<CheckBox Content="{Binding DisplayValue}" IsChecked="{Binding IsChecked}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<Border Style="{StaticResource BarSeparator}" />

			<pager:PagingControlView VerticalAlignment="Center" ViewModel="{Binding PlannedUpgradesPager}" />
		</WrapPanel>

		<ScrollViewer
			Grid.Row="1"
			Grid.Column="0"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto"
			>
			<ItemsControl Margin="12 0 4 4" ItemsSource="{Binding PlannedUpgradesPager.DisplayedItems}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type planner:EquipmentUpgradePlanItemViewModel}">
						<Border Style="{StaticResource Card}">
							<StackPanel>
								<!--  Header line: the equipment's icon and name, then edit, remove and the upgrade tree  -->
								<DockPanel Style="{StaticResource CardHeader}">
									<StackPanel
										Margin="6 0 4 0"
										DockPanel.Dock="Right"
										Orientation="Horizontal"
										>
										<Button
											Command="{Binding DataContext.OpenEditDialogCommand, Source={StaticResource Proxy}}"
											CommandParameter="{Binding}"
											Style="{StaticResource CardButton}"
											ToolTip="{Binding DataContext.EquipmentUpgradePlanner.Edit, Source={StaticResource Proxy}}"
											>
											<TextBlock Style="{StaticResource CardButtonIcon}" Text="&#xE70F;" />
										</Button>
										<Button
											Command="{Binding DataContext.RemovePlanCommand, Source={StaticResource Proxy}}"
											CommandParameter="{Binding}"
											Style="{StaticResource CardButton}"
											ToolTip="{Binding DataContext.EquipmentUpgradePlanner.Remove, Source={StaticResource Proxy}}"
											>
											<TextBlock Style="{StaticResource CardButtonIcon}" Text="&#xE74D;" />
										</Button>
										<Button
											Command="{Binding DataContext.OpenTreeDialogCommand, Source={StaticResource Proxy}}"
											CommandParameter="{Binding}"
											Style="{StaticResource CardButton}"
											ToolTip="{Binding DataContext.EquipmentUpgradePlanner.UpgradeTree, Source={StaticResource Proxy}}"
											>
											<TextBlock Style="{StaticResource CardButtonIcon}" Text="&#xE71D;" />
										</Button>
									</StackPanel>
									<Image
										Width="20"
										Height="20"
										Margin="8 0 6 0"
										VerticalAlignment="Center"
										Style="{StaticResource Kcv.EquipmentIcon}"
										>
										<Image.Source>
											<MultiBinding Converter="{StaticResource Kcv.UpgradePlanIcon}">
												<Binding Path="EquipmentName" />
												<Binding />
											</MultiBinding>
										</Image.Source>
									</Image>
									<TextBlock
										Style="{StaticResource CardHeaderText}"
										Text="{Binding EquipmentName}"
										ToolTip="{Binding EquipmentName}"
										/>
								</DockPanel>

								<StackPanel Margin="10 6 10 8">
									<!--  Level, goal, priority, finished  -->
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<TextBlock
											Grid.Row="0"
											Grid.Column="0"
											Style="{StaticResource Label}"
											Text="{Binding EquipmentUpgradePlanItem.UpgradeLevel}"
											/>
										<TextBlock Grid.Row="0" Grid.Column="1">
											<TextBlock.Text>
												<MultiBinding Converter="{StaticResource Kcv.UpgradeCurrentLevel}">
													<Binding Path="CurrentLevelDisplay" />
													<Binding />
												</MultiBinding>
											</TextBlock.Text>
											<TextBlock.Style>
												<Style BasedOn="{StaticResource Value}" TargetType="TextBlock">
													<Setter Property="Foreground">
														<Setter.Value>
															<MultiBinding Converter="{StaticResource Kcv.UpgradeCurrentLevel}" ConverterParameter="Brush">
																<Binding Path="CurrentLevelDisplay" />
																<Binding />
															</MultiBinding>
														</Setter.Value>
													</Setter>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Equipment.MasterID}" Value="0">
															<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>

										<TextBlock
											Grid.Row="0"
											Grid.Column="2"
											Style="{StaticResource Label}"
											Text="{Binding EquipmentUpgradePlanItem.Goal}"
											/>
										<TextBlock
											Grid.Row="0"
											Grid.Column="3"
											Text="{Binding DesiredUpgradeLevel, Converter={StaticResource Kcv.UpgradeLevel}}"
											>
											<TextBlock.Style>
												<Style BasedOn="{StaticResource Value}" TargetType="TextBlock">
													<Setter Property="Foreground" Value="{Binding DesiredUpgradeLevel, Converter={StaticResource Kcv.UpgradeLevel}, ConverterParameter=Brush}" />
													<Style.Triggers>
														<!--  개수 갱신 in the text colour (the converter has no colour for it, which left it black)  -->
														<DataTrigger Binding="{Binding DesiredUpgradeLevel}" Value="Conversion">
															<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>

										<TextBlock
											Grid.Row="1"
											Grid.Column="0"
											Style="{StaticResource Label}"
											Text="{Binding EquipmentUpgradePlanItem.Priority}"
											/>
										<TextBlock
											Grid.Row="1"
											Grid.Column="1"
											Style="{StaticResource Value}"
											Text="{Binding Priority}"
											/>

										<TextBlock
											Grid.Row="1"
											Grid.Column="2"
											Style="{StaticResource Label}"
											Text="{Binding EquipmentUpgradePlanItem.IsFinished}"
											/>
										<!--  shown only; finishing a plan is done in its edit dialog, as in the viewer's card  -->
										<CheckBox
											Grid.Row="1"
											Grid.Column="3"
											Margin="0"
											HorizontalAlignment="Left"
											Focusable="False"
											IsChecked="{Binding Finished, Mode=OneWay}"
											IsHitTestVisible="False"
											/>
									</Grid>

									<!--  Cost up to the goal (and what the conversion gives)  -->
									<Border Style="{StaticResource SectionLine}" />
									<TextBlock Style="{StaticResource Section}" Text="{Binding EquipmentUpgradePlanItem.Cost}" />
									<TextBlock
										Margin="0 0 0 3"
										FontSize="12"
										Style="{StaticResource Kcv.SubText}"
										Visibility="{Binding EquipmentAfterConversionVisible}"
										>
										<Run Text="{Binding EquipmentUpgradePlanItem.ConvertTo, Mode=OneWay}" />
										<Run Text="{Binding EquipmentAfterConversionDisplay, Mode=OneWay}" />
									</TextBlock>
									<kcv:KcvUpgradeCostView DataContext="{Binding Cost}" />

									<!--  Helpers: per group with its days, or in compact mode one line of days  -->
									<Border Style="{StaticResource SectionLine}" />
									<TextBlock Style="{StaticResource Section}" Text="{x:Static fork:ForkStrings.KcvUpgradeHelpers}" />
									<kcv:KcvUpgradeHelpersView DataContext="{Binding HelperViewModels}">
										<kcv:KcvUpgradeHelpersView.Style>
											<Style TargetType="kcv:KcvUpgradeHelpersView">
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.EquipmentUpgradePlanManager.CompactMode, Source={StaticResource Proxy}}" Value="True">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</kcv:KcvUpgradeHelpersView.Style>
									</kcv:KcvUpgradeHelpersView>
									<kcv:KcvUpgradeDaysView HorizontalAlignment="Left" DataContext="{Binding HelperViewModelCompact}">
										<kcv:KcvUpgradeDaysView.Style>
											<Style TargetType="kcv:KcvUpgradeDaysView">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.EquipmentUpgradePlanManager.CompactMode, Source={StaticResource Proxy}}" Value="True">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</kcv:KcvUpgradeDaysView.Style>
									</kcv:KcvUpgradeDaysView>
								</StackPanel>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<GridSplitter
			Grid.Row="1"
			Grid.Column="1"
			Width="4"
			HorizontalAlignment="Center"
			VerticalAlignment="Stretch"
			Background="Transparent"
			ResizeBehavior="PreviousAndNext"
			ResizeDirection="Columns"
			/>

		<!--  Total cost of the plans not finished, on a card of the same look  -->
		<ScrollViewer
			Grid.Row="1"
			Grid.Column="2"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto"
			>
			<Border
				Margin="4 0 12 12"
				VerticalAlignment="Top"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="1"
				>
				<StackPanel>
					<DockPanel Style="{StaticResource CardHeader}">
						<TextBlock
							Margin="10 0"
							Style="{StaticResource CardHeaderText}"
							Text="{Binding EquipmentUpgradePlanner.TotalCost}"
							/>
					</DockPanel>
					<kcv:KcvUpgradeCostView Margin="10 6 10 8" DataContext="{Binding TotalCost}" />
				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</common:WindowBase>

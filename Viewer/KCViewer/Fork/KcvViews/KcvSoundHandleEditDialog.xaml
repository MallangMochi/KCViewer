<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvSoundHandleEditDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bgm="clr-namespace:KCViewer.Window.Settings.BGM"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding Title}"
	Width="520"
	Height="190"
	d:DataContext="{d:DesignInstance bgm:SoundHandleEditViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="bgm:SoundHandleEditViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the BGM scene editor of the settings window in KanColleViewer's style (mockup 20261007-settings-v2:
		520×190, 74식 500×170) with the viewer's view model: 경로 with [...] and [Dir], 루프 and 루프 시작 위치
		(seconds, four decimals as the viewer's), 음량, then [OK] and [취소].
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button
					MinWidth="72"
					Command="{Binding ConfirmCommand}"
					Content="OK"
					Style="{StaticResource KcvRec.PrimaryButton}"
					/>
				<Button
					MinWidth="72"
					Command="{Binding CancelCommand}"
					Content="{Binding Translation.Cancel}"
					Style="{StaticResource KcvRec.Button}"
					/>
			</StackPanel>
		</Border>

		<StackPanel Margin="14 10">
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<TextBlock
					MinWidth="40"
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.Path, Converter={StaticResource Cfg.Label}}"
					/>
				<TextBox
					Width="340"
					Style="{StaticResource Cfg.Field}"
					Text="{Binding SoundHandle.Path}"
					/>
				<Button Command="{Binding OpenSoundPathCommand}" Style="{StaticResource Cfg.Browse}" />
				<Button
					Command="{Binding SoundPathDirectorizeCommand}"
					Content="Dir"
					Style="{StaticResource Cfg.Browse}"
					/>
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<CheckBox Content="{Binding Translation.Loop}" IsChecked="{Binding SoundHandle.IsLoop}" />
				<TextBlock Style="{StaticResource Cfg.Lbl}" Text="{Binding Translation.Lead, Converter={StaticResource Cfg.Label}}" />
				<TextBox
					Width="90"
					Style="{StaticResource Cfg.Field}"
					Text="{Binding SoundHandle.LoopHeadPosition, StringFormat=0.0000}"
					/>
				<TextBlock Style="{StaticResource Cfg.Unit}" Text="{Binding Translation.Second}" />
			</WrapPanel>
			<WrapPanel Style="{StaticResource Cfg.Row}">
				<TextBlock
					MinWidth="40"
					Style="{StaticResource Cfg.Lbl}"
					Text="{Binding Translation.Volume, Converter={StaticResource Cfg.Label}}"
					/>
				<kcv:KcvNumberBox
					Maximum="100"
					Minimum="0"
					Style="{StaticResource Cfg.Num}"
					Value="{Binding SoundHandle.Volume}"
					/>
			</WrapPanel>
		</StackPanel>
	</DockPanel>
</common:WindowBase>

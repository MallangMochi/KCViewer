<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvShipGroupView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shipGroup="clr-namespace:KCViewer.Avalonia.ShipGroup;assembly=KCViewer.Avalonia"
	x:Name="Panel"
	d:DesignHeight="400"
	d:DesignWidth="800"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the ship group panel in KanColleViewer's style (remaining panels mockup 1, user's approval 2026-10-02),
		a WPF view over the viewer's own view models (ShipGroupAvaloniaViewModel and its Avalonia ShipGroupViewModel),
		so the groups, their filters, the dialogs, the saved columns and sorting and the auto update stay the viewer's.
		The 61 columns are the viewer's in the same order: the saved column settings of a group are matched by position
		(PersistentColumnsBehavior), and this view keeps them as the Avalonia grid would (KcvShipGroupView.xaml.cs).
		Looks: group tabs as text boxes (the selected one in the accent), the ship list's table, HP with the fleet
		panel's gauge, condition with its square, short fuel, ammo and planes, repair times and lost planes in text
		colours (the viewer's rules), fully modernized firepower, torpedo, AA and armor in the ship list's colours.
	-->
	<UserControl.Resources>
		<kcv:KcvShipGroupProxy x:Key="Proxy" />
		<kcv:KcvShipGroupTextConverter x:Key="Text" />
		<kcv:KcvShipGroupStateConverter x:Key="State" />
		<kcv:KcvShipGroupMaxConverter x:Key="Max" />
		<kcv:KcvShipGroupLockConverter x:Key="Lock" />

		<Style x:Key="Cell" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="5 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style x:Key="SubCell" BasedOn="{StaticResource Cell}" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
		</Style>

		<!--  A text whose Tag is a KcvShipGroupStateConverter category  -->
		<Style x:Key="StateCell" BasedOn="{StaticResource Cell}" TargetType="TextBlock">
			<Style.Triggers>
				<Trigger Property="Tag" Value="Short">
					<Setter Property="Foreground" Value="{x:Static kcv:KcvShipGroupBrushes.Short}" />
				</Trigger>
				<Trigger Property="Tag" Value="Middle">
					<Setter Property="Foreground" Value="{x:Static kcv:KcvShipGroupBrushes.Middle}" />
				</Trigger>
				<Trigger Property="Tag" Value="Long">
					<Setter Property="Foreground" Value="{x:Static kcv:KcvShipGroupBrushes.Long}" />
				</Trigger>
				<Trigger Property="Tag" Value="Empty">
					<Setter Property="Foreground" Value="{x:Static kcv:KcvShipGroupBrushes.Long}" />
				</Trigger>
				<Trigger Property="Tag" Value="None">
					<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<!--  Grips to resize a column  -->
		<Style x:Key="Grip" TargetType="Thumb">
			<Setter Property="Width" Value="6" />
			<Setter Property="Cursor" Value="SizeWE" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Border Background="Transparent" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Header" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="{DynamicResource Kcv.TableHeaderBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="5 6" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridColumnHeader">
						<Grid>
							<Border
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="{DynamicResource Kcv.HeaderBackground}"
								BorderThickness="0 0 1 0"
								>
								<DockPanel>
									<Path
										x:Name="Arrow"
										Width="8"
										Height="5"
										Margin="4 0 0 0"
										VerticalAlignment="Center"
										Data="M 0,0 L 4,5 L 8,0 Z"
										DockPanel.Dock="Right"
										Fill="{DynamicResource Kcv.SubForeground}"
										Visibility="Collapsed"
										/>
									<ContentPresenter VerticalAlignment="Center" />
								</DockPanel>
							</Border>
							<Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Grip}" />
							<Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Grip}" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="SortDirection" Value="Descending">
								<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="SortDirection" Value="Ascending">
								<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
								<Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 4,0 L 8,5 Z" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  Cells draw their own background (the fully modernized parameters)  -->
		<Style x:Key="CellBox" TargetType="DataGridCell">
			<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridCell">
						<Border Background="{TemplateBinding Background}">
							<ContentPresenter VerticalAlignment="Stretch" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="FirepowerBox" BasedOn="{StaticResource CellBox}" TargetType="DataGridCell">
			<Style.Triggers>
				<DataTrigger Value="True">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Max}">
							<Binding Path="FirepowerRemain" />
							<Binding Path="FirepowerTotal" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter Property="Background" Value="{DynamicResource Kcv.StatFirepower}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="TorpedoBox" BasedOn="{StaticResource CellBox}" TargetType="DataGridCell">
			<Style.Triggers>
				<DataTrigger Value="True">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Max}">
							<Binding Path="TorpedoRemain" />
							<Binding Path="TorpedoTotal" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter Property="Background" Value="{DynamicResource Kcv.StatTorpedo}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="AaBox" BasedOn="{StaticResource CellBox}" TargetType="DataGridCell">
			<Style.Triggers>
				<DataTrigger Value="True">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Max}">
							<Binding Path="AARemain" />
							<Binding Path="AATotal" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter Property="Background" Value="{DynamicResource Kcv.StatAA}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="ArmorBox" BasedOn="{StaticResource CellBox}" TargetType="DataGridCell">
			<Style.Triggers>
				<DataTrigger Value="True">
					<DataTrigger.Binding>
						<MultiBinding Converter="{StaticResource Max}">
							<Binding Path="ArmorRemain" />
							<Binding Path="ArmorTotal" />
						</MultiBinding>
					</DataTrigger.Binding>
					<Setter Property="Background" Value="{DynamicResource Kcv.StatArmor}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!--  Rows as the ship list's: hover and selection on the row template's border  -->
		<Style x:Key="Row" TargetType="DataGridRow">
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridRow">
						<Border x:Name="Back" Background="Transparent" SnapsToDevicePixels="True">
							<DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  An equipment cell: the game icon and the name, as the viewer's column shows the name  -->
		<DataTemplate x:Key="Slot">
			<StackPanel Margin="5 0" VerticalAlignment="Center" Orientation="Horizontal">
				<Image
					Width="16"
					Height="16"
					Margin="0 0 4 0"
					Source="{Binding MasterEquipment.IconTypeTyped, Converter={StaticResource Kcv.GameIcon}}"
					Style="{StaticResource Kcv.EquipmentIcon}"
					/>
				<TextBlock FontSize="12" Style="{StaticResource Kcv.Text}" Text="{Binding Name}" VerticalAlignment="Center" />
			</StackPanel>
		</DataTemplate>

		<!--  The group tabs' menu (the viewer's)  -->
		<ContextMenu x:Key="GroupMenu" x:Shared="False" DataContext="{Binding DataContext, Source={StaticResource Proxy}}">
			<MenuItem Command="{Binding AddGroupCommand}" Header="{Binding FormShipGroup.MenuGroup_Add}" />
			<MenuItem
				Command="{Binding CopyGroupCommand}"
				CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
				Header="{Binding FormShipGroup.MenuGroup_Copy}"
				/>
			<MenuItem
				Command="{Binding RenameGroupCommand}"
				CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
				Header="{Binding FormShipGroup.MenuGroup_Rename}"
				/>
			<MenuItem
				Command="{Binding DeleteGroupCommand}"
				CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
				Header="{Binding FormShipGroup.MenuGroup_Delete}"
				/>
			<Separator />
			<MenuItem Command="{Binding OpenDataGridSettingsCommand}" Header="{Binding FormShipGroup.DataGridSettings}" />
			<MenuItem
				Header="{Binding FormShipGroup.MenuGroup_AutoUpdate}"
				IsCheckable="True"
				IsChecked="{Binding AutoUpdate}"
				/>
			<MenuItem
				Header="{Binding FormShipGroup.MenuGroup_ShowStatusBar}"
				IsCheckable="True"
				IsChecked="{Binding ShowStatusBar}"
				/>
		</ContextMenu>
	</UserControl.Resources>

	<Grid x:Name="Root" Margin="8 6 8 4">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Group tabs; a double click on the empty part adds a group, a tab can be dragged onto another  -->
		<Border
			x:Name="GroupArea"
			Grid.Row="0"
			Margin="0 0 0 6"
			Background="Transparent"
			MouseLeftButtonDown="OnGroupAreaMouseDown"
			>
			<Border.ContextMenu>
				<ContextMenu DataContext="{Binding DataContext, Source={StaticResource Proxy}}">
					<MenuItem Command="{Binding AddGroupCommand}" Header="{Binding FormShipGroup.MenuGroup_Add}" />
					<Separator />
					<MenuItem Command="{Binding OpenDataGridSettingsCommand}" Header="{Binding FormShipGroup.DataGridSettings}" />
					<MenuItem
						Header="{Binding FormShipGroup.MenuGroup_AutoUpdate}"
						IsCheckable="True"
						IsChecked="{Binding AutoUpdate}"
						/>
					<MenuItem
						Header="{Binding FormShipGroup.MenuGroup_ShowStatusBar}"
						IsCheckable="True"
						IsChecked="{Binding ShowStatusBar}"
						/>
				</ContextMenu>
			</Border.ContextMenu>
			<ItemsControl ItemsSource="{Binding Groups}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<!--  a button drawn as a tab: selected on press, as the viewer's tab (and pressable by UI Automation)  -->
					<DataTemplate DataType="{x:Type shipGroup:ShipGroupItem}">
						<Button
							MinWidth="24"
							Margin="0 0 4 4"
							AllowDrop="True"
							ClickMode="Press"
							Command="{Binding DataContext.SelectGroupCommand, Source={StaticResource Proxy}}"
							CommandParameter="{Binding}"
							Content="{Binding Name}"
							ContextMenu="{StaticResource GroupMenu}"
							Drop="OnGroupDrop"
							Focusable="False"
							PreviewMouseLeftButtonDown="OnGroupMouseDown"
							PreviewMouseMove="OnGroupMouseMove"
							Tag="{Binding}"
							>
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border
										x:Name="Tab"
										Padding="8 2"
										Background="Transparent"
										BorderBrush="{DynamicResource Kcv.Separator}"
										BorderThickness="1"
										>
										<TextBlock FontSize="12" Style="{StaticResource Kcv.Text}" Text="{TemplateBinding Content}" />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="Tab" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
										</Trigger>
										<DataTrigger Binding="{Binding IsSelected}" Value="True">
											<Setter TargetName="Tab" Property="Background" Value="{DynamicResource Kcv.Accent}" />
											<Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
										</DataTrigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>

		<DataGrid
			x:Name="Grid"
			Grid.Row="1"
			AutoGenerateColumns="False"
			Background="Transparent"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="1"
			CanUserAddRows="False"
			CanUserDeleteRows="False"
			CanUserReorderColumns="True"
			CanUserResizeColumns="True"
			CellStyle="{StaticResource CellBox}"
			ColumnHeaderHeight="{Binding DataGridSettings.ColumnHeaderHeight}"
			ColumnHeaderStyle="{StaticResource Header}"
			ColumnReordered="OnColumnReordered"
			ColumnWidth="Auto"
			EnableColumnVirtualization="True"
			FrozenColumnCount="{Binding FrozenColumns}"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
			HorizontalGridLinesBrush="{DynamicResource Kcv.Separator}"
			IsReadOnly="True"
			ItemsSource="{Binding Items}"
			RowHeight="{Binding DataGridSettings.RowHeight}"
			RowStyle="{StaticResource Row}"
			SelectionChanged="OnSelectionChanged"
			SelectionMode="Extended"
			SelectionUnit="FullRow"
			Sorting="OnSorting"
			>
			<DataGrid.ContextMenu>
				<ContextMenu DataContext="{Binding DataContext, Source={StaticResource Proxy}}">
					<MenuItem Command="{Binding AddToGroupCommand}" Header="{Binding FormShipGroup.MenuMember_AddToGroup}" IsEnabled="{Binding AnyShipsSelected}" />
					<MenuItem Command="{Binding CreateGroupCommand}" Header="{Binding FormShipGroup.MenuMember_CreateGroup}" IsEnabled="{Binding AnyShipsSelected}" />
					<MenuItem Command="{Binding ExcludeFromGroupCommand}" Header="{Binding FormShipGroup.MenuMember_Exclude}" IsEnabled="{Binding AnyShipsSelected}" />
					<Separator />
					<MenuItem Command="{Binding FilterGroupCommand}" Header="{Binding FormShipGroup.MenuMember_Filter}" />
					<MenuItem Command="{Binding FilterColumnsCommand}" Header="{Binding FormShipGroup.MenuMember_ColumnFilter}" />
					<Separator />
					<MenuItem Command="{Binding ExportCsvCommand}" Header="{Binding FormShipGroup.MenuMember_CSVOutput}" />
					<MenuItem Command="{Binding OpenDataGridSettingsCommand}" Header="{Binding FormShipGroup.DataGridSettings}" />
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<!--  1-11: ID, type, name, level, experience, HP, condition, fuel, ammo  -->
				<DataGridTextColumn Binding="{Binding MasterId}" ElementStyle="{StaticResource Cell}" Header="ID" />
				<DataGridTextColumn Binding="{Binding ShipTypeName}" ElementStyle="{StaticResource SubCell}" Header="{Binding DataContext.FormShipGroup.ShipView_ShipType, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding Name}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Name, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding Level}" ElementStyle="{StaticResource Cell}" Header="Lv" />
				<DataGridTextColumn Binding="{Binding ExpTotal, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Cell}" Header="Exp" SortMemberPath="ExpTotal" />
				<DataGridTextColumn Binding="{Binding ExpNext, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Cell}" Header="next" SortMemberPath="ExpNext" />
				<DataGridTextColumn Binding="{Binding ExpRemodel, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_NextRemodel, Source={StaticResource Proxy}}" SortMemberPath="ExpRemodel" />
				<DataGridTemplateColumn Header="HP" SortMemberPath="Hp">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<StackPanel
								MinWidth="52"
								Margin="5 0"
								VerticalAlignment="Center"
								Background="Transparent"
								ToolTip="{Binding Hp.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}"
								>
								<TextBlock FontSize="12" Style="{StaticResource Kcv.Text}" Text="{Binding Hp}" />
								<ProgressBar
									Height="3"
									Margin="0 1 0 0"
									Maximum="{Binding Hp.Max, Mode=OneWay}"
									Style="{StaticResource Kcv.Gauge}"
									Value="{Binding Hp.Current, Mode=OneWay}"
									>
									<ProgressBar.Foreground>
										<MultiBinding Converter="{StaticResource Kcv.GaugeBrush}">
											<Binding Path="Hp.Current" />
											<Binding Path="Hp.Max" />
										</MultiBinding>
									</ProgressBar.Foreground>
								</ProgressBar>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Cond" SortMemberPath="Condition">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<StackPanel Margin="5 0" VerticalAlignment="Center" Orientation="Horizontal">
								<Rectangle
									Width="10"
									Height="10"
									Margin="0 0 4 0"
									VerticalAlignment="Center"
									Fill="{Binding Condition, Converter={StaticResource Kcv.ConditionBrush}}"
									Stroke="{DynamicResource Kcv.MarkBorder}"
									StrokeThickness="1"
									/>
								<TextBlock FontSize="12" Style="{StaticResource Kcv.Text}" Text="{Binding Condition}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Fuel, Source={StaticResource Proxy}}" SortMemberPath="Fuel">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Fuel, Converter={StaticResource State}}" Text="{Binding Fuel}" ToolTip="{Binding Fuel.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Ammo, Source={StaticResource Proxy}}" SortMemberPath="Ammo">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Ammo, Converter={StaticResource State}}" Text="{Binding Ammo}" ToolTip="{Binding Ammo.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  12-17: equipment 1-5 with icons, reinforcement  -->
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Slot1, Source={StaticResource Proxy}}" SortMemberPath="Slot1.Name">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<ContentPresenter Content="{Binding Slot1}" ContentTemplate="{StaticResource Slot}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Slot2, Source={StaticResource Proxy}}" SortMemberPath="Slot2.Name">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<ContentPresenter Content="{Binding Slot2}" ContentTemplate="{StaticResource Slot}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Slot3, Source={StaticResource Proxy}}" SortMemberPath="Slot3.Name">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<ContentPresenter Content="{Binding Slot3}" ContentTemplate="{StaticResource Slot}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Slot4, Source={StaticResource Proxy}}" SortMemberPath="Slot4.Name">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<ContentPresenter Content="{Binding Slot4}" ContentTemplate="{StaticResource Slot}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Slot5, Source={StaticResource Proxy}}" SortMemberPath="Slot5.Name">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<ContentPresenter Content="{Binding Slot5}" ContentTemplate="{StaticResource Slot}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Binding="{Binding ExpansionSlot}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_ExpansionSlot, Source={StaticResource Proxy}}" />

				<!--  18-23: planes 1-5 and their total: red when all lost, gold when short (the viewer's rules)  -->
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Aircraft1, Source={StaticResource Proxy}}" SortMemberPath="Aircraft1">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Aircraft1, Converter={StaticResource State}, ConverterParameter=Planes}" Text="{Binding Aircraft1}" ToolTip="{Binding Aircraft1.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Aircraft2, Source={StaticResource Proxy}}" SortMemberPath="Aircraft2">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Aircraft2, Converter={StaticResource State}, ConverterParameter=Planes}" Text="{Binding Aircraft2}" ToolTip="{Binding Aircraft2.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Aircraft3, Source={StaticResource Proxy}}" SortMemberPath="Aircraft3">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Aircraft3, Converter={StaticResource State}, ConverterParameter=Planes}" Text="{Binding Aircraft3}" ToolTip="{Binding Aircraft3.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Aircraft4, Source={StaticResource Proxy}}" SortMemberPath="Aircraft4">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Aircraft4, Converter={StaticResource State}, ConverterParameter=Planes}" Text="{Binding Aircraft4}" ToolTip="{Binding Aircraft4.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Aircraft5, Source={StaticResource Proxy}}" SortMemberPath="Aircraft5">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding Aircraft5, Converter={StaticResource State}, ConverterParameter=Planes}" Text="{Binding Aircraft5}" ToolTip="{Binding Aircraft5.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_AircraftTotal, Source={StaticResource Proxy}}" SortMemberPath="AircraftTotal">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding AircraftTotal, Converter={StaticResource State}, ConverterParameter=Planes}" Text="{Binding AircraftTotal}" ToolTip="{Binding AircraftTotal.Rate, Converter={StaticResource Text}, ConverterParameter=Rate}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  24-27: fleet, repair time (gold, orange, red by length), repair steel and fuel  -->
				<DataGridTextColumn Binding="{Binding Fleet}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Fleet, Source={StaticResource Proxy}}" />
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_RepairTime, Source={StaticResource Proxy}}" SortMemberPath="RepairTime">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock Style="{StaticResource StateCell}" Tag="{Binding RepairTime, Converter={StaticResource State}}" Text="{Binding RepairTime, Converter={StaticResource Text}, ConverterParameter=Time}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Binding="{Binding RepairSteel}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_RepairSteel, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding RepairFuel}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_RepairFuel, Source={StaticResource Proxy}}" />

				<!--  28-39: firepower, torpedo, AA, armor (each base, remaining, total), coloured when fully modernized  -->
				<DataGridTextColumn Binding="{Binding Firepower}" CellStyle="{StaticResource FirepowerBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Firepower, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding FirepowerRemain, Converter={StaticResource Text}, ConverterParameter=Remain}" CellStyle="{StaticResource FirepowerBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_FirepowerRemain, Source={StaticResource Proxy}}" SortMemberPath="FirepowerRemain" />
				<DataGridTextColumn Binding="{Binding FirepowerTotal}" CellStyle="{StaticResource FirepowerBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_FirepowerTotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding Torpedo}" CellStyle="{StaticResource TorpedoBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Torpedo, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding TorpedoRemain, Converter={StaticResource Text}, ConverterParameter=Remain}" CellStyle="{StaticResource TorpedoBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_TorpedoRemain, Source={StaticResource Proxy}}" SortMemberPath="TorpedoRemain" />
				<DataGridTextColumn Binding="{Binding TorpedoTotal}" CellStyle="{StaticResource TorpedoBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_TorpedoTotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding AA}" CellStyle="{StaticResource AaBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_AA, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding AARemain, Converter={StaticResource Text}, ConverterParameter=Remain}" CellStyle="{StaticResource AaBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_AARemain, Source={StaticResource Proxy}}" SortMemberPath="AARemain" />
				<DataGridTextColumn Binding="{Binding AATotal}" CellStyle="{StaticResource AaBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_AATotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding Armor}" CellStyle="{StaticResource ArmorBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Armor, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding ArmorRemain, Converter={StaticResource Text}, ConverterParameter=Remain}" CellStyle="{StaticResource ArmorBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_ArmorRemain, Source={StaticResource Proxy}}" SortMemberPath="ArmorRemain" />
				<DataGridTextColumn Binding="{Binding ArmorTotal}" CellStyle="{StaticResource ArmorBox}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_ArmorTotal, Source={StaticResource Proxy}}" />

				<!--  40-49: ASW, evasion, LOS, luck, bombing (no colours, as the ship list)  -->
				<DataGridTextColumn Binding="{Binding ASW}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_ASW, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding ASWTotal}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_ASWTotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding Evasion}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Evasion, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding EvasionTotal}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_EvasionTotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding LOS}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_LOS, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding LOSTotal}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_LOSTotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding Luck}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Luck, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding LuckRemain, Converter={StaticResource Text}, ConverterParameter=Remain}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_LuckRemain, Source={StaticResource Proxy}}" SortMemberPath="LuckRemain" />
				<DataGridTextColumn Binding="{Binding LuckTotal}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_LuckTotal, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding BomberTotal}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_BomberTotal, Source={StaticResource Proxy}}" />

				<!--  50-57: speed, range, the six powers  -->
				<DataGridTextColumn Binding="{Binding Speed, Converter={StaticResource Text}, ConverterParameter=Speed}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Speed, Source={StaticResource Proxy}}" SortMemberPath="Speed" />
				<DataGridTextColumn Binding="{Binding Range, Converter={StaticResource Text}, ConverterParameter=Range}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_Range, Source={StaticResource Proxy}}" SortMemberPath="Range" />
				<DataGridTextColumn Binding="{Binding AirBattlePower}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_AirBattlePower, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding ShellingPower}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_ShellingPower, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding AircraftPower}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_AircraftPower, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding AntiSubmarinePower}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_AntiSubmarinePower, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding TorpedoPower}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_TorpedoPower, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding NightBattlePower}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_NightBattlePower, Source={StaticResource Proxy}}" />

				<!--  58-61: lock (♥ locked, ■ locked by equipment), sortie area, sort ID, repair time per HP  -->
				<DataGridTemplateColumn Header="{Binding DataContext.FormShipGroup.ShipView_Locked, Source={StaticResource Proxy}}" SortMemberPath="LockSortValue">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type shipGroup:ShipGroupItemViewModel}">
							<TextBlock
								HorizontalAlignment="Center"
								Foreground="{Binding Converter={StaticResource Lock}, ConverterParameter=Brush}"
								Style="{StaticResource Cell}"
								Text="{Binding Converter={StaticResource Lock}}"
								/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Binding="{Binding SallyArea}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.ShipView_SallyArea, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding SortId}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.SortId, Source={StaticResource Proxy}}" />
				<DataGridTextColumn Binding="{Binding RepairTimeUnit, Converter={StaticResource Text}, ConverterParameter=Time}" ElementStyle="{StaticResource Cell}" Header="{Binding DataContext.FormShipGroup.RepairTimeUnit, Source={StaticResource Proxy}}" SortMemberPath="RepairTimeUnit" />
			</DataGrid.Columns>
		</DataGrid>

		<!--  Status bar: ships, level and experience totals and averages (of the selection with two or more)  -->
		<StackPanel
			Grid.Row="2"
			Margin="0 4 0 0"
			Orientation="Horizontal"
			Visibility="{Binding ShowStatusBar, Converter={StaticResource BooleanToVisibilityConverter}}"
			>
			<TextBlock Margin="0 0 12 0" Style="{StaticResource SubCell}" Text="{Binding ShipCountText}" />
			<TextBlock Margin="0 0 12 0" Style="{StaticResource SubCell}" Text="{Binding LevelTotalText}" />
			<TextBlock Style="{StaticResource SubCell}" Text="{Binding LevelAverageText}" />
		</StackPanel>
	</Grid>
</UserControl>

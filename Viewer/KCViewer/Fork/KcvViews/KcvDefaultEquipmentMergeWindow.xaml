<Window
	x:Class="KCViewer.Fork.KcvViews.KcvDefaultEquipmentMergeWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static fork:ForkStrings.DefaultEquipmentMergeTitle}"
	Width="640"
	Height="380"
	MinWidth="480"
	MinHeight="260"
	d:DataContext="{d:DesignInstance kcv:KcvDefaultEquipmentMergeViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	FontSize="12"
	ShowActivated="False"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d"
	>
	<!--
		Fork: 자동 데이터 업데이트 수동 병합 in KanColleViewer's style (mockup 20261125-default-equipment-v6, approved
		"시안 6대로 구현"; the text is the user's): the versions, 갱신·일치·불일치 in chips, the ships whose record differs
		from the new data with both side by side (the slots that differ in gold), all chosen at first, 신규 데이터 적용 (x건)
		and 기존 데이터 유지 (also the title bar's ✕ and Esc). It does not stop the viewer and does not take the focus from
		the game; only the table scrolls. Its size and place are kept for the next time.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="Chip" TargetType="Border">
				<Setter Property="Height" Value="19" />
				<Setter Property="Padding" Value="7 0" />
				<Setter Property="Margin" Value="0 0 6 0" />
				<Setter Property="Background" Value="{DynamicResource Kcv.TableHeaderBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Kcv.ButtonBorder}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="TextElement.FontSize" Value="11" />
				<Setter Property="TextElement.Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			</Style>

			<Style x:Key="ColumnHead" TargetType="TextBlock">
				<Setter Property="Margin" Value="8 0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
			</Style>

			<!--  a slot: its number and equipment; none in grey, a slot where the record and the data differ in gold  -->
			<DataTemplate x:Key="Slot" DataType="{x:Type kcv:KcvDefaultEquipmentSlot}">
				<StackPanel Height="19" Orientation="Horizontal">
					<TextBlock
						x:Name="Number"
						Width="12"
						Margin="0 0 6 0"
						VerticalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource Kcv.InactiveForeground}"
						Text="{Binding Number}"
						TextAlignment="Right"
						/>
					<TextBlock
						x:Name="Name"
						VerticalAlignment="Center"
						Foreground="{DynamicResource Kcv.SubForeground}"
						Text="{Binding Name}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding Name}"
						/>
				</StackPanel>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding IsEmpty}" Value="True">
						<Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Differs}" Value="True">
						<Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Kcv.RankS}" />
						<Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Kcv.RankS}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel Margin="14 12">
		<StackPanel
			Margin="0 12 0 0"
			HorizontalAlignment="Right"
			DockPanel.Dock="Bottom"
			Orientation="Horizontal"
			>
			<Button
				MinHeight="24"
				Click="OnApplyClick"
				Content="{Binding ApplyText}"
				IsEnabled="{Binding CanApply}"
				Style="{StaticResource KcvRec.PrimaryButton}"
				/>
			<Button
				MinHeight="24"
				Margin="8 0 0 0"
				Click="OnKeepClick"
				Content="{x:Static fork:ForkStrings.DefaultEquipmentMergeKeep}"
				IsCancel="True"
				Style="{StaticResource KcvRec.Button}"
				/>
		</StackPanel>

		<StackPanel DockPanel.Dock="Top">
			<TextBlock
				FontSize="12.5"
				Foreground="{DynamicResource Kcv.Foreground}"
				Text="{Binding Header}"
				TextWrapping="Wrap"
				/>
			<WrapPanel Margin="0 9 0 0">
				<Border Style="{StaticResource Chip}">
					<TextBlock VerticalAlignment="Center" Text="{Binding UpdatedText}" />
				</Border>
				<Border Style="{StaticResource Chip}">
					<TextBlock VerticalAlignment="Center" Text="{Binding MatchedText}" />
				</Border>
				<Border
					Background="{DynamicResource Kcv.Accent}"
					BorderBrush="{DynamicResource Kcv.AccentHighlight}"
					Style="{StaticResource Chip}"
					TextElement.Foreground="White"
					>
					<TextBlock VerticalAlignment="Center" Text="{Binding ConflictsText}" />
				</Border>
			</WrapPanel>
			<TextBlock
				Margin="0 8 0 0"
				Foreground="{DynamicResource Kcv.SubForeground}"
				Text="{x:Static fork:ForkStrings.DefaultEquipmentMergeDescription}"
				TextWrapping="Wrap"
				/>
		</StackPanel>

		<Grid Margin="0 10 0 0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border
				Height="24"
				Background="{DynamicResource Kcv.TableHeaderBackground}"
				BorderBrush="{DynamicResource Kcv.ButtonBorder}"
				BorderThickness="0 0 0 1"
				>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="30" />
						<ColumnDefinition Width="150" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<CheckBox
						Margin="8 0 0 0"
						IsChecked="{Binding AllSelected}"
						Style="{StaticResource KcvRec.Check}"
						/>
					<TextBlock
						Grid.Column="1"
						Style="{StaticResource ColumnHead}"
						Text="{x:Static fork:ForkStrings.DefaultEquipmentMergeShip}"
						/>
					<TextBlock
						Grid.Column="2"
						Style="{StaticResource ColumnHead}"
						Text="{x:Static fork:ForkStrings.DefaultEquipmentMergeProfile}"
						/>
					<TextBlock
						Grid.Column="3"
						Style="{StaticResource ColumnHead}"
						Text="{Binding NewColumn}"
						/>
				</Grid>
			</Border>

			<ScrollViewer
				Grid.Row="1"
				Focusable="False"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto"
				>
				<ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type kcv:KcvDefaultEquipmentMergeRow}">
							<Border
								x:Name="Row"
								BorderBrush="{DynamicResource Kcv.ButtonBorder}"
								BorderThickness="0 0 0 1"
								>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="30" />
										<ColumnDefinition Width="150" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<!--  the chosen row's bar on the left  -->
									<Rectangle
										x:Name="Bar"
										Width="3"
										HorizontalAlignment="Left"
										Fill="{DynamicResource Kcv.AccentHighlight}"
										Visibility="Collapsed"
										/>
									<CheckBox
										Margin="8 7 0 0"
										VerticalAlignment="Top"
										IsChecked="{Binding IsSelected}"
										Style="{StaticResource KcvRec.Check}"
										/>
									<StackPanel Grid.Column="1" Margin="8 6">
										<TextBlock
											Foreground="{DynamicResource Kcv.Foreground}"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis"
											/>
										<TextBlock
											FontSize="11"
											Foreground="{DynamicResource Kcv.InactiveForeground}"
											Text="{Binding Detail}"
											/>
									</StackPanel>
									<ItemsControl
										Grid.Column="2"
										Margin="8 6"
										Focusable="False"
										ItemTemplate="{StaticResource Slot}"
										ItemsSource="{Binding Profile}"
										/>
									<ItemsControl
										Grid.Column="3"
										Margin="8 6"
										Focusable="False"
										ItemTemplate="{StaticResource Slot}"
										ItemsSource="{Binding New}"
										/>
								</Grid>
							</Border>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding IsSelected}" Value="True">
									<Setter TargetName="Row" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
									<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</DockPanel>
</Window>

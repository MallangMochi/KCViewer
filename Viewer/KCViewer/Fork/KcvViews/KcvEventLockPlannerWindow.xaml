<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvEventLockPlannerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:colorPicker="clr-namespace:ColorPickerLib.Controls;assembly=ColorPickerLib"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:eventLock="clr-namespace:KCViewer.Window.Tools.EventLockPlanner"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:persistentColumns="clr-namespace:KCViewer.Behaviors.PersistentColumns"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding EventLockPlanner.Title}"
	Width="1200"
	Height="800"
	d:DataContext="{d:DesignInstance eventLock:EventLockPlannerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="eventLock:EventLockPlannerViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: 이벤트 딱지 플래너 in KanColleViewer's style (mockup 20261007-event-lock-v2, approved 2026-10-07 "구현") with
		the viewer's view model, so the plan is the one its window saves and loads. Three boxes with their counts:
		「단계」 (a card per phase: its name to edit, 「완료」, the ship count, the phase's locks as chips in their colours,
		its ships, red when their planned lock is not one of the phase's), 「딱지」 (a card per lock with its header in
		the lock's colour: the colour square, the name to edit, the count, its ships) and 「딱지 없는 함선」 (the fold
		「필터 설정」 with the name box, then the table). Ships are dragged between the table and the cards as in the
		viewer's window, whose drop handlers look for the data context of the list a ship comes from; the right click
		menus are the viewer's. The boxes share the window's height (the handles between them move it); a window lower
		than their least heights scrolls (③ of the mockup), the card rows and the table scroll sideways themselves.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<eventLock:EventLockPlannerBindingProxy x:Key="Proxy" DataContext="{Binding}" />
			<kcv:KcvAllTypesCheckedConverter x:Key="AllTypesChecked" />
			<kcv:KcvLockPrefixConverter x:Key="LockPrefix" />
			<kcv:KcvCheckMarkConverter x:Key="CheckMark" />

			<!--  a box: 「단계」, 「딱지」, 「딱지 없는 함선」  -->
			<Style x:Key="Section" TargetType="Border">
				<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="8 3 8 6" />
			</Style>
			<Style x:Key="SectionTitle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			</Style>
			<Style x:Key="SectionCount" TargetType="TextBlock">
				<Setter Property="FontSize" Value="11" />
				<Setter Property="Margin" Value="6 0 0 0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.InactiveForeground}" />
			</Style>
			<Style
				x:Key="SectionButton"
				BasedOn="{StaticResource KcvRec.Button}"
				TargetType="Button"
				>
				<Setter Property="FontSize" Value="12" />
				<Setter Property="Padding" Value="10 1" />
				<Setter Property="Margin" Value="4 0 0 0" />
			</Style>

			<!--  the handle between two boxes (the viewer's GridSplitter), a short bar in the middle  -->
			<Style x:Key="Splitter" TargetType="GridSplitter">
				<Setter Property="Height" Value="8" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="VerticalAlignment" Value="Stretch" />
				<Setter Property="ResizeBehavior" Value="PreviousAndNext" />
				<Setter Property="ResizeDirection" Value="Rows" />
				<Setter Property="Focusable" Value="False" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="GridSplitter">
							<Border Background="Transparent">
								<Rectangle
									Width="40"
									Height="2"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Fill="{DynamicResource Kcv.Separator}"
									RadiusX="1"
									RadiusY="1"
									/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--  a card's name, edited where it is: no box until the mouse is over it or it is being typed  -->
			<Style x:Key="NameBox" TargetType="TextBox">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
				<Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
				<Setter Property="SelectionBrush" Value="{DynamicResource Kcv.Accent}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="SnapsToDevicePixels" Value="True" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="TextBox">
							<Border
								x:Name="Box"
								Padding="2 0"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1"
								>
								<ScrollViewer
									x:Name="PART_ContentHost"
									VerticalAlignment="Center"
									Focusable="False"
									HorizontalScrollBarVisibility="Hidden"
									VerticalScrollBarVisibility="Hidden"
									/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Separator}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kcv.Accent}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--  the colour square of a lock's header with a small arrow; the viewer's colour picker opens under it  -->
			<Style x:Key="Swatch" TargetType="ToggleButton">
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Focusable" Value="False" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ToggleButton">
							<StackPanel Background="Transparent" Orientation="Horizontal">
								<Border
									Width="12"
									Height="12"
									VerticalAlignment="Center"
									Background="{Binding Background}"
									BorderBrush="#59000000"
									BorderThickness="1"
									/>
								<Path
									Margin="3 1 0 0"
									VerticalAlignment="Center"
									Data="M 0,0 L 3,3 L 6,0 Z"
									Fill="{Binding Foreground}"
									/>
							</StackPanel>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--
				The ships of a card, scrolled when there are more than the card shows; an empty card asks for ships (the
				hint lets the drop through to the list).
			-->
			<Style x:Key="ShipList" TargetType="ItemsControl">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="MinHeight" Value="40" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ItemsControl">
							<Grid Background="{TemplateBinding Background}">
								<ScrollViewer
									Focusable="False"
									HorizontalScrollBarVisibility="Disabled"
									VerticalScrollBarVisibility="Auto"
									>
									<ItemsPresenter Margin="6 2 8 4" />
								</ScrollViewer>
								<Grid
									x:Name="Hint"
									Margin="6 4"
									VerticalAlignment="Top"
									IsHitTestVisible="False"
									Visibility="Collapsed"
									>
									<Rectangle
										Stroke="{DynamicResource Kcv.Separator}"
										StrokeDashArray="3 2"
										StrokeThickness="1"
										/>
									<TextBlock
										Margin="2 8"
										HorizontalAlignment="Center"
										FontSize="11"
										Foreground="{DynamicResource Kcv.FaintForeground}"
										Text="{x:Static fork:ForkStrings.KcvLockDropHint}"
										TextAlignment="Center"
										TextWrapping="Wrap"
										/>
								</Grid>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="HasItems" Value="False">
									<Setter TargetName="Hint" Property="Visibility" Value="Visible" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--
				A phase. The right click menu is the viewer's (딱지 할당 ▸ the locks not on the phase yet, each with its
				colour; 단계 제거; 완료), as are the chips' and the ships' 「제거」.
			-->
			<DataTemplate x:Key="Phase" DataType="{x:Type eventLock:EventPhaseViewModel}">
				<Border
					x:Name="Card"
					Width="132"
					Margin="0 0 6 0"
					Background="{DynamicResource Kcv.StatusBackground}"
					BorderBrush="{DynamicResource Kcv.HeaderBackground}"
					BorderThickness="1"
					>
					<Border.Resources>
						<eventLock:EventPhaseBindingProxy x:Key="PhaseProxy" DataContext="{Binding}" />
					</Border.Resources>
					<Border.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{Binding EventLockPlanner.AssignLock}" ItemsSource="{Binding RemainingGroups}">
								<MenuItem.ItemContainerStyle>
									<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
										<Setter Property="Header" Value="{Binding Name}" />
										<Setter Property="Icon" Value="{Binding}" />
										<Setter Property="Command" Value="{Binding DataContext.AddLockToPhaseCommand, Source={StaticResource PhaseProxy}}" />
										<Setter Property="CommandParameter" Value="{Binding}" />
										<Style.Resources>
											<!--  the icon: a dot in the lock's colour (the menu scales its icon to the box, so the dot sits in one)  -->
											<DataTemplate DataType="{x:Type eventLock:LockGroupViewModel}">
												<Grid Width="16" Height="16">
													<Rectangle
														Width="9"
														Height="9"
														Fill="{Binding Background}"
														/>
												</Grid>
											</DataTemplate>
										</Style.Resources>
									</Style>
								</MenuItem.ItemContainerStyle>
							</MenuItem>
							<MenuItem
								Command="{Binding DataContext.DeletePhaseCommand, Source={StaticResource Proxy}}"
								CommandParameter="{Binding}"
								Header="{Binding EventLockPlanner.RemovePhase}"
								/>
							<Separator />
							<MenuItem
								Header="{Binding EventLockPlanner.IsFinished}"
								IsCheckable="True"
								IsChecked="{Binding IsFinished}"
								/>
						</ContextMenu>
					</Border.ContextMenu>

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<!--  the ships of all the cards start at the same height, as in the viewer's window  -->
							<RowDefinition Height="Auto" SharedSizeGroup="PhaseLocks" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  the name (edited in place), 「완료」 and the ship count  -->
						<Grid Grid.Row="0" Margin="4 3 6 1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								MinWidth="30"
								MaxWidth="76"
								FontSize="13"
								Style="{StaticResource NameBox}"
								Text="{Binding Name}"
								/>
							<TextBlock
								x:Name="Done"
								Grid.Column="1"
								Margin="4 0 0 0"
								VerticalAlignment="Center"
								FontSize="10"
								Foreground="{DynamicResource Kcv.SuccessText}"
								Text="{x:Static fork:ForkStrings.KcvLockFinished}"
								Visibility="Collapsed"
								/>
							<TextBlock
								Grid.Column="3"
								VerticalAlignment="Center"
								FontSize="11"
								Foreground="{DynamicResource Kcv.InactiveForeground}"
								Text="{Binding Ships.Count, StringFormat={x:Static fork:ForkStrings.KcvLockShipCount}}"
								/>
						</Grid>

						<ItemsControl
							Grid.Row="1"
							Margin="6 0 6 3"
							ItemsSource="{Binding PhaseLockGroups}"
							>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type eventLock:LockGroupViewModel}">
									<Border
										MaxWidth="118"
										Margin="0 0 3 3"
										Padding="5 0"
										Background="{Binding Background}"
										CornerRadius="2"
										>
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem
													Command="{Binding DataContext.RemoveLockFromPhaseCommand, Source={StaticResource PhaseProxy}}"
													CommandParameter="{Binding}"
													Header="{Binding DataContext.EventLockPlanner.Remove, Source={StaticResource PhaseProxy}}"
													/>
											</ContextMenu>
										</Border.ContextMenu>
										<TextBlock
											FontSize="11"
											Foreground="{Binding Foreground}"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis"
											/>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Border
							Grid.Row="2"
							BorderBrush="{DynamicResource Kcv.HeaderBackground}"
							BorderThickness="0 1 0 0"
							>
							<ItemsControl
								dd:DragDrop.DropHandler="{Binding}"
								dd:DragDrop.IsDragSource="True"
								dd:DragDrop.IsDropTarget="True"
								dd:DragDrop.UseDefaultDragAdorner="True"
								ItemsSource="{Binding Ships}"
								Style="{StaticResource ShipList}"
								>
								<ItemsControl.ItemTemplate>
									<!--  a ship: its lock in the game (「[2] 」), name and level; red when the phase does not take its lock  -->
									<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
										<DockPanel x:Name="Line" Background="Transparent">
											<DockPanel.ContextMenu>
												<ContextMenu>
													<MenuItem
														Command="{Binding DataContext.RemoveShipLockCommand, Source={StaticResource PhaseProxy}}"
														CommandParameter="{Binding}"
														Header="{Binding DataContext.EventLockPlanner.Remove, Source={StaticResource PhaseProxy}}"
														/>
												</ContextMenu>
											</DockPanel.ContextMenu>
											<TextBlock
												VerticalAlignment="Center"
												DockPanel.Dock="Left"
												FontSize="11"
												Foreground="{DynamicResource Kcv.InactiveForeground}"
												Text="{Binding ActualLock, Converter={StaticResource LockPrefix}}"
												/>
											<TextBlock
												Margin="0 1"
												FontSize="12"
												TextTrimming="CharacterEllipsis"
												>
												<Run Text="{Binding Ship.Name, Mode=OneWay}" /><Run
													FontSize="11"
													Foreground="{DynamicResource Kcv.InactiveForeground}"
													Text="{Binding Ship.Level, Mode=OneWay, StringFormat=' Lv.{0}'}"
													/>
											</TextBlock>
										</DockPanel>
										<DataTemplate.Triggers>
											<DataTrigger Binding="{Binding MatchesPhaseLock}" Value="False">
												<Setter TargetName="Line" Property="TextElement.Foreground" Value="{DynamicResource Kcv.FailureText}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding DataContext.DisplayToolTips, Source={StaticResource Proxy}}" Value="True">
												<Setter TargetName="Line" Property="ToolTip" Value="{Binding TooltipDisplay}" />
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<!--  finished: the quests' green and 「완료」; hidden when 완료한 단계 표시 is off  -->
					<DataTrigger Binding="{Binding IsFinished}" Value="True">
						<Setter TargetName="Card" Property="Background" Value="{DynamicResource Kcv.FinishedRow}" />
						<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Kcv.FinishedRowHover}" />
						<Setter TargetName="Done" Property="Visibility" Value="Visible" />
					</DataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding IsFinished}" Value="True" />
							<Condition Binding="{Binding DataContext.ShowFinishedPhases, Source={StaticResource Proxy}}" Value="False" />
						</MultiDataTrigger.Conditions>
						<Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
					</MultiDataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>

			<!--  A lock: the header in its colour (the colour square, the name to edit, the count), then its ships  -->
			<DataTemplate x:Key="Lock" DataType="{x:Type eventLock:LockGroupViewModel}">
				<Border
					Width="150"
					Margin="0 0 6 0"
					Background="{DynamicResource Kcv.StatusBackground}"
					BorderBrush="{Binding Background}"
					BorderThickness="1"
					>
					<DockPanel>
						<Border
							Height="24"
							Padding="5 0"
							Background="{Binding Background}"
							DockPanel.Dock="Top"
							TextElement.Foreground="{Binding Foreground}"
							>
							<DockPanel>
								<colorPicker:ColorPicker
									VerticalAlignment="Center"
									ButtonStyle="{StaticResource Swatch}"
									ColorMode="ColorCanvas"
									DisplayColorAndName="False"
									DockPanel.Dock="Left"
									SelectedColor="{Binding Color}"
									>
									<colorPicker:ColorPicker.Resources>
										<SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource SystemAltHighColor}" />
									</colorPicker:ColorPicker.Resources>
								</colorPicker:ColorPicker>
								<TextBlock
									Margin="6 0 0 0"
									VerticalAlignment="Center"
									DockPanel.Dock="Right"
									FontSize="11"
									Opacity="0.8"
									Text="{Binding Ships.Count}"
									/>
								<TextBox
									Margin="4 0 0 0"
									FontSize="12"
									Foreground="{Binding Foreground}"
									Style="{StaticResource NameBox}"
									Text="{Binding Name}"
									/>
							</DockPanel>
						</Border>

						<ItemsControl
							dd:DragDrop.DropHandler="{Binding}"
							dd:DragDrop.IsDragSource="True"
							dd:DragDrop.IsDropTarget="True"
							dd:DragDrop.UseDefaultDragAdorner="True"
							ItemsSource="{Binding Ships}"
							Style="{StaticResource ShipList}"
							>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
									<DockPanel x:Name="Line" Background="Transparent">
										<TextBlock
											VerticalAlignment="Center"
											DockPanel.Dock="Left"
											FontSize="11"
											Foreground="{DynamicResource Kcv.InactiveForeground}"
											Text="{Binding ActualLock, Converter={StaticResource LockPrefix}}"
											/>
										<TextBlock
											Margin="0 1"
											FontSize="12"
											TextTrimming="CharacterEllipsis"
											>
											<Run Text="{Binding Ship.Name, Mode=OneWay}" /><Run
												FontSize="11"
												Foreground="{DynamicResource Kcv.InactiveForeground}"
												Text="{Binding Ship.Level, Mode=OneWay, StringFormat=' Lv.{0}'}"
												/>
										</TextBlock>
									</DockPanel>
									<DataTemplate.Triggers>
										<DataTrigger Binding="{Binding DataContext.DisplayToolTips, Source={StaticResource Proxy}}" Value="True">
											<Setter TargetName="Line" Property="ToolTip" Value="{Binding TooltipDisplay}" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DockPanel>
				</Border>
			</DataTemplate>

			<!--  the filter's labels and box, as the ship list's  -->
			<Style
				x:Key="FilterLabel"
				BasedOn="{StaticResource Kcv.SubText}"
				TargetType="TextBlock"
				>
				<Setter Property="FontSize" Value="13" />
				<Setter Property="Margin" Value="0 0 10 0" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style x:Key="FilterBox" TargetType="Border">
				<Setter Property="BorderBrush" Value="{DynamicResource Kcv.HeaderBackground}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="10 4" />
				<Setter Property="Margin" Value="0 0 0 6" />
			</Style>

			<!--  the table's numbers on the right, its yes / no columns a centred ✓  -->
			<Style
				x:Key="Number"
				BasedOn="{StaticResource KcvRec.Text}"
				TargetType="TextBlock"
				>
				<Setter Property="TextAlignment" Value="Right" />
			</Style>
			<Style
				x:Key="Mark"
				BasedOn="{StaticResource KcvRec.Text}"
				TargetType="TextBlock"
				>
				<Setter Property="TextAlignment" Value="Center" />
				<Setter Property="Foreground" Value="{DynamicResource Kcv.AccentHighlight}" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="{Binding EventLockPlanner.File}">
				<MenuItem Command="{Binding CopyLocksToClipboardCommand}" Header="{Binding EventLockPlanner.CopyToClipboard}" />
				<MenuItem Command="{Binding LoadLocksFromClipboardCommand}" Header="{Binding EventLockPlanner.LoadFromClipboard}" />
				<Separator />
				<MenuItem Command="{Binding LoadEventLocksCommand}" Header="{Binding EventLockPlanner.LoadEventLocks}" />
			</MenuItem>
			<MenuItem Header="{Binding EventLockPlanner.View}">
				<MenuItem
					Header="{Binding EventLockPlanner.ShowFinishedPhases}"
					IsCheckable="True"
					IsChecked="{Binding ShowFinishedPhases}"
					/>
				<MenuItem
					Header="{Binding EventLockPlanner.DisplayToolTips}"
					IsCheckable="True"
					IsChecked="{Binding DisplayToolTips}"
					/>
			</MenuItem>
		</Menu>

		<!--
			The body is as high as the window, but not lower than the boxes' least heights (단계 150, 딱지 140, 딱지 없는
			함선 230 and the open filter, the handles and the margins); below that it scrolls. The wheel goes on to the
			body when the list under the mouse cannot move (PassWheel).
		-->
		<ScrollViewer
			x:Name="Body"
			Focusable="False"
			HorizontalScrollBarVisibility="Disabled"
			PreviewMouseWheel="PassWheel"
			VerticalScrollBarVisibility="Auto"
			>
			<Grid
				x:Name="BodyContent"
				Height="{Binding ActualHeight, ElementName=Body}"
				MinHeight="546"
				>
				<Grid>
					<Grid.Style>
						<!--  room on the right for the body's scroll bar, which is drawn over the content  -->
						<Style TargetType="Grid">
							<Setter Property="Margin" Value="8 2 8 8" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=Body}" Value="Visible">
									<Setter Property="Margin" Value="8 2 20 8" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Grid.RowDefinitions>
						<RowDefinition Height="196*" MinHeight="150" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="178*" MinHeight="140" />
						<RowDefinition Height="Auto" />
						<RowDefinition
							x:Name="ShipsRow"
							Height="346*"
							MinHeight="230"
							/>
					</Grid.RowDefinitions>

					<!--  단계  -->
					<Border Grid.Row="0" Style="{StaticResource Section}">
						<DockPanel>
							<DockPanel Height="24" DockPanel.Dock="Top">
								<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
									<Button
										Command="{Binding AddPhaseCommand}"
										Content="{Binding EventLockPlanner.AddPhase}"
										Style="{StaticResource SectionButton}"
										/>
									<Button
										Command="{Binding RemovePhaseCommand}"
										Content="{Binding EventLockPlanner.RemovePhase}"
										Style="{StaticResource SectionButton}"
										/>
								</StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static fork:ForkStrings.KcvLockPhases}" />
								<TextBlock Style="{StaticResource SectionCount}" Text="{Binding EventPhases.Count}" />
							</DockPanel>
							<!--  the bottom margin keeps the cards clear of the scroll bar, which is drawn over them  -->
							<ScrollViewer
								Focusable="False"
								HorizontalScrollBarVisibility="Auto"
								VerticalScrollBarVisibility="Disabled"
								>
								<ItemsControl
									Margin="0 4 0 14"
									Grid.IsSharedSizeScope="True"
									ItemTemplate="{StaticResource Phase}"
									ItemsPanel="{StaticResource KcvRec.Horizontal}"
									ItemsSource="{Binding EventPhases}"
									/>
							</ScrollViewer>
						</DockPanel>
					</Border>

					<GridSplitter Grid.Row="1" Style="{StaticResource Splitter}" />

					<!--  딱지  -->
					<Border Grid.Row="2" Style="{StaticResource Section}">
						<DockPanel>
							<DockPanel Height="24" DockPanel.Dock="Top">
								<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
									<Button
										Command="{Binding AddLockCommand}"
										Content="{Binding EventLockPlanner.AddLock}"
										Style="{StaticResource SectionButton}"
										/>
									<Button
										Command="{Binding RemoveLockCommand}"
										Content="{Binding EventLockPlanner.RemoveLock}"
										Style="{StaticResource SectionButton}"
										/>
								</StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static fork:ForkStrings.KcvLockLocks}" />
								<TextBlock Style="{StaticResource SectionCount}" Text="{Binding LockGroups.Count}" />
							</DockPanel>
							<ScrollViewer
								Focusable="False"
								HorizontalScrollBarVisibility="Auto"
								VerticalScrollBarVisibility="Disabled"
								>
								<ItemsControl
									Margin="0 4 0 14"
									ItemTemplate="{StaticResource Lock}"
									ItemsPanel="{StaticResource KcvRec.Horizontal}"
									ItemsSource="{Binding LockGroups}"
									/>
							</ScrollViewer>
						</DockPanel>
					</Border>

					<GridSplitter Grid.Row="3" Style="{StaticResource Splitter}" />

					<!--  딱지 없는 함선  -->
					<Border Grid.Row="4" Style="{StaticResource Section}">
						<DockPanel>
							<StackPanel
								Height="24"
								DockPanel.Dock="Top"
								Orientation="Horizontal"
								>
								<TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static fork:ForkStrings.KcvLockFreeShips}" />
								<TextBlock Style="{StaticResource SectionCount}" Text="{Binding NoLockGroup.Ships.Count}" />
							</StackPanel>

							<!--  필터 설정 (folded at first) and the name box, shown folded too, as in the ship list  -->
							<StackPanel
								Margin="0 0 0 6"
								DockPanel.Dock="Top"
								Orientation="Horizontal"
								>
								<ToggleButton x:Name="FilterFold" Style="{StaticResource Kcv.FilterFold}" />
								<TextBlock
									Margin="20 0 6 0"
									Style="{StaticResource KcvRec.FirstLabel}"
									Text="{x:Static fork:ForkStrings.KcvColumnName}"
									/>
								<TextBox
									Width="180"
									Style="{StaticResource KcvRec.TextBox}"
									Tag="{x:Static fork:ForkStrings.KcvPickerNameHint}"
									Text="{Binding NoLockGroup.Filter.NameFilter, UpdateSourceTrigger=PropertyChanged}"
									/>
							</StackPanel>

							<!--
								함종 (「전체 선택」 for the viewer's 함 종류 토글: it turns all on, or all off when all are on),
								대잠 and 운 ranges, the equipment the ship can take
							-->
							<Border
								x:Name="Filter"
								DataContext="{Binding NoLockGroup.Filter}"
								DockPanel.Dock="Top"
								Style="{StaticResource FilterBox}"
								Visibility="{Binding IsChecked, ElementName=FilterFold, Converter={StaticResource KcvRec.Visible}}"
								>
								<Border.Resources>
									<Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
										<Setter Property="Margin" Value="0 0 14 0" />
									</Style>
								</Border.Resources>
								<StackPanel>
									<DockPanel>
										<!--  at the first row when the types wrap  -->
										<TextBlock
											Margin="0 3 10 0"
											VerticalAlignment="Top"
											Style="{StaticResource FilterLabel}"
											Text="{x:Static fork:ForkStrings.KcvPickerShipType}"
											/>
										<CheckBox
											VerticalAlignment="Top"
											Command="{Binding ToggleShipTypesCommand}"
											Content="{x:Static fork:ForkStrings.KcvSelectAll}"
											IsChecked="{Binding TypeFilters, Mode=OneWay, Converter={StaticResource AllTypesChecked}}"
											/>
										<ItemsControl ItemsSource="{Binding TypeFilters}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</DockPanel>
									<WrapPanel Margin="0 2 0 0">
										<StackPanel Style="{StaticResource KcvRec.Pair}">
											<TextBlock Style="{StaticResource FilterLabel}" Text="{x:Static translations:GeneralRes.ASW}" />
											<kcv:KcvNumberBox
												Width="56"
												Minimum="0"
												Value="{Binding AswMin}"
												/>
											<TextBlock
												Margin="6 0"
												Style="{StaticResource FilterLabel}"
												Text="~"
												/>
											<kcv:KcvNumberBox
												Width="56"
												Minimum="0"
												Value="{Binding AswMax}"
												/>
										</StackPanel>
										<StackPanel Style="{StaticResource KcvRec.Pair}">
											<TextBlock Style="{StaticResource FilterLabel}" Text="{x:Static translations:GeneralRes.Luck}" />
											<kcv:KcvNumberBox
												Width="56"
												Minimum="0"
												Value="{Binding LuckMin}"
												/>
											<TextBlock
												Margin="6 0"
												Style="{StaticResource FilterLabel}"
												Text="~"
												/>
											<kcv:KcvNumberBox
												Width="56"
												Minimum="0"
												Value="{Binding LuckMax}"
												/>
										</StackPanel>
										<StackPanel Style="{StaticResource KcvRec.Pair}">
											<TextBlock Style="{StaticResource FilterLabel}" Text="{x:Static fork:ForkStrings.KcvLockEquipment}" />
											<CheckBox Content="{x:Static translations:ShipFilterResources.Daihatsu}" IsChecked="{Binding CanEquipDaihatsu}" />
											<CheckBox Content="{x:Static translations:ShipFilterResources.Tank}" IsChecked="{Binding CanEquipTank}" />
											<CheckBox Content="{x:Static translations:ShipFilterResources.Fcf}" IsChecked="{Binding CanEquipFcf}" />
											<CheckBox Content="{x:Static translations:ShipFilterResources.Bulge}" IsChecked="{Binding CanEquipBulge}" />
											<CheckBox Content="{x:Static translations:ShipFilterResources.SeaplaneFighter}" IsChecked="{Binding CanEquipSeaplaneFighter}" />
											<CheckBox Content="{x:Static translations:GeneralRes.Expansion}" IsChecked="{Binding HasExpansionSlot}" />
										</StackPanel>
									</WrapPanel>
								</StackPanel>
							</Border>

							<!--
								The ships without a lock, dragged to the cards (and back); one row at a time, as the viewer's
								table. Its data context is the lock group 「없음」, which the drop handlers look for.
							-->
							<DataGrid
								dd:DragDrop.DropHandler="{Binding}"
								dd:DragDrop.IsDragSource="True"
								dd:DragDrop.IsDropTarget="True"
								dd:DragDrop.UseDefaultDragAdorner="True"
								BorderBrush="{DynamicResource Kcv.HeaderBackground}"
								BorderThickness="1"
								DataContext="{Binding NoLockGroup}"
								ItemsSource="{Binding DataContext.DataGridViewModel.Items, Source={StaticResource Proxy}}"
								SelectionMode="Single"
								Style="{StaticResource KcvRec.Grid}"
								Tag="{Binding DataContext.DataGridViewModel, Source={StaticResource Proxy}}"
								>
								<b:Interaction.Behaviors>
									<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataContext.DataGridViewModel.ColumnProperties, Source={StaticResource Proxy}}" SortDescriptions="{Binding DataContext.DataGridViewModel.SortDescriptions, Source={StaticResource Proxy}}" />
								</b:Interaction.Behaviors>

								<DataGrid.ContextMenu>
									<ContextMenu>
										<MenuItem Command="{Binding DataContext.DataGridViewModel.OpenColumnSelectorCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.DataGridViewModel.DataGrid.OpenColumnSelector, Source={StaticResource Proxy}}" />
										<MenuItem Command="{Binding DataContext.DataGridViewModel.ClearSortingCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.DataGridViewModel.DataGrid.ClearSorting, Source={StaticResource Proxy}}" />
									</ContextMenu>
								</DataGrid.ContextMenu>

								<DataGrid.Columns>
									<DataGridTemplateColumn
										Width="54"
										MinWidth="54"
										Header="ID"
										SortMemberPath="Ship.ID"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Number}" Text="{Binding Ship.ID}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="110"
										MinWidth="110"
										Header="{x:Static fork:ForkStrings.KcvColumnType}"
										SortMemberPath="Ship.MasterShip.ShipType"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding Ship.MasterShip.ShipTypeName}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="*"
										MinWidth="140"
										Header="{x:Static fork:ForkStrings.KcvColumnName}"
										SortMemberPath="Ship.MasterShip.SortID"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding Ship.Name}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="48"
										MinWidth="48"
										Header="Lv"
										SortMemberPath="Ship.Level"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Number}" Text="{Binding Ship.Level}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="56"
										MinWidth="56"
										Header="{x:Static translations:GeneralRes.Firepower}"
										SortMemberPath="Ship.FirepowerBase"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Number}" Text="{Binding Ship.FirepowerBase}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="76"
										MinWidth="76"
										Header="{x:Static translations:ShipGroupResources.ShipView_NightBattlePower}"
										SortMemberPath="NightPowerBase"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Number}" Text="{Binding NightPowerBase, Mode=OneWay}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="56"
										MinWidth="56"
										Header="{x:Static translations:GeneralRes.ASW}"
										SortMemberPath="Ship.ASWBase"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Number}" Text="{Binding Ship.ASWBase}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="48"
										MinWidth="48"
										Header="{x:Static translations:GeneralRes.Luck}"
										SortMemberPath="Ship.LuckBase"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Number}" Text="{Binding Ship.LuckBase}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="64"
										MinWidth="64"
										Header="{x:Static translations:EventLockPlannerResources.Daihatsu}"
										SortMemberPath="CanUseDaihatsu"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Mark}" Text="{Binding CanUseDaihatsu, Mode=OneWay, Converter={StaticResource CheckMark}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="64"
										MinWidth="64"
										Header="{x:Static translations:EventLockPlannerResources.Tank}"
										SortMemberPath="CanUseTank"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Mark}" Text="{Binding CanUseTank, Mode=OneWay, Converter={StaticResource CheckMark}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="90"
										MinWidth="90"
										Header="{x:Static translations:EventLockPlannerResources.Fcf}"
										SortMemberPath="CanUseFcf"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Mark}" Text="{Binding CanUseFcf, Mode=OneWay, Converter={StaticResource CheckMark}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn
										Width="56"
										MinWidth="56"
										Header="{x:Static translations:GeneralRes.Expansion}"
										SortMemberPath="IsExpansionSlotAvailable"
										>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="{x:Type eventLock:ShipLockViewModel}">
												<TextBlock Style="{StaticResource Mark}" Text="{Binding IsExpansionSlotAvailable, Mode=OneWay, Converter={StaticResource CheckMark}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</DockPanel>
					</Border>
				</Grid>
			</Grid>
		</ScrollViewer>
	</DockPanel>
</common:WindowBase>

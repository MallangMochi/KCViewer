<UserControl
	x:Class="KCViewer.Fork.KcvViews.KcvShipTrainingView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:persistentColumns="clr-namespace:KCViewer.Behaviors.PersistentColumns"
	xmlns:sys="clr-namespace:System;assembly=System.Runtime"
	xmlns:training="clr-namespace:KCViewer.Window.Wpf.ShipTrainingPlanner"
	d:DataContext="{d:DesignInstance Type=training:ShipTrainingPlanViewerViewModel}"
	d:DesignHeight="300"
	d:DesignWidth="800"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the ship training panel in KanColleViewer's style (remaining panels mockup 1, user's approval
		2026-10-02). The viewer's buttons, filter, columns, sorting and context menus stay; the columns are the viewer's
		in the same order with the same sort paths, so the saved column settings (PersistentColumnsBehavior) are shared
		with its view. Changed: the table looks like the planned upgrades panel; a value that has reached its target is
		green; the level has a gauge of the experience towards the target level; a finished plan (shown while 표시 완료
		is on) gets the planned upgrades panel's green row. The plan editor and the ship picker stay the viewer's.
	-->
	<UserControl.Resources>
		<training:ShipTrainingPlanViewerViewBindingProxy x:Key="Proxy" DataContext="{Binding}" />
		<kcv:KcvAtLeastConverter x:Key="AtLeast" />
		<kcv:KcvExpProgressConverter x:Key="ExpProgress" />
		<sys:Boolean x:Key="True">True</sys:Boolean>

		<Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
			<Setter Property="Margin" Value="6 0 0 0" />
			<Setter Property="MinWidth" Value="0" />
		</Style>

		<Style x:Key="Text" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="6 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  A plan value and its smaller second line; green when the cell's Tag says the target is reached  -->
		<Style x:Key="Goal" BasedOn="{StaticResource Kcv.Text}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="{StaticResource True}">
					<Setter Property="Foreground" Value="{DynamicResource Kcv.FinishedBar}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="GoalSub" BasedOn="{StaticResource Kcv.SubText}" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="{StaticResource True}">
					<Setter Property="Foreground" Value="{DynamicResource Kcv.FinishedBar}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="GoalCell" TargetType="StackPanel">
			<Setter Property="Margin" Value="6 3 10 3" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  Grips to resize a column, as the viewer's header has them  -->
		<Style x:Key="Grip" TargetType="Thumb">
			<Setter Property="Width" Value="6" />
			<Setter Property="Cursor" Value="SizeWE" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Border Background="Transparent" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  The ship list's header, with the viewer's header menu  -->
		<Style x:Key="Header" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="{DynamicResource Kcv.TableHeaderBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource Kcv.SubForeground}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="6 7" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="ContextMenu">
				<Setter.Value>
					<ContextMenu>
						<MenuItem
							Command="{Binding DataContext.DataGridViewModel.HideColumnCommand, Source={StaticResource Proxy}}"
							CommandParameter="{Binding}"
							Header="{Binding DataContext.DataGridViewModel.DataGrid.HideColumn, Source={StaticResource Proxy}}"
							/>
						<Separator />
						<MenuItem Command="{Binding DataContext.DataGridViewModel.OpenColumnSelectorCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.DataGridViewModel.DataGrid.OpenColumnSelector, Source={StaticResource Proxy}}" />
						<MenuItem Command="{Binding DataContext.DataGridViewModel.ClearSortingCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.DataGridViewModel.DataGrid.ClearSorting, Source={StaticResource Proxy}}" />
					</ContextMenu>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridColumnHeader">
						<Grid>
							<Border
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="{DynamicResource Kcv.HeaderBackground}"
								BorderThickness="0 0 1 0"
								>
								<DockPanel>
									<Path
										x:Name="Arrow"
										Width="8"
										Height="5"
										Margin="4 0 0 0"
										VerticalAlignment="Center"
										Data="M 0,0 L 4,5 L 8,0 Z"
										DockPanel.Dock="Right"
										Fill="{DynamicResource Kcv.SubForeground}"
										Visibility="Collapsed"
										/>
									<ContentPresenter VerticalAlignment="Center" />
								</DockPanel>
							</Border>
							<Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Grip}" />
							<Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Grip}" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="SortDirection" Value="Descending">
								<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="SortDirection" Value="Ascending">
								<Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
								<Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 4,0 L 8,5 Z" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Cell" TargetType="DataGridCell">
			<Setter Property="Foreground" Value="{DynamicResource Kcv.Foreground}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridCell">
						<ContentPresenter VerticalAlignment="Stretch" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--
			Rows as in the planned upgrades panel: the colours are on the row template's border (DataGridRow coerces its
			own Background). Selected as in the ship list; a finished plan green.
		-->
		<Style x:Key="Row" TargetType="DataGridRow">
			<Style.Resources>
				<!--  the viewer's row menu  -->
				<ContextMenu x:Key="RowMenu">
					<MenuItem Command="{Binding DataContext.OpenShipPickerToAddNewPlanCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.ShipTrainingPlanner.AddShip, Source={StaticResource Proxy}, Mode=OneWay}" />
					<MenuItem
						Command="{Binding DataContext.OpenEditPopupCommand, Source={StaticResource Proxy}}"
						CommandParameter="{Binding}"
						Header="{Binding DataContext.ShipTrainingPlanner.EditPlan, Source={StaticResource Proxy}, Mode=OneWay}"
						/>
					<MenuItem
						Command="{Binding DataContext.RemovePlanCommand, Source={StaticResource Proxy}}"
						CommandParameter="{Binding}"
						Header="{Binding DataContext.ShipTrainingPlanner.RemovePlan, Source={StaticResource Proxy}, Mode=OneWay}"
						/>
					<Separator />
					<MenuItem Command="{Binding DataContext.RemoveAllFinishedPlansCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.ShipTrainingPlanner.RemoveFinishedPlans, Source={StaticResource Proxy}, Mode=OneWay}" />
					<Separator />
					<MenuItem Command="{Binding DataContext.DataGridViewModel.OpenColumnSelectorCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.DataGridViewModel.DataGrid.OpenColumnSelector, Source={StaticResource Proxy}}" />
					<MenuItem Command="{Binding DataContext.DataGridViewModel.ClearSortingCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.DataGridViewModel.DataGrid.ClearSorting, Source={StaticResource Proxy}}" />
				</ContextMenu>
			</Style.Resources>
			<Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
			<Setter Property="MinHeight" Value="27" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridRow">
						<!--  every row keeps the bar's width, so the columns line up  -->
						<Border
							x:Name="Back"
							Background="Transparent"
							BorderBrush="Transparent"
							BorderThickness="3 0 0 0"
							SnapsToDevicePixels="True"
							>
							<DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.AlternateRow}" />
							</Trigger>
							<DataTrigger Binding="{Binding PlanFinished}" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.FinishedRow}" />
								<Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Kcv.FinishedBar}" />
							</DataTrigger>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<!--  Self in a template's triggers is the row itself  -->
									<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
									<Condition Binding="{Binding PlanFinished}" Value="True" />
								</MultiDataTrigger.Conditions>
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.FinishedRowHover}" />
							</MultiDataTrigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Back" Property="Background" Value="{DynamicResource Kcv.HeaderBackground}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Margin="8 6 8 8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  The viewer's buttons and filter  -->
		<StackPanel Grid.Row="0" Margin="0 0 0 6" Orientation="Horizontal">
			<Button
				Margin="0 0 6 0"
				Padding="10 2"
				Command="{Binding OpenShipPickerToAddNewPlanCommand}"
				Content="{Binding ShipTrainingPlanner.AddShip}"
				/>
			<Button
				Margin="0 0 6 0"
				Padding="10 2"
				Command="{Binding OpenEditPopupSelectedPlanCommand}"
				Content="{Binding ShipTrainingPlanner.EditPlan}"
				/>
			<Button
				Margin="0 0 6 0"
				Padding="10 2"
				Command="{Binding RemoveSelectedPlanCommand}"
				Content="{Binding ShipTrainingPlanner.RemovePlan}"
				/>
			<CheckBox Content="{Binding ShipTrainingPlanner.DisplayFinished}" IsChecked="{Binding DisplayFinished}" />
		</StackPanel>

		<DataGrid
			Grid.Row="1"
			AutoGenerateColumns="False"
			Background="Transparent"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="1"
			CanUserAddRows="False"
			CanUserDeleteRows="False"
			CellStyle="{StaticResource Cell}"
			ColumnHeaderStyle="{StaticResource Header}"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
			HorizontalGridLinesBrush="{DynamicResource Kcv.Separator}"
			IsReadOnly="True"
			ItemsSource="{Binding DataGridViewModel.Items}"
			RowStyle="{StaticResource Row}"
			SelectedItem="{Binding SelectedPlan}"
			SelectionMode="Single"
			SelectionUnit="FullRow"
			>
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Command="{Binding DataContext.OpenShipPickerToAddNewPlanCommand, Source={StaticResource Proxy}}" Header="{Binding DataContext.ShipTrainingPlanner.AddShip, Source={StaticResource Proxy}, Mode=OneWay}" />
					<Separator />
					<MenuItem Command="{Binding DataGridViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridViewModel.DataGrid.OpenColumnSelector}" />
					<MenuItem Command="{Binding DataGridViewModel.ClearSortingCommand}" Header="{Binding DataGridViewModel.DataGrid.ClearSorting}" />
				</ContextMenu>
			</DataGrid.ContextMenu>

			<b:Interaction.Behaviors>
				<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridViewModel.SortDescriptions}" />
			</b:Interaction.Behaviors>

			<DataGrid.Columns>
				<DataGridTemplateColumn
					Width="Auto"
					Header="{Binding DataContext.ShipTrainingPlanner.ShipName, Source={StaticResource Proxy}}"
					SortMemberPath="Ship.MasterShip.NameEN"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<TextBlock Margin="6 0 10 0" Style="{StaticResource Text}" Text="{Binding Ship.MasterShip.NameEN}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="Auto"
					Header="{Binding DataContext.ShipTrainingPlanner.ShipType, Source={StaticResource Proxy}}"
					SortMemberPath="Ship.MasterShip.ShipTypeName"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<TextBlock
								Margin="6 0 10 0"
								Foreground="{DynamicResource Kcv.SubForeground}"
								Style="{StaticResource Text}"
								Text="{Binding Ship.MasterShip.ShipTypeName}"
								/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  Level: current / target, a gauge of the experience towards the target, the experience left  -->
				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.Level, Source={StaticResource Proxy}}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<StackPanel MinWidth="96" Style="{StaticResource GoalCell}">
								<StackPanel.Tag>
									<MultiBinding Converter="{StaticResource AtLeast}">
										<Binding Path="Ship.Level" />
										<Binding Path="TargetLevel" />
									</MultiBinding>
								</StackPanel.Tag>
								<TextBlock Style="{StaticResource Goal}">
									<Run Text="{Binding Ship.Level, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TargetLevel, Mode=OneWay}" />
								</TextBlock>
								<ProgressBar
									Height="3"
									Margin="0 2"
									Foreground="{DynamicResource Kcv.FinishedBar}"
									Maximum="1"
									Style="{StaticResource Kcv.Gauge}"
									>
									<ProgressBar.Value>
										<!--  OneWay: a progress bar's value binds both ways by default, and these are read only  -->
										<MultiBinding Converter="{StaticResource ExpProgress}" Mode="OneWay">
											<Binding Path="Ship.ExpTotal" />
											<Binding Path="RemainingExpToTarget" />
										</MultiBinding>
									</ProgressBar.Value>
								</ProgressBar>
								<TextBlock Style="{StaticResource GoalSub}">
									<Run Text="{Binding RemainingExpToTarget, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" " /><Run Text="{Binding DataContext.ShipTrainingPlanner.Exp, Source={StaticResource Proxy}, Mode=OneWay}" />
								</TextBlock>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  HP: modernization +current / +target, then max HP / target HP  -->
				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.HPBonus, Source={StaticResource Proxy}}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<StackPanel Style="{StaticResource GoalCell}">
								<StackPanel.Tag>
									<MultiBinding Converter="{StaticResource AtLeast}">
										<Binding Path="Ship.HPMaxModernized" />
										<Binding Path="TargetHPBonus" />
									</MultiBinding>
								</StackPanel.Tag>
								<TextBlock Style="{StaticResource Goal}">
									<Run Text="+" /><Run Text="{Binding Ship.HPMaxModernized, Mode=OneWay}" /><Run Text=" / +" /><Run Text="{Binding TargetHPBonus, Mode=OneWay}" />
								</TextBlock>
								<TextBlock Style="{StaticResource GoalSub}">
									<Run Text="{Binding Ship.HPMax, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TargetHP, Mode=OneWay}" />
								</TextBlock>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  ASW: modernization +current / +target, then ASW / target ASW  -->
				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.ASWBonus, Source={StaticResource Proxy}}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<StackPanel Style="{StaticResource GoalCell}">
								<StackPanel.Tag>
									<MultiBinding Converter="{StaticResource AtLeast}">
										<Binding Path="Ship.ASWModernized" />
										<Binding Path="TargetASWBonus" />
									</MultiBinding>
								</StackPanel.Tag>
								<TextBlock Style="{StaticResource Goal}">
									<Run Text="+" /><Run Text="{Binding Ship.ASWModernized, Mode=OneWay}" /><Run Text=" / +" /><Run Text="{Binding TargetASWBonus, Mode=OneWay}" />
								</TextBlock>
								<TextBlock Style="{StaticResource GoalSub}">
									<Run Text="{Binding Ship.ASWBase, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TargetASW, Mode=OneWay}" />
								</TextBlock>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  Luck: current / target  -->
				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.Luck, Source={StaticResource Proxy}}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<StackPanel Style="{StaticResource GoalCell}">
								<StackPanel.Tag>
									<MultiBinding Converter="{StaticResource AtLeast}">
										<Binding Path="Ship.LuckBase" />
										<Binding Path="TargetLuck" />
									</MultiBinding>
								</StackPanel.Tag>
								<TextBlock Style="{StaticResource Goal}">
									<Run Text="{Binding Ship.LuckBase, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TargetLuck, Mode=OneWay}" />
								</TextBlock>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.RemodelGoal, Source={StaticResource Proxy}}" SortMemberPath="TargetRemodel.NameEN">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<TextBlock Margin="6 0 10 0" Style="{StaticResource Text}" Text="{Binding TargetRemodel.NameEN}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  Finished: the checkbox of the panels' style, read only  -->
				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.Finished, Source={StaticResource Proxy}}" SortMemberPath="PlanFinished">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<Border
								Width="13"
								Height="13"
								Margin="6 0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Background="{DynamicResource Kcv.CheckFill}"
								>
								<TextBlock
									x:Name="Mark"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{DynamicResource Kcv.CheckMark}"
									Text="✓"
									Visibility="Collapsed"
									/>
							</Border>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding PlanFinished}" Value="True">
									<Setter TargetName="Mark" Property="Visibility" Value="Visible" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Header="{Binding DataContext.ShipTrainingPlanner.Priority, Source={StaticResource Proxy}}" SortMemberPath="Priority">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type training:ShipTrainingPlanViewModel}">
							<TextBlock HorizontalAlignment="Center" Style="{StaticResource Text}" Text="{Binding Priority}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!--  Hidden columns (available for sorting), as the viewer's  -->
				<DataGridTextColumn Binding="{Binding Ship.Level, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.LevelCurrent, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding TargetLevel, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.LevelTarget, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding RemainingExpToTarget, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.RemainingExp, Source={StaticResource Proxy}}" Visibility="Collapsed" />

				<DataGridTextColumn Binding="{Binding Ship.HPMaxModernized, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.HPBonusCurrent, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding TargetHPBonus, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.HPBonusTarget, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding Ship.HPMax, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.HPCurrent, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding TargetHP, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.HPTarget, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding RemainingHP, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.HPRemaining, Source={StaticResource Proxy}}" Visibility="Collapsed" />

				<DataGridTextColumn Binding="{Binding Ship.ASWModernized, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.ASWBonusCurrent, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding TargetASWBonus, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.ASWBonusTarget, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding Ship.ASWBase, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.ASWCurrent, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding TargetASW, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.ASWTarget, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding RemainingASW, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.ASWRemaining, Source={StaticResource Proxy}}" Visibility="Collapsed" />

				<DataGridTextColumn Binding="{Binding Ship.LuckBase, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.LuckCurrent, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding TargetLuck, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.LuckTarget, Source={StaticResource Proxy}}" Visibility="Collapsed" />
				<DataGridTextColumn Binding="{Binding RemainingLuck, Mode=OneWay}" ElementStyle="{StaticResource Text}" Header="{Binding DataContext.ShipTrainingPlanner.LuckRemaining, Source={StaticResource Proxy}}" Visibility="Collapsed" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>

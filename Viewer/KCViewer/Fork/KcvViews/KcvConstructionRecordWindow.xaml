<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvConstructionRecordWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:construction="clr-namespace:KCViewer.Window.Tools.ConstructionRecordViewer"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:persistentColumns="clr-namespace:KCViewer.Behaviors.PersistentColumns"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding DialogConstructionRecordViewer.Title}"
	Width="600"
	Height="470"
	d:DataContext="{d:DesignInstance construction:ConstructionRecordViewerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="construction:ConstructionRecordViewerViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the construction record in KanColleViewer's style (mockup v5,
		viewer-design/mockups/20261004-construction-record-v5.html, approved 2026-10-04) with the viewer's view model.
		Conditions in four rows without the viewer's 빈 도크 ("빈 도크 항목은 제거"; the record file keeps it). Columns
		시간·이름·레시피 (coloured, 「대형」 for large construction)·기함. With 합치기 the viewer's two merged tables, by ship
		(함명·횟수) or, with a ship chosen, by recipe; the development material columns in the order ×1 ×20 ×100.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<construction:ConstructionFilterToDisplayConverter x:Key="Filter" />

			<DataTemplate x:Key="FilterItem">
				<TextBlock Text="{Binding Converter={StaticResource Filter}}" />
			</DataTemplate>

			<DataTemplate x:Key="Count" DataType="{x:Type construction:ConstructionRecordRow}">
				<ContentControl
					Content="{Binding CountDisplay}"
					ContentTemplate="{StaticResource KcvRec.Count}"
					Focusable="False"
					/>
			</DataTemplate>
			<DataTemplate x:Key="DevMats1" DataType="{x:Type construction:ConstructionRecordRow}">
				<ContentControl
					Content="{Binding DevMats1CountDisplay}"
					ContentTemplate="{StaticResource KcvRec.Count}"
					Focusable="False"
					/>
			</DataTemplate>
			<DataTemplate x:Key="DevMats20" DataType="{x:Type construction:ConstructionRecordRow}">
				<ContentControl
					Content="{Binding DevMats20CountDisplay}"
					ContentTemplate="{StaticResource KcvRec.Count}"
					Focusable="False"
					/>
			</DataTemplate>
			<DataTemplate x:Key="DevMats100" DataType="{x:Type construction:ConstructionRecordRow}">
				<ContentControl
					Content="{Binding DevMats100CountDisplay}"
					ContentTemplate="{StaticResource KcvRec.Count}"
					Focusable="False"
					/>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  검색 조건: 카테고리·함명·레시피 / 기함 (함종, 함선)·개발 자재 / 기간 / 대형함 건조·합치기  -->
		<ContentControl Grid.Row="0" Style="{StaticResource KcvRec.Conditions}">
			<StackPanel>
				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.FirstLabel}" Text="{Binding Source={x:Static translations:ConstructionRecordViewerResources.Hull}, StringFormat={}{0}:}" />
						<ComboBox
							ItemTemplate="{StaticResource FilterItem}"
							ItemsSource="{Binding Categories}"
							SelectedItem="{Binding SelectedShipType}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding Source={x:Static translations:ConstructionRecordViewerResources.Ship}, StringFormat={}{0}:}" />
						<ComboBox
							ItemTemplate="{StaticResource FilterItem}"
							ItemsSource="{Binding Ships}"
							SelectedItem="{Binding SelectedShip}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding DialogConstructionRecordViewer.Recipe, StringFormat={}{0}:}" />
						<ComboBox
							ItemTemplate="{StaticResource FilterItem}"
							ItemsSource="{Binding Recipes}"
							SelectedItem="{Binding SelectedRecipe}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
				</WrapPanel>

				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.FirstLabel}" Text="{Binding Source={x:Static fork:ForkStrings.KcvRecordFlagship}, StringFormat={}{0}:}" />
						<ComboBox
							ItemTemplate="{StaticResource FilterItem}"
							ItemsSource="{Binding FlagshipTypes}"
							SelectedItem="{Binding SelectedFlagshipType}"
							Style="{StaticResource KcvRec.Combo}"
							/>
						<ComboBox
							Margin="4 1 0 1"
							ItemTemplate="{StaticResource FilterItem}"
							ItemsSource="{Binding Flagships}"
							SelectedItem="{Binding SelectedFlagship}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding DialogConstructionRecordViewer.DevMats, StringFormat={}{0}:}" />
						<ComboBox
							ItemTemplate="{StaticResource FilterItem}"
							ItemsSource="{Binding DevelopmentMaterials}"
							SelectedItem="{Binding SelectedDevelopmentMaterial}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
				</WrapPanel>

				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<kcv:KcvRecordPeriod Margin="0 0 14 0" />
				</WrapPanel>

				<DockPanel Margin="0 2">
					<StackPanel
						VerticalAlignment="Bottom"
						DockPanel.Dock="Right"
						Orientation="Horizontal"
						>
						<Button
							Command="{Binding ForkSearchCommand}"
							Content="{x:Static fork:ForkStrings.KcvRecordSearch}"
							IsEnabled="{Binding ForkCanSearch}"
							Style="{StaticResource KcvRec.PrimaryButton}"
							/>
						<Button
							Command="{Binding ForkCancelSearchCommand}"
							Content="{x:Static fork:ForkStrings.KcvRecordCancel}"
							IsEnabled="{Binding ForkIsSearching}"
							Style="{StaticResource KcvRec.Button}"
							/>
						<Button
							Click="ResetConditions"
							Content="{x:Static fork:ForkStrings.KcvRecordReset}"
							Style="{StaticResource KcvRec.Button}"
							/>
					</StackPanel>
					<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
						<CheckBox
							Margin="0"
							Content="{Binding DialogConstructionRecordViewer.IsLargeConstruction}"
							IsChecked="{Binding IsLargeConstruction}"
							IsThreeState="True"
							Style="{StaticResource KcvRec.Check}"
							/>
						<CheckBox
							Margin="16 0 0 0"
							Content="{Binding DialogConstructionRecordViewer.MergeRows}"
							IsChecked="{Binding MergeRows}"
							Style="{StaticResource KcvRec.Check}"
							/>
					</StackPanel>
				</DockPanel>
			</StackPanel>
		</ContentControl>

		<DataGrid
			Grid.Row="1"
			ItemsSource="{Binding DataGridRawRowsViewModel.Items}"
			SelectionChanged="ShowSelection"
			Style="{StaticResource KcvRec.Grid}"
			Tag="{Binding DataGridRawRowsViewModel}"
			Visibility="{Binding RawRows, Converter={StaticResource KcvRec.Visible}}"
			>
			<b:Interaction.Behaviors>
				<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridRawRowsViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridRawRowsViewModel.SortDescriptions}" />
			</b:Interaction.Behaviors>

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Command="{Binding DataGridRawRowsViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridRawRowsViewModel.DataGrid.OpenColumnSelector}" />
					<MenuItem Command="{Binding DataGridRawRowsViewModel.ClearSortingCommand}" Header="{Binding DataGridRawRowsViewModel.DataGrid.ClearSorting}" />
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTemplateColumn
					Width="140"
					MinWidth="140"
					Header="{x:Static fork:ForkStrings.KcvRecordTime}"
					SortMemberPath="DateDisplay"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type construction:ConstructionRecordRow}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding DateDisplay, Converter={StaticResource KcvRec.Time}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="100"
					MinWidth="100"
					Header="{x:Static translations:ConstructionRecordViewerResources.RecordView_Name}"
					SortMemberPath="CellTag1"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type construction:ConstructionRecordRow}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding ShipName}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="230"
					MinWidth="230"
					Header="{x:Static translations:ConstructionRecordViewerResources.RecordView_Recipe}"
					SortMemberPath="CellTag3"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type construction:ConstructionRecordRow}">
							<StackPanel Margin="6 0" Orientation="Horizontal">
								<ItemsControl ItemsSource="{Binding Recipe, Converter={StaticResource KcvRec.RecipeParts}}" Style="{StaticResource KcvRec.Recipe}" />
								<Border
									x:Name="Large"
									Padding="4 0"
									VerticalAlignment="Center"
									Background="{DynamicResource Kcv.ChipBackground}"
									CornerRadius="2"
									Visibility="Collapsed"
									>
									<TextBlock
										FontSize="11"
										Foreground="{DynamicResource Kcv.SubForeground}"
										Text="{x:Static fork:ForkStrings.KcvRecordLarge}"
										/>
								</Border>
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding Recipe, Converter={StaticResource KcvRec.LargeRecipe}}" Value="True">
									<Setter TargetName="Large" Property="Visibility" Value="Visible" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="*"
					MinWidth="110"
					Header="{x:Static fork:ForkStrings.KcvRecordFlagship}"
					SortMemberPath="CellTag4"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type construction:ConstructionRecordRow}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding FlagshipName}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!--  merged by ship (the ship is (모두))  -->
		<DataGrid
			Grid.Row="1"
			ItemsSource="{Binding DataGridMergedRowsAllViewModel.Items}"
			Style="{StaticResource KcvRec.Grid}"
			Tag="{Binding DataGridMergedRowsAllViewModel}"
			Visibility="{Binding MergedShipNameVisible, Converter={StaticResource KcvRec.Visible}}"
			>
			<b:Interaction.Behaviors>
				<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridMergedRowsAllViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridMergedRowsAllViewModel.SortDescriptions}" />
			</b:Interaction.Behaviors>

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Command="{Binding DataGridMergedRowsAllViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridMergedRowsAllViewModel.DataGrid.OpenColumnSelector}" />
					<MenuItem Command="{Binding DataGridMergedRowsAllViewModel.ClearSortingCommand}" Header="{Binding DataGridMergedRowsAllViewModel.DataGrid.ClearSorting}" />
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTemplateColumn
					Width="*"
					MinWidth="110"
					Header="{x:Static translations:ConstructionRecordViewerResources.Ship}"
					SortMemberPath="CellTag1"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type construction:ConstructionRecordRow}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding ShipName}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Width="100"
					MinWidth="100"
					CellTemplate="{StaticResource Count}"
					Header="{x:Static translations:ConstructionRecordViewerResources.Tries}"
					SortMemberPath="Count"
					/>
				<DataGridTemplateColumn
					Width="110"
					MinWidth="110"
					CellTemplate="{StaticResource DevMats1}"
					Header="{x:Static fork:ForkStrings.KcvRecordDevMats1}"
					SortMemberPath="DevMats1Count"
					/>
				<DataGridTemplateColumn
					Width="110"
					MinWidth="110"
					CellTemplate="{StaticResource DevMats20}"
					Header="{x:Static fork:ForkStrings.KcvRecordDevMats20}"
					SortMemberPath="DevMats20Count"
					/>
				<DataGridTemplateColumn
					Width="110"
					MinWidth="110"
					CellTemplate="{StaticResource DevMats100}"
					Header="{x:Static fork:ForkStrings.KcvRecordDevMats100}"
					SortMemberPath="DevMats100Count"
					/>
			</DataGrid.Columns>
		</DataGrid>

		<!--  merged by recipe (a ship is chosen)  -->
		<DataGrid
			Grid.Row="1"
			ItemsSource="{Binding DataGridMergedRowsFilteredByShipViewModel.Items}"
			Style="{StaticResource KcvRec.Grid}"
			Tag="{Binding DataGridMergedRowsFilteredByShipViewModel}"
			Visibility="{Binding MergedRecipeVisible, Converter={StaticResource KcvRec.Visible}}"
			>
			<b:Interaction.Behaviors>
				<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridMergedRowsFilteredByShipViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridMergedRowsFilteredByShipViewModel.SortDescriptions}" />
			</b:Interaction.Behaviors>

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Command="{Binding DataGridMergedRowsFilteredByShipViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridMergedRowsFilteredByShipViewModel.DataGrid.OpenColumnSelector}" />
					<MenuItem Command="{Binding DataGridMergedRowsFilteredByShipViewModel.ClearSortingCommand}" Header="{Binding DataGridMergedRowsFilteredByShipViewModel.DataGrid.ClearSorting}" />
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTemplateColumn
					Width="*"
					MinWidth="140"
					Header="{x:Static translations:ConstructionRecordViewerResources.RecordView_Recipe}"
					SortMemberPath="CellTag3"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type construction:ConstructionRecordRow}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding Recipe}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Width="100"
					MinWidth="100"
					CellTemplate="{StaticResource Count}"
					Header="{x:Static translations:ConstructionRecordViewerResources.Tries}"
					SortMemberPath="Count"
					/>
				<DataGridTemplateColumn
					Width="110"
					MinWidth="110"
					CellTemplate="{StaticResource DevMats1}"
					Header="{x:Static fork:ForkStrings.KcvRecordDevMats1}"
					SortMemberPath="DevMats1Count"
					/>
				<DataGridTemplateColumn
					Width="110"
					MinWidth="110"
					CellTemplate="{StaticResource DevMats20}"
					Header="{x:Static fork:ForkStrings.KcvRecordDevMats20}"
					SortMemberPath="DevMats20Count"
					/>
				<DataGridTemplateColumn
					Width="110"
					MinWidth="110"
					CellTemplate="{StaticResource DevMats100}"
					Header="{x:Static fork:ForkStrings.KcvRecordDevMats100}"
					SortMemberPath="DevMats100Count"
					/>
			</DataGrid.Columns>
		</DataGrid>

		<Border Grid.Row="2" Style="{StaticResource KcvRec.StatusBar}">
			<DockPanel>
				<TextBlock x:Name="SelectionText" DockPanel.Dock="Right" />
				<TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>
	</Grid>
</common:WindowBase>

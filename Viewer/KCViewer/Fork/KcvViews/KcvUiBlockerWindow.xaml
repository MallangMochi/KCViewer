<Window
	x:Class="KCViewer.Fork.KcvViews.KcvUiBlockerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:blocker="clr-namespace:KCViewer.Window.Dialog.UiBlocker"
	xmlns:colorPicker="clr-namespace:ColorPickerLib.Controls;assembly=ColorPickerLib"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{x:Static translations:UiBlockerResources.UiBlocker}"
	Width="560"
	d:DataContext="{d:DesignInstance blocker:UiBlockerManagerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	SizeToContent="Height"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: UI 차단기 in KanColleViewer's style (KcvMenuWindows, mockup viewer-design/mockups/20261018-menu-windows-v2.html,
		approved 2026-10-18 "구현") with the viewer's view model: a box per blocker instead of the tabs (the viewer has one,
		「대파」, titled 「대파 진격 차단」) with 사용, 위·왼쪽·높이·너비 in small number boxes and 기본값, 배경 with the
		settings window's colour picker, 이미지, and 미리 보기 below. The blockers work with the window closed; closing it
		saves the settings and takes the preview away, as the viewer.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvConfigurationStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<kcv:KcvDoubleIntConverter x:Key="Whole" />
			<kcv:KcvUiBlockerTitleConverter x:Key="Title" />

			<Style
				x:Key="Name"
				BasedOn="{StaticResource Cfg.Lbl}"
				TargetType="TextBlock"
				>
				<Setter Property="MinWidth" Value="42" />
			</Style>
			<!--  a name after a box on the same row (narrower, so 위·왼쪽·높이·너비 keep to one row)  -->
			<Style
				x:Key="Name2"
				BasedOn="{StaticResource Name}"
				TargetType="TextBlock"
				>
				<Setter Property="MinWidth" Value="32" />
				<Setter Property="Margin" Value="10 0 8 0" />
			</Style>

			<DataTemplate DataType="{x:Type blocker:UiBlockerViewModel}">
				<ContentControl Style="{StaticResource Cfg.Box}" Tag="{Binding Converter={StaticResource Title}}">
					<StackPanel>
						<CheckBox Content="{x:Static translations:UiBlockerResources.Enabled}" IsChecked="{Binding IsEnabled}" />
						<WrapPanel Style="{StaticResource Cfg.Row}">
							<TextBlock Style="{StaticResource Name}" Text="{x:Static translations:UiBlockerResources.Top}" />
							<kcv:KcvNumberBox Style="{StaticResource Cfg.Num}" Value="{Binding DesiredTop, Converter={StaticResource Whole}}" />
							<TextBlock Style="{StaticResource Name2}" Text="{x:Static translations:UiBlockerResources.Left}" />
							<kcv:KcvNumberBox Style="{StaticResource Cfg.Num}" Value="{Binding DesiredLeft, Converter={StaticResource Whole}}" />
							<TextBlock Style="{StaticResource Name2}" Text="{x:Static translations:UiBlockerResources.Height}" />
							<kcv:KcvNumberBox
								Minimum="0"
								Style="{StaticResource Cfg.Num}"
								Value="{Binding DesiredHeight, Converter={StaticResource Whole}}"
								/>
							<TextBlock Style="{StaticResource Name2}" Text="{x:Static translations:UiBlockerResources.Width}" />
							<kcv:KcvNumberBox
								Minimum="0"
								Style="{StaticResource Cfg.Num}"
								Value="{Binding DesiredWidth, Converter={StaticResource Whole}}"
								/>
						</WrapPanel>
						<WrapPanel Style="{StaticResource Cfg.Row}">
							<Button
								Margin="0"
								Command="{Binding SetDesiredValuesToDefaultCommand}"
								Content="{x:Static translations:UiBlockerResources.Default}"
								Style="{StaticResource KcvRec.Button}"
								/>
						</WrapPanel>
						<WrapPanel Style="{StaticResource Cfg.Row}">
							<TextBlock Style="{StaticResource Name}" Text="{x:Static translations:UiBlockerResources.Background}" />
							<colorPicker:ColorPicker
								Margin="0 1"
								ColorMode="ColorCanvas"
								DisplayColorAndName="True"
								SelectedColor="{Binding BackgroundColor, Converter={StaticResource HexToColorConverter}}"
								>
								<colorPicker:ColorPicker.Resources>
									<SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource SystemAltHighColor}" />
								</colorPicker:ColorPicker.Resources>
							</colorPicker:ColorPicker>
						</WrapPanel>
						<DockPanel Margin="0 2">
							<TextBlock
								DockPanel.Dock="Left"
								Style="{StaticResource Name}"
								Text="{x:Static translations:UiBlockerResources.Image}"
								/>
							<Button
								Command="{Binding OpenImagePathCommand}"
								DockPanel.Dock="Right"
								Style="{StaticResource Cfg.Browse}"
								/>
							<TextBox Style="{StaticResource Cfg.Field}" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />
						</DockPanel>
					</StackPanel>
				</ContentControl>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<Button
				HorizontalAlignment="Right"
				Command="{Binding ShowBlockerCommand}"
				CommandParameter="{Binding SelectedBlocker}"
				Content="{x:Static translations:UiBlockerResources.Show}"
				Style="{StaticResource KcvRec.Button}"
				/>
		</Border>

		<ItemsControl
			Margin="12 6 12 0"
			Focusable="False"
			ItemsSource="{Binding Blockers}"
			/>
	</DockPanel>
</Window>

<common:WindowBase
	x:Class="KCViewer.Fork.KcvViews.KcvExpeditionRecordWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:behaviors="clr-namespace:KCViewer.Behaviors"
	xmlns:common="clr-namespace:KCViewer.Common"
	xmlns:core="clr-namespace:KCViewer.Core.Types;assembly=KCViewer.Core"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:expedition="clr-namespace:KCViewer.Window.Tools.ExpeditionRecordViewer"
	xmlns:fork="clr-namespace:KCViewer.Fork"
	xmlns:kcv="clr-namespace:KCViewer.Fork.KcvViews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:persistentColumns="clr-namespace:KCViewer.Behaviors.PersistentColumns"
	xmlns:translations="clr-namespace:KCViewer.Translations"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Title="{Binding ExpeditionRecordViewer.Title}"
	Width="800"
	Height="450"
	d:DataContext="{d:DesignInstance expedition:ExpeditionRecordViewerViewModel}"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="expedition:ExpeditionRecordViewerViewModel"
	Background="{DynamicResource Kcv.Background}"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	mc:Ignorable="d"
	>
	<!--
		Fork: the expedition record in KanColleViewer's style (mockup v4, viewer-design/mockups/20261004-expedition-record-v4.html,
		approved 2026-10-04) with the viewer's view model. Columns 시간·ID (and the name in grey)·결과 (대성공 gold, 성공
		green, 실패 red)·연료·탄약·강재·보크사이트 (0 faded)·아이템1·아이템2 (icon and count, the name in the tooltip)·함대
		(ship chips, as the sortie record). The status bar adds up the selected rows, as the viewer.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<kcv:KcvExpeditionNameConverter x:Key="ExpeditionName" />
			<kcv:KcvExpeditionResultConverter x:Key="Result" />

			<!--  a resource: its square and the number, faded when 0  -->
			<Style x:Key="Amount" BasedOn="{StaticResource KcvRec.Text}" TargetType="TextBlock">
				<Setter Property="Margin" Value="0" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="0">
						<Setter Property="Foreground" Value="{DynamicResource Kcv.FaintForeground}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!--  an item and its count; the name is the tooltip  -->
			<DataTemplate x:Key="SummaryItem" DataType="{x:Type expedition:ExpeditionItem}">
				<StackPanel Margin="6 0 0 0" Orientation="Horizontal">
					<common:UseItemIcon
						Width="14"
						Height="14"
						Type="{Binding UseItemId}"
						/>
					<TextBlock VerticalAlignment="Center" Text="{Binding Count, StringFormat=×{0}}" />
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  검색 조건: 기간 (date and time), 해역, 원정  -->
		<ContentControl Grid.Row="0" Style="{StaticResource KcvRec.Conditions}">
			<DockPanel>
				<StackPanel
					VerticalAlignment="Bottom"
					DockPanel.Dock="Right"
					Orientation="Horizontal"
					>
					<Button
						Command="{Binding SearchCommand}"
						Content="{x:Static fork:ForkStrings.KcvRecordSearch}"
						Style="{StaticResource KcvRec.PrimaryButton}"
						/>
					<Button
						Command="{Binding SearchCancelCommand}"
						Content="{x:Static fork:ForkStrings.KcvRecordCancel}"
						Style="{StaticResource KcvRec.Button}"
						/>
					<Button
						Click="ResetConditions"
						Content="{x:Static fork:ForkStrings.KcvRecordReset}"
						Style="{StaticResource KcvRec.Button}"
						/>
				</StackPanel>
				<WrapPanel Style="{StaticResource KcvRec.ConditionRow}">
					<kcv:KcvRecordPeriod Margin="0 0 14 0" />
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding Source={x:Static translations:SortieRecordViewerResources.World}, StringFormat={}{0}:}" />
						<ComboBox
							ItemsSource="{Binding Worlds}"
							SelectedItem="{Binding World}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
					<StackPanel Style="{StaticResource KcvRec.Pair}">
						<TextBlock Style="{StaticResource KcvRec.Label}" Text="{Binding Source={x:Static fork:ForkStrings.KcvRecordExpedition}, StringFormat={}{0}:}" />
						<ComboBox
							ItemsSource="{Binding Missions}"
							SelectedItem="{Binding Mission}"
							Style="{StaticResource KcvRec.Combo}"
							/>
					</StackPanel>
				</WrapPanel>
			</DockPanel>
		</ContentControl>

		<DataGrid
			Grid.Row="1"
			ItemsSource="{Binding Expeditions}"
			SelectedItem="{Binding SelectedExpedition}"
			Style="{StaticResource KcvRec.Grid}"
			Tag="{Binding DataGridViewModel}"
			>
			<b:Interaction.Behaviors>
				<behaviors:MultiSelectionBehavior SelectedItems="{Binding SelectedExpeditions}" />
				<persistentColumns:PersistentColumnsBehavior ColumnProperties="{Binding DataGridViewModel.ColumnProperties}" SortDescriptions="{Binding DataGridViewModel.SortDescriptions}" />
			</b:Interaction.Behaviors>

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Command="{Binding DataGridViewModel.OpenColumnSelectorCommand}" Header="{Binding DataGridViewModel.DataGrid.OpenColumnSelector}" />
					<MenuItem Command="{Binding DataGridViewModel.ClearSortingCommand}" Header="{Binding DataGridViewModel.DataGrid.ClearSorting}" />
					<Separator />
					<MenuItem Command="{Binding OpenFleetImageGeneratorCommand}" Header="{Binding ExpeditionRecordViewer.FleetImage}" />
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTemplateColumn
					Width="140"
					Header="{x:Static fork:ForkStrings.KcvRecordTime}"
					SortMemberPath="ExpeditionStart"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<TextBlock Style="{StaticResource KcvRec.Text}" Text="{Binding ExpeditionStart, Converter={StaticResource KcvRec.Time}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="130"
					Header="ID"
					SortMemberPath="DisplayId"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<TextBlock Style="{StaticResource KcvRec.Text}">
								<Run Text="{Binding DisplayId, Mode=OneWay}" />
								<Run
									FontSize="11"
									Foreground="{DynamicResource Kcv.InactiveForeground}"
									Text="{Binding Model.Expedition, Mode=OneWay, Converter={StaticResource ExpeditionName}}"
									/>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="62"
					Header="{x:Static translations:ExpeditionRecordViewerResources.Result}"
					SortMemberPath="ClearResult"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<Border
								x:Name="Badge"
								Margin="6 0"
								Padding="5 0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								CornerRadius="2"
								>
								<TextBlock
									x:Name="Label"
									FontSize="11"
									Text="{Binding ClearResult}"
									/>
							</Border>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding ClearResult, Converter={StaticResource Result}}" Value="Great">
									<Setter TargetName="Badge" Property="Background" Value="{DynamicResource Kcv.GreatSuccess}" />
									<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kcv.GreatSuccessText}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding ClearResult, Converter={StaticResource Result}}" Value="Success">
									<Setter TargetName="Badge" Property="Background" Value="{DynamicResource Kcv.Success}" />
									<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kcv.SuccessText}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding ClearResult, Converter={StaticResource Result}}" Value="Failure">
									<Setter TargetName="Badge" Property="Background" Value="{DynamicResource Kcv.Failure}" />
									<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kcv.FailureText}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="60"
					Header="{x:Static translations:ConstantsRes.Fuel}"
					SortMemberPath="Fuel"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<StackPanel Margin="6 0" Orientation="Horizontal">
								<Rectangle Fill="{StaticResource KcvRec.Fuel}" Style="{StaticResource KcvRec.Dot}" />
								<TextBlock Style="{StaticResource Amount}" Text="{Binding Fuel}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="60"
					Header="{x:Static translations:ConstantsRes.Ammo}"
					SortMemberPath="Ammo"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<StackPanel Margin="6 0" Orientation="Horizontal">
								<Rectangle Fill="{StaticResource KcvRec.Ammo}" Style="{StaticResource KcvRec.Dot}" />
								<TextBlock Style="{StaticResource Amount}" Text="{Binding Ammo}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="60"
					Header="{x:Static translations:ConstantsRes.Steel}"
					SortMemberPath="Steel"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<StackPanel Margin="6 0" Orientation="Horizontal">
								<Rectangle Fill="{StaticResource KcvRec.Steel}" Style="{StaticResource KcvRec.Dot}" />
								<TextBlock Style="{StaticResource Amount}" Text="{Binding Steel}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="86"
					Header="{x:Static translations:ConstantsRes.Baux}"
					SortMemberPath="Bauxite"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<StackPanel Margin="6 0" Orientation="Horizontal">
								<Rectangle Fill="{StaticResource KcvRec.Bauxite}" Style="{StaticResource KcvRec.Dot}" />
								<TextBlock Style="{StaticResource Amount}" Text="{Binding Bauxite}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="64"
					Header="{x:Static translations:ExpeditionRecordViewerResources.Item1}"
					SortMemberPath="ItemOneCount"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<StackPanel
								x:Name="Item"
								Margin="6 0"
								HorizontalAlignment="Left"
								Background="Transparent"
								Orientation="Horizontal"
								ToolTip="{Binding ItemOneName}"
								>
								<common:UseItemIcon
									Width="16"
									Height="16"
									Type="{Binding ItemOneId}"
									/>
								<TextBlock
									Margin="1 0 0 0"
									VerticalAlignment="Center"
									FontSize="13"
									Text="{Binding ItemOneCount, StringFormat=×{0}}"
									/>
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding ItemOneId}" Value="{x:Static core:UseItemId.Unknown}">
									<Setter TargetName="Item" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					Width="64"
					Header="{x:Static translations:ExpeditionRecordViewerResources.Item2}"
					SortMemberPath="ItemTwoCount"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<StackPanel
								x:Name="Item"
								Margin="6 0"
								HorizontalAlignment="Left"
								Background="Transparent"
								Orientation="Horizontal"
								ToolTip="{Binding ItemTwoName}"
								>
								<common:UseItemIcon
									Width="16"
									Height="16"
									Type="{Binding ItemTwoId}"
									/>
								<TextBlock
									Margin="1 0 0 0"
									VerticalAlignment="Center"
									FontSize="13"
									Text="{Binding ItemTwoCount, StringFormat=×{0}}"
									/>
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding ItemTwoId}" Value="{x:Static core:UseItemId.Unknown}">
									<Setter TargetName="Item" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn
					x:Name="FleetColumn"
					Width="Auto"
					MinWidth="120"
					CanUserSort="False"
					Header="{x:Static translations:SortieRecordViewerResources.Fleet}"
					>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type expedition:ExpeditionRecordViewModel}">
							<ItemsControl ItemsSource="{Binding Converter={StaticResource KcvRec.FleetShips}}" Style="{StaticResource KcvRec.Fleet}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!--  the viewer's status text, and the sum of the selected rows on the right  -->
		<Border Grid.Row="2" Style="{StaticResource KcvRec.StatusBar}">
			<DockPanel>
				<StackPanel
					DockPanel.Dock="Right"
					Orientation="Horizontal"
					Visibility="{Binding ExpeditionSummary, Converter={x:Static kcv:KcvNotNullConverter.Visible}}"
					>
					<Rectangle Fill="{StaticResource KcvRec.Fuel}" Style="{StaticResource KcvRec.Dot}" />
					<TextBlock Margin="0 0 8 0" Text="{Binding ExpeditionSummary.Fuel}" />
					<Rectangle Fill="{StaticResource KcvRec.Ammo}" Style="{StaticResource KcvRec.Dot}" />
					<TextBlock Margin="0 0 8 0" Text="{Binding ExpeditionSummary.Ammo}" />
					<Rectangle Fill="{StaticResource KcvRec.Steel}" Style="{StaticResource KcvRec.Dot}" />
					<TextBlock Margin="0 0 8 0" Text="{Binding ExpeditionSummary.Steel}" />
					<Rectangle Fill="{StaticResource KcvRec.Bauxite}" Style="{StaticResource KcvRec.Dot}" />
					<TextBlock Text="{Binding ExpeditionSummary.Bauxite}" />
					<ItemsControl
						Focusable="False"
						ItemTemplate="{StaticResource SummaryItem}"
						ItemsPanel="{StaticResource KcvRec.Horizontal}"
						ItemsSource="{Binding ExpeditionSummary.ExpeditionItems.Values}"
						/>
				</StackPanel>
				<TextBlock Text="{Binding StatusBarText}" TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>
	</Grid>
</common:WindowBase>

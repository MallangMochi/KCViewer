<Window
	x:Class="KCViewer.Fork.KcvViews.KcvUpdateDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	Width="430"
	ui:WindowHelper.UseModernWindowStyle="True"
	Background="{DynamicResource Kcv.Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	TextElement.FontFamily="{DynamicResource Kcv.FontFamily}"
	TextElement.Foreground="{DynamicResource Kcv.Foreground}"
	WindowStartupLocation="CenterOwner"
	>
	<!--
		Fork: the program update's small windows in KanColleViewer's style (mockup 20261022-program-update-v5 ①-2, ⑧, ⑨):
		the text, an optional box (the release's note), the buttons on the bottom line, the first of them accented.
		Enter is the first button, Esc the last.
	-->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/KCViewer;component/Fork/KcvViews/KcvRecordStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<DockPanel>
		<Border
			Padding="12 7"
			BorderBrush="{DynamicResource Kcv.HeaderBackground}"
			BorderThickness="0 1 0 0"
			DockPanel.Dock="Bottom"
			>
			<StackPanel x:Name="Buttons" HorizontalAlignment="Right" Orientation="Horizontal" />
		</Border>

		<StackPanel Margin="14 10 14 12">
			<TextBlock
				x:Name="MessageText"
				FontSize="13"
				LineHeight="20"
				TextWrapping="Wrap"
				/>
			<Border
				x:Name="NoteBox"
				Margin="0 8 0 0"
				Padding="8 5"
				BorderBrush="{DynamicResource Kcv.HeaderBackground}"
				BorderThickness="1"
				Visibility="Collapsed"
				>
				<ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
					<TextBlock
						x:Name="NoteText"
						FontSize="12.5"
						Foreground="{DynamicResource Kcv.SubForeground}"
						LineHeight="19"
						TextWrapping="Wrap"
						/>
				</ScrollViewer>
			</Border>
		</StackPanel>
	</DockPanel>
</Window>

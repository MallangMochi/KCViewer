<Window
	x:Class="KCViewer.Avalonia.ExpeditionCalculator.ExpeditionCalculatorWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:KCViewer.Avalonia.ExpeditionCalculator"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{x:Static local:ExpeditionCalculatorResources.Title}"
	Width="1000"
	Height="680"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d"
	>
	<!--  Fork: a size of its own (1000×680, user decision 2026-10-06); without one the window opened as large as the screen  -->
	<local:ExpeditionCalculatorView />
</Window>
